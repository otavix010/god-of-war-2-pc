+void VU1Interpreter::otxAssumeNativo(const void *ctx)
+{
+    const vu1n::Ctx &x = *static_cast<const vu1n::Ctx *>(ctx);
+    m_cycle = x.c;
+    m_state.cycles = x.c;
+    m_flagPipeline = {};
+    for (int i = 0, j = 0; i < x.nfq && j < static_cast<int>(kMaxFlagEntries); ++i, ++j)
+    {
+        const vu1n::Flag &f = vu1n::fqAt(x, i); // Otavix: anel
+        FlagPipelineEntry &e = m_flagPipeline[j];
+        e.valid = true;
+        e.readyCycle = f.pronto;
+        e.issueCycle = f.pronto - kFmacLatency;
+        e.mac = f.mac;
+        e.status = f.status;
+        e.clip = f.clip;
+        e.writesMac = (f.tipo & vu1n::FlagMac) != 0u;
+        e.writesStatus = (f.tipo & vu1n::FlagStatus) != 0u;
+        e.writesSticky = (f.tipo & vu1n::FlagSticky) != 0u;
+        e.writesClip = (f.tipo & vu1n::FlagClip) != 0u;
+    }
+    m_fdiv = {};
+    m_fdiv.valid = x.qv;
+    m_fdiv.readyCycle = x.qPronto;
+    m_fdiv.value = x.qVal;
+    m_fdiv.statusDi = x.qDi;
+    for (int i = 0; i < 2; ++i)
+    {
+        m_efu[i] = {};
+        m_efu[i].valid = x.pv[i];
+        m_efu[i].readyCycle = x.pPronto[i];
+        m_efu[i].value = x.pVal[i];
+    }
+    m_efuResourceReady = x.efuLivre;
+    // VF/VI/ACC/memória já foram escritos na hora; só os prontos importam (as leituras travam neles)
+    m_storePipeline = {};
+    m_vfWritePipeline = {};
+    m_viWritePipeline = {};
+    m_accWritePipeline = {};
+    for (int r = 0; r < 32; ++r)
+        for (int c = 0; c < 4; ++c)
+            m_vfReady[r][c] = x.vfR[r][c];
+    for (int r = 0; r < 16; ++r)
+        m_viReady[r] = x.viR[r];
+    m_accReady = {};
+    m_vfLatestWrite = {};
+    m_viLatestWrite = {};
+    m_accLatestWrite = {};
+    m_xgkick.active = x.xg.ativo;
+    m_xgkick.currentTagEop = x.xg.eop;
+    m_xgkick.sourceAddress = x.xg.origem;
+    m_xgkick.copiedBytes = x.xg.copiado;
+    m_xgkick.currentTagEnd = x.xg.tagFim;
+    m_xgkick.totalBytes = x.xg.total;
+    m_xgkick.cycleCredit = vu1n::credXg(x);
+    m_xgkick.issueCycle = x.xg.emissao;
+    if (x.xg.ativo && x.pacote)
+        std::memcpy(m_xgkick.packet.data(), x.pacote, std::min<uint32_t>(x.xg.copiado, XgkickPipeline::kBufferSize));
+    m_workingClip = x.workClip;
+    m_viBranchBackupReg = x.bkReg;
+    m_viBranchBackupValue = x.bkVal;
+    m_viBranchBackupValid = x.bkReg != 0u;
+    m_state.pc = x.pc;
+    m_state.branchPending = x.bp;
+    m_state.branchTarget = x.bt;
+    m_state.branchDelay = x.bd;
+    m_state.ebit = x.eb;
+    m_state.haltAfterDelaySlot = false;
+    m_otxProxCommit = 0;
+    if (x.xg.erro)
+        reportReservedInstruction(false, 0xFFFFFFFBu);
+}
+
+bool VU1Interpreter::otxNativo(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize, GS &gs,
+                               PS2Memory *memory, uint32_t startPC, uint32_t maxCycles)
+{
+    const int modo = otxModoNativo();
+    if (modo == 0 || !memory || !vuCode || vuCode != memory->getVU1Code() || codeSize != 0x4000u ||
+        dataSize != 0x4000u || otxVuExato() || vu1n::kNumProgramas == 0u)
+        return false;
+    const uint64_t g = memory->getVU1CodeGeneration();
+    if (g != m_otxGeracao)
+    {
+        m_otxGeracao = g;
+        // Otavix (cache por conteúdo): o jogo alterna entre poucos microcódigos; guarda a tabela do atual e
+        // recupera a do novo se o conteúdo já foi visto (CRC32 dos 16 KB em 2 trilhas, ~1 µs), em vez de refazer
+        // o hash dos programas. PS2X_VU1_CACHE_CONTEUDO=0 desliga.
+        static const bool porConteudo = [] { const char *e = std::getenv("PS2X_VU1_CACHE_CONTEUDO"); return !(e && e[0] == '0'); }();
+        if (porConteudo)
+        {
+            if (m_otxCacheAtual < m_otxCachesConteudo.size())
+                m_otxCachesConteudo[m_otxCacheAtual].second = m_otxCachePc;
+            uint64_t ca = 0, cb = ~0ull;
+            for (uint32_t k = 0; k < codeSize; k += 16u)
+            {
+                uint64_t a0, a1;
+                std::memcpy(&a0, vuCode + k, 8);
+                std::memcpy(&a1, vuCode + k + 8, 8);
+                ca = _mm_crc32_u64(ca, a0);
+                cb = _mm_crc32_u64(cb, a1);
+            }
+            const uint64_t chave = (ca << 32) ^ cb;
+            m_otxCacheAtual = ~size_t(0);
+            for (size_t k = 0; k < m_otxCachesConteudo.size(); ++k)
+                if (m_otxCachesConteudo[k].first == chave)
+                {
+                    m_otxCacheAtual = k;
+                    break;
+                }
+            if (m_otxCacheAtual == ~size_t(0))
+            {
+                if (m_otxCachesConteudo.size() >= 2048u) // Otavix: o God of War II alterna centenas de microcódigos
+                    m_otxCachesConteudo.erase(m_otxCachesConteudo.begin());
+                m_otxCachesConteudo.emplace_back(chave, std::vector<std::pair<uint32_t, void *>>());
+                m_otxCacheAtual = m_otxCachesConteudo.size() - 1u;
+            }
+            m_otxCachePc = m_otxCachesConteudo[m_otxCacheAtual].second;
+        }
+        else
+            m_otxCachePc.clear();
+    }
+    // cache por pc: Programa* com o bit 0 ligado quando as entradas extras não conferem
+    uintptr_t marca = 0;
+    bool achou = false;
+    for (const auto &e : m_otxCachePc)
+        if (e.first == startPC)
+        {
+            marca = reinterpret_cast<uintptr_t>(e.second);
+            achou = true;
+            break;
+        }
+    if (!achou)
+    {
+        const vu1n::Programa *pr = vu1n::procuraPrograma(vu1n::hashPrograma(vuCode, codeSize, startPC));
+        marca = reinterpret_cast<uintptr_t>(pr);
+        if (pr && !vu1n::extrasConferem(*pr, vuCode, codeSize))
+            marca |= 1u;
+        m_otxCachePc.emplace_back(startPC, reinterpret_cast<void *>(marca));
+    }
+    const vu1n::Programa *prog = reinterpret_cast<const vu1n::Programa *>(marca & ~static_cast<uintptr_t>(1u));
+    const bool semExtras = (marca & 1u) != 0u;
+    const vu1n::Funcao f = prog ? prog->f : nullptr;
+    // Otavix (31/10): PS2X_VU1_FALTAS=1 conta acertos/faltas da tabela nativa e mostra as primeiras faltas por pc
+    static const bool faltas = [] { const char *e = std::getenv("PS2X_VU1_FALTAS"); return e && e[0] == '1'; }();
+    if (faltas)
+    {
+        static std::atomic<uint64_t> acertos{0}, falhas{0}, semX{0};
+        static std::atomic<int> logs{0};
+        (f ? (semExtras ? semX : acertos) : falhas).fetch_add(1u, std::memory_order_relaxed);
+        if (!f && logs.fetch_add(1) < 60)
+            std::fprintf(stderr, "[vu1n:falta] pc=0x%04x hash=%016llx\n", startPC,
+                         static_cast<unsigned long long>(vu1n::hashPrograma(vuCode, codeSize, startPC)));
+        const uint64_t tot = acertos.load() + falhas.load() + semX.load();
+        if ((tot & 0xFFFFu) == 0u)
+            std::fprintf(stderr, "[vu1n:conta] acertos=%llu faltas=%llu sem_extras=%llu\n",
+                         static_cast<unsigned long long>(acertos.load()), static_cast<unsigned long long>(falhas.load()),
+                         static_cast<unsigned long long>(semX.load()));
+    }
+    // Otavix (encadeamento; 31/10: limite 65536 saltos, o orçamento de ciclos já segura o laço): um programa que sai por JR para o início de OUTRO programa conhecido (Spawn: 0x2000..
+    // 0x2020 → 0x0000, ~3% das execuções) seguia no interpretador (~6x mais lento); agora segue no nativo com o
+    // mesmo Ctx. PS2X_VU1_ENCADEIA=0 desliga. Até 256 saltos (o despachante do God of War encadeia dezenas por execução).
+    static const bool encadeia = [] { const char *e = std::getenv("PS2X_VU1_ENCADEIA"); return !(e && e[0] == '0'); }();
+    auto procura = [&](uint32_t pc, bool &semX) -> vu1n::Funcao
+    {
+        uintptr_t m = 0;
+        bool tem = false;
+        for (const auto &e : m_otxCachePc)
+            if (e.first == pc)
+            {
+                m = reinterpret_cast<uintptr_t>(e.second);
+                tem = true;
+                break;
+            }
+        if (!tem)
+        {
+            const vu1n::Programa *pr = vu1n::procuraPrograma(vu1n::hashPrograma(vuCode, codeSize, pc));
+            m = reinterpret_cast<uintptr_t>(pr);
+            if (pr && !vu1n::extrasConferem(*pr, vuCode, codeSize))
+                m |= 1u;
+            m_otxCachePc.emplace_back(pc, reinterpret_cast<void *>(m));
+        }
+        semX = (m & 1u) != 0u;
+        const vu1n::Programa *pr = reinterpret_cast<const vu1n::Programa *>(m & ~static_cast<uintptr_t>(1u));
+        return pr ? pr->f : nullptr;
+    };
+    auto roda = [&](vu1n::Ctx &cx) -> int
+    {
+        int res = f(cx, startPC);
+        for (int k = 0; encadeia && res == vu1n::Devolve && k < 65536 && !cx.eb && !cx.bp && cx.c < cx.fim; ++k)
+        {
+            bool semX = false;
+            const vu1n::Funcao g = procura(cx.pc, semX);
+            if (!g)
+                break;
+            cx.semExtras = semX;
+            const uint32_t pcAntes = cx.pc;
+            const uint64_t cAntes = cx.c;
+            res = g(cx, cx.pc);
+            if (res == vu1n::Devolve && cx.pc == pcAntes && cx.c == cAntes)
+            {
+                // Otavix (31/10): o programa achado devolveu sem andar (não aceita entrar nesse pc): interpretador
+                static std::atomic<int> logs{0};
+                if (logs.fetch_add(1) < 20)
+                    std::fprintf(stderr, "[vu1n:parado] pc=0x%04x hash=%016llx sem_extras=%d\n", cx.pc,
+                                 static_cast<unsigned long long>(vu1n::hashPrograma(vuCode, codeSize, cx.pc)), semX ? 1 : 0);
+                break;
+            }
+        }
+        return res;
+    };
+    if (!f)
+    {
+        g_otxVu1SemProg.fetch_add(1u, std::memory_order_relaxed);
+        return false;
+    }
+
+    if (modo == 2)
+    {
+        // verificação: interpretador de verdade, nativo numa cópia
+        static thread_local std::vector<uint8_t> dados0, dadosN;
+        static std::atomic<uint64_t> verificados{0u};
+        static std::vector<uint64_t> divergiram;
+        dados0.assign(vuData, vuData + dataSize);
+        const VU1State estado0 = m_state;
+        const uint64_t ciclo0 = m_cycle;
+        std::vector<std::vector<uint8_t>> pacI, pacN;
+        m_otxCaptura = &pacI;
+        resetScheduler(); // patch_vu1_reset_tardio: o execute não zera mais antes do nativo
+        m_otxSujo = false;
+        run(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+        m_otxCaptura = nullptr;
+
+        VU1State estadoN = estado0;
+        dadosN = dados0;
+        OtxEnvio envio{nullptr, nullptr, &pacN};
+        vu1n::Ctx x;
+        otxPreparaCtx(x, &estadoN, dadosN.data(), dataSize, ciclo0, maxCycles, &envio);
+        x.semExtras = semExtras;
+        const int arred = std::fegetround();
+        std::fesetround(FE_TOWARDZERO);
+        const int r = roda(x);
+        vu1n::comitaRapido(x);
+        vu1n::avancaXg(x, 0u); // XGKICK preguiçoso: efetiva o crédito antes de devolver
+        std::fesetround(arred);
+        if (r != vu1n::Terminou)
+        {
+            g_otxVu1Devolvido.fetch_add(1u, std::memory_order_relaxed);
+            otxRegistraDevolve(vuCode, codeSize, startPC, x);
+            return true;
+        }
+        estadoN.cycles = x.c;
+        const std::string dif = otxDiferenca(m_state, estadoN, vuData, dadosN.data(), dataSize, pacI, pacN,
+                                             m_cycle - ciclo0, x.c - ciclo0);
+        const uint64_t n = verificados.fetch_add(1u) + 1u;
+        if (!dif.empty())
+        {
+            g_otxVu1Diverge.fetch_add(1u, std::memory_order_relaxed);
+            const uint64_t hp = vu1n::hashPrograma(vuCode, codeSize, startPC);
+            static std::mutex mtx;
+            std::lock_guard<std::mutex> lk(mtx);
+            if (std::find(divergiram.begin(), divergiram.end(), hp) == divergiram.end())
+            {
+                divergiram.push_back(hp);
+                std::fprintf(stderr, "[vu1n] DIVERGE programa %016llx pc=0x%04x: %s\n", static_cast<unsigned long long>(hp),
+                             startPC, dif.c_str());
+                std::fflush(stderr);
+            }
+        }
+        if ((n & 0xFFFFu) == 0u)
+        {
+            std::fprintf(stderr, "[vu1n] verificados=%llu divergiram=%llu devolvidos=%llu sem_programa=%llu\n",
+                         static_cast<unsigned long long>(n), static_cast<unsigned long long>(g_otxVu1Diverge.load()),
+                         static_cast<unsigned long long>(g_otxVu1Devolvido.load()),
+                         static_cast<unsigned long long>(g_otxVu1SemProg.load()));
+            std::fflush(stderr);
+        }
+        return true;
+    }
+
+    // nativo
+    OtxEnvio envio{memory, &gs, nullptr};
+    vu1n::Ctx x;
+    otxPreparaCtx(x, &m_state, vuData, dataSize, m_cycle, maxCycles, &envio);
+    x.semExtras = semExtras;
+    m_activeVuData = vuData;
+    m_activeVuDataSize = dataSize;
+    m_activeGs = &gs;
+    m_activeMemory = memory;
+    // Otavix: arredondamento para zero direto no MXCSR (RC = bits 13-14); o fesetround do ucrt mexia também no
+    // x87 (_controlfp) e custava ~3% da thread gráfica com ~20 mil execuções por quadro
+    const unsigned int csr = _mm_getcsr();
+    _mm_setcsr(csr | 0x6000u);
+    const int r = roda(x);
+    vu1n::comitaRapido(x);
+    vu1n::avancaXg(x, 0u); // XGKICK preguiçoso: efetiva o crédito antes de devolver
+    _mm_setcsr(csr);
+    g_otxVu1Runs.store(g_otxVu1Runs.load(std::memory_order_relaxed) + (1u), std::memory_order_relaxed); // Otavix: um só escritor (sem lock)
+    g_otxVu1Instr.store(g_otxVu1Instr.load(std::memory_order_relaxed) + (x.c - m_cycle), std::memory_order_relaxed); // Otavix: um só escritor (sem lock)
+    if (r == vu1n::Terminou)
+    {
+        g_otxVu1Nativo.store(g_otxVu1Nativo.load(std::memory_order_relaxed) + (1u), std::memory_order_relaxed); // Otavix: um só escritor (sem lock)
+        g_otxVu1Ciclos.store(g_otxVu1Ciclos.load(std::memory_order_relaxed) + (x.c - m_cycle), std::memory_order_relaxed); // Otavix: um só escritor (sem lock)
+        m_cycle = x.c;
+        m_state.cycles = x.c;
+        m_state.ebit = false;
+        m_state.haltAfterDelaySlot = false;
+        m_state.branchPending = false;
+        m_otxSujo = true; // os pipelines do interpretador ficaram sem reset (patch_vu1_reset_tardio)
+        return true;
+    }
+    g_otxVu1Devolvido.fetch_add(1u, std::memory_order_relaxed);
+    if (faltas)
+    {
+        // Otavix (31/10): motivo da devolução: 0 sem programa no pc (ou limite de saltos), 1 e-bit, 2 desvio pendente, 3 orçamento
+        static std::atomic<uint64_t> motivo[4]{};
+        bool sx = false;
+        const int m = x.c >= x.fim ? 3 : x.eb ? 1 : x.bp ? 2 : 0;
+        motivo[m].fetch_add(1u, std::memory_order_relaxed);
+        static std::atomic<int> logsM{0};
+        if (m == 0 && !procura(x.pc, sx) && logsM.fetch_add(1) < 40)
+            std::fprintf(stderr, "[vu1n:sem_prog] inicio=0x%04x pc=0x%04x hash=%016llx\n", startPC, x.pc,
+                         static_cast<unsigned long long>(vu1n::hashPrograma(vuCode, codeSize, x.pc)));
+        static std::atomic<uint64_t> nd{0};
+        if (((nd.fetch_add(1) + 1) & 0x3FFFu) == 0u)
+            std::fprintf(stderr, "[vu1n:motivos] sem_prog=%llu ebit=%llu desvio=%llu orcamento=%llu\n",
+                         static_cast<unsigned long long>(motivo[0].load()), static_cast<unsigned long long>(motivo[1].load()),
+                         static_cast<unsigned long long>(motivo[2].load()), static_cast<unsigned long long>(motivo[3].load()));
+    }
+    otxRegistraDevolve(vuCode, codeSize, startPC, x);
+    const uint64_t resta = x.fim > x.c ? x.fim - x.c : 0u;
+    vu1n::sincLento(x); // efetiva até x.c em ordem de tempo (o commit do interpretador é por fila)
+    resetScheduler(); // patch_vu1_reset_tardio
+    m_otxSujo = false;
+    otxAssumeNativo(&x);
+    g_otxVu1Runs.fetch_sub(1u, std::memory_order_relaxed); // o run() conta de novo
+    run(vuCode, codeSize, vuData, dataSize, gs, memory, static_cast<uint32_t>(resta));
+    return true;
+}
+
+// Otavix (diagnóstico PS2X_VU1_CONTA): contagem por (programa, par)
+#include <map>
+void vu1n::contaPar(uint64_t hp, uint32_t pc)
+{
+    static std::map<std::pair<uint64_t, uint32_t>, uint64_t> conta;
+    static uint64_t n = 0;
+    ++conta[{hp, pc}];
+    if ((++n & 0xFFFFFFu) != 0u)
+        return;
+    if (FILE *f = std::fopen("vu1_conta.txt", "w"))
+    {
+        for (const auto &kv : conta)
+            std::fprintf(f, "%016llx %04x %llu\n", static_cast<unsigned long long>(kv.first.first), kv.first.second,
+                         static_cast<unsigned long long>(kv.second));
+        std::fclose(f);
+    }
+}
