+        return static_cast<uint32_t>(v.r) | (static_cast<uint32_t>(v.g) << 8) | (static_cast<uint32_t>(v.b) << 16) |
+               (static_cast<uint32_t>(v.a) << 24);
+    }
+
+    // Otavix (01/11, frente 1): geometria da primitiva (só depende do lote: tipo, caixa, arestas, Z, cores, UV/STQ);
+    // false = nada a desenhar. Roda no frontend (OtxGsGpu::montaPrim) ou no adiciona. Linhas e pontos ficam no adiciona.
+    bool montaGeo(const GSPrimitiveBatch &batch, Prim &p)
+    {
+        const GSDrawState &state = batch.state;
+        const auto &ctx = state.context;
+        const int ofx = ctx.xyoffset.ofx >> 4, ofy = ctx.xyoffset.ofy >> 4;
+        const GSVertex &v0 = batch.vertices[0], &v1 = batch.vertices[1], &v2 = batch.vertices[2];
+        if (state.prim.type == GS_PRIM_SPRITE)
+        {
+            int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+            int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+            if (x0 > x1) std::swap(x0, x1);
+            if (y0 > y1) std::swap(y0, y1);
+            const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
+            const int ux1 = x0 + spanX - 1, uy1 = y0 + spanY - 1;
+            if (ux1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || uy1 < ctx.scissor.y0 || y0 > ctx.scissor.y1)
+                return false; // nada a desenhar
+            p.tipo = 1;
+            p.minX = clampInt(x0, ctx.scissor.x0, ctx.scissor.x1);
+            p.minY = clampInt(y0, ctx.scissor.y0, ctx.scissor.y1);
+            p.maxX = clampInt(ux1, ctx.scissor.x0, ctx.scissor.x1);
+            p.maxY = clampInt(uy1, ctx.scissor.y0, ctx.scissor.y1);
+            p.ux0 = x0;
+            p.uy0 = y0;
+            p.spW = std::max(1.0f, static_cast<float>(spanX));
+            p.spH = std::max(1.0f, static_cast<float>(spanY));
+            p.zSprite = static_cast<uint32_t>(v1.z);
+            p.cor0 = corDe(v1);
+            p.fog3 = v1.fog;
+            if (state.prim.tme)
+            {
+                if (state.prim.fst)
+                {
+                    p.u0f = static_cast<float>(v0.u >> 4);
+                    p.v0f = static_cast<float>(v0.v >> 4);
+                    p.u1f = static_cast<float>(v1.u >> 4);
+                    p.v1f = static_cast<float>(v1.v >> 4);
+                }
+                else
+                {
+                    const float q0 = fabsQ(v0.q), q1 = fabsQ(v1.q);
+                    p.u0f = (v0.s / q0) * static_cast<float>(state.textureWidth);
+                    p.v0f = (v0.t / q0) * static_cast<float>(state.textureHeight);
+                    p.u1f = (v1.s / q1) * static_cast<float>(state.textureWidth);
+                    p.v1f = (v1.t / q1) * static_cast<float>(state.textureHeight);
+                }
+            }
+        }
+        else
+        {
+            const float fx0 = v0.x - static_cast<float>(ofx), fy0 = v0.y - static_cast<float>(ofy);
+            const float fx1 = v1.x - static_cast<float>(ofx), fy1 = v1.y - static_cast<float>(ofy);
+            const float fx2 = v2.x - static_cast<float>(ofx), fy2 = v2.y - static_cast<float>(ofy);
+            p.minX = clampInt(static_cast<int>(std::floor(std::min(std::min(fx0, fx1), fx2))), ctx.scissor.x0, ctx.scissor.x1);
+            p.maxX = clampInt(static_cast<int>(std::ceil(std::max(std::max(fx0, fx1), fx2))), ctx.scissor.x0, ctx.scissor.x1);
+            p.minY = clampInt(static_cast<int>(std::floor(std::min(std::min(fy0, fy1), fy2))), ctx.scissor.y0, ctx.scissor.y1);
+            p.maxY = clampInt(static_cast<int>(std::ceil(std::max(std::max(fy0, fy1), fy2))), ctx.scissor.y0, ctx.scissor.y1);
+            const float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+            if (std::fabs(denom) < 0.001f)
+                return false;
+            p.tipo = 0;
+            p.fx0 = fx0; p.fy0 = fy0; p.fx1 = fx1; p.fy1 = fy1; p.fx2 = fx2; p.fy2 = fy2;
+            p.winding = (denom < 0.0f) ? -1.0f : 1.0f;
+            p.invAbsDenom = 1.0f / std::fabs(denom);
+            const auto zSepara = [](double z, float &zh, float &zl) {
+                const double h = std::floor(z / 65536.0);
+                zh = static_cast<float>(h);
+                zl = static_cast<float>(z - h * 65536.0);
+            };
+            zSepara(v0.z, p.zh0, p.zl0);
+            zSepara(v1.z, p.zh1, p.zl1);
+            zSepara(v2.z, p.zh2, p.zl2);
+            p.cor0 = corDe(v0); p.cor1 = corDe(v1); p.cor2 = corDe(v2);
+            p.fog3 = static_cast<uint32_t>(v0.fog) | (static_cast<uint32_t>(v1.fog) << 8) | (static_cast<uint32_t>(v2.fog) << 16);
+            p.s0 = v0.s; p.s1 = v1.s; p.s2 = v2.s;
+            p.t0 = v0.t; p.t1 = v1.t; p.t2 = v2.t;
+            p.q0 = v0.q; p.q1 = v1.q; p.q2 = v2.q;
+            p.uv0 = static_cast<uint32_t>(v0.u) | (static_cast<uint32_t>(v0.v) << 16);
+            p.uv1 = static_cast<uint32_t>(v1.u) | (static_cast<uint32_t>(v1.v) << 16);
+            p.uv2 = static_cast<uint32_t>(v2.u) | (static_cast<uint32_t>(v2.v) << 16);
+        }
+        return true;
+    }
