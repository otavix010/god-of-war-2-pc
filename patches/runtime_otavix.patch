+
+    bool otxChamaRpcEe(uint8_t *rdram, PS2Runtime *runtime, uint32_t sid, uint32_t rpcNumber, const void *send,
+                       uint32_t sendSize, uint32_t recvSize, std::function<void(const uint8_t *, uint32_t)> done)
+    {
+        if (!runtime || !rdram)
+            return false;
+        uint32_t sdPtr = 0u;
+        {
+            std::unique_lock<std::mutex> lock(g_rpc_mutex, std::try_to_lock); // o IOP pode rodar com o mutex já preso pela própria thread do executor
+            auto it = g_rpc_servers.find(sid);
+            if (it != g_rpc_servers.end())
+                sdPtr = it->second.sd_ptr;
+        }
+        const auto *sd = sdPtr ? reinterpret_cast<const t_SifRpcServerData *>(getMemPtr(rdram, sdPtr)) : nullptr;
+        if (!sd || sd->func == 0u || !runtime->hasFunction(sd->func))
+            return false;
+        const uint32_t buf = sd->buf;
+        if (buf != 0u && send != nullptr && sendSize > 0u)
+        {
+            uint8_t *destino = getMemPtr(rdram, buf);
+            if (destino)
+                std::memcpy(destino, send, sendSize);
+        }
+        GuestInvocation invocation{};
+        invocation.kind = GuestInvocationKind::RpcCallback;
+        invocation.tag = sid; // Otavix (patch_iop_rpc_ee3)
+        invocation.context = runtime->cpu();
+        invocation.context.pc = sd->func;
+        SET_GPR_U32(&invocation.context, 4, rpcNumber);
+        SET_GPR_U32(&invocation.context, 5, buf);
+        SET_GPR_U32(&invocation.context, 6, sendSize);
+        SET_GPR_U32(&invocation.context, 7, 0u);
+        SET_GPR_U32(&invocation.context, 29, 0u);
+        SET_GPR_U32(&invocation.context, 31, 0u);
+        invocation.onComplete = [rdram, recvSize, done = std::move(done)](const R5900Context &fim, R5900Context &)
+        {
+            const R5900Context *pfim = &fim; const uint32_t ret = GPR_U32(pfim, 2);
+            const uint8_t *origem = (ret != 0u && recvSize > 0u) ? getMemPtr(rdram, ret) : nullptr;
+            if (done)
+                done(origem, origem ? recvSize : 0u);
+        };
+        invocation.context.cop0_status |= 0x10000u; // thread de servidor roda com interrupções ligadas
+        runtime->eeScheduler().otxInvocaEmThreadPropria(std::move(invocation), 1);
+        return true;
+    }
