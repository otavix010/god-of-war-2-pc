+// Otavix: DMA do canal 4 (toIPU): normal ou em cadeia; os bytes vão para g_otxIpuSink
+void PS2Memory::otxDmaParaIpu(uint32_t channelBase, uint32_t chcr)
+{
+    static int otxLogs = 0;
+    uint32_t total = 0;
+    auto envia = [&](uint32_t endereco, uint32_t qwc)
+    {
+        if (qwc == 0u)
+            return;
+        const uint32_t fis = endereco & 0x01FFFFF0u;
+        const uint32_t tam = qwc * 16u;
+        if (fis + tam > PS2_RAM_SIZE)
+            return;
+        total += tam;
+        if (g_otxIpuSink)
+            g_otxIpuSink(m_rdram + fis, tam);
+    };
+    const uint32_t modo = (chcr >> 2) & 0x3u;
+    if (modo == 1u)
+    {
+        uint32_t tadr = m_ioRegisters[channelBase + 0x30u];
+        for (int i = 0; i < 4096; ++i)
+        {
+            const uint32_t fis = tadr & 0x01FFFFF0u;
+            if (fis + 16u > PS2_RAM_SIZE)
+                break;
+            uint32_t lo = 0, hi = 0;
+            std::memcpy(&lo, m_rdram + fis, 4);
+            std::memcpy(&hi, m_rdram + fis + 4, 4);
+            const uint32_t qwc = lo & 0xFFFFu;
+            const uint32_t id = (lo >> 28) & 0x7u;
+            bool fim = false;
+            switch (id)
+            {
+            case 0u: envia(hi, qwc); fim = true; break;                       // refe
+            case 1u: envia(tadr + 16u, qwc); tadr = tadr + 16u + qwc * 16u; break; // cnt
+            case 2u: envia(tadr + 16u, qwc); tadr = hi; break;                 // next
+            case 3u:
+            case 4u: envia(hi, qwc); tadr += 16u; break;                       // ref/refs
+            default: envia(tadr + 16u, qwc); fim = true; break;                // end
+            }
+            if (fim || ((lo >> 31) && (chcr & 0x80u)))
+                break;
+        }
+        m_ioRegisters[channelBase + 0x30u] = tadr;
+    }
+    else
+    {
+        envia(m_ioRegisters[channelBase + 0x10u], m_ioRegisters[channelBase + 0x20u] & 0xFFFFu);
+    }
+    if (otxLogs < 20)
+    {
+        ++otxLogs;
+        std::cerr << "[ipu:dma] modo=" << modo << " bytes=" << total << (g_otxIpuSink ? "" : " (sem receptor)") << std::endl;
+    }
+    m_ioRegisters[channelBase + 0x20u] = 0u;
+    m_ioRegisters[channelBase] = chcr & ~0x100u;
+    queueCompletedDmacCause(4u);
+}
