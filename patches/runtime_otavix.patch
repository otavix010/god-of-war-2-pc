+    // bloco (256 bytes) do pixel, pela mesma conta de bitsDe() do shader
+    uint32_t GsGpu::blocoDe(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        struct Tab
+        {
+            std::vector<uint32_t> t;
+            uint32_t pw = 0, ph = 0;
+            bool ok = false, lido = false;
+        };
+        static Tab tabs[64];
+        static std::mutex mtx;
+        Tab &tb = tabs[psm & 63u];
+        if (!tb.lido)
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            if (!tb.lido)
+            {
+                tb.ok = GSMem::OtxTabelaPlana(psm, tb.t, tb.pw, tb.ph);
+                tb.lido = true;
+            }
+        }
+        if (!tb.ok)
+            return ~0u;
+        const uint32_t ppb = tb.pw * tb.ph / 32u;
+        const uint32_t page = base / 32u + (y / tb.ph) * ((std::max<uint32_t>(bw, 1u) * 64u) / tb.pw) + x / tb.pw;
+        const uint32_t pa = page * (tb.pw * tb.ph) + (base % 32u) * ppb + tb.t[(y % tb.ph) * tb.pw + (x % tb.pw)];
+        return (pa / ppb) & (kPaginas * 32u - 1u);
+    }
+
+    // Otavix (01/11): a página tem 8x4 blocos retangulares (pw/8 x ph/4 pixels): bloco da página por (coluna, linha) de
+    // bloco, com deslocamentos no lugar das divisões do blocoDe(); ok = false se a tabela não for assim (usa o blocoDe)
+    struct GeoBlocos
+    {
+        bool ok = false;
+        uint32_t lpw = 0, lph = 0, lbw = 0, lbh = 0; // log2 da página e do bloco em pixels
+        uint8_t blk[32]{};
+    };
+
+    const GeoBlocos &geoBlocos(uint32_t psm)
+    {
+        static GeoBlocos geos[64];
+        static std::atomic<bool> lidos[64]{};
+        static std::mutex mtx;
+        const uint32_t i = psm & 63u;
+        if (lidos[i].load(std::memory_order_acquire))
+            return geos[i];
+        std::lock_guard<std::mutex> lk(mtx);
+        if (lidos[i].load(std::memory_order_relaxed))
+            return geos[i];
+        struct Marca { std::atomic<bool> &l; ~Marca() { l.store(true, std::memory_order_release); } } marca{lidos[i]};
+        static const bool desliga = [] { const char *e = std::getenv("PS2X_GS_GPU_BLOCOS_RAPIDO"); return e && e[0] == '0'; }();
+        std::vector<uint32_t> t;
+        uint32_t pw = 0, ph = 0;
+        if (desliga || !GSMem::OtxTabelaPlana(i, t, pw, ph) || pw < 8u || ph < 4u || (pw & (pw - 1u)) || (ph & (ph - 1u)) ||
+            t.size() < static_cast<size_t>(pw) * ph)
+            return geos[i];
+        GeoBlocos g;
+        while ((1u << g.lpw) < pw) ++g.lpw;
+        while ((1u << g.lph) < ph) ++g.lph;
+        g.lbw = g.lpw - 3u;
+        g.lbh = g.lph - 2u;
+        const uint32_t ppb = pw * ph / 32u;
+        for (uint32_t y = 0; y < ph; ++y)
+            for (uint32_t x = 0; x < pw; ++x)
+            {
+                const uint32_t b = t[y * pw + x] / ppb, k = (y >> g.lbh) * 8u + (x >> g.lbw);
+                if (b >= 32u)
+                    return geos[i];
+                if (x == (x >> g.lbw << g.lbw) && y == (y >> g.lbh << g.lbh))
+                    g.blk[k] = static_cast<uint8_t>(b);
+                else if (g.blk[k] != b)
+                    return geos[i];
+            }
+        g.ok = true;
+        geos[i] = g;
+        return geos[i];
+    }
+
+    // chama f(bloco) para cada bloco do retângulo (já limitado a 0..2047); false se o formato não tem geometria
+    template <typename F>
+    bool porBlocos(uint32_t psm, uint32_t base, uint32_t bw, int x0, int y0, int x1, int y1, F &&f)
+    {
+        const GeoBlocos &g = geoBlocos(psm);
+        if (!g.ok)
+            return false;
+        const uint32_t largPag = (std::max<uint32_t>(bw, 1u) * 64u) >> g.lpw;
+        const uint32_t b0 = base; // = (base / 32) * 32 + base % 32 do blocoDe()
+        const uint32_t cx0 = static_cast<uint32_t>(x0) >> g.lbw, cx1 = static_cast<uint32_t>(x1) >> g.lbw;
+        const uint32_t cy0 = static_cast<uint32_t>(y0) >> g.lbh, cy1 = static_cast<uint32_t>(y1) >> g.lbh;
+        for (uint32_t cy = cy0; cy <= cy1; ++cy)
+        {
+            const uint32_t linha = b0 + (cy >> 2) * largPag * 32u;
+            const uint8_t *blk = g.blk + (cy & 3u) * 8u;
+            for (uint32_t cx = cx0; cx <= cx1; ++cx)
+                if (f((linha + (cx >> 3) * 32u + blk[cx & 7u]) & (kPaginas * 32u - 1u)))
+                    return true;
+        }
+        return true;
+    }
+
+    // os blocos têm >= 8x8 pixels em todos os formatos: amostrar a cada 8 (e na borda) acha todos
+    void GsGpu::marcaBlocos(std::bitset<kPaginas * 32u> &bits, uint32_t psm, uint32_t base, uint32_t bw, int x0, int y0, int x1, int y1)
+    {
+        x0 = std::max(x0, 0); y0 = std::max(y0, 0);
+        x1 = std::min(x1, 2047); y1 = std::min(y1, 2047);
+        if (x1 < x0 || y1 < y0)
+            return;
+        static const bool confere = std::getenv("PS2X_GS_GPU_BLOCOS_CONFERE") != nullptr;
+        if (!confere)
+        {
+            if (porBlocos(psm, base, bw, x0, y0, x1, y1, [&](uint32_t b) { bits.set(b); return false; }))
+                return;
+        }
+        else
+        {
+            std::bitset<kPaginas * 32u> novo, velho;
+            if (porBlocos(psm, base, bw, x0, y0, x1, y1, [&](uint32_t b) { novo.set(b); return false; }))
+            {
+                for (int y = y0;; y = std::min(y + 8, y1))
+                {
+                    for (int x = x0;; x = std::min(x + 8, x1))
+                    {
+                        velho.set(blocoDe(psm, base, bw, static_cast<uint32_t>(x), static_cast<uint32_t>(y)));
+                        if (x >= x1)
+                            break;
+                    }
+                    if (y >= y1)
+                        break;
+                }
+                static std::atomic<int> nDif{0}, nTot{0};
+                if (novo != velho && nDif.fetch_add(1) < 20)
+                    std::fprintf(stderr, "[gs-gpu-blocos] DIFERE psm=0x%x base=%u bw=%u (%d,%d)-(%d,%d) novo=%zu velho=%zu\n", psm, base, bw, x0, y0,
+                                 x1, y1, novo.count(), velho.count());
+                if ((nTot.fetch_add(1) & 0xFFFFF) == 0)
+                    std::fprintf(stderr, "[gs-gpu-blocos] conferidos=%d diferentes=%d\n", nTot.load(), nDif.load());
+            }
+        }
+        for (int y = y0;; y = std::min(y + 8, y1))
+        {
+            for (int x = x0;; x = std::min(x + 8, x1))
+            {
+                const uint32_t b = blocoDe(psm, base, bw, static_cast<uint32_t>(x), static_cast<uint32_t>(y));
+                if (b == ~0u)
+                {
+                    bits.set();
+                    return;
+                }
+                bits.set(b);
+                if (x >= x1)
+                    break;
+            }
+            if (y >= y1)
+                break;
+        }
+    }
+
+    bool GsGpu::tocaBlocos(const std::bitset<kPaginas * 32u> &bits, uint32_t psm, uint32_t base, uint32_t bw, int x0, int y0, int x1, int y1)
+    {
+        x0 = std::max(x0, 0); y0 = std::max(y0, 0);
+        x1 = std::min(x1, 2047); y1 = std::min(y1, 2047);
+        if (x1 < x0 || y1 < y0)
+            return false;
+        bool achou = false;
+        static const bool confere = std::getenv("PS2X_GS_GPU_BLOCOS_CONFERE") != nullptr;
+        if (!confere &&
+            porBlocos(psm, base, bw, x0, y0, x1, y1, [&](uint32_t b) { return achou = bits.test(b); }))
+            return achou;
+        for (int y = y0;; y = std::min(y + 8, y1))
+        {
+            for (int x = x0;; x = std::min(x + 8, x1))
+            {
+                const uint32_t b = blocoDe(psm, base, bw, static_cast<uint32_t>(x), static_cast<uint32_t>(y));
+                if (b == ~0u || bits.test(b))
+                    return true;
+                if (x >= x1)
+                    break;
+            }
+            if (y >= y1)
+                break;
+        }
+        return false;
+    }
+
+    void GsGpu::trabalha(std::promise<bool> &pronto)
+    {
+        const bool ok = criaContexto();
+        pronto.set_value(ok);
+        if (!ok)
+            return;
+        otxPerfilRegistra("gpu"); // Otavix (31/10)
+        if (const char *arq = std::getenv("PS2X_GS_GPU_REPRODUZ"))
+        {
+            reproduz(arq);
+            std::fflush(stdout);
+            std::_Exit(0);
+        }
+        for (;;)
+        {
+            terminaDescidas(false);
+            Cmd c;
+            {
+                std::unique_lock<std::mutex> lk(m_filaMutex);
+                if (m_fila.empty() && !m_parar && !m_descePend.empty())
+                {
+                    // descida em voo: volta logo para entregá-la
+                    m_temCmd.wait_for(lk, std::chrono::microseconds(500), [&] { return m_parar || !m_fila.empty(); });
+                    if (m_fila.empty() && !m_parar)
+                        continue;
+                }
+                if (m_fila.empty() && !m_parar)
+                {
+                    otxLinhaTempo("gpu-vazio", 0u);
+                    m_temCmd.wait(lk, [&] { return m_parar || !m_fila.empty(); });
+                    otxLinhaTempo("gpu-acorda", 0u);
+                }
+                if (m_fila.empty())
+                {
+                    lk.unlock();
+                    terminaDescidas(true);
+                    break;
+                }
+                c = std::move(m_fila.front());
+                m_fila.pop_front();
+                m_filaBytes -= std::min(m_filaBytes, bytesDe(c));
+            }
+            m_andouFila.notify_all();
+            {
+                if (c.tipo == 0 && c.agrupar)
+                    agrupa(c, m_contG, m_inicioG, m_usadosG);
+                // Otavix (31/10): tempo da thread da GPU por tipo de comando (desenho com cópia, desenho, desce, mescla)
+                const int k = c.tipo == 0 ? (c.copia ? 0 : 1) : (c.tipo == 1 ? 2 : 3);
+                const auto t0 = std::chrono::steady_clock::now();
+                static const bool tempoGpu = [] { const char *e = std::getenv("PS2X_GS_GPU_TEMPO_GPU"); return e && e[0] == '1'; }();
+                struct Med { GLuint a, b; int k; uint32_t tiles, prims, copia; };
+                static std::deque<Med> pend;
+                static std::vector<GLuint> livres;
+                const bool mede = tempoGpu && p_glGenQueries && p_glQueryCounter && p_glGetQueryObjectiv && p_glGetQueryObjectui64v;
+                if (mede && livres.size() < 2u)
+                {
+                    std::vector<GLuint> q(512u);
+                    p_glGenQueries(512, q.data());
+                    livres.insert(livres.end(), q.begin(), q.end());
+                }
+                Med med{};
+                if (mede)
+                {
+                    med.a = livres.back(); livres.pop_back();
+                    med.b = livres.back(); livres.pop_back();
+                    med.k = k;
+                    med.tiles = static_cast<uint32_t>(c.tiles.size() / 4u);
+                    med.prims = static_cast<uint32_t>(c.prims.size());
+                    med.copia = c.copia ? std::min(c.copiaB - c.copiaA, kPaginas) : 0u;
+                    p_glQueryCounter(med.a, 0x8E28u); // GL_TIMESTAMP
+                }
+                executa(c);
+                if (c.tipo == 0)
+                {
+                    c.prims.clear(); c.ests.clear(); c.tiles.clear(); c.lista.clear(); c.luts.clear(); c.caixas.clear();
+                    c.sobe.clear(); c.sobePag.clear();
+                    // Otavix (01/11): com 3 (e com 8) a reciclagem esvaziava (lotes em voo na fila) e cada lote novo crescia o
+                    // vetor de primitivas do zero (realocações + páginas novas: ~14% da thread desenho no GoW2)
+                    static const size_t otxRecicla = [] { const char *e = std::getenv("PS2X_GS_GPU_RECICLA"); const long v = e ? std::strtol(e, nullptr, 10) : 0; return v > 0 && v <= 64 ? static_cast<size_t>(v) : 16u; }();
+                    std::lock_guard<std::mutex> lk(m_reciclaMtx);
+                    if (m_recicla.size() < otxRecicla)
+                        m_recicla.push_back(std::move(c));
+                }
+                if (mede)
+                {
+                    p_glQueryCounter(med.b, 0x8E28u);
+                    pend.push_back(med);
+                    while (!pend.empty())
+                    {
+                        GLint pronto = 0;
+                        p_glGetQueryObjectiv(pend.front().b, 0x8867u, &pronto); // GL_QUERY_RESULT_AVAILABLE
+                        if (!pronto)
+                            break;
+                        unsigned long long ta = 0, tb = 0;
+                        p_glGetQueryObjectui64v(pend.front().a, 0x8866u, &ta); // GL_QUERY_RESULT
+                        p_glGetQueryObjectui64v(pend.front().b, 0x8866u, &tb);
+                        const unsigned long long dt = tb > ta ? tb - ta : 0ull;
+                        g_otxGpuGpuNs[pend.front().k].fetch_add(dt, std::memory_order_relaxed);
+                        {
+                            // os 6 mais caros da janela e a soma por faixa de tiles
+                            std::lock_guard<std::mutex> lk(g_otxCarosMtx);
+                            const Med &m = pend.front();
+                            const int faixa = m.tiles <= 4u ? 0 : m.tiles <= 32u ? 1 : m.tiles <= 256u ? 2 : m.tiles <= 2048u ? 3 : 4;
+                            g_otxFaixaNs[faixa] += dt;
+                            ++g_otxFaixaN[faixa];
+                            g_otxCaros.push_back({dt, m.tiles, m.prims, m.copia, m.k});
+                            std::sort(g_otxCaros.begin(), g_otxCaros.end(), [](const OtxCaro &x, const OtxCaro &y) { return x.ns > y.ns; });
+                            if (g_otxCaros.size() > 6u)
+                                g_otxCaros.resize(6u);
+                        }
+                        livres.push_back(pend.front().a);
+                        livres.push_back(pend.front().b);
+                        pend.pop_front();
+                    }
+                }
+                g_otxGpuNs[k].fetch_add(static_cast<uint64_t>(
+                                            std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()),
+                                        std::memory_order_relaxed);
+                g_otxGpuN[k].fetch_add(1u, std::memory_order_relaxed);
+            }
+        }
+        wglMakeCurrent(nullptr, nullptr);
+        wglDeleteContext(m_rc);
+        ReleaseDC(m_janela, m_dc);
+        DestroyWindow(m_janela);
+    }
+
+    // copia para o anel e liga o trecho no binding; o anel tem 4 segmentos, cada um com uma fence posta ao sair dele
+    // (ao voltar, espera a GPU terminar os lotes que o usaram). Falha (sem as funções, ou maior que um segmento): o caminho antigo
+    bool GsGpu::anelPoe(const void *dados, size_t bytes, GLuint indice, GLuint destino, GLintptr destOff)
+    {
+        if (!m_anelTentou)
+        {
+            m_anelTentou = true;
+            static const bool liga = [] { const char *e = std::getenv("PS2X_GS_GPU_ANEL"); return !(e && e[0] == '0'); }();
+            if (liga && p_glBufferStorage && p_glMapBufferRange && p_glBindBufferRange && p_glFenceSync && p_glClientWaitSync && p_glDeleteSync)
+            {
+                p_glGenBuffers(1, &m_anel);
+                p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_anel);
+                const GLbitfield fl = 0x0002u | 0x0040u | 0x0080u; // WRITE | PERSISTENT | COHERENT
+                p_glBufferStorage(kGL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(kAnel), nullptr, fl);
+                m_anelPtr = static_cast<uint8_t *>(p_glMapBufferRange(kGL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(kAnel), fl));
+                static const bool dev = [] { const char *e = std::getenv("PS2X_GS_GPU_ANEL_DEV"); return !(e && e[0] == '0'); }();
+                if (m_anelPtr && dev)
+                {
+                    p_glGenBuffers(1, &m_anelDev);
+                    p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_anelDev);
+                    p_glBufferStorage(kGL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(kAnel), nullptr, 0u);
+                }
+            }
+            std::printf("[gs-gpu] anel persistente: %s%s\n", m_anelPtr ? "sim" : "não", m_anelDev ? " (espelho na GPU)" : "");
+        }
+        if (!m_anelPtr)
+            return false;
+        const size_t tam = (std::max<size_t>(bytes, 16u) + 255u) & ~static_cast<size_t>(255u);
+        if (tam > kAnelSeg)
+            return false;
+        size_t pos = m_anelPos;
+        if (pos + tam > (static_cast<size_t>(m_anelSeg) + 1u) * kAnelSeg)
+        {
+            // troca de segmento: o que sai ganha fence no fim do comando; espera a GPU largar o que entra.
+            // (antes pos/kAnelSeg errava quando pos caía bem no limite: entrava no segmento seguinte sem esperar a fence)
+            m_anelUsados |= 1u << m_anelSeg;
+            const uint32_t entra = (m_anelSeg + 1u) % static_cast<uint32_t>(kAnel / kAnelSeg);
+            m_anelSeg = entra;
+            if (m_anelUsados & (1u << entra))
+            {
+                // deixado neste mesmo comando (>= 64 MB num comando só): ainda sem fence
+                glFinish();
+                m_anelUsados &= ~(1u << entra);
+            }
+            if (m_anelFence[entra])
+            {
+                p_glClientWaitSync(m_anelFence[entra], 0x00000001u, 2000000000ull); // SYNC_FLUSH_COMMANDS_BIT, 2 s
+                p_glDeleteSync(m_anelFence[entra]);
+                m_anelFence[entra] = nullptr;
+            }
+            pos = entra * kAnelSeg;
+        }
+        if (bytes)
+            std::memcpy(m_anelPtr + pos, dados, bytes);
+        if (destino)
+        {
+            // Otavix (31/10): páginas que a CPU mudou -> VRAM da GPU por cópia na própria GPU. O glBufferSubData direto no
+            // buffer da VRAM (em uso pelo lote anterior, sem como renomear) fazia a CPU esperar a GPU esvaziar a cada lote
+            copiaGpu(m_anel, static_cast<GLintptr>(pos), destino, destOff, static_cast<GLsizeiptr>(bytes));
+            m_anelPos = pos + tam;
+            return true;
+        }
+        if (m_anelDev)
+        {
+            // a GPU copia o trecho para o espelho (mesmo deslocamento: as fences do anel valem para os dois)
+            if (m_anelGrupo)
+            {
+                if (pos != m_grupoFim)
+                {
+                    anelGrupoCopia();
+                    m_grupoIni = pos;
+                }
+                m_grupoFim = pos + tam;
+            }
+            else
+            {
+                copiaGpu(m_anel, static_cast<GLintptr>(pos), m_anelDev, static_cast<GLintptr>(pos), static_cast<GLsizeiptr>(tam));
+            }
+            p_glBindBufferRange(kGL_SHADER_STORAGE_BUFFER, indice, m_anelDev, static_cast<GLintptr>(pos), static_cast<GLsizeiptr>(tam));
+        }
+        else
+            p_glBindBufferRange(kGL_SHADER_STORAGE_BUFFER, indice, m_anel, static_cast<GLintptr>(pos), static_cast<GLsizeiptr>(tam));
+        m_anelPos = pos + tam;
+        return true;
+    }
+
+    void GsGpu::anelGrupoCopia()
+    {
+        if (m_grupoFim > m_grupoIni)
+        {
+            copiaGpu(m_anel, static_cast<GLintptr>(m_grupoIni), m_anelDev, static_cast<GLintptr>(m_grupoIni),
+                     static_cast<GLsizeiptr>(m_grupoFim - m_grupoIni));
+        }
+        m_grupoIni = m_grupoFim;
+    }
+
+    void GsGpu::copiaGpu(GLuint src, GLintptr so, GLuint dst, GLintptr dOff, GLsizeiptr n)
+    {
+        static const bool porShader = [] { const char *e = std::getenv("PS2X_GS_GPU_COPIA_SHADER"); return !(e && e[0] == '0'); }();
+        if (n <= 0)
+            return;
+        if (!porShader || !m_progCopia || ((so | dOff | n) & 255) != 0)
+        {
+            p_glBindBuffer(0x8F36, src); // GL_COPY_READ_BUFFER
+            p_glBindBuffer(0x8F37, dst); // GL_COPY_WRITE_BUFFER
+            p_glCopyBufferSubData(0x8F36, 0x8F37, so, dOff, n);
+            return;
+        }
+        p_glBindBufferRange(kGL_SHADER_STORAGE_BUFFER, 10, src, so, n);
+        p_glBindBufferRange(kGL_SHADER_STORAGE_BUFFER, 11, dst, dOff, n);
+        p_glUseProgram(m_progCopia);
+        const GLuint grupos = static_cast<GLuint>(std::min<GLsizeiptr>((n / 4 + 255) / 256, 1024));
+        p_glDispatchCompute(grupos, 1, 1);
+        p_glUseProgram(m_prog);
+        p_glMemoryBarrier(0x2000u); // GL_SHADER_STORAGE_BARRIER_BIT: o desenho seguinte lê o que a cópia escreveu
+    }
+
+    void GsGpu::executa(Cmd &c)
+    {
+        static const bool grava = std::getenv("PS2X_GS_GPU_GRAVA") != nullptr;
+        if (grava && !m_gravaFim)
+            gravaCmd(c);
+        // Otavix (31/10): só os bits que estes buffers precisam (SSBO entre dispatches + cópia/leitura/escrita de buffer pela
+        // API); ALL_BARRIER_BITS esvazia todos os caches da GPU a cada lote. PS2X_GS_GPU_BARREIRA=tudo volta ao antigo
+        static const GLbitfield kBarreira = []
+        {
+            const char *e = std::getenv("PS2X_GS_GPU_BARREIRA");
+            return (e && std::strcmp(e, "tudo") == 0) ? kGL_ALL_BARRIER_BITS : static_cast<GLbitfield>(0x2000u | 0x0200u);
+        }();
+        auto subir = [](GLuint buf, const void *dados, size_t bytes) {
+            p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, buf);
+            p_glBufferData(kGL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(std::max<size_t>(bytes, 16u)), nullptr, kGL_STREAM_DRAW);
+            if (bytes)
+                p_glBufferSubData(kGL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(bytes), dados);
+        };
+        if (c.tipo == 0)
+        {
+            if (!c.sobePag.empty())
+            {
+                p_glMemoryBarrier(kBarreira);
+                size_t o = 0;
+                for (const auto &r : c.sobePag)
+                {
+                    const size_t n = static_cast<size_t>(r.second) * kPagBytes;
+                    if (!anelPoe(c.sobe.data() + o, n, 0, m_buf[0], static_cast<GLintptr>(r.first) * kPagBytes))
+                    {
+                        p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_buf[0]);
+                        p_glBufferSubData(kGL_SHADER_STORAGE_BUFFER, static_cast<GLintptr>(r.first) * kPagBytes,
+                                          static_cast<GLsizeiptr>(n), c.sobe.data() + o);
+                    }
+                    o += n;
+                }
+            }
+            if (c.copia)
+            {
+                p_glMemoryBarrier(kBarreira);
+                // Otavix (31/10): só as páginas da textura (antes os 4 MB a cada lote de realimentação)
+                const uint32_t n = std::min(c.copiaB - c.copiaA, kPaginas);
+                const uint32_t a = c.copiaA & (kPaginas - 1u);
+                const uint32_t n1 = std::min(n, kPaginas - a);
+                if (n1)
+                    copiaGpu(m_buf[0], static_cast<GLintptr>(a) * kPagBytes, m_buf[6], static_cast<GLintptr>(a) * kPagBytes,
+                             static_cast<GLsizeiptr>(n1) * kPagBytes);
+                if (n > n1)
+                    copiaGpu(m_buf[0], 0, m_buf[6], 0, static_cast<GLsizeiptr>(n - n1) * kPagBytes);
+                p_glMemoryBarrier(kBarreira);
+            }
+            if (!c.prims.empty())
+            {
+                const size_t total = c.prims.size() * sizeof(Prim) + c.ests.size() * sizeof(Est) +
+                                     (c.tiles.size() + c.lista.size() + c.luts.size() + c.caixas.size()) * 4u + 5u * 256u;
+                static const bool grupo = [] { const char *e = std::getenv("PS2X_GS_GPU_ANEL_GRUPO"); return !(e && e[0] == '0'); }();
+                m_anelGrupo = grupo;
+                m_grupoIni = m_grupoFim = 0;
+                const bool noAnel = total <= kAnelSeg && anelPoe(c.prims.data(), c.prims.size() * sizeof(Prim), 1) &&
+                                    anelPoe(c.tiles.data(), c.tiles.size() * 4u, 2) && anelPoe(c.lista.data(), c.lista.size() * 4u, 3) &&
+                                    anelPoe(c.luts.data(), c.luts.size() * 4u, 4) && anelPoe(c.caixas.data(), c.caixas.size() * 4u, 9) &&
+                                    anelPoe(c.ests.data(), c.ests.size() * sizeof(Est), 12);
+                anelGrupoCopia();
+                m_anelGrupo = false;
+                if (!noAnel)
+                {
+                    if (!m_bufCaixas)
+                        p_glGenBuffers(1, &m_bufCaixas);
+                    subir(m_bufCaixas, c.caixas.data(), c.caixas.size() * 4u);
+                    p_glBindBufferBase(kGL_SHADER_STORAGE_BUFFER, 9, m_bufCaixas);
+                    if (!m_bufEsts)
+                        p_glGenBuffers(1, &m_bufEsts);
+                    subir(m_bufEsts, c.ests.data(), c.ests.size() * sizeof(Est));
+                    p_glBindBufferBase(kGL_SHADER_STORAGE_BUFFER, 12, m_bufEsts);
+                    subir(m_buf[1], c.prims.data(), c.prims.size() * sizeof(Prim));
+                    subir(m_buf[2], c.tiles.data(), c.tiles.size() * 4u);
+                    subir(m_buf[3], c.lista.data(), c.lista.size() * 4u);
+                    subir(m_buf[4], c.luts.data(), c.luts.size() * 4u);
+                    for (GLuint i = 1; i < 5; ++i)
+                        p_glBindBufferBase(kGL_SHADER_STORAGE_BUFFER, i, m_buf[i]);
+                }
+                p_glDispatchCompute(static_cast<GLuint>(c.tiles.size() / 4u), 1, 1);
+                p_glMemoryBarrier(kBarreira);
+
+            }
+        }
+        else if (c.tipo == 2)
+        {
+            // Otavix (31/10): vram = (vram & ~máscara) | (dado & máscara), página a página, na própria GPU
+            p_glMemoryBarrier(kBarreira);
+            subir(m_bufMescla[0], c.mescla.data(), c.mescla.size() * 4u);
+            subir(m_bufMescla[1], c.mesclaPag.data(), c.mesclaPag.size() * 4u);
+            p_glBindBufferBase(kGL_SHADER_STORAGE_BUFFER, 7, m_bufMescla[0]);
+            p_glBindBufferBase(kGL_SHADER_STORAGE_BUFFER, 8, m_bufMescla[1]);
+            p_glUseProgram(m_progMescla);
+            p_glDispatchCompute(static_cast<GLuint>(c.mesclaPag.size() * 8u), 1, 1);
+            p_glMemoryBarrier(kBarreira);
+            p_glUseProgram(m_prog);
+        }
+        else if (c.prontoAssinc && !c.pronto && desceComFence(c, kBarreira))
+        {
+        }
+        else
+        {
+            p_glMemoryBarrier(kBarreira);
+            p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_buf[0]);
+            for (const auto &r : c.descePag)
+                p_glGetBufferSubData(kGL_SHADER_STORAGE_BUFFER, static_cast<GLintptr>(r.first) * kPagBytes,
+                                     static_cast<GLsizeiptr>(r.second) * kPagBytes,
+                                     c.destino + static_cast<size_t>(r.first) * kPagBytes);
+            if (c.pronto)
+                c.pronto->set_value();
+            if (c.prontoAssinc)
+                c.prontoAssinc->set_value();
+        }
+        // fences dos segmentos do anel que este comando usou (ao voltar a eles, espera a GPU terminar)
+        for (uint32_t sg = 0; m_anelUsados != 0u; ++sg)
+            if (m_anelUsados & (1u << sg))
+            {
+                m_anelUsados &= ~(1u << sg);
+                if (m_anelFence[sg])
+                    p_glDeleteSync(m_anelFence[sg]);
+                m_anelFence[sg] = p_glFenceSync(0x9117u, 0u); // GL_SYNC_GPU_COMMANDS_COMPLETE
+            }
+        // Otavix (31/10): glGetError sincroniza com a thread do driver (otimização em threads da NVIDIA): 1 a cada 256 comandos
+        static uint32_t otxNErro = 0;
+        static const uint32_t otxErroMasc = std::getenv("PS2X_GS_GPU_ERRO_CADA") ? 0u : 255u; // =1: confere a cada comando
+        if ((++otxNErro & otxErroMasc) != 0u)
+            return;
+        const GLenum e = glGetError();
+        if (e != GL_NO_ERROR)
+        {
+            static int n = 0;
+            if (n++ < 10)
+                std::fprintf(stderr, "[gs-gpu] erro GL 0x%x (cmd %d)\n", e, c.tipo);
+        }
+    }
+
+    namespace
+    {
+        template <typename T>
+        void otxEscVec(std::FILE *f, const std::vector<T> &v, uint64_t &bytes)
+        {
+            const uint64_t n = v.size();
+            std::fwrite(&n, 8, 1, f);
+            if (n)
+                std::fwrite(v.data(), sizeof(T), n, f);
+            bytes += 8u + n * sizeof(T);
+        }
+        template <typename T>
+        bool otxLeVec(const uint8_t *&p, const uint8_t *fim, std::vector<T> &v)
+        {
+            if (fim - p < 8)
+                return false;
+            uint64_t n;
+            std::memcpy(&n, p, 8);
+            p += 8;
+            if (static_cast<uint64_t>(fim - p) < n * sizeof(T))
+                return false;
+            v.resize(static_cast<size_t>(n));
+            if (n)
+                std::memcpy(v.data(), p, static_cast<size_t>(n) * sizeof(T));
+            p += n * sizeof(T);
+            return true;
+        }
+        uint64_t otxFnv(const uint8_t *d, size_t n)
+        {
+            uint64_t h = 1469598103934665603ull;
+            for (size_t i = 0; i < n; ++i)
+                h = (h ^ d[i]) * 1099511628211ull;
+            return h;
+        }
+    }
+
+    void GsGpu::gravaCmd(const Cmd &c)
+    {
+        if (!m_gravaF)
+        {
+            static const double seg = [] { const char *e = std::getenv("PS2X_GS_GPU_GRAVA_SEG"); return e ? std::atof(e) : 60.0; }();
+            if (std::chrono::duration<double>(std::chrono::steady_clock::now() - m_gravaT0).count() < seg)
+                return;
+            m_gravaF = std::fopen(std::getenv("PS2X_GS_GPU_GRAVA"), "wb");
+            if (!m_gravaF)
+            {
+                m_gravaFim = true;
+                return;
+            }
+            std::vector<uint8_t> vram(static_cast<size_t>(kPaginas) * kPagBytes);
+            p_glMemoryBarrier(kGL_ALL_BARRIER_BITS);
+            p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_buf[0]);
+            p_glGetBufferSubData(kGL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(vram.size()), vram.data());
+            std::fwrite("OTXG", 4, 1, m_gravaF);
+            std::fwrite(vram.data(), 1, vram.size(), m_gravaF);
+            std::printf("[gs-gpu-grava] começou\n");
+        }
+        if (c.tipo == 1)
+            return; // descida: não muda a VRAM
+        const uint32_t cab[4] = {static_cast<uint32_t>(c.tipo), c.copia ? 1u : 0u, c.copiaA, c.copiaB};
+        std::fwrite(cab, 4, 4, m_gravaF);
+        m_gravaBytes += 16u;
+        otxEscVec(m_gravaF, c.sobePag, m_gravaBytes);
+        otxEscVec(m_gravaF, c.sobe, m_gravaBytes);
+        otxEscVec(m_gravaF, c.prims, m_gravaBytes);
+        otxEscVec(m_gravaF, c.ests, m_gravaBytes);
+        otxEscVec(m_gravaF, c.tiles, m_gravaBytes);
+        otxEscVec(m_gravaF, c.lista, m_gravaBytes);
+        otxEscVec(m_gravaF, c.luts, m_gravaBytes);
+        otxEscVec(m_gravaF, c.caixas, m_gravaBytes);
+        otxEscVec(m_gravaF, c.mesclaPag, m_gravaBytes);
+        otxEscVec(m_gravaF, c.mescla, m_gravaBytes);
+        ++m_gravaCmds;
+        static const uint64_t teto = [] { const char *e = std::getenv("PS2X_GS_GPU_GRAVA_MB"); return static_cast<uint64_t>(e ? std::atoi(e) : 400) << 20; }();
+        if (m_gravaBytes >= teto)
+        {
+            std::fclose(m_gravaF);
+            m_gravaF = nullptr;
+            m_gravaFim = true;
+            std::printf("[gs-gpu-grava] fim: %llu comandos, %llu MB\n", static_cast<unsigned long long>(m_gravaCmds),
+                        static_cast<unsigned long long>(m_gravaBytes >> 20));
+            std::fflush(stdout);
+        }
+    }
