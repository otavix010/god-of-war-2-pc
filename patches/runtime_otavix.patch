+namespace
+{
+    // Otavix (01/11, frente 1): as páginas do desenho saem no frontend e vão em a..f (DesenhoPre).
+    // Otavix (02/11): desligado por padrão pelo mesmo motivo da geometria (abaixo): o frontend está na cadeia do quadro
+    // e a desenho não. Notebook, GoW 1: frontend 363/351 -> 266/291 ns/prim, desenho 395 -> 440 (com folga). =1 liga
+    bool otxPre()
+    {
+        static const bool pre = [] { const char *e = std::getenv("PS2X_GS_PRE"); return e && e[0] == '1'; }();
+        return pre;
+    }
+    // Otavix (01/11, frente 1): a geometria da primitiva também (o frontend fica ~50% ocioso; a desenho é o gargalo).
+    // Otavix (02/11): desligado por padrão. O FINISH sai do frontend, e o jogo espera por ele a cada quadro: a cadeia
+    // EE -> VU1 -> frontend é a latência do quadro, e a desenho fica fora dela (com folga). No notebook (4 núcleos),
+    // trechos pesados: GoW 1 23,3/22,1 -> 24,9/24,9 qps, GoW 2 25,2/24,4 -> 27,4/24,8 (intercalados). =1 liga
+    bool otxMontaNoFrontend()
+    {
+        static const bool m = [] { const char *e = std::getenv("PS2X_GS_PRIM_FRONTEND"); return OtxGsGpu::ligado() && e && e[0] == '1'; }();
+        return m;
+    }
+}
