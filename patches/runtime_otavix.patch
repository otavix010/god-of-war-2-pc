+void PS2Memory::otxSincGrafico()
+{
+    if (t_otxSouGrafico || t_otxSouFrontend)
+        return;
+    if (g_otxG.pendentes.load(std::memory_order_acquire) == 0u && g_otxF.pendentes.load(std::memory_order_acquire) == 0u)
+        return;
+    static uint64_t n = 0, nsEspera = 0;
+    static auto ultimo = std::chrono::steady_clock::now();
+    const auto t0 = std::chrono::steady_clock::now();
+    {
+        std::unique_lock<std::mutex> lk(g_otxG.m);
+        g_otxG.vazia.wait(lk, [] { return g_otxG.pendentes.load(std::memory_order_acquire) == 0u; });
+    }
+    {
+        // a thread gráfica já não posta mais nada: esvazia o frontend
+        std::unique_lock<std::mutex> lk(g_otxF.m);
+        g_otxF.vazia.wait(lk, [] { return g_otxF.pendentes.load(std::memory_order_acquire) == 0u; });
+    }
+    const auto t1 = std::chrono::steady_clock::now();
+    ++n;
+    nsEspera += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+    if (t1 - ultimo >= std::chrono::seconds(10))
+    {
+        std::cout << "[mtvu] esperas=" << n << " tempo=" << (nsEspera / 1000000u) << "ms (10 s)" << std::endl;
+        ultimo = t1;
+        n = 0;
+        nsEspera = 0;
+    }
+}
+
+void PS2Memory::otxPostaGrafico(std::function<void()> f)
+{
+    // limite de tarefas na fila: acima disso o EE espera a thread gráfica andar
+    static const uint64_t limite = []
+    {
+        const char *e = std::getenv("PS2X_MTVU_FILA");
+        const long long v = e ? std::atoll(e) : 0;
+        return v > 0 ? static_cast<uint64_t>(v) : 512ull;
+    }();
+    std::unique_lock<std::mutex> lk(g_otxG.m);
+    if (!g_otxG.iniciada)
+    {
+        g_otxG.iniciada = true;
+        std::thread(otxLacoGrafico).detach();
+    }
+    // Otavix (fila em lote): o limite vale para as tarefas pendentes (a thread gráfica esvazia a fila de uma vez)
+    if (g_otxG.pendentes.load(std::memory_order_acquire) >= limite)
+    {
+        static uint64_t nCheia = 0;
+        if ((nCheia++ % 64u) == 0u)
+            std::cout << "[mtvu:cheia] vezes=" << nCheia << std::endl;
+        g_otxG.limiteFila.store(limite / 2u, std::memory_order_seq_cst);
+        g_otxG.andou.wait(lk, [] { return g_otxG.pendentes.load(std::memory_order_acquire) < limite / 2u; });
+        g_otxG.limiteFila.store(0u, std::memory_order_release);
+    }
+    g_otxG.pendentes.fetch_add(1u, std::memory_order_acq_rel);
+    g_otxG.postados.fetch_add(1u, std::memory_order_acq_rel);
+    g_otxG.fila.push_back(std::move(f));
+    lk.unlock();
+    g_otxG.temTrabalho.notify_one();
+}
+
+// copia para chainData o que a transferência normal (qwc) leria da RAM/scratchpad, para a thread gráfica
+// não depender da RAM do EE (que o jogo pode reescrever logo depois da conclusão)
+void PS2Memory::otxMaterializa(std::vector<PendingTransfer> &fila, bool gif)
+{
+    for (auto &p : fila)
