+// Otavix (01/11): imagem final da apresentação — ampliação FSR 1 (EASU + RCAS, algoritmo do AMD FidelityFX FSR 1, MIT)
+// e anti-serrilhamento FXAA, em shaders da raylib. PS2X_IMAGEM escolhe:
+//   nativo (padrão: o quadro esticado sem filtro, como antes) | bilinear | fxaa | fsr | fxaa+fsr | nis | fxaa+nis
+// PS2X_NITIDEZ = força do RCAS em "stops" (0 = máxima, 0.2 padrão, 2 = quase nenhuma).
+// PS2X_NIS_NITIDEZ = nitidez do NVIDIA Image Scaling, de 0 a 1 (0,5 padrão).
+#include "runtime/otx_imagem.h"
+
+#include "raylib.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace
+{
+    // a raylib usa o vertex shader padrão: fragTexCoord/fragColor, sampler texture0
+    const char *kFxaa = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 texel; // 1 / tamanho da textura
+uniform vec2 lim;   // último centro de texel válido (a textura do quadro tem lixo além da área apresentada)
+out vec4 finalColor;
+vec3 le(vec2 uv) { return texture(texture0, min(max(uv, 0.5 * texel), lim)).rgb; }
+float lu(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+void main()
+{
+    vec2 uv = fragTexCoord;
+    vec3 nw = le(uv + vec2(-1.0, -1.0) * texel), ne = le(uv + vec2(1.0, -1.0) * texel);
+    vec3 sw = le(uv + vec2(-1.0, 1.0) * texel), se = le(uv + vec2(1.0, 1.0) * texel);
+    vec3 m = le(uv);
+    float lnw = lu(nw), lne = lu(ne), lsw = lu(sw), lse = lu(se), lm = lu(m);
+    float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));
+    float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));
+    vec2 dir = vec2(-((lnw + lne) - (lsw + lse)), (lnw + lsw) - (lne + lse));
+    float red = max((lnw + lne + lsw + lse) * (0.25 / 8.0), 1.0 / 128.0);
+    float rcpMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);
+    dir = clamp(dir * rcpMin, vec2(-8.0), vec2(8.0)) * texel;
+    vec3 a = 0.5 * (le(uv + dir * (1.0 / 3.0 - 0.5)) + le(uv + dir * (2.0 / 3.0 - 0.5)));
+    vec3 b = a * 0.5 + 0.25 * (le(uv + dir * -0.5) + le(uv + dir * 0.5));
+    float lb = lu(b);
+    finalColor = vec4((lb < lmin || lb > lmax) ? a : b, 1.0);
+}
+)GLSL";
+
+    // cópia da área apresentada para um alvo do tamanho exato (entrada do EASU)
+    const char *kCopia = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+out vec4 finalColor;
+void main() { finalColor = vec4(texture(texture0, fragTexCoord).rgb, 1.0); }
+)GLSL";
+
+    // FSR 1 EASU (caminho F32): 12 taps em volta, direção e comprimento da borda pelas 4 quadras bilineares,
+    // núcleo lanczos2 aproximado esticado ao longo da borda, sem anel (limitado ao mínimo/máximo dos 4 vizinhos)
+    const char *kEasu = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 tamEnt; // tamanho da entrada em pixels
+out vec4 finalColor;
+vec3 px(ivec2 p) { return texelFetch(texture0, clamp(p, ivec2(0), ivec2(tamEnt) - 1), 0).rgb; }
+float lu(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
+void setF(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE)
+{
+    float dc = lD - lC, cb = lC - lB;
+    float lenX = max(abs(dc), abs(cb));
+    lenX = lenX > 0.0 ? 1.0 / lenX : 0.0;
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+    lenX *= lenX;
+    len += lenX * w;
