+
+void GSThreadBackend::Sync(GSSyncReason reason)
+{
+    // Finish não precisa esperar: toda leitura da VRAM já espera a fila (e o limite segura o atraso)
+    if (reason == GSSyncReason::Finish)
+        return;
+    if (reason == GSSyncReason::Presentation)
+    {
+        // a apresentação roda na thread da janela (entrada, roteiro, 60x/s): não espera o GS; o Present seguinte
+        // guarda a posição da fila deste momento junto com o pedido (ver Present)
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        m_postosNoSync = m_postos;
+        return;
+    }
+    esperaTudo();
+}
+
+// cópia da VRAM para a apresentação no ponto atual da fila (quem chama segura m_vezMutex)
+void GSThreadBackend::capturaComVez(const GSPresentationRequest &pedido)
+{
+    std::shared_ptr<std::vector<uint8_t>> buf;
+    int slot = -1;
+    {
+        std::lock_guard<std::mutex> lk(m_capMutex);
+        for (int i = 0; i < 3; ++i)
+        {
+            auto &b = m_capBufs[i];
+            if (!b)
+                b = std::make_shared<std::vector<uint8_t>>();
+            if (b.use_count() == 1 && b != m_capVram)
+            {
+                buf = b;
+                slot = i;
+                break;
+            }
+        }
+    }
+    if (!buf)
+        buf = std::make_shared<std::vector<uint8_t>>(); // as 3 em uso (conversão lenta): uma avulsa
+    // Otavix (gs_gpu): a descida anterior para este buffer tem que ter terminado antes de reaproveitá-lo
+    const auto otxT0 = std::chrono::steady_clock::now();
+    if (slot >= 0 && m_capProntoDe[slot].valid())
+        m_capProntoDe[slot].wait();
+    const auto otxT1 = std::chrono::steady_clock::now();
+    std::shared_future<void> pronto;
+    m_cpu->otxSnapshotExibicao(pedido, *buf, &pronto); // Otavix (gs_gpu): as páginas da GPU descem sem parar o GS
+    if (slot >= 0)
+        m_capProntoDe[slot] = pronto;
+    else
+    {
+        ++m_otxCapAvulsas;
+        if (pronto.valid())
+            pronto.wait();
+    }
+    // Otavix (01/11): quanto a thread desenho fica parada na captura (vai no [gs-desenho])
+    m_otxCapEsperaNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(otxT1 - otxT0).count());
+    m_otxCapTotalNs += static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - otxT0).count());
+    ++m_otxCaps;
+    std::lock_guard<std::mutex> lk(m_capMutex);
+    m_capPronto = pronto;
+    m_capVram = buf;
+    m_capPedido = pedido;
+    m_capQuando = std::chrono::steady_clock::now();
+    ++m_capGen;
+}
+
+bool GSThreadBackend::otxPresentNoGs()
+{
+    static const bool l = [] { const char *e = std::getenv("PS2X_GS_PRESENT_GS"); return !(e && e[0] == '0'); }();
+    return l;
+}
+
+// Otavix (captura na troca): o frontend acabou de trocar o DISPFB; tudo o que ele postou antes (o quadro inteiro)
+// está à frente na fila e nada do quadro seguinte no buffer exibido. A thread do GS copia a VRAM neste ponto.
+void GSThreadBackend::otxMarcaExibicao(const GSPresentationRequest &pedido)
+{
+    if (!otxPresentNoGs())
+        return;
+    Cmd c;
+    c.tipo = Tipo::Marca;
+    Extra x;
+    x.pedido = pedido;
+    poeExtra(std::move(c), std::move(x));
+}
+
+PresentationFrame GSThreadBackend::Present(const GSPresentationRequest &request)
+{
+    if (otxPresentNoGs())
+    {
+        std::shared_ptr<std::vector<uint8_t>> vram;
+        GSPresentationRequest usar{};
+        uint64_t gen;
+        std::chrono::steady_clock::time_point quando;
+        std::shared_future<void> pronto;
+        {
+            std::lock_guard<std::mutex> lk(m_capMutex);
+            pronto = m_capPronto;
+            vram = m_capVram;
+            usar = m_capPedido;
+            gen = m_capGen;
+            quando = m_capQuando;
+        }
+        // sem trocas recentes (boot, menu com buffer único): volta à cópia "agora" (abaixo)
+        const bool recente = vram && std::chrono::steady_clock::now() - quando < std::chrono::milliseconds(100);
+        if (recente)
+        {
+            if (gen == m_convGen && m_convQuadro)
+                return m_convQuadro;
+            PresentationFrame f;
+            if (pronto.valid())
+                pronto.wait(); // Otavix (gs_gpu): as páginas da GPU desta cópia
+            if (!vram->empty())
+            {
+                thread_local GSCpuBackend conversorCap;
+                conversorCap.Initialize(vram->data(), static_cast<uint32_t>(vram->size()));
+                f = conversorCap.otxPresentaDaMemoria(usar);
+            }
+            m_convGen = gen;
+            m_convQuadro = f;
+            static const bool logTroca = std::getenv("PS2X_LOG_TROCA") != nullptr;
+            if (logTroca)
+            {
+                static const auto t0 = std::chrono::steady_clock::now();
+                static int n = 0;
+                const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+                if (s >= 150.0 && n < 400)
+                {
+                    ++n;
+                    uint32_t claros = 0;
+                    for (size_t i = 0; i + 3 < f.pixels.size(); i += 4 * 16)
+                        if (f.pixels[i] > 24 || f.pixels[i + 1] > 24 || f.pixels[i + 2] > 24)
+                            ++claros;
+                    std::printf("[present] t=%.3f gen=%llu disp=%u fonte=%u pref=%d claros=%u\n", s,
+                                static_cast<unsigned long long>(gen), f.displayFbp, f.sourceFbp, f.usedPreferred ? 1 : 0, claros);
+                }
+            }
+            return f;
+        }
+    }
+
+    // pede a vez: a thread do GS para entre dois comandos (o mutex do GSCpuBackend não é justo e a thread do
+    // GS o pegaria de novo sem parar)
+    // O EE troca o DISPFB antes de o GS terminar o quadro; apresentar o pedido atual mostraria um buffer pela
+    // metade. Cada pedido guarda a posição da fila no Sync anterior; usa o mais novo que o GS já alcançou.
+    GSPresentationRequest usar = request;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        m_pedidos.push_back({m_postosNoSync, request});
+        const uint64_t feitos = m_feitos.load(std::memory_order_acquire);
+        size_t pronto = SIZE_MAX;
+        for (size_t i = 0; i < m_pedidos.size(); ++i)
+            if (m_pedidos[i].first <= feitos)
+                pronto = i;
+        if (pronto != SIZE_MAX)
+        {
+            usar = m_pedidos[pronto].second;
+
+            m_pedidos.erase(m_pedidos.begin(), m_pedidos.begin() + static_cast<std::ptrdiff_t>(pronto) + 1);
+            m_ultimoPedido = usar;
+            m_temUltimo = true;
+        }
+        else if (m_temUltimo)
+            usar = m_ultimoPedido; // nenhum alcançado ainda: repete o último completo
+        if (m_pedidos.size() > 256u)
+            m_pedidos.erase(m_pedidos.begin(), m_pedidos.begin() + 128);
+    }
+    // nada mudou nos buffers que a apresentação pode ler: devolve o quadro anterior sem parar o GS
+    // (PS2X_GS_PRESENT_CACHE=0 desliga)
+    static const bool comCache = [] { const char *e = std::getenv("PS2X_GS_PRESENT_CACHE"); return !(e && e[0] == '0'); }();
+    auto gen = [this](uint32_t fbp) { return m_genFb[fbp & 511u].load(std::memory_order_acquire); };
+    // só o que o GSCpuBackend::Present pode ler: os buffers exibidos; os do contexto só com FBP exibido 0 (procura
+    // fonte não preta); a fonte preferida só quando o destino dela é o exibido
+    const uint32_t fb1 = static_cast<uint32_t>(usar.dispfb1) & 511u, fb2 = static_cast<uint32_t>(usar.dispfb2) & 511u;
+    const bool usaContexto = fb1 == 0u || fb2 == 0u;
+    const bool usaPref = usar.hasPreferredSource && (usar.preferredDestFbp == fb1 || usar.preferredDestFbp == fb2);
+    const uint64_t chave[12] = {usar.pmode, usar.smode2, usar.dispfb1, usar.display1, usar.dispfb2, usar.display2,
+                                usar.bgcolor ^ (m_genOutros.load(std::memory_order_acquire) << 32), gen(fb1), gen(fb2),
+                                usaContexto ? (gen(usar.contextFrames[0].fbp) ^ (gen(usar.contextFrames[1].fbp) << 20)) : 0u,
+                                usaPref ? (gen(usar.preferredSource.fbp) ^ (static_cast<uint64_t>(usar.preferredSource.fbp) << 32)) : 0u,
+                                (usaContexto ? (static_cast<uint64_t>(usar.contextFrames[0].fbp) | (static_cast<uint64_t>(usar.contextFrames[1].fbp) << 16)) : 0u) |
+                                    (static_cast<uint64_t>(usaPref) << 40)};
+    if (comCache && m_temCache && std::memcmp(chave, m_chaveCache, sizeof(chave)) == 0 && m_quadroCache)
+        return m_quadroCache;
+    // o GS para só durante a cópia da VRAM; a conversão para RGBA roda depois, com ele já andando
+    thread_local std::vector<uint8_t> copia;
+    m_querPresentar.fetch_add(1u, std::memory_order_acq_rel);
+    {
+        std::lock_guard<std::mutex> vez(m_vezMutex);
+        m_cpu->otxSnapshotExibicao(usar, copia); // Otavix (gs_gpu)
+    }
+    m_querPresentar.fetch_sub(1u, std::memory_order_acq_rel);
+    PresentationFrame f;
+    if (!copia.empty())
+    {
+        thread_local GSCpuBackend conversor;
+        conversor.Initialize(copia.data(), static_cast<uint32_t>(copia.size()));
+        f = conversor.otxPresentaDaMemoria(usar);
+    }
+    if (comCache)
+    {
+        std::memcpy(m_chaveCache, chave, sizeof(chave));
+        m_temCache = true;
+        m_quadroCache = f;
+    }
+    return f;
+}
+
+bool GSThreadBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    // mesmo critério de retorno do GSCpuBackend::ClearFramebuffer
+    if (!m_vram || context.frame.fbw == 0u)
+        return false;
+    const uint32_t psm = context.frame.psm;
+    if (psm != GS_PSM_CT32 && psm != GS_PSM_CT24 && psm != GS_PSM_CT16 && psm != GS_PSM_CT16S)
+        return false;
+    GSDrawState st{};
+    st.context = context;
+    uint64_t postos;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        const uint32_t est = poeEstado(st, 0u);
+        Cmd &c = m_fila.emplace_back();
+        c.tipo = Tipo::Limpa;
+        c.est = est;
+        c.a = rgba;
+        postos = ++m_postos;
+    }
+    notificaEEspera(postos, true);
+    return true;
+}
+
+uint32_t GSThreadBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    esperaTudo();
+    return m_cpu->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    esperaTudo();
+    return m_cpu->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    Cmd c;
+    c.tipo = Tipo::Escreve;
+    c.a = psm;
+    c.b = base;
+    c.c = bw;
+    c.d = x;
+    c.e = y;
+    c.f = value;
+    poe(std::move(c));
+}
+
+void GSThreadBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    esperaTudo();
+    m_cpu->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadBackend::GetTransferSnapshot() const
+{
+    // só é usado para depuração (histórico do frontend, a cada desenho): devolve o último visto pela thread do GS
+    std::lock_guard<std::mutex> lk(m_transfMutex);
+    return m_transf;
+}
