diff --git a/ps2xRuntime/include/runtime/gs/gs_thread_backend.h b/ps2xRuntime/include/runtime/gs/gs_thread_backend.h
new file mode 100644
index 0000000..82a2393
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_thread_backend.h
@@ -0,0 +1,162 @@
+// Otavix (patch_gs_thread): backend do GS numa thread própria. Embrulha o GSCpuBackend: desenhos, CLUT,
+// transferências, uploads, limpezas e escritas de VRAM entram numa fila e são executados na mesma ordem por
+// uma thread de trabalho, enquanto o EE/VU1 seguem. Tudo que lê a VRAM (ReadVram, SnapshotVram,
+// ConsumeLocalToHostBytes, Reset/Initialize) espera a fila esvaziar; Present espera só até o ponto em que
+// foi pedido (Sync(Presentation)). Liga com PS2X_GS_THREAD=1 (ver otxCriaBackendGs).
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+class GSThreadBackend final : public GSRasterBackend
+{
+public:
+    GSThreadBackend();
+    ~GSThreadBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    enum class Tipo : uint8_t
+    {
+        Desenho,
+        DesenhoPre, // Otavix (01/11): desenho com as páginas já calculadas no frontend (a..f)
+        Clut,
+        Transfer,
+        Upload,
+        TexFlush,
+        Limpa,
+        Escreve,
+        Marca // Otavix: troca do DISPFB (captura a VRAM para a apresentação neste ponto)
+    };
+
+    // Otavix (02/11): o estado do desenho (~300 bytes) vai à parte, em m_estados, só quando muda; o Cmd leva os vértices
+    // e o índice. Antes cada primitiva levava o GSPrimitiveBatch inteiro e o PrimPre (~530 bytes zerados e copiados duas
+    // vezes no frontend, que é um elo da cadeia do quadro)
+    struct Cmd
+    {
+        Tipo tipo = Tipo::Desenho;
+        uint8_t nv = 0;                                    // Desenho/DesenhoPre: vértices
+        uint32_t a = 0, b = 0, c = 0, d = 0, e = 0, f = 0; // Escreve: psm base bw x y valor; Limpa: rgba; Upload: índice
+        uint32_t est = 0;                                  // Desenho/DesenhoPre/Limpa: índice em m_estados (do lote)
+        uint32_t pre = ~0u;                                // DesenhoPre com a geometria montada no frontend: índice em m_pres
+        std::array<GSVertex, 3> vtx;
+    };
+    // Otavix (01/11): o que só os comandos raros usam (Clut, Transfer, Marca) fica à parte, no índice cmd.a: o Cmd de
+    // cada desenho caiu de ~528 para ~344 bytes (o frontend escreve e a thread desenho lê um por primitiva)
+    struct Extra
+    {
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+        GSPresentationRequest pedido{};
+    };
+
+    void poe(Cmd &&cmd);
+    void poeExtra(Cmd &&cmd, Extra &&extra);
+    void espera(uint64_t ate) const;
+    void esperaTudo() const;
+    void trabalha();
+    void executa(Cmd &cmd, std::vector<std::vector<uint8_t>> &uploads, std::vector<Extra> &extras,
+                 std::vector<GSDrawState> &estados, std::vector<OtxGsGpu::PrimPre> &pres);
+    // sob m_filaMutex: índice do estado em m_estados (versao 0: confere com o último por memcmp)
+    uint32_t poeEstado(const GSDrawState &estado, uint64_t versao);
+    void notificaEEspera(uint64_t postos, bool estavaVazia);
+
+    std::vector<GSDrawState> m_estados;
+    std::vector<OtxGsGpu::PrimPre> m_pres;
+    uint64_t m_ultVersao = 0; // versão do estado em m_estados.back() (0: veio de Submit/Limpa)
+    uint64_t m_otxLoteN = 0;  // lotes pegos pela desenho (só ela usa)
+
+public:
+    void SubmitEstado(const GSVertex *vtx, uint8_t n, const GSDrawState &estado, uint64_t versao) override;
+
+private:
+
+    std::unique_ptr<GSCpuBackend> m_cpu;
+    uint8_t *m_vram = nullptr;
+
+    mutable std::mutex m_filaMutex;
+    mutable std::condition_variable m_temTrabalho;
+    mutable std::condition_variable m_andou;
+    std::vector<Cmd> m_fila;
+    std::vector<std::vector<uint8_t>> m_uploads;
+    std::vector<Extra> m_extras;
+    uint64_t m_postos = 0;                // comandos postos (sob m_filaMutex)
+    std::atomic<uint64_t> m_feitos{0};    // comandos executados
+    bool m_parar = false;
+
+    uint64_t m_postosNoSync = 0;                                           // posição da fila no último Sync(Presentation)
+    std::vector<std::pair<uint64_t, GSPresentationRequest>> m_pedidos;      // pedidos de apresentação ainda à frente do GS
+    GSPresentationRequest m_ultimoPedido{};
+    bool m_temUltimo = false;
+    // cache da apresentação: gerações de desenho por FBP e de transferências/limpezas (escritas só pela thread do
+    // GS); se os registradores de exibição e as gerações dos buffers envolvidos não mudaram, o quadro é o mesmo
+    std::atomic<uint64_t> m_genFb[512]{};
+    std::atomic<uint64_t> m_genOutros{0};
+    uint32_t m_otxDbpTransf = 0; // destino (em páginas de FBP) da última transferência
+    uint64_t m_chaveCache[12]{};
+    bool m_temCache = false;
+    PresentationFrame m_quadroCache{};
+
+    std::mutex m_vezMutex;                     // um comando ou um Present por vez
+    std::atomic<uint32_t> m_querPresentar{0}; // a thread do GS cede a vez enquanto > 0
+
+    // Otavix (captura na troca): a cópia da VRAM para a apresentação é feita pela thread do GS no ponto da fila em
+    // que o frontend trocou o DISPFB (comando Marca); antes ela era feita "agora", com o GS às vezes já limpando/
+    // redesenhando o buffer exibido (quadros pretos/parciais). PS2X_GS_PRESENT_GS=0 desliga.
+    std::mutex m_capMutex;
+    std::chrono::steady_clock::time_point m_capQuando{};
+    std::shared_ptr<std::vector<uint8_t>> m_capBufs[3];    // cópias da VRAM (reaproveitadas)
+    std::shared_ptr<std::vector<uint8_t>> m_capVram;       // última cópia pronta
+    std::shared_future<void> m_capProntoDe[3];             // Otavix (gs_gpu): descida assíncrona de cada cópia
+    std::shared_future<void> m_capPronto;                  // a de m_capVram
+    GSPresentationRequest m_capPedido{};
+    uint64_t m_capGen = 0;
+    uint64_t m_convGen = 0;
+    PresentationFrame m_convQuadro{};
+    static bool otxPresentNoGs();
+    void capturaComVez(const GSPresentationRequest &pedido); // chamar com m_vezMutex
+    uint64_t m_otxCapTotalNs = 0, m_otxCapEsperaNs = 0, m_otxCaps = 0, m_otxCapAvulsas = 0; // só a thread desenho
+
+public:
+    void otxMarcaExibicao(const GSPresentationRequest &pedido) override;
+
+    mutable std::mutex m_transfMutex;
+    GSTransferSnapshot m_transf{};
+
+    std::thread m_thread;
+};
+
+// cria o backend do GS: GSThreadBackend com PS2X_GS_THREAD=1, senão GSCpuBackend
+std::unique_ptr<GSRasterBackend> otxCriaBackendGs();
