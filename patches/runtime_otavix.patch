+        // ficou pronto antes dela. Antes: os 4 tempos intercalados um a um (~7% da thread gráfica no notebook)
+        auto comitaQ = [&]()
+        {
+            s.q = x.qVal;
+            const uint32_t di = x.qDi & 0x30u;
+            s.status = (s.status & 0xFCFu) | di | (di << 6);
+            x.qv = false;
+        };
+        int i = 0;
+        while (i < x.nfq)
+        {
+            const Flag &f = fqAt(x, i);
+            if (f.pronto > x.c)
+                break;
+            if (f.tipo & FlagMac)
+                s.mac = f.mac;
+            if (f.tipo & FlagStatus)
+            {
+                const uint32_t cur = f.status & 0xFu;
+                s.status = (s.status & 0xFF0u) | cur | (cur << 6);
+            }
+            if (f.tipo & FlagSticky)
+            {
+                if (x.qv && x.qPronto < f.pronto) // no mesmo ciclo a flag vem antes do Q
+                    comitaQ();
+                s.status = (s.status & 0x03Fu) | (f.status & 0xFC0u);
+            }
+            if (f.tipo & FlagClip)
+                s.clip = f.clip;
+            ++i;
+        }
+        if (i > 0)
+        {
+            x.fqIni = (x.fqIni + i) & (kFilaFlags - 1);
+            x.nfq -= i;
+        }
+        if (x.qv && x.qPronto <= x.c)
+            comitaQ();
+        // P0 e P1 gravam o mesmo registrador: o mais novo por último (empate: P0 antes, como antes)
+        const bool p0 = x.pv[0] && x.pPronto[0] <= x.c, p1 = x.pv[1] && x.pPronto[1] <= x.c;
+        if (p0 && p1)
+        {
+            const int pri = x.pPronto[1] < x.pPronto[0] ? 1 : 0;
+            s.p = x.pVal[1 - pri];
+            x.pv[0] = x.pv[1] = false;
+        }
+        else if (p0)
+        {
+            s.p = x.pVal[0];
+            x.pv[0] = false;
+        }
+        else if (p1)
+        {
+            s.p = x.pVal[1];
+            x.pv[1] = false;
+        }
+    }
+
+    VU1N_F void sinc(Ctx &x)
+    {
+        if ((x.nfq > 0 && fqAt(x, 0).pronto <= x.c) || (x.qv && x.qPronto <= x.c) || (x.pv[0] && x.pPronto[0] <= x.c) ||
+            (x.pv[1] && x.pPronto[1] <= x.c))
+            sincLento(x);
+    }
+
+    // progressXgkick por 'ciclos' ciclos (1 quadword a cada 2 ciclos). XGKICK preguiçoso: o relógio só acumula
+    // crédito (ate/fimPar) e a cópia acontece aqui, chamada antes de qualquer escrita na memória do VU, ao
+    // esperar o XGKICK anterior, no flush e na devolução; a cópia só é visível pelas escritas, então o pacote
+    // sai igual ao da cópia ciclo a ciclo
+    VU1N_F uint32_t credXg(const Ctx &x)
+    {
+        const uint64_t d = x.c - x.xg.base;
+        return d > 0x7FFFFFFFu ? 0x7FFFFFFFu : static_cast<uint32_t>(d);
+    }
+
+    VU1N_X void avancaXg(Ctx &x, uint64_t)
+    {
+        Xg &g = x.xg;
+        if (!g.ativo)
+            return;
+        const uint32_t tam = x.dataSize;
+        while (g.ativo && credXg(x) >= 2u)
+        {
+            // Otavix (XGKICK em lote): dentro do corpo de uma tag já conhecida, copia de uma vez todos os quadwords que
+            // o crédito cobre (mesmo resultado da cópia de 16 em 16 bytes: só as escritas na memória do VU enxergam)
+            if (g.tagFim != 0u && g.copiado + 16u < g.tagFim)
+            {
+                uint32_t n = std::min<uint32_t>(credXg(x) / 2u, (g.tagFim - g.copiado) / 16u - 1u);
+                if (n > 0u && g.copiado + n * 16u <= kPacote)
+                {
+                    const uint32_t src = (g.origem + g.copiado) % tam;
+                    const uint32_t bytes = n * 16u;
+                    if (src + bytes <= tam)
+                        std::memcpy(x.pacote + g.copiado, x.data + src, bytes);
+                    else
+                    {
+                        const uint32_t a1 = tam - src;
+                        std::memcpy(x.pacote + g.copiado, x.data + src, a1);
+                        std::memcpy(x.pacote + g.copiado + a1, x.data, bytes - a1);
+                    }
+                    g.base += 2u * n;
+                    g.copiado += bytes;
+                    continue;
+                }
+            }
+            g.base += 2u;
+            if (g.copiado > kPacote - 16u)
+            {
+                g.ativo = false;
+                g.erro = true;
+                return;
+            }
+            const uint32_t off = g.copiado;
+            const uint32_t src = (g.origem + off) % tam;
+            if (src + 16u <= tam)
+                std::memcpy(x.pacote + off, x.data + src, 16);
+            else
+                for (uint32_t i = 0; i < 16u; ++i)
+                    x.pacote[off + i] = x.data[(g.origem + off + i) % tam];
+            g.copiado += 16u;
+            if (g.tagFim == 0u)
+            {
+                uint64_t tag;
+                std::memcpy(&tag, x.pacote + off, 8);
+                const uint32_t nloop = static_cast<uint32_t>(tag & 0x7FFFu);
+                const uint32_t fmt = static_cast<uint32_t>((tag >> 58) & 3u);
+                uint32_t nreg = static_cast<uint32_t>((tag >> 60) & 0xFu);
+                if (nreg == 0u)
+                    nreg = 16u;
+                uint64_t bytes = 16u;
+                if (fmt == 0u)
+                    bytes += static_cast<uint64_t>(nloop) * nreg * 16u;
+                else if (fmt == 1u)
+                    bytes += ((static_cast<uint64_t>(nloop) * nreg + 1u) & ~1ull) * 8u;
+                else
+                    bytes += static_cast<uint64_t>(nloop) * 16u;
+                if (bytes > kPacote - off)
+                {
+                    g.ativo = false;
+                    g.erro = true;
+                    return;
+                }
+                g.tagFim = off + static_cast<uint32_t>(bytes);
+                g.eop = ((tag >> 15) & 1u) != 0u;
+                if (g.eop)
+                    g.total = g.tagFim;
+            }
+            if (g.copiado >= g.tagFim)
+            {
+                if (g.eop)
+                {
+                    if (x.envia)
+                        x.envia(x.eu, x.pacote, g.total);
+                    g.ativo = false;
+                }
+                else
+                {
+                    g.tagFim = 0u;
+                    g.eop = false;
+                }
+            }
+        }
+    }
+
+    VU1N_F void creditaXg(Ctx &, uint64_t) {} // Otavix: crédito derivado do relógio (credXg)
+
+    // efetiva a cópia do XGKICK com o crédito acumulado (antes de escrever na memória do VU)
+    VU1N_F void efetivaXg(Ctx &x)
+    {
+        if (x.xg.ativo && credXg(x) >= 2u)
+            avancaXg(x, 0u);
+    }
+
+    // avança o relógio até 'alvo' (flags/Q/P ficam para o sinc; o XGKICK só acumula crédito)
+    VU1N_F void ate(Ctx &x, uint64_t alvo)
+    {
+        if (alvo <= x.c)
+            return;
+        creditaXg(x, alvo - x.c);
+        x.c = alvo;
+    }
+
+    // espera até o ciclo r; false = o orçamento acabou antes (o par não executa)
+    VU1N_F bool trava(Ctx &x, uint64_t r)
+    {
+        if (r <= x.c)
+            return true;
+        if (r >= x.fim)
+        {
+            ate(x, x.fim);
+            return false;
+        }
+        ate(x, r);
+        return true;
+    }
+
+    VU1N_F void fimPar(Ctx &x)
+    {
+        ++x.c; // Otavix: x.pares saiu (só estatística; o [vu1] conta ciclos); o crédito do XGKICK sai do relógio
+    }
+
+    // espera o XGKICK anterior terminar (um ciclo por vez, como o interpretador); false = o orçamento acabou
+    // Otavix (XGKICK por tag): ciclos de crédito que faltam para copiar o resto da tag atual (ou o próximo
+    // quadword, se ele é a tag). O estado só muda a cada quadword copiado, então saltar direto até esse ciclo dá
+    // o mesmo relógio e o mesmo pacote que andar um ciclo de cada vez. PS2X_VU1_XG_CICLO=1 volta ao antigo.
+    // Otavix: PS2X_VU1_XG_ANSIOSO=1 copia o pacote inteiro no XGKICK (padrão: cópia preguiçosa por crédito; A/B 29/10: igual)
+    inline bool xgAnsioso()
+    {
+        static const bool l = [] { const char *e = std::getenv("PS2X_VU1_XG_ANSIOSO"); return e && e[0] == '1'; }(); // sem ganho medido: desligado
+        return l;
+    }
+
+    inline bool xgPorCiclo()
+    {
+        static const bool c = [] { const char *e = std::getenv("PS2X_VU1_XG_CICLO"); return e && e[0] == '1'; }();
+        return c;
+    }
+
+    VU1N_F uint64_t faltaXg(const Ctx &x)
+    {
+        if (xgPorCiclo())
+            return 1u;
+        const Xg &g = x.xg;
+        const uint64_t qw = (g.tagFim != 0u && g.tagFim > g.copiado) ? (g.tagFim - g.copiado) / 16u : 1u;
+        const uint64_t precisa = 2u * (qw ? qw : 1u);
+        const uint32_t cr = credXg(x);
+        return precisa > cr ? precisa - cr : 1u;
+    }
+
+    VU1N_X bool esperaXg(Ctx &x)
+    {
+        if (xgAnsioso())
+            return x.xgFim > x.c ? trava(x, x.xgFim) : true;
+        avancaXg(x, 0u);
+        while (x.xg.ativo)
+        {
+            if (!trava(x, x.c + faltaXg(x)))
+            {
+                avancaXg(x, 0u);
+                return false;
+            }
+            avancaXg(x, 0u);
+        }
+        return true;
+    }
+
+    // flushPipelines: anda até não sobrar nada pendente
+    VU1N_F void comitaRapido(Ctx &x)
+    {
+        if (x.rStickMorto)
+        {
+            x.s->status |= (x.rStickMorto & 0xFu) << 6;
+            x.rStickMorto = 0;
+        }
+        if (!x.rTem)
+            return;
+        VU1State &s = *x.s;
+        s.mac = x.rMac;
+        s.status = (s.status & 0xFF0u) | (x.rStatus & 0xFu) | ((x.rStick & 0xFu) << 6);
+        x.rTem = false;
+        x.rStick = 0;
+    }
+
+    VU1N_X void flush(Ctx &x)
+    {
+        comitaRapido(x);
+        uint64_t alvo = std::max(x.fimW, x.fimV);
+#if defined(__AVX2__)
+        {
+            // Otavix: máximo dos prontos em AVX2 (os ciclos cabem em 63 bits: comparação com sinal serve)
+            __m256i m = _mm256_loadu_si256(reinterpret_cast<const __m256i *>(x.vfR[1]));
+            for (int r = 2; r < 32; ++r)
+            {
+                const __m256i v = _mm256_loadu_si256(reinterpret_cast<const __m256i *>(x.vfR[r]));
+                m = _mm256_blendv_epi8(m, v, _mm256_cmpgt_epi64(v, m));
+            }
+            alignas(32) uint64_t t[4];
+            _mm256_store_si256(reinterpret_cast<__m256i *>(t), m);
+            for (int c = 0; c < 4; ++c)
+                alvo = std::max(alvo, t[c]);
+        }
+#else
+        for (int r = 1; r < 32; ++r)
+            for (int c = 0; c < 4; ++c)
+                alvo = std::max(alvo, x.vfR[r][c]);
+#endif
+        for (int r = 1; r < 16; ++r)
+            alvo = std::max(alvo, x.viR[r]);
+        for (int i = 0; i < x.nfq; ++i)
+            alvo = std::max(alvo, fqAt(x, i).pronto);
+        if (x.qv)
+            alvo = std::max(alvo, x.qPronto);
+        for (int i = 0; i < 2; ++i)
+            if (x.pv[i])
+                alvo = std::max(alvo, x.pPronto[i]);
+        alvo = std::max(alvo, x.xgFim); // Otavix (XGKICK ansioso)
+        ate(x, alvo);
+        avancaXg(x, 0u);
+        while (x.xg.ativo)
+        {
+            ate(x, x.c + faltaXg(x));
+            avancaXg(x, 0u);
+        }
+        sincLento(x);
+    }
+
+    VU1N_F void vf0(Ctx &x)
+    {
+        x.s->vf[0][0] = x.s->vf[0][1] = x.s->vf[0][2] = 0.0f;
+        x.s->vf[0][3] = 1.0f;
+    }
+
+    // ------------------------------------------------------------------ flags
+    VU1N_F void poeFlag(Ctx &x, const Flag &f)
+    {
+        if (x.nfq == kFilaFlags)
+            sincLento(x); // sobram no máximo 8 (2 por ciclo nos últimos 4)
+        if (x.nfq < kFilaFlags)
+        {
+            fqAt(x, x.nfq) = f;
+            ++x.nfq;
+        }
+    }
+
+    // Otavix: grava os campos direto na fila (montar o Flag na pilha e copiar dava falha de store-forwarding:
+    // escritas de 4/1 bytes lidas em blocos de 16/8, ~12 ciclos parados por flag)
+    VU1N_F void poeFlagC(Ctx &x, uint64_t pronto, uint32_t mac, uint32_t status, uint32_t clip, uint8_t tipo)
+    {
+        if (x.nfq == kFilaFlags)
+            sincLento(x);
+        if (x.nfq < kFilaFlags)
+        {
+            Flag &f = fqAt(x, x.nfq);
+            ++x.nfq;
+            f.pronto = pronto;
+            f.mac = mac;
+            f.status = status;
+            f.clip = clip;
+            f.tipo = tipo;
+        }
+    }
+
+    template <uint8_t Dest, int SemFila = 0>
+    VU1N_F void flagsFmac(Ctx &x, const uint32_t lf[4])
+    {
+        if (Dest == 0u)
+            return;
+        uint32_t mac = 0, status = 0;
+        for (int c = 0; c < 4; ++c)
+        {
+            const uint32_t lane = 8u >> c;
+            if (!(Dest & lane))
+                continue;
+            mac |= ((lf[c] & 1u) ? lane : 0u) | ((lf[c] & 2u) ? lane << 4 : 0u) | ((lf[c] & 4u) ? lane << 8 : 0u) |
+                   ((lf[c] & 8u) ? lane << 12 : 0u);
+            status |= lf[c];
+        }
+        if (SemFila == 2)
+        {
+            x.rStickMorto |= status;
+            return;
+        }
+        if (SemFila == 1)
+        {
+            x.rTem = true;
+            x.rMac = mac;
+            x.rStatus = status;
+            x.rStick |= status;
+            return;
+        }
+        poeFlagC(x, x.c + kFmac, mac, status, 0u, static_cast<uint8_t>(FlagMac | FlagStatus));
+    }
+
+    template <uint8_t Dest>
+    VU1N_F void grava(float *dst, const float r[4])
+    {
+        if (Dest & 8u)
+            dst[0] = r[0];
+        if (Dest & 4u)
+            dst[1] = r[1];
+        if (Dest & 2u)
+            dst[2] = r[2];
+        if (Dest & 1u)
+            dst[3] = r[3];
+    }
+
+
+    // ------------------------------------------------------------------ SSE (mesmos bits do caminho escalar)
+    // lanes na ordem do registrador (0 = x); Dest usa x = bit 8, então a máscara por lane é a de Dest invertida
+    constexpr uint8_t kInv4[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+
+    // Otavix (01/11): a normalização (rara) fora de linha: o caminho comum do fmac não precisa de xmm6+ (salvos no prólogo)
+    VU1N_X __m128 nOpVLento(__m128 v)
+    {
+        const __m128i b = _mm_castps_si128(v);
+        const __m128i expM = _mm_set1_epi32(0x7F800000);
+        const __m128i e = _mm_and_si128(b, expM);
+        const __m128i ez = _mm_cmpeq_epi32(e, _mm_setzero_si128());
+        const __m128i ef = _mm_cmpeq_epi32(e, expM);
+        const __m128i sinal = _mm_and_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        __m128i r = _mm_andnot_si128(_mm_or_si128(ez, ef), b);
+        r = _mm_or_si128(r, _mm_and_si128(ef, _mm_or_si128(sinal, _mm_set1_epi32(0x7F7FFFFF))));
+        r = _mm_or_si128(r, _mm_and_si128(ez, sinal));
+        return _mm_castsi128_ps(r);
+    }
+
+    // lanes (bit 0 = x) com denormal ou expoente 255 (infinito/NaN); zero exato (±0) não muda na normalização
+    VU1N_F int nEspecialMasc(__m128 v, __m128i &magZero)
+    {
+        const __m128i b = _mm_castps_si128(v);
+        const __m128i e = _mm_and_si128(b, _mm_set1_epi32(0x7F800000));
+        magZero = _mm_cmpeq_epi32(_mm_and_si128(b, _mm_set1_epi32(0x7FFFFFFF)), _mm_setzero_si128());
+        const __m128i den = _mm_andnot_si128(magZero, _mm_cmpeq_epi32(e, _mm_setzero_si128()));
+        const __m128i ef = _mm_cmpeq_epi32(e, _mm_set1_epi32(0x7F800000));
+        return _mm_movemask_ps(_mm_castsi128_ps(_mm_or_si128(den, ef)));
+    }
+
+    // o mesmo para um escalar, em registrador inteiro (sem o sinal: 0 = zero, [2, 0xFFFFFE] = denormal, >= 0xFF000000 = expoente 255)
+    VU1N_F bool nEspecialE(float f)
+    {
+        const uint32_t u = bits(f) << 1;
+        return (u - 1u) < 0x00FFFFFFu || u >= 0xFF000000u;
+    }
+
+    VU1N_F bool nEspecialV(__m128 v)
+    {
+        __m128i mz;
+        return nEspecialMasc(v, mz) != 0;
+    }
+
+    VU1N_F __m128 nOpV(__m128 v)
+    {
+        return nEspecialV(v) ? nOpVLento(v) : v; // caso comum: nada a normalizar
+    }
+
+    // nRes nas 4 lanes; z/sg/u/o = máscaras de 4 bits (bit 0 = lane x) das flags de cada lane
+    VU1N_F __m128 nResV(__m128 v, int &z, int &sg, int &u, int &o)
+    {
+        const __m128i b = _mm_castps_si128(v);
+        const __m128i expM = _mm_set1_epi32(0x7F800000);
+        const __m128i e = _mm_and_si128(b, expM);
+        const __m128i ez = _mm_cmpeq_epi32(e, _mm_setzero_si128());
+        const __m128i ef = _mm_cmpeq_epi32(e, expM);
+        sg = _mm_movemask_ps(v);
+        if (_mm_movemask_ps(_mm_castsi128_ps(_mm_or_si128(ez, ef))) == 0) // caso comum: sem zero/denormal/infinito
+        {
+            z = u = o = 0;
+            return v;
+        }
+        const __m128i sinal = _mm_and_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i magZero = _mm_cmpeq_epi32(_mm_and_si128(b, _mm_set1_epi32(0x7FFFFFFF)), _mm_setzero_si128());
+        z = _mm_movemask_ps(_mm_castsi128_ps(ez));
+        u = _mm_movemask_ps(_mm_castsi128_ps(_mm_andnot_si128(magZero, ez)));
+        o = _mm_movemask_ps(_mm_castsi128_ps(ef));
+        __m128i r = _mm_andnot_si128(_mm_or_si128(ez, ef), b);
+        r = _mm_or_si128(r, _mm_and_si128(ef, _mm_or_si128(sinal, _mm_set1_epi32(0x7F7FFFFF))));
+        r = _mm_or_si128(r, _mm_and_si128(ez, sinal));
+        return _mm_castsi128_ps(r);
+    }
+
+    template <uint8_t Dest, int SemFila>
+    VU1N_F void flagsMasc(Ctx &x, int z, int sg, int u, int o)
+    {
+        if (Dest == 0u)
+            return;
+        if (SemFila == 2)
+        {
+            // Otavix: só o sticky; Dest na ordem das lanes (bit 0 = x) é constante
+            constexpr int dl = kInv4[Dest];
+            x.rStickMorto |= ((z & dl) ? 1u : 0u) | ((sg & dl) ? 2u : 0u) | ((u & dl) ? 4u : 0u) | ((o & dl) ? 8u : 0u);
+            return;
+        }
+        const uint32_t mz = kInv4[z] & Dest, ms = kInv4[sg] & Dest, mu = kInv4[u] & Dest, mo = kInv4[o] & Dest;
+        const uint32_t mac = mz | (ms << 4) | (mu << 8) | (mo << 12);
+        const uint32_t status = (mz ? 1u : 0u) | (ms ? 2u : 0u) | (mu ? 4u : 0u) | (mo ? 8u : 0u);
+        if (SemFila == 2)
+        {
+            x.rStickMorto |= status;
+            return;
+        }
+        if (SemFila == 1)
+        {
+            x.rTem = true;
+            x.rMac = mac;
+            x.rStatus = status;
+            x.rStick |= status;
+            return;
+        }
+        poeFlagC(x, x.c + kFmac, mac, status, 0u, static_cast<uint8_t>(FlagMac | FlagStatus));
+    }
+
+    template <uint8_t Dest>
+    VU1N_F void gravaV(float *dst, __m128 r)
+    {
+        if (Dest == 0xFu)
+            _mm_storeu_ps(dst, r);
+        else if (Dest != 0u)
+            _mm_storeu_ps(dst, _mm_blend_ps(_mm_loadu_ps(dst), r, kInv4[Dest]));
+    }
+
+    // Otavix (01/11): resultado do FMAC/OPM e as flags. Caso comum (nenhuma lane de Dest com zero/denormal/infinito) em
+    // linha: só o S pode subir (MAC = sinal << 4); o resto (nResV + flagsMasc) fora de linha. As lanes fora de Dest não
+    // são gravadas nem entram nas flags.
+    template <uint8_t Dest, int SemFila>
+    VU1N_X __m128 resLento(Ctx &x, __m128 v)
+    {
+        int z, sg, u, o;
+        v = nResV(v, z, sg, u, o);
+        flagsMasc<Dest, SemFila>(x, z, sg, u, o);
+        return v;
+    }
+
+    // resultado especial: normaliza, flags e grava, fora de linha (chamada em posição de cauda: nada vivo depois)
+    template <uint8_t Dest, int SemFila>
+    VU1N_X void resGravaLento(Ctx &x, __m128 v, float *dst)
+    {
+        v = resLento<Dest, SemFila>(x, v);
+        gravaV<Dest>(dst, v);
+    }
+
+    // caso comum (nenhuma lane de Dest com denormal/infinito): grava e põe as flags; zero exato fica como está (sinal
+    // preservado) e só levanta o Z
+    template <uint8_t Dest, int SemFila>
+    VU1N_F void resGrava(Ctx &x, __m128 v, float *dst)
+    {
+        __m128i magZero;
+        if (nEspecialMasc(v, magZero) & kInv4[Dest])
+            return resGravaLento<Dest, SemFila>(x, v, dst);
+        const uint32_t ms = kInv4[_mm_movemask_ps(v)] & Dest;
+        const uint32_t mz = kInv4[_mm_movemask_ps(_mm_castsi128_ps(magZero))] & Dest;
+        gravaV<Dest>(dst, v);
+        if (SemFila == 2)
+        {
+            x.rStickMorto |= (mz ? 1u : 0u) | (ms ? 2u : 0u);
+            return;
+        }
+        const uint32_t mac = mz | (ms << 4), status = (mz ? 1u : 0u) | (ms ? 2u : 0u);
+        if (SemFila == 1)
+        {
+            x.rTem = true;
+            x.rMac = mac;
+            x.rStatus = status;
+            x.rStick |= status;
+            return;
+        }
+        poeFlagC(x, x.c + kFmac, mac, status, 0u, static_cast<uint8_t>(FlagMac | FlagStatus));
+    }
+
+    // ------------------------------------------------------------------ superiores
+    // Tipo: 0 ADD 1 SUB 2 MUL 3 MADD 4 MSUB 5 MAX 6 MINI; Fonte: 0 vetor, 1 bc, 2 q, 3 i
+#if !defined(VU1N_ESCALAR)
+    template <int Tipo>
+    VU1N_F __m128 fmacOp(__m128 a, __m128 b, __m128 acc)
+    {
+        if (Tipo == 0)
+            return _mm_add_ps(a, b);
+        if (Tipo == 1)
+            return _mm_sub_ps(a, b);
+        if (Tipo == 2)
+            return _mm_mul_ps(a, b);
+        if (Tipo == 3)
+            return _mm_add_ps(acc, _mm_mul_ps(a, b));
+        if (Tipo == 4)
+            return _mm_sub_ps(acc, _mm_mul_ps(a, b));
+        if (Tipo == 5)
+            return _mm_max_ps(a, b); // a > b ? a : b
+        return _mm_min_ps(a, b);     // a < b ? a : b
+    }
+
+    template <int Fonte, int Bc>
+    VU1N_F __m128 fmacFonteB(const VU1State &s, uint8_t ft)
+    {
+        if (Fonte == 0)
+            return _mm_loadu_ps(s.vf[ft]);
+        if (Fonte == 1)
+            return _mm_set1_ps(s.vf[ft][Bc]);
+        return _mm_set1_ps(nOp(Fonte == 2 ? s.q : s.i));
+    }
+
+    // Otavix (01/11): alguma entrada com denormal/infinito: tudo normalizado, fora de linha
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila>
+    VU1N_X void fmacLento(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        VU1State &s = *x.s;
+        const __m128 a = nOpVLento(_mm_loadu_ps(s.vf[fs]));
+        const __m128 b = Fonte <= 1 ? nOpVLento(fmacFonteB<Fonte, Bc>(s, ft)) : fmacFonteB<Fonte, Bc>(s, ft);
+        const __m128 ac = (Tipo == 3 || Tipo == 4) ? nOpVLento(_mm_loadu_ps(s.acc)) : _mm_setzero_ps();
+        __m128 v = fmacOp<Tipo>(a, b, ac);
+        float *dst = ParaAcc ? s.acc : s.vf[fd];
+        if (Tipo <= 4)
+            v = resLento<Dest, SemFila>(x, v);
+        gravaV<Dest>(dst, v);
+    }
+
+    template <bool ParaAcc, uint8_t Dest, int SemFila>
+    VU1N_X void opmLento(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        VU1State &s = *x.s;
+        const __m128 vs = nOpVLento(_mm_loadu_ps(s.vf[fs]));
+        const __m128 vt = nOpVLento(_mm_loadu_ps(s.vf[ft]));
+        const __m128 p = _mm_mul_ps(_mm_shuffle_ps(vs, vs, _MM_SHUFFLE(3, 0, 2, 1)), _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 1, 0, 2)));
+        __m128 r = ParaAcc ? p : _mm_sub_ps(nOpVLento(_mm_loadu_ps(s.acc)), p);
+        r = _mm_blend_ps(r, _mm_setzero_ps(), 8); // w = 0
+        r = resLento<Dest, SemFila>(x, r);
+        gravaV<Dest>(ParaAcc ? s.acc : s.vf[fd], r);
+    }
+
+    // Otavix (01/11): as entradas são só testadas (a normalização não muda valores comuns nem zero exato); qualquer
+    // especial refaz a instrução inteira fora de linha. As duas saídas lentas ficam em posição de cauda, então nada
+    // atravessa uma chamada e as constantes não ocupam xmm6+ (que o prólogo salvaria em toda instrução).
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila = 0, int Norm = 0>
+    VU1N_F void fmacC(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        if (Dest == 0u)
+            return;
+        VU1State &s = *x.s;
+        // Otavix (Norm): bit 1 = fs, 2 = ft, 4 = ACC já normalizados nas lanes usadas (análise do tradutor)
+        const __m128 a = _mm_loadu_ps(s.vf[fs]);
+        const __m128 b = fmacFonteB<Fonte, Bc>(s, ft);
+        const __m128 ac = (Tipo == 3 || Tipo == 4) ? _mm_loadu_ps(s.acc) : _mm_setzero_ps();
+        __m128i mz;
+        int esp = 0;
+        if (!(Norm & 1))
+            esp |= nEspecialMasc(a, mz);
+        if (Fonte == 0 && !(Norm & 2))
+            esp |= nEspecialMasc(b, mz);
+        if (Fonte == 1 && !(Norm & 2) && nEspecialE(s.vf[ft][Bc])) // Otavix: o bc é um escalar só (menos xmm vivos)
+            esp |= 0xF;
+        if ((Tipo == 3 || Tipo == 4) && !(Norm & 4))
+            esp |= nEspecialMasc(ac, mz);
+        if (esp & kInv4[Dest]) // lanes independentes: fora de Dest não importa
+            return fmacLento<Tipo, Fonte, ParaAcc, Dest, Bc, SemFila>(x, fd, fs, ft);
+        const __m128 v = fmacOp<Tipo>(a, b, ac);
+        float *dst = ParaAcc ? s.acc : s.vf[fd];
+        if (Tipo <= 4)
+            return resGrava<Dest, SemFila>(x, v, dst);
+        gravaV<Dest>(dst, v);
+    }
+
+    template <bool ParaAcc, uint8_t Dest, int SemFila = 0, int Norm = 0>
+    VU1N_F void opmC(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        if (Dest == 0u)
+            return;
+        VU1State &s = *x.s;
+        const __m128 vs = _mm_loadu_ps(s.vf[fs]);
+        const __m128 vt = _mm_loadu_ps(s.vf[ft]);
+        const __m128 ac = ParaAcc ? _mm_setzero_ps() : _mm_loadu_ps(s.acc);
+        __m128i mz;
+        int esp = 0;
+        if (!(Norm & 1))
+            esp |= nEspecialMasc(vs, mz);
+        if (!(Norm & 2))
+            esp |= nEspecialMasc(vt, mz);
+        esp &= 7; // o w das entradas não entra no produto (o w do resultado é 0)
+        if (!ParaAcc && !(Norm & 4))
+            esp |= nEspecialMasc(ac, mz) & kInv4[Dest];
+        if (esp)
+            return opmLento<ParaAcc, Dest, SemFila>(x, fd, fs, ft);
+        const __m128 p = _mm_mul_ps(_mm_shuffle_ps(vs, vs, _MM_SHUFFLE(3, 0, 2, 1)), _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 1, 0, 2)));
+        __m128 r = ParaAcc ? p : _mm_sub_ps(ac, p);
+        r = _mm_blend_ps(r, _mm_setzero_ps(), 8); // w = 0
+        return resGrava<Dest, SemFila>(x, r, ParaAcc ? s.acc : s.vf[fd]);
+    }
+    // chamada (fmac/opm, fora de linha: o arquivo gerado cabe na memória do compilador) e em linha (fmacI/opmI, só
+    // nos programas mais quentes)
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila = 0, int Norm = 0>
+    VU1N_X void fmac(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { fmacC<Tipo, Fonte, ParaAcc, Dest, Bc, SemFila, Norm>(x, fd, fs, ft); }
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila = 0, int Norm = 0>
+    VU1N_F void fmacI(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { fmacC<Tipo, Fonte, ParaAcc, Dest, Bc, SemFila, Norm>(x, fd, fs, ft); }
+    template <bool ParaAcc, uint8_t Dest, int SemFila = 0, int Norm = 0>
+    VU1N_X void opm(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { opmC<ParaAcc, Dest, SemFila, Norm>(x, fd, fs, ft); }
+    template <bool ParaAcc, uint8_t Dest, int SemFila = 0, int Norm = 0>
+    VU1N_F void opmI(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { opmC<ParaAcc, Dest, SemFila, Norm>(x, fd, fs, ft); }
+#else
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila = 0, int Norm = 0>
+    VU1N_X void fmac(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        VU1State &s = *x.s;
+        float b0 = 0.0f;
+        if (Fonte == 1)
+            b0 = nOp(s.vf[ft][Bc]);
+        else if (Fonte == 2)
+            b0 = nOp(s.q);
+        else if (Fonte == 3)
+            b0 = nOp(s.i);
+        float r[4];
+        uint32_t lf[4]{};
+        for (int c = 0; c < 4; ++c)
+        {
+            if (!(Dest & (8u >> c)))
+                continue;
+            const float a = nOp(s.vf[fs][c]);
+            const float b = Fonte == 0 ? nOp(s.vf[ft][c]) : b0;
+            float v;
+            if (Tipo == 0)
+                v = a + b;
+            else if (Tipo == 1)
+                v = a - b;
+            else if (Tipo == 2)
+                v = a * b;
+            else if (Tipo == 3)
+                v = nOp(s.acc[c]) + a * b;
+            else if (Tipo == 4)
+                v = nOp(s.acc[c]) - a * b;
+            else if (Tipo == 5)
+                v = a > b ? a : b;
+            else
+                v = a < b ? a : b;
+            if (Tipo <= 4)
+                v = nRes(v, lf[c]);
+            r[c] = v;
+        }
+        if (Tipo <= 4)
+            flagsFmac<Dest, SemFila>(x, lf);
+        grava<Dest>(ParaAcc ? s.acc : s.vf[fd], r);
+    }
+
+    template <bool ParaAcc, uint8_t Dest, int SemFila = 0, int Norm = 0>
+    VU1N_X void opm(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft)
+    {
+        VU1State &s = *x.s;
+        float vs[3], vt[3], r[4];
+        for (int c = 0; c < 3; ++c)
+        {
+            vs[c] = nOp(s.vf[fs][c]);
+            vt[c] = nOp(s.vf[ft][c]);
+        }
+        if (ParaAcc)
+        {
+            r[0] = vs[1] * vt[2];
+            r[1] = vs[2] * vt[0];
+            r[2] = vs[0] * vt[1];
+        }
+        else
+        {
+            r[0] = nOp(s.acc[0]) - vs[1] * vt[2];
+            r[1] = nOp(s.acc[1]) - vs[2] * vt[0];
+            r[2] = nOp(s.acc[2]) - vs[0] * vt[1];
+        }
+        r[3] = 0.0f;
+        uint32_t lf[4]{};
+        for (int c = 0; c < 4; ++c)
+            if (Dest & (8u >> c))
+                r[c] = nRes(r[c], lf[c]);
+        flagsFmac<Dest, SemFila>(x, lf);
+        grava<Dest>(ParaAcc ? s.acc : s.vf[fd], r);
+    }
+
+    template <int Tipo, int Fonte, bool ParaAcc, uint8_t Dest, int Bc, int SemFila = 0, int Norm = 0>
+    VU1N_F void fmacI(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { fmac<Tipo, Fonte, ParaAcc, Dest, Bc, SemFila, Norm>(x, fd, fs, ft); }
+    template <bool ParaAcc, uint8_t Dest, int SemFila = 0, int Norm = 0>
+    VU1N_F void opmI(Ctx &x, uint8_t fd, uint8_t fs, uint8_t ft) { opm<ParaAcc, Dest, SemFila, Norm>(x, fd, fs, ft); }
+#endif
+
+    template <int Escala, uint8_t Dest> // 0 4 12 15
+    VU1N_F void itof(Ctx &x, uint8_t ft, uint8_t fs)
+    {
+        // Otavix (SSE): int -> float e escala por potência de 2 (multiplicar pelo inverso é exato)
+        VU1State &s = *x.s;
+        __m128 r = _mm_cvtepi32_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(s.vf[fs])));
+        if (Escala != 0)
+            r = _mm_mul_ps(r, _mm_set1_ps(Escala == 4 ? 1.0f / 16.0f : Escala == 12 ? 1.0f / 4096.0f : 1.0f / 32768.0f));
+        gravaV<Dest>(s.vf[ft], r);
+    }
+
+    VU1N_F int32_t f2i(float v, float esc)
+    {
+        const double d = static_cast<double>(v) * static_cast<double>(esc);
+        if (d >= static_cast<double>(std::numeric_limits<int32_t>::max()))
+            return std::numeric_limits<int32_t>::max();
+        if (d <= static_cast<double>(std::numeric_limits<int32_t>::min()))
+            return std::numeric_limits<int32_t>::min();
+        return static_cast<int32_t>(d);
+    }
+
+    template <int Escala, uint8_t Dest>
+    VU1N_F void ftoi(Ctx &x, uint8_t ft, uint8_t fs)
+    {
+        // Otavix (SSE): igual ao f2i(nOp(v), esc) por lane. esc é potência de 2, então v*esc em float é exato (o
+        // nOp tira infinito/NaN); cvtt dá INT_MIN fora da faixa, e as lanes >= 2^31 viram INT_MAX
+        VU1State &s = *x.s;
+        const float e = Escala == 0 ? 1.0f : Escala == 4 ? 16.0f : Escala == 12 ? 4096.0f : 32768.0f;
+        const __m128 p = _mm_mul_ps(nOpV(_mm_loadu_ps(s.vf[fs])), _mm_set1_ps(e));
+        __m128i r = _mm_cvttps_epi32(p);
+        const __m128i alto = _mm_castps_si128(_mm_cmpge_ps(p, _mm_set1_ps(2147483648.0f)));
+        r = _mm_blendv_epi8(r, _mm_set1_epi32(0x7FFFFFFF), alto);
+        gravaV<Dest>(s.vf[ft], _mm_castsi128_ps(r));
+    }
+
+    template <uint8_t Dest>
+    VU1N_X void absv(Ctx &x, uint8_t ft, uint8_t fs)
+    {
+        VU1State &s = *x.s;
+        float r[4];
+        for (int c = 0; c < 4; ++c)
+            if (Dest & (8u >> c))
+                r[c] = std::fabs(nOp(s.vf[fs][c]));
+        grava<Dest>(s.vf[ft], r);
+    }
+
+    VU1N_F void clip(Ctx &x, uint8_t fs, uint8_t ft)
+    {
+        // Otavix (SSE): as 6 comparações inteiras (bits crus, sem nOp, como antes) em duas de 4 lanes
+        VU1State &s = *x.s;
+        uint32_t w;
+        std::memcpy(&w, &s.vf[ft][3], 4);
+        const int32_t lim = (w & 0x7F800000u) != 0u ? static_cast<int32_t>(w & 0x7FFFFFFFu) : 0x007FFFFF;
+        const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i *>(s.vf[fs]));
+        const __m128i vl = _mm_set1_epi32(lim);
+        const int mPos = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(b, vl))) & 7;
+        const int mNeg = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(_mm_xor_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u))), vl))) & 7;
+        static constexpr uint8_t kEspalha[8] = {0x00, 0x01, 0x04, 0x05, 0x10, 0x11, 0x14, 0x15}; // bit k -> bit 2k
+        const uint32_t f = static_cast<uint32_t>(kEspalha[mPos]) | (static_cast<uint32_t>(kEspalha[mNeg]) << 1);
+        x.workClip = ((x.workClip << 6) | f) & 0xFFFFFFu;
+        poeFlagC(x, x.c + kFmac, 0u, 0u, x.workClip, FlagClip);
+    }
+
+    // ------------------------------------------------------------------ inferiores
+    VU1N_F uint32_t endQ(const Ctx &x, int32_t base, int32_t imm)
+    {
+        return (static_cast<uint32_t>(base + imm) * 16u) & (x.dataSize - 1u);
+    }
+    VU1N_F uint32_t endR(const Ctx &x, int32_t vi)
+    {
+        return (static_cast<uint32_t>(static_cast<uint16_t>(vi)) * 16u) & (x.dataSize - 1u);
+    }
+
+    template <uint8_t Dest>
+    VU1N_F void carrega(Ctx &x, uint8_t ft, uint32_t a)
+    {
+        float t[4];
+        std::memcpy(t, x.data + a, 16);
+        grava<Dest>(x.s->vf[ft], t);
+    }
+
+    VU1N_X void xgConflito(Ctx &x, uint32_t a);
+
+    template <uint8_t Dest>
+    VU1N_F void guarda(Ctx &x, uint32_t a, const uint32_t w[4])
+    {
+        if (x.xgFim > x.c)
+            xgConflito(x, a); // Otavix (XGKICK ansioso): escrita no pacote antes de ele "sair"?
+        efetivaXg(x);
+        uint32_t *m = reinterpret_cast<uint32_t *>(x.data + a);
+        if (Dest == 0xFu)
+        {
+            std::memcpy(m, w, 16);
+            return;
+        }
+        for (int c = 0; c < 4; ++c)
+            if (Dest & (8u >> c))
+                std::memcpy(m + c, &w[c], 4);
+    }
+
+    template <uint8_t Dest>
+    VU1N_F void guardaVf(Ctx &x, uint32_t a, uint8_t fs)
+    {
+        uint32_t w[4];
+        std::memcpy(w, x.s->vf[fs], 16);
+        guarda<Dest>(x, a, w);
+    }
+
+    template <uint8_t Dest>
+    VU1N_F void guardaVi(Ctx &x, uint32_t a, uint8_t it)
+    {
+        const uint32_t v = static_cast<uint16_t>(x.s->vi[it] & 0xFFFF);
+        const uint32_t w[4] = {v, v, v, v};
+        guarda<Dest>(x, a, w);
+    }
+
+    template <uint8_t Dest>
+    VU1N_F int32_t leVi(const Ctx &x, uint32_t a)
+    {
+        constexpr int comp = (Dest & 8u) ? 0 : (Dest & 4u) ? 1 : (Dest & 2u) ? 2 : 3;
+        uint32_t v;
+        std::memcpy(&v, x.data + a + comp * 4, 4);
+        return static_cast<int16_t>(v & 0xFFFFu);
+    }
+
+    VU1N_F void viEscreve(Ctx &x, uint8_t r, int32_t v)
+    {
+        x.s->vi[r] = static_cast<int16_t>(v);
+    }
+
+    VU1N_F int32_t viDesvio(const Ctx &x, uint8_t r)
+    {
+        return x.bkReg == r ? x.bkVal : x.s->vi[r];
+    }
+
+    VU1N_F void queueQ(Ctx &x, float v, uint32_t lat, uint32_t di)
+    {
+        if (x.qv)
+            sincLento(x);
+        x.qv = true;
+        x.qPronto = x.c + lat;
+        x.qVal = nRes(v);
+        x.qDi = di & 0x30u;
+    }
+
+    VU1N_F void queueP(Ctx &x, float v, uint32_t lat)
+    {
+        v = nRes(v);
+        if (x.pv[0] || x.pv[1])
+            sincLento(x);
+        for (int i = 0; i < 2; ++i)
+            if (!x.pv[i])
+            {
+                x.pv[i] = true;
+                x.pPronto[i] = x.c + lat;
+                x.pVal[i] = v;
+                x.efuLivre = x.c + (lat > 0u ? lat - 1u : 0u);
+                return;
+            }
+    }
+
+    VU1N_X void div(Ctx &x, uint8_t fs, uint8_t fsf, uint8_t ft, uint8_t ftf)
+    {
+        const float num = nOp(x.s->vf[fs][fsf]), den = nOp(x.s->vf[ft][ftf]);
+        uint32_t di = 0;
+        float r;
+        if (den == 0.0f)
+        {
+            di = num == 0.0f ? 0x10u : 0x20u;
+            r = std::signbit(num) != std::signbit(den) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+        }
+        else
+            r = num / den;
+        queueQ(x, nRes(r), 7u, di);
+    }
+
+    VU1N_X void sqrtq(Ctx &x, uint8_t ft, uint8_t ftf)
+    {
+        const float v = nOp(x.s->vf[ft][ftf]);
+        queueQ(x, std::sqrt(std::fabs(v)), 7u, v < 0.0f ? 0x10u : 0u);
+    }
+
+    VU1N_X void rsqrt(Ctx &x, uint8_t fs, uint8_t fsf, uint8_t ft, uint8_t ftf)
+    {
+        const float num = nOp(x.s->vf[fs][fsf]), rad = nOp(x.s->vf[ft][ftf]);
+        const float den = std::sqrt(std::fabs(rad));
+        uint32_t di = rad < 0.0f ? 0x10u : 0u;
+        float r;
+        if (den != 0.0f)
+            r = num / den;
+        else
+        {
+            di = num == 0.0f ? 0x10u : 0x20u;
+            r = std::signbit(num) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+        }
+        queueQ(x, nRes(r), 13u, di);
+    }
+
+    VU1N_X void fcset(Ctx &x, uint32_t imm)
+    {
+        x.workClip = imm & 0xFFFFFFu;
+        // anula a escrita de clip de outra instrução do mesmo ciclo (todas as flags têm latência 4)
+        for (int i = 0; i < x.nfq; ++i)
+            if (fqAt(x, i).pronto == x.c + kFmac)
+                fqAt(x, i).tipo &= static_cast<uint8_t>(~FlagClip);
+        poeFlagC(x, x.c + kFmac, 0u, 0u, x.workClip, FlagClip);
+    }
+
+    VU1N_X void fsset(Ctx &x, uint32_t imm12)
+    {
+        // anula só a escrita do status (o MAC continua) das entradas do mesmo ciclo
+        for (int i = 0; i < x.nfq; ++i)
+            if (fqAt(x, i).pronto == x.c + kFmac)
+                fqAt(x, i).tipo &= static_cast<uint8_t>(~FlagStatus);
+        poeFlagC(x, x.c + kFmac, 0u, imm12 & 0xFC0u, 0u, FlagSticky);
+    }
+
+    VU1N_X void xgkick(Ctx &x, uint8_t is)
+    {
+        if (x.dataSize < 16u)
+            return;
+        x.xg = Xg{};
+        x.xg.ativo = true;
+        x.xg.origem = (static_cast<uint32_t>(static_cast<uint16_t>(x.s->vi[is])) * 16u) % x.dataSize;
+        x.xg.base = x.c - 1u; // o ciclo do XGKICK conta para o PATH1
+        x.xg.emissao = x.c;
+        if (xgAnsioso())
+        {
+            // Otavix: copia e envia o pacote inteiro agora; o PATH1 termina quando o crédito (1 + 1 por ciclo, 2 por
+            // quadword) cobre todos os quadwords: emissão + 2N - 1, igual ao modo preguiçoso
+            x.xg.base = x.c - 0x7FFFFFFFull;
+            avancaXg(x, 0u);
+            const uint32_t n = std::max<uint32_t>(x.xg.copiado / 16u, 1u);
+            x.xgEmissao = x.c;
+            x.xgFim = x.c + 2u * n - 1u;
+            x.xgIni = x.xg.origem;
+            x.xgTam = x.xg.copiado;
+            x.xg.ativo = false;
+        }
+    }
+
+    VU1N_X void xgConflito(Ctx &x, uint32_t a)
+    {
+        if (x.dataSize == 0u)
+            return;
+        const uint32_t off = (a + x.dataSize - x.xgIni) % x.dataSize;
+        if (off >= x.xgTam)
+            return;
+        const uint64_t saida = x.xgEmissao + 2u * (off / 16u) + 1u; // ciclo em que esse quadword já teria saído
+        if (x.c >= saida)
+            return;
+        static std::atomic<uint32_t> n{0u};
+        if (n.fetch_add(1u, std::memory_order_relaxed) < 10u)
+            std::fprintf(stderr, "[vu1n] xg-conflito: escrita em 0x%04x no pacote (off %u de %u) no ciclo %llu < %llu\n", a, off,
+                         x.xgTam, static_cast<unsigned long long>(x.c), static_cast<unsigned long long>(saida));
+    }
+
+    // ------------------------------------------------------------------ EFU (mesmas aproximações do interpretador)
+    inline float eatan(float v)
+    {
+        constexpr float k[] = {0.999999344348907f, -0.333298563957214f, 0.199465364217758f, -0.13085337519646f,
+                               0.096420042216778f, -0.055909886956215f, 0.021861229091883f, -0.004054057877511f};
+        const float q = v * v;
+        float p = k[7];
+        for (int i = 6; i >= 0; --i)
+            p = k[i] + q * p;
+        return 0.785398185253143f + v * p;
+    }
+
+    inline float esin(float v)
+    {
+        constexpr float k[] = {1.0f, -0.166666567325592f, 0.008333025500178f, -0.000198074136279f, 0.000002601886990f};
+        const float q = v * v;
+        float p = k[4];
+        for (int i = 3; i >= 0; --i)
+            p = k[i] + q * p;
+        return v * p;
+    }
+
+    inline float eexp(float v)
+    {
+        constexpr float k[] = {0.249998688697815f, 0.031257584691048f, 0.002591371303424f,
+                               0.000171562001924f, 0.000005430199963f, 0.000000690600018f};
+        float p = k[5];
+        for (int i = 4; i >= 0; --i)
+            p = k[i] + v * p;
+        p = 1.0f + v * p;
+        p *= p;
+        p *= p;
+        return p != 0.0f ? 1.0f / p : std::numeric_limits<float>::max();
+    }
+
+    // Op: identificador interno 0x70..0x7D (sem 0x7B): 0x77 ERSQRT, 0x79 ESIN, 0x7C EATAN, 0x7D EEXP (o código real vem do vu1_comum.py)
+    template <int Op>
+    VU1N_X void efu(Ctx &x, uint8_t fs, uint8_t comp)
+    {
+        const float *v = x.s->vf[fs];
+        if (Op >= 0x70 && Op <= 0x73)
+        {
+            const float a = nOp(v[0]), b = nOp(v[1]), c = nOp(v[2]);
+            const float soma = a * a + b * b + c * c;
+            if (Op == 0x70)
+                queueP(x, soma, 11u);
+            else if (Op == 0x71)
+                queueP(x, soma != 0.0f ? 1.0f / soma : soma, 18u);
+            else if (Op == 0x72)
+                queueP(x, std::sqrt(soma), 18u);
+            else
+            {
+                const float len = std::sqrt(soma);
+                queueP(x, len != 0.0f ? 1.0f / len : len, 24u);
+            }
+        }
+        else if (Op == 0x74 || Op == 0x75)
+        {
+            const float a = nOp(v[0]), b = nOp(v[Op == 0x74 ? 1 : 2]);
+            queueP(x, a != 0.0f ? eatan(b / a) : 0.0f, 54u);
+        }
+        else if (Op == 0x76)
+        {
+            float soma = 0.0f;
+            for (int c = 0; c < 4; ++c)
+                soma += nOp(v[c]);
+            queueP(x, soma, 12u);
+        }
+        else
+        {
+            const float a = nOp(v[comp]);
+            if (Op == 0x77)
+            {
+                float r = a;
+                if (r >= 0.0f)
+                {
+                    r = std::sqrt(r);
+                    if (r != 0.0f)
+                        r = 1.0f / r;
+                }
+                queueP(x, r, 18u);
+            }
+            else if (Op == 0x78)
+                queueP(x, a >= 0.0f ? std::sqrt(a) : a, 12u);
+            else if (Op == 0x79)
+                queueP(x, esin(a), 29u);
+            else if (Op == 0x7A)
+                queueP(x, a != 0.0f ? 1.0f / a : a, 12u);
+            else if (Op == 0x7C)
+                queueP(x, eatan(a), 54u);
+            else if (Op == 0x7D)
+                queueP(x, eexp(a), 44u);
+        }
+    }
+
+    // ------------------------------------------------------------------ identidade do programa
+    // Mesmo alcance e hash do vu1_comum.py (programa / hash_programa).
+    inline const char *nomeDesvio(uint32_t l, bool &indireto)
+    {
+        indireto = false;
+        if (l == 0u || l == 0x8000033Cu)
+            return nullptr;
+        const uint32_t op = (l >> 25) & 0x7Fu;
+        switch (op)
+        {
+        case 0x20:
+            return "B";
+        case 0x21:
+            return "BAL";
+        case 0x28:
+        case 0x29:
+        case 0x2C:
+        case 0x2D:
+        case 0x2E:
+        case 0x2F:
+            return "IB";
+        case 0x24:
+            indireto = true;
+            return "JR";
+        case 0x25:
+            indireto = true;
+            return "JALR";
+        default:
+            return nullptr;
+        }
+    }
+
+    VU1N_F int32_t imm11(uint32_t l)
+    {
+        const int32_t v = static_cast<int32_t>(l & 0x7FFu);
+        return (v & 0x400) ? v - 0x800 : v;
+    }
+
+    // devolve o hash FNV-1a 64 dos pares alcançáveis a partir dos inícios (código de 16 KB)
+    inline uint64_t hashPrograma(const uint8_t *code, uint32_t tam, const uint32_t *inicios, uint32_t nInicios)
+    {
+        const uint32_t n = tam / 8u;
+        uint8_t marca[0x4000 / 8]{}; // 1 incluído, 2 explorado
+        uint32_t pend[0x4000 / 8 * 3];
+        uint32_t np = 0;
+        const uint32_t m = tam - 1u;
+        auto empilha = [&](uint32_t a)
+        {
+            if (np < sizeof(pend) / sizeof(pend[0]))
+                pend[np++] = a & m;
+        };
+        auto le = [&](uint32_t a, uint32_t &lo, uint32_t &up)
+        {
+            std::memcpy(&lo, code + a, 4);
+            std::memcpy(&up, code + a + 4, 4);
+        };
+        auto delaySlot = [&](uint32_t a)
+        {
+            a &= m;
+            marca[a / 8u] |= 1u;
+            uint32_t lo, up;
+            le(a, lo, up);
+            if (up & 0x80000000u)
+                return;
+            bool ind;
+            const char *d = nomeDesvio(lo, ind);
+            if (!d)
+                return;
+            if (!ind)
+                empilha(a + 8u + static_cast<uint32_t>(imm11(lo) * 8));
+            empilha(a + 8u);
+        };
+        for (uint32_t k = 0; k < nInicios; ++k)
+            empilha(inicios[k]);
+        while (np)
+        {
+            uint32_t pc = pend[--np];
+            for (;;)
+            {
+                pc &= m;
+                if (marca[pc / 8u] & 2u)
+                    break;
+                marca[pc / 8u] |= 3u;
+                uint32_t lo, up;
+                le(pc, lo, up);
+                if (up & 0x40000000u)
+                {
+                    delaySlot(pc + 8u);
+                    break;
+                }
+                bool ind = false;
+                const char *d = (up & 0x80000000u) ? nullptr : nomeDesvio(lo, ind);
+                if (d && !ind)
+                {
+                    empilha(pc + 8u + static_cast<uint32_t>(imm11(lo) * 8));
+                    delaySlot(pc + 8u);
+                    if (d[0] == 'B' && d[1] == 0)
+                        break;
+                    if (d[0] == 'B' && d[1] == 'A')
+                        empilha(pc + 16u);
+                    pc += 16u;
+                    continue;
+                }
+                if (d && ind)
+                {
+                    delaySlot(pc + 8u);
+                    if (d[1] == 'A')
+                        empilha(pc + 16u);
+                    break;
+                }
+                pc += 8u;
+            }
+        }
+        uint64_t h = 1469598103934665603ull;
+        for (uint32_t i = 0; i < n && i < 0x4000u / 8u; ++i)
+        {
+            if (!(marca[i] & 1u))
+                continue;
+            uint8_t b[12];
+            const uint32_t a = i * 8u;
+            std::memcpy(b, &a, 4);
+            std::memcpy(b + 4, code + a, 8);
+            for (int k = 0; k < 12; ++k)
+            {
+                h ^= b[k];
+                h *= 1099511628211ull;
+            }
+        }
+        return h;
+    }
+
+    inline uint64_t hashPrograma(const uint8_t *code, uint32_t tam, uint32_t inicio)
+    {
+        return hashPrograma(code, tam, &inicio, 1u);
+    }
+
+    inline const Programa *procuraPrograma(uint64_t hash)
+    {
+        uint32_t lo = 0, hi = kNumProgramas;
+        while (lo < hi)
+        {
+            const uint32_t meio = (lo + hi) / 2u;
+            if (kProgramas[meio].hash < hash)
+                lo = meio + 1u;
+            else
+                hi = meio;
+        }
+        return (lo < kNumProgramas && kProgramas[lo].hash == hash) ? &kProgramas[lo] : nullptr;
+    }
+
+    // confere o código das entradas extras do programa na memória atual
+    inline bool extrasConferem(const Programa &p, const uint8_t *code, uint32_t tam)
+    {
+        if (p.nExtras == 0u)
+            return true;
+        uint32_t ini[64];
+        uint32_t n = 0;
+        ini[n++] = p.inicio;
+        for (uint32_t k = 0; k < p.nExtras && n < 64u; ++k)
+            ini[n++] = p.extras[k];
+        return hashPrograma(code, tam, ini, n) == p.hashCompleto;
+    }
+
+    inline Funcao procura(uint64_t hash)
+    {
+        uint32_t lo = 0, hi = kNumProgramas;
+        while (lo < hi)
+        {
+            const uint32_t meio = (lo + hi) / 2u;
+            if (kProgramas[meio].hash < hash)
+                lo = meio + 1u;
+            else
+                hi = meio;
+        }
+        return (lo < kNumProgramas && kProgramas[lo].hash == hash) ? kProgramas[lo].f : nullptr;
+    }
+}
