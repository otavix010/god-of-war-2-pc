+void OtxGsGpu::montaPrim(const GSPrimitiveBatch &batch, PrimPre &out)
+{
+    static_assert(sizeof(Prim) == sizeof(out.b), "PrimPre::b tem que ter o tamanho do Prim");
+    Prim p{};
+    out.estado = montaGeo(batch, p) ? 1u : 2u;
+    std::memcpy(out.b, &p, sizeof p);
+}
+
+bool OtxGsGpu::ligado()
+{
+    // Otavix (30/10): ligado por padrão (Spawn 15 min sem queda, ~75 x ~55 qps da CPU); PS2X_GS_GPU=0 volta à CPU,
+    // e sem OpenGL 4.3 o cria() devolve nulo e fica na CPU também
+    static const bool v = [] { const char *e = std::getenv("PS2X_GS_GPU"); return !(e && e[0] == '0'); }();
+    return v;
+}
+
+bool OtxGsGpu::confere()
+{
+    static const bool v = [] { const char *e = std::getenv("PS2X_GS_GPU_CONFERE"); return e && e[0] == '1'; }();
+    return v;
+}
+
+std::unique_ptr<OtxGsGpu> OtxGsGpu::cria(uint8_t *vram)
+{
+    auto g = std::make_unique<GsGpu>(vram);
+    if (!g->inicia())
+    {
+        std::fprintf(stderr, "[gs-gpu] GPU indisponível; o GS segue na CPU\n");
+        return nullptr;
+    }
+    return g;
+}
