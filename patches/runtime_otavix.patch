+// Otavix (patch_vu1_nativo): integração do VU1 nativo no VU1Interpreter; incluído no fim de ps2_vu1_core.cpp
+#include <xmmintrin.h>
+#include <nmmintrin.h>
+
+// ============================================================================
+// Otavix (patch_vu1_nativo): microprogramas traduzidos (vu1_programas.cpp)
+// ============================================================================
+std::atomic<uint64_t> g_otxVu1Nativo{0u}, g_otxVu1Devolvido{0u}, g_otxVu1SemProg{0u}, g_otxVu1Diverge{0u};
+
+namespace
+{
+    int otxModoNativo()
+    {
+        static const int modo = []
+        {
+            const char *v = std::getenv("PS2X_VU1_VERIFICA");
+            if (v && v[0] == '1')
+                return 2;
+            const char *n = std::getenv("PS2X_VU1_NATIVO");
+            return (n && n[0] == '1') ? 1 : 0;
+        }();
+        return modo;
+    }
+
+    struct OtxEnvio
+    {
+        PS2Memory *memory;
+        GS *gs;
+        std::vector<std::vector<uint8_t>> *captura;
+    };
+
+    void otxEnvia(void *u, const uint8_t *pacote, uint32_t bytes)
+    {
+        OtxEnvio &e = *static_cast<OtxEnvio *>(u);
+        if (e.captura)
+        {
+            e.captura->emplace_back(pacote, pacote + bytes);
+            return;
+        }
+        if (e.memory)
+            e.memory->submitGifPacket(GifPathId::Path1, pacote, bytes);
+        else if (e.gs)
+            e.gs->processGIFPacket(pacote, bytes);
+    }
+
+    uint8_t *otxPacote()
+    {
+        static thread_local std::vector<uint8_t> buf(vu1n::kPacote);
+        return buf.data();
+    }
+
+    void otxPreparaCtx(vu1n::Ctx &x, VU1State *s, uint8_t *data, uint32_t dataSize, uint64_t ciclo, uint32_t maxCycles,
+                       OtxEnvio *envio)
+    {
+        x.s = s;
+        x.data = data;
+        x.dataSize = dataSize;
+        x.c = ciclo;
+        x.fim = ciclo + maxCycles;
+        x.workClip = s->clip;
+        x.pacote = otxPacote();
+        x.envia = &otxEnvia;
+        x.eu = envio;
+    }
+
+    // Devolução ao interpretador (amostra 1/64): registra cada (programa, pc) novo em stderr e, sem orçamento
+    // esgotado, em PS2X_VU1_EXTRAS=<arquivo> ("hash pc"), que o vu1_tradutor.py usa como entradas extras.
+    void otxRegistraDevolve(const uint8_t *vuCode, uint32_t codeSize, uint32_t startPC, const vu1n::Ctx &x)
+    {
+        if (!x.eb && x.c < x.fim)
+            otxVu1ColetaDestino(x.pc); // Otavix: o pc de devolução vira início de programa na coleta
+        static std::atomic<uint64_t> n{0u};
+        if ((n.fetch_add(1u, std::memory_order_relaxed) & 63u) != 0u)
+            return;
+        const uint64_t hp = vu1n::hashPrograma(vuCode, codeSize, startPC);
+        const bool orcamento = x.c >= x.fim;
+        static std::mutex mtx;
+        static std::vector<std::pair<uint64_t, uint32_t>> vistos;
+        std::lock_guard<std::mutex> lk(mtx);
+        const std::pair<uint64_t, uint32_t> chave{hp, x.pc};
+        if (std::find(vistos.begin(), vistos.end(), chave) != vistos.end())
+            return;
+        vistos.push_back(chave);
+        std::fprintf(stderr, "[vu1n] devolve programa %016llx inicio=0x%04x pc=0x%04x%s%s%s\n",
+                     static_cast<unsigned long long>(hp), startPC, x.pc, orcamento ? " orcamento" : "",
+                     x.eb ? " ebit" : "", x.bp ? " desvio_pendente" : "");
+        std::fflush(stderr);
+        static const char *extras = std::getenv("PS2X_VU1_EXTRAS");
+        if (extras && !orcamento)
+            if (FILE *f = std::fopen(extras, "a"))
+            {
+                std::fprintf(f, "%016llx %04x\n", static_cast<unsigned long long>(hp), x.pc);
+                std::fclose(f);
+            }
+    }
+
+    // compara o estado do interpretador (a) com o do nativo (b); devolve a 1ª diferença ou ""
+    std::string otxDiferenca(const VU1State &a, const VU1State &b, const uint8_t *da, const uint8_t *db, uint32_t tam,
+                             const std::vector<std::vector<uint8_t>> &pa, const std::vector<std::vector<uint8_t>> &pb,
+                             uint64_t ca, uint64_t cb)
+    {
+        char t[256];
+        for (int r = 0; r < 32; ++r)
+            for (int c = 0; c < 4; ++c)
+                if (std::memcmp(&a.vf[r][c], &b.vf[r][c], 4) != 0)
+                {
+                    std::snprintf(t, sizeof(t), "vf%d[%d] interp=%08x nativo=%08x", r, c, vu1n::bits(a.vf[r][c]), vu1n::bits(b.vf[r][c]));
+                    return t;
+                }
+        for (int r = 0; r < 16; ++r)
+            if (a.vi[r] != b.vi[r])
+            {
+                std::snprintf(t, sizeof(t), "vi%d interp=%d nativo=%d", r, a.vi[r], b.vi[r]);
+                return t;
+            }
+        for (int c = 0; c < 4; ++c)
+            if (std::memcmp(&a.acc[c], &b.acc[c], 4) != 0)
+            {
+                std::snprintf(t, sizeof(t), "acc[%d] interp=%08x nativo=%08x", c, vu1n::bits(a.acc[c]), vu1n::bits(b.acc[c]));
+                return t;
+            }
+        const struct
+        {
+            const char *n;
+            uint32_t va, vb;
+        } esc[] = {{"q", vu1n::bits(a.q), vu1n::bits(b.q)}, {"p", vu1n::bits(a.p), vu1n::bits(b.p)},
+                   {"i", vu1n::bits(a.i), vu1n::bits(b.i)}, {"r", a.r, b.r}, {"mac", a.mac, b.mac},
+                   {"clip", a.clip, b.clip}, {"status", a.status, b.status}, {"pc", a.pc, b.pc}};
+        for (const auto &e : esc)
+            if (e.va != e.vb)
+            {
+                std::snprintf(t, sizeof(t), "%s interp=%08x nativo=%08x", e.n, e.va, e.vb);
+                return t;
+            }
+        for (uint32_t i = 0; i < tam; i += 4)
+            if (std::memcmp(da + i, db + i, 4) != 0)
+            {
+                uint32_t wa, wb;
+                std::memcpy(&wa, da + i, 4);
+                std::memcpy(&wb, db + i, 4);
+                std::snprintf(t, sizeof(t), "dados[0x%04x] interp=%08x nativo=%08x", i, wa, wb);
+                return t;
+            }
+        if (pa.size() != pb.size())
+        {
+            std::snprintf(t, sizeof(t), "pacotes interp=%zu nativo=%zu", pa.size(), pb.size());
+            return t;
+        }
+        for (size_t k = 0; k < pa.size(); ++k)
+            if (pa[k] != pb[k])
+            {
+                size_t i = 0;
+                while (i < pa[k].size() && i < pb[k].size() && pa[k][i] == pb[k][i])
+                    ++i;
+                std::snprintf(t, sizeof(t), "pacote %zu (bytes %zu/%zu) difere no byte %zu", k, pa[k].size(), pb[k].size(), i);
+                return t;
+            }
+        if (ca != cb)
+        {
+            std::snprintf(t, sizeof(t), "ciclos interp=+%llu nativo=+%llu", static_cast<unsigned long long>(ca),
+                          static_cast<unsigned long long>(cb));
+            return t;
+        }
+        return std::string();
+    }
