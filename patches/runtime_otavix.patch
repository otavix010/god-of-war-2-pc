+    }
+    if (m_otxGpu->adiciona(batch, lut, pg, m_otxPrimPre))
+        return true;
+    m_otxGpu->paraCpu(pg.f0, pg.f1, true, "cpu-realim");
+    m_otxGpu->paraCpu(pg.z0, pg.z1, true, "cpu-realim");
+    if (pg.temTex)
+        m_otxGpu->paraCpu(pg.t0, pg.t1, false, "cpu-realim");
+    m_otxGpu->cpuEscreveu(pg.f0, pg.f1);
+    m_otxGpu->cpuEscreveu(pg.z0, pg.z1);
+    return false;
+}
+
+void GSCpuBackend::otxGpuCpuDesenha(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    const uint32_t linhas = static_cast<uint32_t>(ctx.scissor.y1) + 1u;
+    uint32_t f0, f1, z0, z1;
+    otxPaginas(ctx.frame.fbp, ctx.frame.fbw, linhas, ctx.frame.psm, f0, f1);
+    otxPaginas(ctx.zbuf.zbp, ctx.frame.fbw, linhas, ctx.zbuf.psm, z0, z1);
+    m_otxGpu->paraCpu(f0, f1, true, "cpu-linha");
+    m_otxGpu->paraCpu(z0, z1, true, "cpu-linha");
+    if (state.prim.tme)
+    {
+        uint32_t t0, t1;
+        otxLotePaginasTex(batch, t0, t1);
+        m_otxGpu->paraCpu(t0, t1, false, "cpu-linha");
+    }
+    m_otxGpu->cpuEscreveu(f0, f1);
+    m_otxGpu->cpuEscreveu(z0, z1);
+}
+
+void GSCpuBackend::otxGpuPagTransfer(bool origem, uint32_t &a, uint32_t &b) const
+{
+    const auto &bb = m_transfer.bitbltbuf;
+    const uint32_t bp = origem ? bb.sbp : bb.dbp;
+    const uint32_t bw = std::max<uint32_t>(origem ? bb.sbw : bb.dbw, 1u);
+    const uint32_t psm = origem ? bb.spsm : bb.dpsm;
+    const uint32_t y = (origem ? m_transfer.trxpos.ssay : m_transfer.trxpos.dsay) + m_transfer.trxreg.rrh;
+    otxPaginas(bp / 32u, bw, y, psm, a, b, (bp % 32u) != 0u);
+}
+
+void GSCpuBackend::otxDesenhaLote(GSCpuBackend *dono, const std::vector<GSPrimitiveBatch> &lote)
+{
+    for (const GSPrimitiveBatch &b : lote)
+        dono->otxDesenhaUm(b);
+}
+
+void GSCpuBackend::otxLoteSolta()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_otxLote.empty() && OtxBandasGs::ligado())
+        otxLoteEnfileira();
+    otxUpsOportunos(); // Otavix (upload adiado)
+    if (m_otxGpu)
+        m_otxGpu->solta(); // Otavix (gs_gpu): o GS ficou ocioso, a GPU já começa (se o lote vale a pena)
+}
+
+void GSCpuBackend::otxLoteBarreira()
+{
+    if (!OtxBandasGs::ligado() || !m_otxPublicou)
+        return;
+    OtxBandasGs::instancia().barreira();
+    m_otxPublicou = false;
+    m_otxPendPaginas.clear();
+    m_otxPendLe.clear();
+    m_otxPendUp.clear();
+}
+
+// Otavix: as listas de páginas só servem para "algum intervalo sobrepõe?": guarda cada intervalo uma vez só
+// (o FB/Z se repete em todo triângulo; antes a lista crescia até 64 mil e era varrida a cada triângulo)
+static inline void otxPoeIntervalo(std::vector<std::pair<uint32_t, uint32_t>> &v, uint32_t a, uint32_t b)
+{
+    for (const auto &p : v)
+        if (p.first == a && p.second == b)
+            return;
+    v.emplace_back(a, b);
+}
+
+static inline void otxJuntaIntervalos(std::vector<std::pair<uint32_t, uint32_t>> &dst,
+                                      const std::vector<std::pair<uint32_t, uint32_t>> &src)
+{
+    for (const auto &p : src)
+        otxPoeIntervalo(dst, p.first, p.second);
+}
+
+static bool otxEsperaPagLigada()
+{
+    static const bool l = [] { const char *e = std::getenv("PS2X_GS_ESPERA_PAG"); return !(e && e[0] == '0'); }();
+    return l && OtxBandasGs::ligado();
+}
+
+// Otavix (espera por página): antes de escrever (upload) ou ler (textura) as páginas [a, b), espera só os lotes
+// que escrevem nelas (e, se for escrita, também os que as leem); o lote atual vai para as faixas se tocar nelas
+void GSCpuBackend::otxEsperaPaginas(uint32_t a, uint32_t b, bool escreve)
+{
+    bool tocaAtual = false;
+    for (const auto &pg : m_otxLotePaginas)
+        if (a < pg.second && pg.first < b)
+        {
+            tocaAtual = true;
+            break;
+        }
+    if (!tocaAtual && escreve)
+        for (const auto &pg : m_otxLoteLe)
+            if (a < pg.second && pg.first < b)
+            {
+                tocaAtual = true;
+                break;
+            }
+    if (tocaAtual)
+        otxLoteEnfileira();
+    uint64_t precisa = 0;
+    for (uint32_t p = a; p < b && p < a + 512u; ++p)
+    {
+        precisa = std::max(precisa, m_otxSeqEsc[p & 511u]);
+        if (escreve)
+            precisa = std::max(precisa, m_otxSeqLe[p & 511u]);
+    }
+    if (precisa != 0u)
+        OtxBandasGs::instancia().esperaAte(precisa);
+}
+
+static bool otxUpAdiaLigado()
+{
+    static const bool l = [] { const char *e = std::getenv("PS2X_GS_UP_ADIA"); return !(e && e[0] == '0'); }();
+    return l && otxEsperaPagLigada();
+}
+
+// Otavix (upload adiado): grava em ordem os uploads adiados até o último que toca [a, b) (ou todos)
+void GSCpuBackend::otxUpsAplica(uint32_t a, uint32_t b, bool todos)
+{
+    if (m_otxUps.empty())
+        return;
+    size_t n = 0;
+    if (todos)
+        n = m_otxUps.size();
+    else
+        for (size_t i = m_otxUps.size(); i-- > 0;)
+            if (a < m_otxUps[i].b && m_otxUps[i].a < b)
+            {
+                n = i + 1;
+                break;
+            }
+    if (n == 0)
+        return;
+    for (size_t i = 0; i < n; ++i)
+    {
+        OtxUpAdiado &u = m_otxUps[i];
+        if (u.seq != 0u)
+            OtxBandasGs::instancia().esperaAte(u.seq);
+        otxUploadCore(u.tr, u.st, u.dados.data(), static_cast<uint32_t>(u.dados.size()), true);
+        u.dados.clear();
+        m_otxUpsLivres.push_back(std::move(u.dados));
+    }
+    m_otxUps.erase(m_otxUps.begin(), m_otxUps.begin() + static_cast<std::ptrdiff_t>(n));
+    m_texturePageCache.Invalidate();
+}
+
+// Otavix (upload adiado): grava, sem esperar, os da frente cujos lotes já terminaram
+void GSCpuBackend::otxUpsOportunos()
+{
+    if (m_otxUps.empty())
+        return;
+    const uint64_t feitos = OtxBandasGs::instancia().feitos();
+    size_t n = 0;
+    while (n < m_otxUps.size() && m_otxUps[n].seq <= feitos)
+        ++n;
+    if (n == 0)
+        return;
+    for (size_t i = 0; i < n; ++i)
+    {
+        OtxUpAdiado &u = m_otxUps[i];
+        otxUploadCore(u.tr, u.st, u.dados.data(), static_cast<uint32_t>(u.dados.size()), true);
+        u.dados.clear();
+        m_otxUpsLivres.push_back(std::move(u.dados));
+    }
+    m_otxUps.erase(m_otxUps.begin(), m_otxUps.begin() + static_cast<std::ptrdiff_t>(n));
+    m_texturePageCache.Invalidate();
+}
+
+// manda o lote atual para as faixas e segue (no modo sÃ­ncrono, desenha e espera como antes)
+void GSCpuBackend::otxLoteEnfileira()
+{
+    if (m_otxLote.empty())
+        return;
+    if (!OtxBandasGs::ligado())
+    {
+        otxLoteDescarrega();
+        return;
+    }
+    OtxBandasGs &bandas = OtxBandasGs::instancia();
+    OtxBandasGs::Slot &s = bandas.reserva();
+    s.lote.swap(m_otxLote);
+    m_otxLote.clear();
+    s.tarefa = nullptr;
+    s.temLut = m_otxLoteLutChave != ~0ull;
+    if (s.temLut)
+        s.lut = m_otxLut;
+    s.csr = _mm_getcsr();
+    s.dono = this;
+    bandas.publica();
+    m_otxPublicou = true;
+    {
+        const uint64_t seq = bandas.publicados();
+        for (const auto &pg : m_otxLotePaginas)
+            for (uint32_t p = pg.first; p < pg.second && p < pg.first + 512u; ++p)
+                m_otxSeqEsc[p & 511u] = seq;
+        for (const auto &pg : m_otxLoteLe)
+            for (uint32_t p = pg.first; p < pg.second && p < pg.first + 512u; ++p)
+                m_otxSeqLe[p & 511u] = seq;
+    }
+    otxJuntaIntervalos(m_otxPendPaginas, m_otxLotePaginas);
+    otxJuntaIntervalos(m_otxPendLe, m_otxLoteLe);
+    m_otxLotePaginas.clear();
+    m_otxLoteLe.clear();
+    m_otxLoteLutChave = ~0ull;
+    // muitas faixas pendentes acumuladas: espera (mantÃ©m as listas de pÃ¡ginas curtas)
+    if (m_otxPendPaginas.size() > 65536u)
+        otxLoteBarreira();
+}
+
+void GSCpuBackend::otxLoteAdiciona(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    if (!otxLoteLigado() || OtxPoolGs::instancia().threads() == 0)
+    {
+        otxDesenhaUm(batch);
+        return;
+    }
+    // pÃ¡ginas que este triÃ¢ngulo escreve (FB e Z), por cima: atÃ© a Ãºltima linha do scissor
+    const uint32_t linhas = static_cast<uint32_t>(ctx.scissor.y1) + 1u;
+    uint32_t f0, f1, z0, z1;
+    otxPaginas(ctx.frame.fbp, ctx.frame.fbw, linhas, ctx.frame.psm, f0, f1);
+    otxPaginas(ctx.zbuf.zbp, ctx.frame.fbw, linhas, ctx.zbuf.psm, z0, z1);
+    // Otavix (upload adiado): um upload adiado para o FB/Z deste triângulo é gravado antes (ordem de escrita)
+    if (!m_otxUps.empty())
+    {
+        otxUpsOportunos();
+        otxUpsAplica(f0, f1, false);
+        otxUpsAplica(z0, z1, false);
+    }
+    uint32_t otxT0 = 0, otxT1 = 0;
+    if (state.prim.tme)
+    {
+        uint32_t t0, t1;
+        otxLotePaginasTex(batch, t0, t1);
+        if (!m_otxUps.empty())
+            otxUpsAplica(t0, t1, false); // a textura que ele lê ainda não foi gravada
+        otxT0 = t0;
+        otxT1 = t1;
+        // realimentaÃ§Ã£o com o que o lote (ou os enfileirados) escreve: esvazia e espera antes
+        // Otavix (espera por página): só espera os lotes que escrevem nas páginas da textura
+        if (otxEsperaPagLigada())
+            otxEsperaPaginas(t0, t1, false);
+        else
+        {
+            bool otxToca = false;
+            for (const auto &pg : m_otxLotePaginas)
+                if (t0 < pg.second && pg.first < t1)
+                {
+                    otxToca = true;
+                    break;
+                }
+            if (!otxToca)
+                for (const auto &pg : m_otxPendPaginas)
+                    if (t0 < pg.second && pg.first < t1)
+                    {
+                        otxToca = true;
+                        break;
+                    }
+            if (otxToca)
+                otxLoteDescarrega();
+        }
+        // realimentaÃ§Ã£o consigo mesmo: desenha sozinho, em sÃ©rie
+        if ((t0 < f1 && f0 < t1) || (t0 < z1 && z0 < t1))
+        {
+            ++g_otxLoteSerie;
+            static int otxGrandes = 0;
+            const float otxBx0 = std::min(std::min(batch.vertices[0].x, batch.vertices[1].x), batch.vertices[2].x);
+            const float otxBx1 = std::max(std::max(batch.vertices[0].x, batch.vertices[1].x), batch.vertices[2].x);
+            const float otxBy0 = std::min(std::min(batch.vertices[0].y, batch.vertices[1].y), batch.vertices[2].y);
+            const float otxBy1 = std::max(std::max(batch.vertices[0].y, batch.vertices[1].y), batch.vertices[2].y);
+            const bool otxGrande = (otxBx1 - otxBx0) * (otxBy1 - otxBy0) > 50000.0f;
+            if (otxGrande && otxGrandes < 20)
+            {
+                ++otxGrandes;
+                std::printf("[gs-lote] serie-grande: caixa=%.0fx%.0f fbp=%u fbw=%u psm=0x%x zbp=%u ztst=%u zmsk=%u tex tbp0=0x%x tbw=%u w=%d h=%d psm=0x%x "
+                            "uv=(%.1f,%.1f)-(%.1f,%.1f) fst=%u t=%u..%u f=%u..%u z=%u..%u\n",
+                            otxBx1 - otxBx0, otxBy1 - otxBy0, ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.zbuf.zbp,
+                            static_cast<unsigned>((ctx.test >> 17) & 3u), static_cast<unsigned>(ctx.zbuf.zmask), ctx.tex0.tbp0, ctx.tex0.tbw,
+                            state.textureWidth, state.textureHeight, ctx.tex0.psm,
+                            batch.vertices[0].s / batch.vertices[0].q, batch.vertices[0].t / batch.vertices[0].q,
+                            batch.vertices[2].s / batch.vertices[2].q, batch.vertices[2].t / batch.vertices[2].q,
+                            static_cast<unsigned>(state.prim.fst), t0, t1, f0, f1, z0, z1);
+            }
+            if (g_otxLoteSerie <= 12u)
+                std::printf("[gs-lote] serie: fbp=%u fbw=%u zbp=%u tex=%u..%u (tbp0=0x%x tbw=%u h=%u psm=0x%x) f=%u..%u z=%u..%u y1=%d\n",
+                            ctx.frame.fbp, ctx.frame.fbw, ctx.zbuf.zbp, t0, t1, ctx.tex0.tbp0, ctx.tex0.tbw,
+                            static_cast<unsigned>(state.textureHeight), ctx.tex0.psm, f0, f1, z0, z1, static_cast<int>(ctx.scissor.y1));
+            otxLoteDescarrega();
+            otxDesenhaUm(batch);
+            return;
+        }
+        const uint8_t psm = ctx.tex0.psm;
+        if (psm == GS_PSM_T8 || psm == GS_PSM_T8H || psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH)
+        {
+            // um lote usa uma CLUT decodificada sÃ³ (as threads leem a mesma tabela)
+            const uint64_t chave = (static_cast<uint64_t>(m_otxClutGen) << 32) ^
+                                   (static_cast<uint64_t>(ctx.tex0.cpsm) | (static_cast<uint64_t>(ctx.tex0.csm) << 6) |
+                                    (static_cast<uint64_t>(ctx.tex0.csa) << 8) | (static_cast<uint64_t>(psm) << 14) |
+                                    (static_cast<uint64_t>(state.texa.ta0) << 20) | (static_cast<uint64_t>(state.texa.ta1) << 28) |
+                                    (static_cast<uint64_t>(state.texa.aem ? 1u : 0u) << 36));
+            if (!m_otxLote.empty() && m_otxLoteLutChave != ~0ull && m_otxLoteLutChave != chave)
+                otxLoteEnfileira(); // o lote leva a prÃ³pria cÃ³pia da CLUT
+            m_otxLoteLutChave = chave;
+            (void)otxClutLut(state);
+        }
+    }
+    m_otxLote.push_back(batch);
+    otxPoeIntervalo(m_otxLotePaginas, f0, f1);
+    otxPoeIntervalo(m_otxLotePaginas, z0, z1);
+    if (otxT1 > otxT0)
+        otxPoeIntervalo(m_otxLoteLe, otxT0, otxT1);
+    // PS2X_GS_LOTE_MAX (padrão 4096): lotes menores saem antes para as faixas (esperas por página mais curtas)
+    static const size_t otxLoteMax = []
+    {
+        const char *e = std::getenv("PS2X_GS_LOTE_MAX");
+        const long v = e ? std::atol(e) : 0;
+        return v > 0 ? static_cast<size_t>(v) : static_cast<size_t>(4096);
+    }();
+    if (m_otxLote.size() >= otxLoteMax)
+        otxLoteEnfileira();
+}
+
+// Otavix (diagnóstico): PS2X_GS_BARESTAT=1 conta as barreiras por quem chamou (RVA do retorno) e o tempo de espera;
+// a cada ~2 s imprime [gs-barreira] rva=... n=... ms=... (resolver o RVA com o .map ou acha_rva.py)
+extern "C" char __ImageBase;
+static void otxBarRegistra(void *ret, int64_t ns)
+{
+    static std::mutex m;
+    static std::vector<std::pair<uintptr_t, std::pair<uint64_t, int64_t>>> tab;
+    static auto proximo = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    std::lock_guard<std::mutex> lk(m);
+    const uintptr_t rva = reinterpret_cast<uintptr_t>(ret) - reinterpret_cast<uintptr_t>(&__ImageBase);
+    bool achou = false;
+    for (auto &e : tab)
+        if (e.first == rva)
+        {
+            ++e.second.first;
+            e.second.second += ns;
+            achou = true;
+            break;
+        }
+    if (!achou)
+        tab.push_back({rva, {1u, ns}});
+    const auto agora = std::chrono::steady_clock::now();
+    if (agora < proximo)
+        return;
+    proximo = agora + std::chrono::seconds(2);
+    std::sort(tab.begin(), tab.end(), [](const auto &a, const auto &b) { return a.second.second > b.second.second; });
+    for (size_t i = 0; i < tab.size() && i < 8; ++i)
+        std::printf("[gs-barreira] rva=0x%llx n=%llu ms=%.1f\n", static_cast<unsigned long long>(tab[i].first),
+                    static_cast<unsigned long long>(tab[i].second.first), static_cast<double>(tab[i].second.second) / 1e6);
+    std::fflush(stdout);
+    tab.clear();
+}
+
+__declspec(noinline) void GSCpuBackend::otxLoteDescarrega()
+{
+    if (OtxBandasGs::ligado())
+    {
+        static const bool estat = [] { const char *e = std::getenv("PS2X_GS_BARESTAT"); return e && e[0] == '1'; }();
+        if (estat)
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            otxLoteEnfileira();
+            otxLoteBarreira();
+            otxUpsAplica(0u, 0u, true);
+            otxBarRegistra(_ReturnAddress(),
+                           std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+            return;
+        }
+        otxLoteEnfileira();
+        otxLoteBarreira();
+        otxUpsAplica(0u, 0u, true); // Otavix (upload adiado): depois da barreira, grava todos (sem esperar)
+        return;
+    }
+    if (m_otxLote.empty())
+        return;
+    {
+        static const bool estat = [] { const char *e = std::getenv("PS2X_GS_ESTAT"); return e && e[0] == '1'; }();
+        static uint64_t lotes = 0, tris = 0;
+        ++lotes;
+        tris += m_otxLote.size();
+        if (estat && (lotes & 4095u) == 0u)
+        {
+            std::printf("[gs-lote] lotes=%llu triangulos/lote=%.1f em serie (realimentacao)=%llu\n",
+                        static_cast<unsigned long long>(lotes), static_cast<double>(tris) / static_cast<double>(lotes),
+                        static_cast<unsigned long long>(g_otxLoteSerie));
+            std::fflush(stdout);
+        }
+    }
+    const int n = OtxPoolGs::instancia().threads() + 1;
+    const auto emFaixas = [&]
+    {
+        const std::function<void(int)> tarefa = [&](int k)
+        {
+            t_otxFaixas = n;
+            t_otxFaixa = k;
+            for (const GSPrimitiveBatch &b : m_otxLote)
+                otxDesenhaUm(b);
+            t_otxFaixas = 1;
+            t_otxFaixa = 0;
+        };
+        OtxPoolGs::instancia().rodaTarefas(n, tarefa);
+    };
+    static const bool verifica = [] { const char *e = std::getenv("PS2X_GS_VERIFICA"); return e && e[0] == '1'; }();
+    static uint64_t nLotes = 0, nVer = 0, nDif = 0;
+    if (verifica && m_vram && (++nLotes & 15u) == 0u)
+    {
+        static std::vector<uint8_t> antes, serial;
+        antes.assign(m_vram, m_vram + m_vramSize);
+        const GSMem::TexturePageCache cacheAntes = m_texturePageCache;
+        for (const GSPrimitiveBatch &b : m_otxLote)
+            otxDesenhaUm(b);
+        serial.assign(m_vram, m_vram + m_vramSize);
+        std::memcpy(m_vram, antes.data(), m_vramSize);
+        m_texturePageCache = cacheAntes;
+        emFaixas();
+        ++nVer;
+        if (std::memcmp(m_vram, serial.data(), m_vramSize) != 0)
+        {
+            size_t nd = 0, prim = 0;
+            for (size_t k = 0; k < m_vramSize; ++k)
+                if (m_vram[k] != serial[k] && nd++ == 0)
+                    prim = k;
+            ++nDif;
+            std::printf("[gs-lote] DIFERE: lote de %zu triangulos, %zu bytes, primeiro 0x%zx\n", m_otxLote.size(), nd, prim);
+        }
