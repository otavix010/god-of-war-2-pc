+// ============================================================================
+// Otavix (patch_gs_lote): lote de triÃ¢ngulos desenhado em paralelo por faixas de linhas
+// ============================================================================
+static uint64_t g_otxLoteSerie = 0; // triÃ¢ngulos desenhados em sÃ©rie por realimentaÃ§Ã£o
+namespace
+{
+    bool otxLoteLigado()
+    {
+        static const bool l = [] { const char *e = std::getenv("PS2X_GS_LOTE"); return !(e && e[0] == '0'); }();
+        return l;
+    }
+
+    // pÃ¡ginas de textura lidas pelo triÃ¢ngulo (por cima) e pÃ¡ginas de FB/Z escritas
+    // linhas de textura [l0, l1] que o triÃ¢ngulo/sprite pode ler: a interpolaÃ§Ã£o (com q de um sinal sÃ³) fica dentro
+    // do mÃ­nimo/mÃ¡ximo dos vÃ©rtices; +1 texel do bilinear e folga pela tolerÃ¢ncia de borda. Wrap que sai da textura,
+    // q perto de zero ou modos de regiÃ£o: a textura inteira.
+    void otxLinhasTex(const GSPrimitiveBatch &batch, int &l0, int &l1)
+    {
+        const GSDrawState &state = batch.state;
+        const int h = std::max(1, static_cast<int>(state.textureHeight));
+        l0 = 0;
+        l1 = h - 1;
+        const uint32_t modoV = static_cast<uint32_t>((state.context.clamp >> 2) & 0x3u);
+        if (modoV >= 2u)
+            return;
+        const int n = state.prim.type == GS_PRIM_SPRITE ? 2 : 3;
+        float vmin = 1e30f, vmax = -1e30f;
+        if (state.prim.fst)
+        {
+            for (int i = 0; i < n; ++i)
+            {
+                const float v = static_cast<float>(batch.vertices[i].v) / 16.0f;
+                vmin = std::min(vmin, v);
+                vmax = std::max(vmax, v);
+            }
+        }
+        else
+        {
+            int pos = 0, neg = 0;
+            for (int i = 0; i < n; ++i)
+            {
+                const float q = batch.vertices[i].q;
+                if (q > 1.0e-8f)
+                    ++pos;
+                else if (q < -1.0e-8f)
+                    ++neg;
+            }
+            if (pos != n && neg != n)
+                return;
+            for (int i = 0; i < n; ++i)
+            {
+                const float v = batch.vertices[i].t / batch.vertices[i].q * static_cast<float>(h);
+                vmin = std::min(vmin, v);
+                vmax = std::max(vmax, v);
+            }
+        }
+        if (!(vmin <= vmax) || vmax - vmin > 1.0e6f || std::fabs(vmin) > 1.0e6f)
+            return;
+        const float folga = 2.0f + (vmax - vmin) * 0.001f;
+        int a = static_cast<int>(std::floor(vmin - folga));
+        int b = static_cast<int>(std::floor(vmax + folga));
+        if (modoV == 0u && (a < 0 || b > h - 1)) // REPEAT dando a volta: a textura toda
+            return;
+        l0 = std::max(0, std::min(a, h - 1));
+        l1 = std::max(0, std::min(b, h - 1));
+    }
+
+    void otxLotePaginasTex(const GSPrimitiveBatch &batch, uint32_t &a, uint32_t &b)
+    {
+        const GSDrawState &state = batch.state;
+        const auto &tx = state.context.tex0;
+        int l0, l1;
+        otxLinhasTex(batch, l0, l1);
+        static const bool largo = [] { const char *e = std::getenv("PS2X_GS_TEX_LARGO"); return e && e[0] == '1'; }();
+        if (largo)
+        {
+            l0 = 0;
+            l1 = std::max(1, static_cast<int>(state.textureHeight)) - 1;
+        }
+        // pÃ¡ginas das linhas [l0, l1]: mesma geometria do otxPaginas
+        uint32_t a0, b0;
+        otxPaginas(tx.tbp0 / 32u, tx.tbw, static_cast<uint32_t>(l1 + 1), tx.psm, a0, b0, (tx.tbp0 % 32u) != 0u);
+        uint32_t ph = 32u, pw = 64u;
+        switch (tx.psm)
+        {
+        case 0x02: case 0x0A: case 0x32: case 0x3A: ph = 64u; break;
+        case 0x13: pw = 128u; ph = 64u; break;
+        case 0x14: pw = 128u; ph = 128u; break;
+        default: break;
+        }
+        const uint32_t largura = (std::max<uint32_t>(tx.tbw, 1u) * 64u + pw - 1u) / pw;
+        a = a0 + (static_cast<uint32_t>(l0) / ph) * largura;
+        b = b0;
+    }
+}
