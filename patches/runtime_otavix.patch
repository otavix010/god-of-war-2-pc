+// a thread gráfica junta o que vai para o frontend e entrega em lotes (no fim de cada tarefa ou a cada 256)
+static thread_local std::vector<std::function<void()>> t_otxLoteFront;
+
+static void otxFechaPacotes();
+static void otxEntregaFrontend()
+{
+    otxFechaPacotes(); // Otavix (pacotes em lote)
+    if (t_otxLoteFront.empty())
+        return;
+    static const uint64_t limite = []
+    {
+        const char *e = std::getenv("PS2X_MTVU_FILA_FRONT");
+        const long long v = e ? std::atoll(e) : 0;
+        return v > 0 ? static_cast<uint64_t>(v) : 16384ull;
+    }();
+    std::unique_lock<std::mutex> lk(g_otxF.m);
+    if (!g_otxF.iniciada)
+    {
+        g_otxF.iniciada = true;
+        std::thread(otxLacoFrontend).detach();
+    }
+    if (g_otxF.pendentes.load(std::memory_order_acquire) >= limite) // Otavix (fila em lote): pendentes
+    {
+        g_otxF.limiteFila.store(limite / 2u, std::memory_order_seq_cst);
+        g_otxF.andou.wait(lk, [] { return g_otxF.pendentes.load(std::memory_order_acquire) < limite / 2u; });
+        g_otxF.limiteFila.store(0u, std::memory_order_release);
+    }
+    g_otxF.pendentes.fetch_add(t_otxLoteFront.size(), std::memory_order_acq_rel);
+    for (auto &f : t_otxLoteFront)
+        g_otxF.fila.push_back(std::move(f));
+    t_otxLoteFront.clear();
+    const bool acorda = g_otxFDormindo;
+    lk.unlock();
+    if (acorda)
+        g_otxF.temTrabalho.notify_one();
+}
+
+// roda f no frontend do GS: na thread gráfica com o 4º estágio ligado, posta (em ordem); senão, roda direto
+// Otavix (pacotes em lote): os pacotes GIF da thread gráfica (XGKICK/PATH) vão para o frontend num buffer só
+// ([16 bytes: tamanho][dados, múltiplo de 16]...) com UMA closure por lote, em vez de um std::function + dois
+// locks do pool por pacote. O lote fecha antes de qualquer outro item do frontend (ordem), no fim de cada tarefa e
+// a cada 64 KB. PS2X_MTVU_PACOTES_LOTE=0 volta ao antigo (o chamador decide).
+using OtxFnPacote = void (*)(void *, const uint8_t *, uint32_t);
+static thread_local std::vector<uint8_t> t_otxPacs;
+static thread_local OtxFnPacote t_otxPacsFn = nullptr;
+static thread_local void *t_otxPacsDono = nullptr;
+
+static void otxFechaPacotes()
+{
+    if (t_otxPacs.empty())
+        return;
+    std::vector<uint8_t> b = PS2Memory::otxPegaBufFrontend();
+    b.clear();
+    b.swap(t_otxPacs);
+    const OtxFnPacote fn = t_otxPacsFn;
+    void *const dono = t_otxPacsDono;
+    t_otxLoteFront.push_back([fn, dono, b = std::move(b)]() mutable
+                             {
+                                 size_t i = 0;
+                                 while (i + 16u <= b.size())
+                                 {
+                                     uint32_t n = 0;
+                                     std::memcpy(&n, b.data() + i, 4);
+                                     fn(dono, b.data() + i + 16u, n);
+                                     i += 16u + ((static_cast<size_t>(n) + 15u) & ~static_cast<size_t>(15u));
+                                 }
+                                 PS2Memory::otxDevolveBufFrontend(b); });
+}
+
+bool otxPacotesEmLote()
+{
+    static const bool l = [] { const char *e = std::getenv("PS2X_MTVU_PACOTES_LOTE"); return !(e && e[0] == '0'); }();
+    return l;
+}
+
+void otxPacoteNoFrontend(OtxFnPacote fn, void *dono, const uint8_t *dados, uint32_t n)
+{
+    if (!t_otxPacs.empty() && (fn != t_otxPacsFn || dono != t_otxPacsDono))
+        otxFechaPacotes();
+    t_otxPacsFn = fn;
+    t_otxPacsDono = dono;
+    const size_t at = t_otxPacs.size();
+    const size_t tam = (static_cast<size_t>(n) + 15u) & ~static_cast<size_t>(15u);
+    if (t_otxPacs.capacity() < at + 16u + tam)
+        t_otxPacs.reserve(std::max<size_t>(at + 16u + tam, 128u * 1024u));
+    uint8_t cab[16] = {};
+    std::memcpy(cab, &n, 4);
+    t_otxPacs.insert(t_otxPacs.end(), cab, cab + 16); // Otavix: sem zerar o buffer antes de copiar
+    t_otxPacs.insert(t_otxPacs.end(), dados, dados + n);
+    if (tam > n)
+        t_otxPacs.insert(t_otxPacs.end(), tam - n, static_cast<uint8_t>(0));
+    if (t_otxPacs.size() >= 64u * 1024u)
+    {
+        otxFechaPacotes();
+        otxEntregaFrontend();
+    }
+}
+
+void PS2Memory::otxNoFrontend(std::function<void()> f)
+{
+    if (!t_otxSouGrafico || !otxFrontendLigado())
+    {
+        f();
+        return;
+    }
+    otxFechaPacotes(); // Otavix (pacotes em lote): o que veio antes vai antes
+    t_otxLoteFront.push_back(std::move(f));
+    if (t_otxLoteFront.size() >= 256u)
+        otxEntregaFrontend();
+}
