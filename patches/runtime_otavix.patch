+// Otavix (patch_perfil): ver otx_perfil.h
+#include "runtime/otx_perfil.h"
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <timeapi.h>
+#include <psapi.h>
+#pragma comment(lib, "winmm.lib")
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <map>
+#include <vector>
+
+namespace
+{
+    struct Alvo
+    {
+        HANDLE h;
+        std::string nome;
+        std::unordered_map<uint64_t, uint32_t> rips;
+        std::unordered_map<uint64_t, uint32_t> chamadores; // amostras fora do exe -> 1º quadro no exe
+        std::map<std::vector<uint64_t>, uint32_t> pilhas;  // PS2X_PERFIL_PILHA=1: quadros no exe, do topo para a base
+        uint64_t amostras = 0;
+    };
+
+    std::mutex g_mtx;
+    std::vector<Alvo> g_alvos;
+    std::once_flag g_inicio;
+    uint64_t g_exeIni = 0, g_exeFim = 0;
+
+    // desenrola a pilha da thread suspensa até o primeiro quadro dentro do executável (0 se não achar)
+    uint64_t primeiroNoExeSeh(CONTEXT *c)
+    {
+        __try
+        {
+            for (int i = 0; i < 24; ++i)
+            {
+                if (c->Rip >= g_exeIni && c->Rip < g_exeFim)
+                    return c->Rip;
+                DWORD64 base = 0;
+                PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(c->Rip, &base, nullptr);
+                if (!fe)
+                {
+                    c->Rip = *reinterpret_cast<const DWORD64 *>(c->Rsp);
+                    c->Rsp += 8;
+                }
+                else
+                {
+                    PVOID dados = nullptr;
+                    DWORD64 quadro = 0;
+                    RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c->Rip, fe, c, &dados, &quadro, nullptr);
+                }
+                if (c->Rip == 0)
+                    return 0;
+            }
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+        }
+        return 0;
+    }
+
+    // desenrola a pilha inteira guardando os quadros dentro do executável (até max)
+    int pilhaNoExeSeh(CONTEXT *c, uint64_t *saida, int max)
+    {
+        int n = 0;
+        __try
+        {
+            for (int i = 0; i < 64 && n < max; ++i)
+            {
+                if (c->Rip >= g_exeIni && c->Rip < g_exeFim)
+                    saida[n++] = c->Rip;
+                DWORD64 base = 0;
+                PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(c->Rip, &base, nullptr);
+                if (!fe)
+                {
+                    c->Rip = *reinterpret_cast<const DWORD64 *>(c->Rsp);
+                    c->Rsp += 8;
+                }
+                else
+                {
+                    PVOID dados = nullptr;
+                    DWORD64 quadro = 0;
+                    RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c->Rip, fe, c, &dados, &quadro, nullptr);
+                }
+                if (c->Rip == 0)
+                    break;
+            }
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+        }
+        return n;
+    }
+
+    bool comPilha()
+    {
+        static const bool s = [] { const char *e = std::getenv("PS2X_PERFIL_PILHA"); return e && e[0] == '1'; }();
+        return s;
+    }
+
+    void grava(const char *arq)
+    {
+        FILE *f = std::fopen(arq, "w");
+        if (!f)
+            return;
+        std::fprintf(f, "base %llx\n", static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(GetModuleHandleA(nullptr))));
+        HMODULE mods[512];
+        DWORD precisa = 0;
+        if (K32EnumProcessModules(GetCurrentProcess(), mods, sizeof(mods), &precisa))
+            for (DWORD i = 0; i < precisa / sizeof(HMODULE) && i < 512u; ++i)
+            {
+                MODULEINFO mi{};
+                char nome[MAX_PATH] = {};
+                if (K32GetModuleInformation(GetCurrentProcess(), mods[i], &mi, sizeof(mi)) &&
+                    K32GetModuleBaseNameA(GetCurrentProcess(), mods[i], nome, sizeof(nome)))
+                    std::fprintf(f, "modulo %s %llx %lx\n", nome, static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(mi.lpBaseOfDll)),
+                                 static_cast<unsigned long>(mi.SizeOfImage));
+            }
+        std::lock_guard<std::mutex> lk(g_mtx);
+        for (const Alvo &a : g_alvos)
+        {
+            std::fprintf(f, "thread %s %llu\n", a.nome.c_str(), static_cast<unsigned long long>(a.amostras));
+            for (const auto &kv : a.rips)
+                std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(kv.first), kv.second);
+            for (const auto &kv : a.chamadores)
+                std::fprintf(f, "c %llx %u\n", static_cast<unsigned long long>(kv.first), kv.second);
+            for (const auto &kv : a.pilhas)
+            {
+                std::fprintf(f, "p %u", kv.second);
+                for (uint64_t r : kv.first)
+                    std::fprintf(f, " %llx", static_cast<unsigned long long>(r));
+                std::fprintf(f, "\n");
+            }
+        }
+        std::fclose(f);
+    }
+
+    void amostrador(const char *arq)
+    {
+        {
+            MODULEINFO mi{};
+            if (K32GetModuleInformation(GetCurrentProcess(), GetModuleHandleA(nullptr), &mi, sizeof(mi)))
+            {
+                g_exeIni = reinterpret_cast<uint64_t>(mi.lpBaseOfDll);
+                g_exeFim = g_exeIni + mi.SizeOfImage;
+            }
+        }
+        timeBeginPeriod(1);
+        auto ultimo = std::chrono::steady_clock::now();
+        // PS2X_PERFIL_ATRASO=N: só amostra depois de N segundos (pula o boot)
+        const char *eAtraso = std::getenv("PS2X_PERFIL_ATRASO");
+        const auto comeco = ultimo + std::chrono::seconds(eAtraso ? std::atoi(eAtraso) : 0);
+        for (;;)
+        {
+            Sleep(1);
+            if (std::chrono::steady_clock::now() < comeco)
+                continue;
+            {
+                std::lock_guard<std::mutex> lk(g_mtx);
+                for (Alvo &a : g_alvos)
+                {
+                    if (SuspendThread(a.h) == static_cast<DWORD>(-1))
+                        continue;
+                    CONTEXT ctx{};
+                    ctx.ContextFlags = CONTEXT_FULL;
+                    const bool ok = GetThreadContext(a.h, &ctx) != FALSE;
+                    uint64_t noExe = 0;
+                    const uint64_t rip = ctx.Rip;
+                    if (ok && (rip < g_exeIni || rip >= g_exeFim))
+                    {
+                        CONTEXT copia = ctx;
+                        noExe = primeiroNoExeSeh(&copia);
+                    }
+                    uint64_t pilha[16];
+                    int nPilha = 0;
+                    if (ok && comPilha())
+                    {
+                        CONTEXT copia = ctx;
+                        nPilha = pilhaNoExeSeh(&copia, pilha, 16);
+                    }
+                    // retoma ANTES de alocar: a thread suspensa pode estar com o lock do heap
+                    ResumeThread(a.h);
+                    if (ok)
+                    {
+                        ++a.rips[rip];
+                        if (noExe)
+                            ++a.chamadores[noExe];
+                        if (nPilha)
+                            ++a.pilhas[std::vector<uint64_t>(pilha, pilha + nPilha)];
+                        ++a.amostras;
+                    }
+                }
+            }
+            const auto agora = std::chrono::steady_clock::now();
+            if (agora - ultimo >= std::chrono::seconds(10))
+            {
+                ultimo = agora;
+                grava(arq);
+            }
+        }
+    }
+}
+
+namespace
+{
+    // Otavix (02/11): threads principais em núcleos físicos diferentes. Num i5 de 4 núcleos/8 threads o Windows punha
+    // duas delas no mesmo núcleo (SMT), e cada uma anda a ~60%: o VU1 ia a 6,1-6,7 ns/ciclo (1,8 no PC). PS2X_NUCLEOS:
+    // "auto" (padrão: só com SMT e até 6 núcleos físicos), "0" desliga, ou "ee=0,grafico=2,..." (processador lógico)
+    void otxFixaNucleo(const char *nome)
+    {
+        // só o primeiro nome de cada thread (as do pool da CPU se registram como gspool/gsfaixa e depois passam pelo
+        // registro "desenho" do cronômetro de desenho: não podem ir todas para o núcleo da desenho)
+        static thread_local bool jaVista = false;
+        if (!nome || jaVista)
+            return;
+        jaVista = true;
+        static const char *cfg = [] { const char *e = std::getenv("PS2X_NUCLEOS"); return e ? e : "auto"; }();
+        if (cfg[0] == '0' && cfg[1] == '\0')
+            return;
+        const std::string n = nome;
+        int lp = -1;
+        if (std::strcmp(cfg, "auto") != 0)
+        {
+            const std::string c = std::string(",") + cfg + ",";
+            const size_t p = c.find("," + n + "=");
+            if (p == std::string::npos)
+                return;
+            lp = std::atoi(c.c_str() + p + n.size() + 2);
+        }
+        else
+        {
+            // processadores lógicos de cada núcleo físico (máscara); preenchido junto com "primeiros"
+            static std::vector<KAFFINITY> mascaras;
+            static const std::vector<int> primeiros = []
+            {
+                // primeiro processador lógico de cada núcleo físico (vazio: sem SMT ou muitos núcleos)
+                std::vector<int> r;
+                DWORD tam = 0;
+                GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &tam);
+                std::vector<uint8_t> buf(tam);
+                if (!tam || !GetLogicalProcessorInformationEx(RelationProcessorCore,
+                                                              reinterpret_cast<SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *>(buf.data()), &tam))
+                    return r;
+                bool smt = false;
+                for (DWORD o = 0; o < tam;)
+                {
+                    const auto *i = reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *>(buf.data() + o);
+                    const KAFFINITY m = i->Processor.GroupMask[0].Mask;
+                    if (i->Processor.Flags & LTP_PC_SMT)
+                        smt = true;
+                    mascaras.push_back(m);
+                    for (int b = 0; b < 64; ++b)
+                        if (m & (KAFFINITY(1) << b))
+                        {
+                            r.push_back(b);
+                            break;
+                        }
+                    o += i->Size;
+                }
+                if (!smt || r.size() < 4u || r.size() > 6u)
+                    r.clear();
+                return r;
+            }();
+            if (primeiros.empty())
+                return;
+            // o núcleo 0 recebe as interrupções do sistema: fica com o frontend (o mais leve dos quatro)
+            static const char *ordem[] = {"ee", "grafico", "desenho", "frontend"};
+            static const int nucleo[] = {1, 2, 3, 0};
+            for (int k = 0; k < 4; ++k)
+                if (n == ordem[k])
+                    lp = primeiros[static_cast<size_t>(nucleo[k]) % primeiros.size()];
+            if (lp < 0)
+            {
+                // Otavix (02/11): PS2X_NUCLEOS_EXCLUSIVO=1: as outras threads (GPU, janela, pool da CPU) ficam fora dos
+                // núcleos do EE e do VU1 inteiros (o irmão SMT deles ocupado deixa os dois elos da cadeia mais lentos)
+                // =2 (padrão): só o núcleo do VU1, o elo mais longo. Notebook, GoW 1 modo 60 (intercalados): VU1 6,04/6,21 ->
+                // 5,34/5,79 ns/ciclo, trecho pesado 26-27/26 -> 28/27-28 qps. =1 tira também o do EE (a desenho piorava
+                // 7%: as outras threads iam para o núcleo dela), =0 desliga
+                static const int exclusivo = [] { const char *e = std::getenv("PS2X_NUCLEOS_EXCLUSIVO"); return e ? std::atoi(e) : 2; }();
+                if (!exclusivo || mascaras.size() != primeiros.size())
+                    return;
+                KAFFINITY m = 0;
+                for (size_t c = 0; c < mascaras.size(); ++c)
+                    if (c != 2u && (exclusivo == 2 || c != 1u))
+                        m |= mascaras[c];
+                if (m && SetThreadAffinityMask(GetCurrentThread(), static_cast<DWORD_PTR>(m)))
+                    std::printf("[nucleos] %s -> fora dos núcleos do EE/VU1 (máscara 0x%llx)\n", nome, static_cast<unsigned long long>(m));
+                return;
+            }
+        }
+        if (lp < 0 || lp > 63)
+            return;
+        const DWORD_PTR ant = SetThreadAffinityMask(GetCurrentThread(), DWORD_PTR(1) << lp);
+        std::printf("[nucleos] %s -> processador %d%s\n", nome, lp, ant ? "" : " (falhou)");
+    }
+}
+
+void otxPerfilRegistra(const char *nome)
+{
+    otxFixaNucleo(nome);
+    static const char *arq = std::getenv("PS2X_PERFIL");
+    if (!arq)
+        return;
+    HANDLE h = nullptr;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+    {
+        std::lock_guard<std::mutex> lk(g_mtx);
+        g_alvos.push_back(Alvo{h, nome ? nome : "?", {}, {}, {}, 0});
+    }
+    std::call_once(g_inicio, []
+                   { std::thread(amostrador, arq).detach(); });
+}
+#else
+void otxPerfilRegistra(const char *) {}
+#endif
