diff --git a/ps2xIOP/include/ps2x/iop/iso_real.h b/ps2xIOP/include/ps2x/iop/iso_real.h
new file mode 100644
index 0000000..e89bef2
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iso_real.h
@@ -0,0 +1,214 @@
+#pragma once
+// Otavix (30/10): leitura do sistema de arquivos ISO9660 da imagem do disco do jogador (PS2X_CD_IMAGE), com as duas
+// camadas dos DVD9 (God of War: PART1.PAK na camada 0, PART2.PAK na camada 1). A imagem é linear: a camada 1 começa
+// no setor (tamanho do volume da camada 0 - 16), onde fica um segundo descritor "CD001" no setor +16. Os LSN que
+// devolvemos são absolutos (como o sceCdLayerSearchFile do console), então o sceCdRead lê direto da imagem.
+// Usado pelos dois lados: stubs do libcdvd no EE (CD.cpp) e o CDVDMAN do IOP emulado (iop_cdvd.cpp).
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop
+{
+    class IsoReal
+    {
+    public:
+        struct Arquivo
+        {
+            uint32_t lsn = 0u; // absoluto na imagem
+            uint32_t tamanho = 0u;
+            bool pasta = false;
+        };
+
+        // A instância da imagem atual (abre na primeira chamada com um caminho novo).
+        static IsoReal &para(const std::filesystem::path &imagem)
+        {
+            static IsoReal unica;
+            std::lock_guard<std::mutex> trava(unica.m_trava);
+            if (unica.m_caminho != imagem)
+                unica.abre(imagem);
+            return unica;
+        }
+
+        bool valida() const { return m_valida; }
+        bool duasCamadas() const { return m_camada1 != 0u; }
+        uint32_t inicioCamada1() const { return m_camada1; }
+
+        // Procura "\PASTA\ARQ.EXT;1" (com ou sem cdrom0:, versão e maiúsculas) na camada pedida; camada < 0 = 0 e
+        // depois 1 (o sceCdSearchFile comum só enxerga a camada 0 no console, mas procurar nas duas não atrapalha).
+        bool procura(std::string caminho, int camada, Arquivo &saida)
+        {
+            std::lock_guard<std::mutex> trava(m_trava);
+            if (!m_valida)
+                return false;
+            const std::vector<std::string> partes = divide(caminho);
+            if (camada <= 0 && procuraEm(m_raiz[0], 0u, partes, saida))
+                return true;
+            if (camada != 0 && m_camada1 != 0u && procuraEm(m_raiz[1], m_camada1, partes, saida))
+                return true;
+            return false;
+        }
+
+        // Lê setores de 2048 bytes (LSN absoluto) da imagem; o que passar do fim vem zerado e devolve false.
+        bool le(uint32_t lsn, uint32_t setores, uint8_t *destino)
+        {
+            std::lock_guard<std::mutex> trava(m_trava);
+            const size_t bytes = static_cast<size_t>(setores) * kSetor;
+            std::memset(destino, 0, bytes);
+            if (!m_valida)
+                return false;
+            m_arq.clear();
+            m_arq.seekg(static_cast<std::streamoff>(static_cast<uint64_t>(lsn) * kSetor), std::ios::beg);
+            m_arq.read(reinterpret_cast<char *>(destino), static_cast<std::streamsize>(bytes));
+            return m_arq.gcount() == static_cast<std::streamsize>(bytes);
+        }
+
+    private:
+        static constexpr uint32_t kSetor = 2048u;
+
+        std::mutex m_trava;
+        std::filesystem::path m_caminho;
+        std::ifstream m_arq;
+        bool m_valida = false;
+        uint32_t m_camada1 = 0u;
+        Arquivo m_raiz[2]{};
+
+        static uint32_t le32(const uint8_t *p)
+        {
+            return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8u) |
+                   (static_cast<uint32_t>(p[2]) << 16u) | (static_cast<uint32_t>(p[3]) << 24u);
+        }
+
+        bool leSetores(uint64_t lsn, uint32_t bytes, std::vector<uint8_t> &saida)
+        {
+            saida.assign(bytes, 0u);
+            m_arq.clear();
+            m_arq.seekg(static_cast<std::streamoff>(lsn * kSetor), std::ios::beg);
+            m_arq.read(reinterpret_cast<char *>(saida.data()), static_cast<std::streamsize>(bytes));
+            return m_arq.gcount() == static_cast<std::streamsize>(bytes);
+        }
+
+        bool lePvd(uint64_t lsn, Arquivo &raiz, uint32_t &setoresVolume)
+        {
+            std::vector<uint8_t> d;
+            if (!leSetores(lsn, kSetor, d) || d[0] != 1u || std::memcmp(d.data() + 1, "CD001", 5) != 0)
+                return false;
+            setoresVolume = le32(d.data() + 80);
+            raiz.lsn = le32(d.data() + 156 + 2);
+            raiz.tamanho = le32(d.data() + 156 + 10);
+            raiz.pasta = true;
+            return true;
+        }
+
+        void abre(const std::filesystem::path &imagem)
+        {
+            m_caminho = imagem;
+            m_valida = false;
+            m_camada1 = 0u;
+            m_arq = std::ifstream(imagem, std::ios::binary);
+            if (!m_arq.is_open())
+                return;
+            uint32_t volume0 = 0u;
+            if (!lePvd(16u, m_raiz[0], volume0))
+                return;
+            m_valida = true;
+            std::error_code ec;
+            const uint64_t total = std::filesystem::file_size(imagem, ec) / kSetor;
+            uint32_t volume1 = 0u;
+            if (!ec && volume0 > 16u && static_cast<uint64_t>(volume0) + 1u < total &&
+                lePvd(volume0, m_raiz[1], volume1))
+                m_camada1 = volume0 - 16u;
+        }
+
+        static std::vector<std::string> divide(std::string caminho)
+        {
+            std::string baixo;
+            for (char c : caminho)
+                baixo.push_back(static_cast<char>(std::toupper(static_cast<unsigned char>(c == '/' ? '\\' : c))));
+            if (baixo.rfind("CDROM0:", 0) == 0)
+                baixo.erase(0, 7);
+            else if (baixo.rfind("CDROM:", 0) == 0)
+                baixo.erase(0, 6);
+            std::vector<std::string> partes;
+            std::string atual;
+            for (char c : baixo)
+            {
+                if (c == '\\')
+                {
+                    if (!atual.empty())
+                        partes.push_back(atual);
+                    atual.clear();
+                }
+                else
+                    atual.push_back(c);
+            }
+            if (!atual.empty())
+                partes.push_back(atual);
+            for (std::string &p : partes)
+            {
+                if (const size_t v = p.find(';'); v != std::string::npos)
+                    p.resize(v);
+                while (!p.empty() && (p.back() == ' ' || p.back() == '.'))
+                    p.pop_back();
+            }
+            return partes;
+        }
+
+        bool procuraEm(Arquivo pasta, uint32_t base, const std::vector<std::string> &partes, Arquivo &saida)
+        {
+            if (partes.empty())
+                return false;
+            for (size_t i = 0; i < partes.size(); ++i)
+            {
+                std::vector<uint8_t> d;
+                if (!pasta.pasta || pasta.tamanho == 0u || pasta.tamanho > (16u << 20u) ||
+                    !leSetores(static_cast<uint64_t>(base) + pasta.lsn, pasta.tamanho, d))
+                    return false;
+                bool achou = false;
+                for (size_t o = 0; o < d.size();)
+                {
+                    const uint8_t len = d[o];
+                    if (len == 0u)
+                    {
+                        o = (o / kSetor + 1u) * kSetor; // registros não cruzam setor
+                        continue;
+                    }
+                    if (o + len > d.size() || len < 34u)
+                        break;
+                    const uint8_t nlen = d[o + 32];
+                    std::string nome(reinterpret_cast<const char *>(d.data() + o + 33), std::min<size_t>(nlen, len - 33u));
+                    if (const size_t v = nome.find(';'); v != std::string::npos)
+                        nome.resize(v);
+                    while (!nome.empty() && nome.back() == '.')
+                        nome.pop_back();
+                    for (char &c : nome)
+                        c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+                    if (nlen > 1u || (d[o + 33] != 0u && d[o + 33] != 1u))
+                    {
+                        if (nome == partes[i])
+                        {
+                            pasta.lsn = le32(d.data() + o + 2);
+                            pasta.tamanho = le32(d.data() + o + 10);
+                            pasta.pasta = (d[o + 25] & 2u) != 0u;
+                            achou = true;
+                            break;
+                        }
+                    }
+                    o += len;
+                }
+                if (!achou)
+                    return false;
+            }
+            saida = pasta;
+            saida.lsn += base;
+            return true;
+        }
+    };
+}
diff --git a/ps2xIOP/src/emulator/core/iop_cpu.cpp b/ps2xIOP/src/emulator/core/iop_cpu.cpp
index e09642e..ae59679 100644
