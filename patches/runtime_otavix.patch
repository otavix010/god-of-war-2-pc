+    // binning em tiles de 16x16 (grade de 128x128 tiles = 2048x2048 pixels)
+    void GsGpu::agrupa(Cmd &c, std::vector<uint32_t> &cont, std::vector<uint32_t> &inicio, std::vector<uint32_t> &usados)
+    {
+        constexpr uint32_t kGrade = 128u;
+        if (cont.size() != kGrade * kGrade)
+        {
+            cont.assign(kGrade * kGrade, 0u);
+            inicio.assign(kGrade * kGrade, 0u);
+        }
+        for (uint32_t t : usados)
+            cont[t] = 0u;
+        usados.clear();
+        size_t total = 0;
+        for (const Prim &p : c.prims)
+        {
+            const int tx0 = std::max(0, p.minX) >> 4, tx1 = std::min(2047, p.maxX) >> 4;
+            const int ty0 = std::max(0, p.minY) >> 4, ty1 = std::min(2047, p.maxY) >> 4;
+            for (int ty = ty0; ty <= ty1; ++ty)
+                for (int tx = tx0; tx <= tx1; ++tx)
+                {
+                    uint32_t &n = cont[static_cast<uint32_t>(ty) * kGrade + static_cast<uint32_t>(tx)];
+                    if (n++ == 0u)
+                        usados.push_back(static_cast<uint32_t>(ty) * kGrade + static_cast<uint32_t>(tx));
+                }
+            total += static_cast<size_t>(tx1 - tx0 + 1) * static_cast<size_t>(ty1 - ty0 + 1);
+        }
+        c.tiles.resize(usados.size() * 4u);
+        {
+            uint32_t o = 0;
+            for (size_t i = 0; i < usados.size(); ++i)
+            {
+                const uint32_t t = usados[i];
+                inicio[t] = o;
+                c.tiles[i * 4u + 0u] = t % kGrade;
+                c.tiles[i * 4u + 1u] = t / kGrade;
+                c.tiles[i * 4u + 2u] = o;
+                c.tiles[i * 4u + 3u] = cont[t];
+                o += cont[t];
+            }
+        }
+        c.lista.resize(total);
+        for (uint32_t i = 0; i < c.prims.size(); ++i)
+        {
+            const Prim &p = c.prims[i];
+            const int tx0 = std::max(0, p.minX) >> 4, tx1 = std::min(2047, p.maxX) >> 4;
+            const int ty0 = std::max(0, p.minY) >> 4, ty1 = std::min(2047, p.maxY) >> 4;
+            for (int ty = ty0; ty <= ty1; ++ty)
+                for (int tx = tx0; tx <= tx1; ++tx)
+                    c.lista[inicio[static_cast<uint32_t>(ty) * kGrade + static_cast<uint32_t>(tx)]++] = i;
+        }
+        c.caixas.resize(c.prims.size() * 4u);
+        for (size_t i = 0; i < c.prims.size(); ++i)
+        {
+            c.caixas[i * 4u + 0u] = c.prims[i].minX;
+            c.caixas[i * 4u + 1u] = c.prims[i].minY;
+            c.caixas[i * 4u + 2u] = c.prims[i].maxX;
+            c.caixas[i * 4u + 3u] = c.prims[i].maxY;
+        }
+        c.agrupar = false;
+    }
+
+    void GsGpu::descarregaPor(const char *por)
+    {
+        if (m_prims.empty())
+            return;
+        const OtxCrono otxCr(m_msDescarrega);
+        const std::string otxDurante = m_cfDurante;
+        m_cfDurante.clear();
+        const size_t otxNPrims = m_prims.size();
+        ++motivo(por).lotes;
+        if (antesDeSubir)
+            antesDeSubir();
+        Cmd c;
+        {
+            std::lock_guard<std::mutex> lk(m_reciclaMtx);
+            if (!m_recicla.empty())
+            {
+                // Otavix (01/11): o de maior capacidade (o vetor vai ser o do próximo lote; no GoW 1 lotes de 1 primitiva se
+                // alternam com lotes de 26 mil e o último devolvido costuma ser pequeno: realocava ~13% da thread desenho)
+                size_t k = m_recicla.size() - 1u;
+                for (size_t i = 0; i + 1u < m_recicla.size(); ++i)
+                    if (m_recicla[i].prims.capacity() > m_recicla[k].prims.capacity())
+                        k = i;
+                Cmd &r = m_recicla[k];
+                c.prims.swap(r.prims); c.ests.swap(r.ests); c.tiles.swap(r.tiles); c.lista.swap(r.lista); c.luts.swap(r.luts);
+                c.caixas.swap(r.caixas); c.sobe.swap(r.sobe); c.sobePag.swap(r.sobePag);
+                if (k + 1u != m_recicla.size())
+                    std::swap(m_recicla[k], m_recicla.back());
+                m_recicla.pop_back();
+            }
+        }
+        c.tipo = 0;
+        c.copia = m_loteCopia;
+        static const bool otxCopiaTudo = [] { const char *e = std::getenv("PS2X_GS_GPU_COPIA_TUDO"); return e && e[0] == '1'; }();
+        c.copiaA = otxCopiaTudo ? 0u : m_copiaA;
+        c.copiaB = otxCopiaTudo ? kPaginas : m_copiaB;
+        m_loteCopia = false;
+        const bool otxCopia = c.copia;
+        GSPrimitiveBatch otxPrim0{};
+        if (confere() && !m_cfLote.empty())
+            otxPrim0 = m_cfLote.front();
+        // páginas que a CPU mudou: sobem antes do desenho
+        std::vector<uint32_t> sobe;
+        for (uint32_t p = 0; p < kPaginas; ++p)
+            if (m_estado[p] == 1u)
+            {
+                sobe.push_back(p);
+                m_estado[p] = 0u;
+            }
+        c.sobePag = corridas(sobe);
+        c.sobe.resize(sobe.size() * kPagBytes);
+        {
+            size_t o = 0;
+            for (const auto &r : c.sobePag)
+            {
+                std::memcpy(c.sobe.data() + o, m_vram + static_cast<size_t>(r.first) * kPagBytes, static_cast<size_t>(r.second) * kPagBytes);
+                o += static_cast<size_t>(r.second) * kPagBytes;
+            }
+        }
+        m_nPagSobe += sobe.size();
+        c.prims.swap(m_prims);
+        c.ests.swap(m_ests);
+        m_ests.clear();
+        c.agrupar = agrupaNaGpu();
+        if (!c.agrupar)
+            agrupa(c, m_cont, m_inicio, m_tilesUsados);
+        c.luts.swap(m_luts);
+        if (c.luts.empty())
+            c.luts.assign(256u, 0u);
+        m_prims.clear();
+        // Otavix (31/10): o próximo lote cresce sem realocar e copiar várias vezes; (01/11) com folga e piso, porque os
+        // lotes variam e um vetor justo realocava (as primitivas têm ~300 bytes)
+        static const bool otxReservaFolga = [] { const char *e = std::getenv("PS2X_GS_GPU_RESERVA"); return !(e && e[0] == '0'); }();
+        // (01/11) pelo pico recente (cai 1/64 por lote), não pelo lote anterior
+        m_picoPrims = std::max(c.prims.size(), m_picoPrims - m_picoPrims / 64u);
+        m_prims.reserve(otxReservaFolga ? std::min<size_t>(65536u, std::max<size_t>(4096u, m_picoPrims + m_picoPrims / 4u))
+                                        : c.prims.size());
+        m_luts.clear();
+        m_ultLut = nullptr;
+        for (auto &v : m_ultF)
+            v = ~0u;
+        const std::bitset<kPaginas> escritas = m_escreve;
+        m_escreve.reset();
+        m_escreveBloco.reset();
+        m_marcaPend.clear();
+        m_le.reset();
+        ++m_nLotes;
+        poe(std::move(c));
+        if (confere())
+        {
+            // a CPU desenha o mesmo lote em m_vram (que tem o estado de antes do lote, igual ao que subiu); depois
+            // desce o resultado da GPU numa cópia e compara página a página
+            if (desenhaCpu)
+                for (const GSPrimitiveBatch &b : m_cfLote)
+                    desenhaCpu(b);
+            m_cfLote.clear();
+            static std::vector<uint8_t> gpu(kPaginas * kPagBytes);
+            std::vector<uint32_t> pags;
+            for (uint32_t p = 0; p < kPaginas; ++p)
+                if (escritas.test(p))
+                    pags.push_back(p);
+            desce(corridas(pags), gpu.data());
+            ++m_cfLotes;
+            size_t nd = 0, primeiro = 0;
+            for (uint32_t p : pags)
+            {
+                const size_t o = static_cast<size_t>(p) * kPagBytes;
+                if (std::memcmp(gpu.data() + o, m_vram + o, kPagBytes) == 0)
+                    continue;
+                for (size_t k = 0; k < kPagBytes; ++k)
+                    if (gpu[o + k] != m_vram[o + k] && nd++ == 0)
+                        primeiro = o + k;
+            }
+            if (nd)
+            {
+                ++m_cfDif;
+                m_cfBytes += nd;
+                if (m_cfDif <= 30)
+                {
+                    const auto &st = otxPrim0.state;
+                    std::printf("[gs-gpu-confere] lote %llu: %zu bytes diferentes, 1o em 0x%zx (pag %zu) cpu=%02x gpu=%02x | copia=%u "
+                                "prim0: tipo=%u tme=%u abe=%u alpha=0x%llx tpsm=0x%x tbp0=0x%x fst=%u lin=%u fbp=%u texW=%u tfx=%u tcc=%u clamp=0x%llx\n",
+                                static_cast<unsigned long long>(m_cfLotes), nd, primeiro, primeiro / kPagBytes, m_vram[primeiro], gpu[primeiro],
+                                otxCopia ? 1u : 0u, static_cast<unsigned>(st.prim.type), static_cast<unsigned>(st.prim.tme),
+                                static_cast<unsigned>(st.prim.abe), static_cast<unsigned long long>(st.context.alpha), st.context.tex0.psm,
+                                st.context.tex0.tbp0, static_cast<unsigned>(st.prim.fst), static_cast<unsigned>(st.linearFilter),
+                                st.context.frame.fbp, st.textureWidth, st.context.tex0.tfx, st.context.tex0.tcc,
+                                static_cast<unsigned long long>(st.context.clamp));
+                    std::printf("[gs-gpu-confere]   por=%s prims=%zu fpsm=0x%x fbw=%u zbp=%u zpsm=0x%x zmsk=%u test=0x%llx durante:%s\n", por,
+                                otxNPrims, st.context.frame.psm, st.context.frame.fbw, st.context.zbuf.zbp, st.context.zbuf.psm,
+                                static_cast<unsigned>(st.context.zbuf.zmask), static_cast<unsigned long long>(st.context.test),
+                                otxDurante.c_str());
+                }
+            }
+            // a GPU recebe o resultado da CPU (as diferenças não se acumulam)
+            Cmd up;
+            up.sobePag = corridas(pags);
+            up.sobe.resize(pags.size() * kPagBytes);
+            size_t o = 0;
+            for (const auto &rr : up.sobePag)
+            {
+                std::memcpy(up.sobe.data() + o, m_vram + static_cast<size_t>(rr.first) * kPagBytes, static_cast<size_t>(rr.second) * kPagBytes);
+                o += static_cast<size_t>(rr.second) * kPagBytes;
+            }
+            poe(std::move(up));
+            for (uint32_t p : pags)
+                m_estado[p] = 0u;
+        }
+        else
+        {
+            for (uint32_t p = 0; p < kPaginas; ++p)
+                if (escritas.test(p))
+                {
+                    m_estado[p] = 2u;
+                    if (!m_validos.empty())
+                        m_validos.erase(p); // o desenho pode ter mudado os bits que a CPU tinha
+                }
+        }
+        estatistica();
+    }
+
+    void GsGpu::paraCpu(uint32_t a, uint32_t b, bool escreve, const char *por)
+    {
+        if (!m_prims.empty() && (tocaFaixa(m_escreve, a, b) || (escreve && tocaFaixa(m_le, a, b))))
+            descarregaPor(por);
+        else if (confere() && !m_prims.empty() && m_cfDurante.size() < 400)
+        {
+            char t[64];
+            std::snprintf(t, sizeof t, " %s%s[%u,%u)@%zu", por, escreve ? "!" : "", a, b, m_prims.size());
+            m_cfDurante += t;
+        }
+        std::vector<uint32_t> pags;
+        const uint32_t n = std::min(b - a, kPaginas);
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            const uint32_t p = (a + i) & (kPaginas - 1u);
+            if (m_estado[p] >= 2u)
+            {
+                pags.push_back(p);
+                m_estado[p] = 0u;
+                m_validos.erase(p);
+            }
+        }
+        std::sort(pags.begin(), pags.end());
+        if (!pags.empty())
+        {
+            Motivo &m = motivo(por);
+            ++m.descidas;
+            m.pags += pags.size();
+            // Otavix (31/10): PS2X_GS_GPU_LOG_DESC=<n> mostra as n primeiras descidas síncronas (o GS espera a GPU toda)
+            static int otxLogDesc = [] { const char *e = std::getenv("PS2X_GS_GPU_LOG_DESC"); return e ? std::atoi(e) : 0; }();
+            if (otxLogDesc > 0)
+            {
+                --otxLogDesc;
+                std::printf("[gs-gpu-desc] por=%s faixa=[%u,%u) pags=%zu (1a %u) lote=%zu fb atual: fbp=%u fbw=%u psm=0x%x zbp=%u\n", por, a, b,
+                            pags.size(), pags.front(), m_prims.size(), m_chaveFb[0], m_chaveFb[1], m_chaveFb[2], m_chaveFb[3]);
+            }
+        }
+        if (!pags.empty())
+            otxLinhaTempo("desce", static_cast<uint32_t>(pags.size()));
+        desce(corridas(pags), m_vram);
+        if (!pags.empty())
+            otxLinhaTempo("desce-fim", 0u);
+    }
+
+    // Otavix (31/10): PS2X_GS_GPU_MESCLA=0 volta a descer a página inteira antes de cada escrita/leitura da CPU
+    static bool otxMesclaLigada()
+    {
+        static const bool v = [] { const char *e = std::getenv("PS2X_GS_GPU_MESCLA"); return !(e && e[0] == '0'); }();
+        return v;
+    }
+
+    bool GsGpu::escreveMesclado(uint32_t a, uint32_t b, const std::function<void()> &grava)
+    {
+        if (confere() || !otxMesclaLigada())
+            return false;
+        const uint32_t n = std::min(b - a, kPaginas);
+        auto maisNovasNaGpu = [&] {
+            std::vector<uint32_t> v;
+            for (uint32_t i = 0; i < n; ++i)
+                if (m_estado[(a + i) & (kPaginas - 1u)] >= 2u)
+                    v.push_back((a + i) & (kPaginas - 1u));
+            return v;
+        };
+        std::vector<uint32_t> gp = maisNovasNaGpu();
+        if (gp.empty())
+            return false;
+        if (!m_prims.empty() && (tocaFaixa(m_escreve, a, b) || tocaFaixa(m_le, a, b)))
+        {
+            descarregaPor("upload-mescla");
+            gp = maisNovasNaGpu();
+            if (gp.empty())
+                return false;
+        }
+        // roda a escrita duas vezes: com as páginas zeradas e com elas todas em 1; o bit escrito sai igual nas duas
+        const size_t k = kPagBytes;
+        std::vector<uint8_t> antigo(gp.size() * k), zero(gp.size() * k);
+        for (size_t i = 0; i < gp.size(); ++i)
+        {
+            std::memcpy(antigo.data() + i * k, m_vram + static_cast<size_t>(gp[i]) * k, k);
+            std::memset(m_vram + static_cast<size_t>(gp[i]) * k, 0x00, k);
+        }
+        grava();
+        for (size_t i = 0; i < gp.size(); ++i)
+        {
+            std::memcpy(zero.data() + i * k, m_vram + static_cast<size_t>(gp[i]) * k, k);
+            std::memset(m_vram + static_cast<size_t>(gp[i]) * k, 0xFF, k);
+        }
+        grava();
+        Cmd c;
+        c.tipo = 2;
+        c.mesclaPag = gp;
+        c.mescla.resize(gp.size() * 4096u);
+        constexpr uint32_t kPal = kPagBytes / 4u;
+        for (size_t i = 0; i < gp.size(); ++i)
+        {
+            uint32_t *v = reinterpret_cast<uint32_t *>(m_vram + static_cast<size_t>(gp[i]) * k);
+            const uint32_t *z = reinterpret_cast<const uint32_t *>(zero.data() + i * k);
+            const uint32_t *o = reinterpret_cast<const uint32_t *>(antigo.data() + i * k);
+            std::vector<uint32_t> &val = m_validos[gp[i]];
+            if (m_estado[gp[i]] != 3u || val.size() != kPal)
+                val.assign(kPal, 0u);
+            uint32_t *d = c.mescla.data() + i * 4096u;
+            for (uint32_t w = 0; w < kPal; ++w)
+            {
+                const uint32_t m = ~(z[w] ^ v[w]);
+                d[w] = z[w] & m;
+                d[kPal + w] = m;
+                v[w] = (o[w] & ~m) | (z[w] & m);
+                val[w] |= m;
+            }
+            m_estado[gp[i]] = 3u;
+        }
+        // as outras páginas do intervalo (em dia ou mais novas na CPU) foram escritas normalmente
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            const uint32_t p = (a + i) & (kPaginas - 1u);
+            if (m_estado[p] < 2u)
+                m_estado[p] = 1u;
+        }
+        ++m_nMesclas;
+        poe(std::move(c));
+        return true;
+    }
+
+    bool GsGpu::leSemDescer(uint32_t a, uint32_t b, const std::function<uint64_t()> &le)
+    {
+        if (confere() || !otxMesclaLigada())
+            return false;
+        if (!m_prims.empty() && tocaFaixa(m_escreve, a, b))
+            descarregaPor("le-mescla");
+        const uint32_t n = std::min(b - a, kPaginas);
+        std::vector<uint32_t> gp;
+        for (uint32_t i = 0; i < n; ++i)
+            if (m_estado[(a + i) & (kPaginas - 1u)] >= 2u)
+                gp.push_back((a + i) & (kPaginas - 1u));
+        if (gp.empty())
+            return false;
+        // a leitura roda com os bits que a CPU não tem em 0 e depois em 1: se o resultado for igual, não dependeu deles
+        const size_t k = kPagBytes;
+        constexpr uint32_t kPal = kPagBytes / 4u;
+        std::vector<uint8_t> antigo(gp.size() * k);
+        for (size_t i = 0; i < gp.size(); ++i)
+            std::memcpy(antigo.data() + i * k, m_vram + static_cast<size_t>(gp[i]) * k, k);
+        auto preenche = [&](bool um) {
+            for (size_t i = 0; i < gp.size(); ++i)
+            {
+                uint32_t *v = reinterpret_cast<uint32_t *>(m_vram + static_cast<size_t>(gp[i]) * k);
+                const uint32_t *o = reinterpret_cast<const uint32_t *>(antigo.data() + i * k);
+                const auto it = m_estado[gp[i]] == 3u ? m_validos.find(gp[i]) : m_validos.end();
+                for (uint32_t w = 0; w < kPal; ++w)
+                {
+                    const uint32_t m = it != m_validos.end() ? it->second[w] : 0u;
+                    v[w] = um ? (o[w] | ~m) : (o[w] & m);
+                }
+            }
+        };
+        preenche(false);
+        const uint64_t h0 = le();
+        preenche(true);
+        const uint64_t h1 = le();
+        for (size_t i = 0; i < gp.size(); ++i)
+            std::memcpy(m_vram + static_cast<size_t>(gp[i]) * k, antigo.data() + i * k, k);
+        if (h0 != h1)
+            return false;
+        ++m_nLeSemDescer;
+        return true;
+    }
+
+    void GsGpu::estatistica()
+    {
+        const double t = agoraMs();
+        if (m_tEst == 0.0)
+            m_tEst = t;
+        if (t - m_tEst < 2000.0)
+            return;
+        std::printf("[gs-gpu] prims=%llu lotes=%llu descidas=%llu (pags %llu, espera %.1f ms) subidas=%llu pags",
+                    static_cast<unsigned long long>(m_nGpu), static_cast<unsigned long long>(m_nLotes),
+                    static_cast<unsigned long long>(m_nDescidas), static_cast<unsigned long long>(m_nPagDesce), m_msEspera,
+                    static_cast<unsigned long long>(m_nPagSobe));
+        std::printf(" | gs: adiciona=%.0f ms descarrega=%.0f ms | mesclas=%llu le_sem_descer=%llu", m_msAdiciona, m_msDescarrega,
+                    static_cast<unsigned long long>(m_nMesclas), static_cast<unsigned long long>(m_nLeSemDescer));
+        m_nMesclas = m_nLeSemDescer = 0;
+        m_msAdiciona = m_msDescarrega = 0.0;
+        if (confere())
+            std::printf(" | confere: lotes=%llu diferentes=%llu bytes=%llu", static_cast<unsigned long long>(m_cfLotes),
+                        static_cast<unsigned long long>(m_cfDif), static_cast<unsigned long long>(m_cfBytes));
+        std::printf("\n[gs-gpu-motivos]");
+        for (auto &m : m_motivos)
+        {
+            if (m.lotes || m.descidas)
+                std::printf(" %s:lotes=%llu,desc=%llu,pags=%llu", m.nome, static_cast<unsigned long long>(m.lotes),
+                            static_cast<unsigned long long>(m.descidas), static_cast<unsigned long long>(m.pags));
+            m.lotes = m.descidas = m.pags = 0;
+        }
+        std::printf("\n");
+        std::fflush(stdout);
+        std::printf("[gs-gpu-tempo]");
+        static const char *kNomes[4] = {"desenho+copia", "desenho", "desce", "mescla"};
+        for (int i = 0; i < 4; ++i)
+            std::printf(" %s:%llu=%.0fms(gpu %.0fms)", kNomes[i], static_cast<unsigned long long>(g_otxGpuN[i].exchange(0u)),
+                        static_cast<double>(g_otxGpuNs[i].exchange(0u)) / 1e6, static_cast<double>(g_otxGpuGpuNs[i].exchange(0u)) / 1e6);
+        std::printf("\n");
+        {
+            std::lock_guard<std::mutex> lk(g_otxCarosMtx);
+            if (!g_otxCaros.empty())
+            {
+                std::printf("[gs-gpu-caros]");
+                for (const OtxCaro &c : g_otxCaros)
+                    std::printf(" %.2fms(t%u p%u c%u k%d)", c.ns / 1e6, c.tiles, c.prims, c.copia, c.k);
+                static const char *kF[5] = {"<=4", "<=32", "<=256", "<=2048", ">2048"};
+                std::printf(" | por tiles:");
+                for (int i = 0; i < 5; ++i)
+                    std::printf(" %s:%llu=%.0fms", kF[i], g_otxFaixaN[i], g_otxFaixaNs[i] / 1e6);
+                std::printf("\n");
+                g_otxCaros.clear();
+                for (int i = 0; i < 5; ++i)
+                    g_otxFaixaNs[i] = g_otxFaixaN[i] = 0;
+            }
+        }
+        std::fflush(stdout);
+        m_nGpu = m_nLotes = m_nDescidas = m_nPagDesce = m_nPagSobe = 0;
+        m_msEspera = 0.0;
+        m_tEst = t;
+    }
+}
