+// Otavix (patch_vu1_dump): coleta dos microprogramas do VU1 (PS2X_VU1_DUMP=<pasta>)
+#include <map>
+#include <string>
+#include <unordered_set>
+static const uint8_t *g_otxColetaCodigo = nullptr;
+static uint32_t g_otxColetaTam = 0;
+static const PS2Memory *g_otxColetaMem = nullptr;
+static void otxVu1Coleta(const uint8_t *vuCode, uint32_t codeSize, const PS2Memory *memory, uint32_t startPC)
+{
+    static const char *pasta = std::getenv("PS2X_VU1_DUMP");
+    if (!pasta || !vuCode || !memory)
+        return;
+    static uint64_t geracao = ~0ull, hash = 0;
+    static std::unordered_set<uint64_t> vistos;
+    static std::map<std::pair<uint64_t, uint32_t>, uint64_t> inicios;
+    static uint64_t execucoes = 0;
+    g_otxColetaCodigo = vuCode;
+    g_otxColetaTam = codeSize;
+    g_otxColetaMem = memory;
+    const uint64_t g = memory->getVU1CodeGeneration();
+    if (g != geracao)
+    {
+        geracao = g;
+        uint64_t h = 1469598103934665603ull;
+        for (uint32_t i = 0; i < codeSize; ++i)
+        {
+            h ^= vuCode[i];
+            h *= 1099511628211ull;
+        }
+        hash = h;
+        if (vistos.insert(h).second)
+        {
+            char nome[64];
+            std::snprintf(nome, sizeof(nome), "\\vu1_%016llx.bin", static_cast<unsigned long long>(h));
+            if (FILE *f = std::fopen((std::string(pasta) + nome).c_str(), "wb"))
+            {
+                std::fwrite(vuCode, 1, codeSize, f);
+                std::fclose(f);
+            }
+        }
+    }
+    auto &n = inicios[{hash, startPC}];
+    if (n++ == 0)
+    {
+        if (FILE *f = std::fopen((std::string(pasta) + "\\inicios.txt").c_str(), "a"))
+        {
+            std::fprintf(f, "%016llx %04x\n", static_cast<unsigned long long>(hash), startPC);
+            std::fclose(f);
+        }
+    }
+    if ((++execucoes & 4095u) == 0u)
+    {
+        if (FILE *f = std::fopen((std::string(pasta) + "\\contagem.txt").c_str(), "w"))
+        {
+            for (const auto &[chave, cont] : inicios)
+                std::fprintf(f, "%016llx %04x %llu\n", static_cast<unsigned long long>(chave.first), chave.second,
+                             static_cast<unsigned long long>(cont));
+            std::fclose(f);
+        }
+    }
+}
