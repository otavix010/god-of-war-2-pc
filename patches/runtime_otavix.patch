+// Otavix (31/10): fromSPR em cadeia de destino / toSPR em cadeia de origem (ver patch_spr_cadeia.py)
+bool PS2Memory::otxSprCadeia(uint32_t channelBase, uint32_t chcr)
+{
+    static constexpr uint32_t kSprFromChannel = 0x1000D000u;
+    const bool fromScratchpad = channelBase == kSprFromChannel;
+    const bool tie = (chcr & 0x80u) != 0u;
+    uint32_t sadr = m_ioRegisters[channelBase + 0x80u] & 0x3FF0u;
+    uint32_t madr = m_ioRegisters[channelBase + 0x10u] & 0x7FFFFFF0u;
+    uint32_t tadr = m_ioRegisters[channelBase + 0x30u] & 0x7FFFFFF0u;
+    uint32_t ultimaTag = (chcr >> 16u) & 0xFFFFu;
+    // copia qwc quadwords entre a RAM (endereço do EE) e o scratchpad (sadr, com volta em 16 KB)
+    auto copia = [&](uint32_t ram, uint32_t qwc) -> bool
+    {
+        for (uint32_t k = 0; k < qwc; ++k)
+        {
+            uint32_t fis = 0u;
+            try
+            {
+                fis = translateAddress(ram + k * 16u);
+            }
+            catch (...)
+            {
+                return false;
+            }
+            if (isScratchpad(ram + k * 16u) || fis + 16u > PS2_RAM_SIZE)
+                return false;
+            if (fromScratchpad)
+            {
+                std::memcpy(m_rdram + fis, m_scratchpad + sadr, 16u);
+                markModified(fis, 16u);
+            }
+            else
+                std::memcpy(m_scratchpad + sadr, m_rdram + fis, 16u);
+            sadr = (sadr + 16u) & 0x3FF0u;
+        }
+        return true;
+    };
+    static int otxLogs = 0;
+    int n = 0;
+    for (; n < 4096; ++n)
+    {
+        uint64_t tag = 0;
+        if (fromScratchpad)
+        {
+            std::memcpy(&tag, m_scratchpad + sadr, 8u);
+            sadr = (sadr + 16u) & 0x3FF0u;
+        }
+        else
+        {
+            uint32_t fis = 0u;
+            try
+            {
+                fis = translateAddress(tadr);
+            }
+            catch (...)
+            {
+                break;
+            }
+            if (fis + 16u > PS2_RAM_SIZE)
+                break;
+            std::memcpy(&tag, m_rdram + fis, 8u);
+        }
+        const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28) & 0x7u);
+        const bool irq = ((tag >> 31) & 1ull) != 0ull;
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0x7FFFFFF0u);
+        ultimaTag = static_cast<uint32_t>((tag >> 16) & 0xFFFFu);
+        bool fim = false;
+        if (fromScratchpad)
+        {
+            // cadeia de destino: CNTS (0) / CNT (1) seguem, END (7) termina; dados logo depois da tag
+            madr = addr;
+            if (!copia(madr, qwc))
+                break;
+            madr += qwc * 16u;
+            fim = id == 7u;
+        }
+        else
+        {
+            switch (id)
+            {
+            case 0u: // REFE
+                madr = addr;
+                copia(madr, qwc);
+                tadr += 16u;
+                fim = true;
+                break;
+            case 1u: // CNT
+                copia(tadr + 16u, qwc);
+                tadr = tadr + 16u + qwc * 16u;
+                break;
+            case 2u: // NEXT
+                copia(tadr + 16u, qwc);
+                tadr = addr;
+                break;
+            case 3u: // REF
+            case 4u: // REFS
+                copia(addr, qwc);
+                tadr += 16u;
+                break;
+            default: // END (e CALL/RET, raros para o toSPR)
+                copia(tadr + 16u, qwc);
+                fim = true;
+                break;
+            }
+        }
+        if (otxLogs < 8)
+        {
+            ++otxLogs;
+            std::cerr << "[spr:cadeia] " << (fromScratchpad ? "fromSPR" : "toSPR") << " id=" << id << " qwc=" << qwc
+                      << " addr=0x" << std::hex << addr << std::dec << std::endl;
+        }
+        if (fim || (irq && tie))
+            break;
+    }
+    m_ioRegisters[channelBase + 0x10u] = madr;
+    m_ioRegisters[channelBase + 0x20u] = 0u;
+    m_ioRegisters[channelBase + 0x30u] = tadr;
+    m_ioRegisters[channelBase + 0x80u] = sadr;
+    m_ioRegisters[channelBase] = (chcr & 0xFFFFu) | (ultimaTag << 16u);
+    completeDmacChannel(channelBase, fromScratchpad ? 8u : 9u);
+    return true;
+}
