+    {
+        deleteSemaphoreImpl(rdram, ctx, runtime, true);
+    }
+
+    void SignalSema(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (otxLogSema(static_cast<int>(getRegU32(ctx, 4))))
+            std::fprintf(stderr, "[sema] sinal id=%d pc=0x%x ra=0x%x thread=%d\n", static_cast<int>(getRegU32(ctx, 4)), ctx->pc, getRegU32(ctx, 31), runtime->eeScheduler().currentThreadId());
+        signalSemaphoreImpl(rdram, ctx, runtime, false);
+    }
+
+    void iSignalSema(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (otxLogSema(static_cast<int>(getRegU32(ctx, 4))))
+            std::fprintf(stderr, "[sema] isinal id=%d ra=0x%x\n", static_cast<int>(getRegU32(ctx, 4)), getRegU32(ctx, 31));
+        signalSemaphoreImpl(rdram, ctx, runtime, true);
+    }
