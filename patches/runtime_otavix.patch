+                tg = _mm256_and_si256(_mm256_srli_epi32(c, 8), _mm256_set1_epi32(0xFF));
+                tb = _mm256_and_si256(_mm256_srli_epi32(c, 16), _mm256_set1_epi32(0xFF));
