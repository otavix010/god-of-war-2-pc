+
+// Otavix (30/10): MMI de HI/LO como o R5900. HI = {hi, hi1}, LO = {lo, lo1}.
+inline __m128i ps2_mmi_lo(const R5900Context *c) { return _mm_set_epi64x(static_cast<int64_t>(c->lo1), static_cast<int64_t>(c->lo)); }
+inline __m128i ps2_mmi_hi(const R5900Context *c) { return _mm_set_epi64x(static_cast<int64_t>(c->hi1), static_cast<int64_t>(c->hi)); }
+inline void ps2_mmi_poe_lo(R5900Context *c, __m128i v)
+{
+    c->lo = static_cast<uint64_t>(_mm_cvtsi128_si64(v));
+    c->lo1 = static_cast<uint64_t>(_mm_extract_epi64(v, 1));
+}
+inline void ps2_mmi_poe_hi(R5900Context *c, __m128i v)
+{
+    c->hi = static_cast<uint64_t>(_mm_cvtsi128_si64(v));
+    c->hi1 = static_cast<uint64_t>(_mm_extract_epi64(v, 1));
+}
+inline void ps2_mmi_poe_rd(R5900Context *c, int rd, __m128i v)
+{
+    if (rd != 0)
+        c->r[rd] = v;
+}
+// PMULTH/PMADDH/PMSUBH: produtos p_i = rs.h[i]*rt.h[i]; LO.w = {p0,p1,p4,p5}, HI.w = {p2,p3,p6,p7}; rd = {LO.w0,HI.w0,LO.w2,HI.w2}
+inline void ps2_mmi_pmulth(R5900Context *c, int rd, __m128i rs, __m128i rt, int modo) // modo 0 mult, 1 madd, -1 msub
+{
+    const __m128i l = _mm_mullo_epi16(rs, rt), h = _mm_mulhi_epi16(rs, rt);
+    const __m128i p0 = _mm_unpacklo_epi16(l, h), p1 = _mm_unpackhi_epi16(l, h);
+    __m128i lo = _mm_unpacklo_epi64(p0, p1), hi = _mm_unpackhi_epi64(p0, p1);
+    if (modo > 0)
+    {
+        lo = _mm_add_epi32(ps2_mmi_lo(c), lo);
+        hi = _mm_add_epi32(ps2_mmi_hi(c), hi);
+    }
+    else if (modo < 0)
+    {
+        lo = _mm_sub_epi32(ps2_mmi_lo(c), lo);
+        hi = _mm_sub_epi32(ps2_mmi_hi(c), hi);
+    }
+    ps2_mmi_poe_lo(c, lo);
+    ps2_mmi_poe_hi(c, hi);
+    // rd = {lo.w0, hi.w0, lo.w2, hi.w2}
+    ps2_mmi_poe_rd(c, rd, _mm_unpacklo_epi32(_mm_shuffle_epi32(lo, _MM_SHUFFLE(3, 1, 2, 0)), _mm_shuffle_epi32(hi, _MM_SHUFFLE(3, 1, 2, 0))));
+}
+// PHMADH/PHMSBH: d_k = rs.h[2k+1]*rt.h[2k+1] +/- rs.h[2k]*rt.h[2k]; LO.w0=d0, HI.w0=d1, LO.w2=d2, HI.w2=d3; rd = {d0..d3}
+inline void ps2_mmi_phmadh(R5900Context *c, int rd, __m128i rs, __m128i rt, bool sub)
+{
+    alignas(16) int16_t a[8], b[8];
+    _mm_store_si128(reinterpret_cast<__m128i *>(a), rs);
+    _mm_store_si128(reinterpret_cast<__m128i *>(b), rt);
+    alignas(16) int32_t d[4];
+    for (int k = 0; k < 4; ++k)
+    {
+        const int32_t odd = static_cast<int32_t>(a[2 * k + 1]) * b[2 * k + 1], even = static_cast<int32_t>(a[2 * k]) * b[2 * k];
+        d[k] = sub ? odd - even : odd + even;
+    }
+    alignas(16) uint32_t lo[4], hi[4];
+    _mm_store_si128(reinterpret_cast<__m128i *>(lo), ps2_mmi_lo(c));
+    _mm_store_si128(reinterpret_cast<__m128i *>(hi), ps2_mmi_hi(c));
+    lo[0] = static_cast<uint32_t>(d[0]);
+    hi[0] = static_cast<uint32_t>(d[1]);
+    lo[2] = static_cast<uint32_t>(d[2]);
+    hi[2] = static_cast<uint32_t>(d[3]);
+    ps2_mmi_poe_lo(c, _mm_load_si128(reinterpret_cast<const __m128i *>(lo)));
+    ps2_mmi_poe_hi(c, _mm_load_si128(reinterpret_cast<const __m128i *>(hi)));
+    ps2_mmi_poe_rd(c, rd, _mm_load_si128(reinterpret_cast<const __m128i *>(d)));
+}
+inline uint64_t ps2_mmi_sx32(uint64_t v) { return static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(v))); }
+// PMULTW/PMULTUW/PMADDW/PMADDUW/PMSUBW: palavras 0 e 2, 32x32 -> 64; LO.d[i] = sx32(t), HI.d[i] = sx32(t >> 32), rd.d[i] = t
+inline void ps2_mmi_pmultw(R5900Context *c, int rd, __m128i rs, __m128i rt, bool semSinal, int modo)
+{
+    uint64_t res[2];
+    uint64_t *lo[2] = {&c->lo, &c->lo1}, *hi[2] = {&c->hi, &c->hi1};
+    for (int i = 0; i < 2; ++i)
+    {
+        const uint32_t a = static_cast<uint32_t>(i == 0 ? _mm_cvtsi128_si32(rs) : _mm_extract_epi32(rs, 2));
+        const uint32_t b = static_cast<uint32_t>(i == 0 ? _mm_cvtsi128_si32(rt) : _mm_extract_epi32(rt, 2));
+        uint64_t t = semSinal ? static_cast<uint64_t>(a) * b
+                              : static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(a)) * static_cast<int32_t>(b));
+        if (modo != 0)
+        {
+            const uint64_t acc = (static_cast<uint64_t>(static_cast<uint32_t>(*hi[i])) << 32) | static_cast<uint32_t>(*lo[i]);
+            t = modo > 0 ? acc + t : acc - t;
+        }
+        *lo[i] = ps2_mmi_sx32(t);
+        *hi[i] = ps2_mmi_sx32(t >> 32);
+        res[i] = t;
+    }
+    ps2_mmi_poe_rd(c, rd, _mm_set_epi64x(static_cast<int64_t>(res[1]), static_cast<int64_t>(res[0])));
+}
+// PDIVW/PDIVUW: palavras 0 e 2; LO.d[i] = sx32(quociente), HI.d[i] = sx32(resto); rd não muda
+inline void ps2_mmi_pdivw(R5900Context *c, __m128i rs, __m128i rt, bool semSinal)
+{
+    uint64_t *lo[2] = {&c->lo, &c->lo1}, *hi[2] = {&c->hi, &c->hi1};
+    for (int i = 0; i < 2; ++i)
+    {
+        const uint32_t a = static_cast<uint32_t>(i == 0 ? _mm_cvtsi128_si32(rs) : _mm_extract_epi32(rs, 2));
+        const uint32_t b = static_cast<uint32_t>(i == 0 ? _mm_cvtsi128_si32(rt) : _mm_extract_epi32(rt, 2));
+        uint32_t q, r;
+        if (semSinal)
+        {
+            if (b == 0u)
+            {
+                q = 0xFFFFFFFFu;
+                r = a;
+            }
+            else
+            {
+                q = a / b;
+                r = a % b;
+            }
+        }
+        else
+        {
+            const int32_t sa = static_cast<int32_t>(a), sb = static_cast<int32_t>(b);
+            if (sb == 0)
+            {
+                q = sa < 0 ? 1u : 0xFFFFFFFFu;
+                r = a;
+            }
+            else if (sa == INT32_MIN && sb == -1)
+            {
+                q = static_cast<uint32_t>(INT32_MIN);
+                r = 0u;
+            }
+            else
+            {
+                q = static_cast<uint32_t>(sa / sb);
+                r = static_cast<uint32_t>(sa % sb);
+            }
+        }
+        *lo[i] = ps2_mmi_sx32(q);
+        *hi[i] = ps2_mmi_sx32(r);
+    }
+}
+// PDIVBW: divisor = rt.h[0]; LO.w[n] = rs.w[n] / d, HI.w[n] = (s16)(rs.w[n] % d); rd não muda
+inline void ps2_mmi_pdivbw(R5900Context *c, __m128i rs, __m128i rt)
+{
+    alignas(16) int32_t a[4];
+    _mm_store_si128(reinterpret_cast<__m128i *>(a), rs);
+    const int32_t d = static_cast<int16_t>(_mm_extract_epi16(rt, 0));
+    alignas(16) int32_t q[4], r[4];
+    for (int n = 0; n < 4; ++n)
+    {
+        if (d == 0)
+        {
+            q[n] = a[n] < 0 ? 1 : -1;
+            r[n] = static_cast<int16_t>(a[n]);
+        }
+        else if (a[n] == INT32_MIN && d == -1)
+        {
+            q[n] = INT32_MIN;
+            r[n] = 0;
+        }
+        else
+        {
+            q[n] = a[n] / d;
+            r[n] = static_cast<int16_t>(a[n] % d);
+        }
