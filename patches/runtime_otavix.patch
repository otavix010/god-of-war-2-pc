+++ b/ps2xIOP/src/emulator/core/iop_cpu.cpp
@@ -56,6 +56,49 @@ namespace ps2x::iop::detail
     {
         const uint32_t pc = cpu.pc;
         const uint32_t instruction = m_memory.read32(pc);
+        if (instruction == kOtxHleBusca48) [[unlikely]]
+        {
+            // Otavix (01/11): busca de bit do 989snd (máscara de 48 vozes em 2 palavras de 24 bits a partir de a0+0x18; a
+            // partir do bit a1; v0 = o 1o ligado ou -1). Era ~29% das instruções do IOP no God of War. Mesmo resultado e
+            // mesmos ciclos do código original (5; ou 7 + 19 por bit desligado + 17 no achado / 2 no fim)
+            const int32_t ini = static_cast<int32_t>(cpu.gpr[5]);
+            const uint32_t base = cpu.gpr[4] + 0x18u;
+            int32_t achado = -1;
+            uint32_t n = 5u;
+            if (ini < 48)
+            {
+                n = 7u;
+                for (int32_t i = ini;; ++i)
+                {
+                    if (i >= 48)
+                    {
+                        n += 2u;
+                        break;
+                    }
+                    const int32_t q = i / 24, r = i - q * 24;
+                    if (m_memory.read32(base + static_cast<uint32_t>(q) * 4u) & (1u << (static_cast<uint32_t>(r) & 31u)))
+                    {
+                        achado = i;
+                        n += 17u;
+                        break;
+                    }
+                    n += 19u;
+                }
+            }
+            if (cpu.pendingLoad)
+            {
+                if (cpu.pendingLoadReg != 0u && cpu.pendingLoadReg != 2u)
+                    cpu.gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+                cpu.pendingLoad = false;
+            }
+            cpu.gpr[2] = static_cast<uint32_t>(achado);
+            cpu.pc = cpu.gpr[31];
+            cpu.branchPending = false;
+            cpu.exception = false;
+            cpu.yielded = false;
+            cpu.otxCiclosExtra = n - 1u;
+            return !cpu.stopped;
+        }
         const bool wasDelaySlot = cpu.branchPending;
         const uint32_t priorBranchTarget = cpu.branchTarget;
 
