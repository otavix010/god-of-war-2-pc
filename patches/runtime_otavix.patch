+            return _mm256_min_epi32(_mm256_max_epi32(c, _mm256_setzero_si256()), _mm256_set1_epi32(tam - 1));
+        case 2:
+            return _mm256_min_epi32(_mm256_max_epi32(c, _mm256_set1_epi32(rmin)), _mm256_set1_epi32(rmax));
+        default:
+            return _mm256_or_si256(_mm256_and_si256(c, _mm256_set1_epi32(rmin)), _mm256_set1_epi32(rmax));
+        }
+    }
+
+    // round(v) meio para longe do zero + clamp 0..255, igual ao otxLerp4 (que faz em double): para v >= 0,
+    // floor(v + 0.5) = trunc(v) + (frac >= 0.5) com frac exato em float; negativos e inválidos dão 0 nos dois
+    __forceinline __m256i otxArred8(__m256 v)
+    {
+        const __m256i t = _mm256_cvttps_epi32(v);
+        const __m256 fr = _mm256_sub_ps(v, _mm256_cvtepi32_ps(t));
+        const __m256i mais = _mm256_castps_si256(_mm256_cmp_ps(fr, _mm256_set1_ps(0.5f), _CMP_GE_OQ));
+        return otxClampU8x8(_mm256_sub_epi32(t, mais)); // mais = -1 nas lanes que sobem
+    }
+}
+
+template <int TK, int ZK>
+void GSCpuBackend::otxLinhaRapida8(const OtxTri &t, int y, int x0, int x1)
