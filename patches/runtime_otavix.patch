+template <int TK>
+__forceinline uint32_t GSCpuBackend::otxAmostra(const OtxTri &t, float s, float tt, float q, uint16_t u, uint16_t v)
+{
+    using namespace GSMem;
+    const GSDrawState &state = t.batch->state;
+    if constexpr (TK == 3)
+        return SampleTexture(state, s, tt, q, u, v);
+    else
+    {
+        const auto &ctx = state.context;
+        const auto &tex = ctx.tex0;
+
+        const int texW = state.textureWidth;
+        const int texH = state.textureHeight;
+        const uint64_t clamp = ctx.clamp;
+        const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u);
+        const uint8_t wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+        const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+        const uint16_t maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+        const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+        const uint16_t maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+
+        float texUf, texVf;
+        if (state.prim.fst)
+        {
+            texUf = static_cast<float>(u) / 16.0f;
+            texVf = static_cast<float>(v) / 16.0f;
+        }
+        else
+        {
+            const float invQ = 1.0f / fabsQ(q);
+            texUf = s * invQ * static_cast<float>(texW);
+            texVf = tt * invQ * static_cast<float>(texH);
+        }
+
+        const auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+        {
+            sampleU = wrapTextureCoordinate(sampleU, texW, wrapU, minU, maxU);
+            sampleV = wrapTextureCoordinate(sampleV, texH, wrapV, minV, maxV);
+            if constexpr (TK == 1)
+                return PixelStorageTraits<C32>::Read(*static_cast<const PixelStorageTraits<C32>::PageLookupTableT *>(t.tabTex),
+                                                     m_vram, tex.tbp0, tex.tbw, sampleU, sampleV);
+            else
+                return t.lut[static_cast<u8>(PixelStorageTraits<P8>::Read(
+                    *static_cast<const PixelStorageTraits<P8>::PageLookupTableT *>(t.tabTex), m_vram, tex.tbp0, tex.tbw, sampleU,
+                    sampleV))];
+        };
+
+        if (!state.linearFilter)
+            return samplePoint(static_cast<int>(texUf), static_cast<int>(texVf));
+
+        const float sampleU = texUf - 0.5f;
+        const float sampleV = texVf - 0.5f;
+        const int u0 = static_cast<int>(std::floor(sampleU));
+        const int v0 = static_cast<int>(std::floor(sampleV));
+        const int u1 = u0 + 1;
+        const int v1 = v0 + 1;
+        const float fx = sampleU - static_cast<float>(u0);
+        const float fy = sampleV - static_cast<float>(v0);
+
+        const uint32_t c00 = samplePoint(u0, v0);
+        const uint32_t c10 = samplePoint(u1, v0);
+        const uint32_t c01 = samplePoint(u0, v1);
+        const uint32_t c11 = samplePoint(u1, v1);
+
+        return otxLerp4(c00, c10, c01, c11, fx, fy);
+    }
+}
+
+template <int TK, int ZK>
+void GSCpuBackend::otxLinhaRapida(const OtxTri &t, int y, int x0, int x1)
+{
+    using namespace GSMem;
+    constexpr PixelStorageMode ZP = ZK == 1 ? Z32 : ZK == 2 ? Z24 : ZK == 3 ? Z16 : Z16S;
+    using ZTraits = PixelStorageTraits<ZP>;
+    using ZPacked = typename ZTraits::PackedT;
+    const auto &tabFb = *static_cast<const PixelStorageTraits<C32>::PageLookupTableT *>(t.tabFb);
+    const auto &tabZ = *static_cast<const typename ZTraits::PageLookupTableT *>(t.tabZ);
+
+    const GSPrimitiveBatch &batch = *t.batch;
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &ctx = state.context;
+    const float fx0 = t.fx0, fy0 = t.fy0, fx1 = t.fx1, fy1 = t.fy1, fx2 = t.fx2, fy2 = t.fy2;
+    const float winding = t.winding, invAbsDenom = t.invAbsDenom;
+    constexpr float kEdgeEpsilon = 1.0e-4f;
+
+    const u32 fbp = t.fbp, fbw = t.fbw, zbp = t.zbp;
+    const uint64_t test = ctx.test;
+    const uint32_t ztestMethod = static_cast<uint32_t>((test >> 17) & 3u);
+    const bool alphaBlendEnabled = state.prim.abe;
+    const bool destinationAlphaTestNeedsRead = ((test >> 14) & 0x1u) != 0u;
+    const uint32_t fbmsk = ctx.frame.fbmsk;
+    const bool iip = state.prim.iip, fst = state.prim.fst, fge = state.prim.fge;
+    const bool fba = (ctx.fba & 0x1ull) != 0ull;
+    const bool zmask = ctx.zbuf.zmask;
+
+    const float py = static_cast<float>(y) + 0.5f;
+    for (int x = x0; x <= x1; ++x)
+    {
+        float px = static_cast<float>(x) + 0.5f;
+
+        float w0 = (((fy1 - fy2) * (px - fx2) + (fx2 - fx1) * (py - fy2)) * winding) * invAbsDenom;
+        float w1 = (((fy2 - fy0) * (px - fx2) + (fx0 - fx2) * (py - fy2)) * winding) * invAbsDenom;
+        float w2 = 1.0f - w0 - w1;
+
+        if (w0 < -kEdgeEpsilon || w1 < -kEdgeEpsilon || w2 < -kEdgeEpsilon)
+            continue;
+
+        double z = v0.z * w0 + v1.z * w1 + v2.z * w2;
+
+        uint8_t r, g, b, a;
+        if (iip)
+        {
+            r = clampU8(static_cast<int>(v0.r * w0 + v1.r * w1 + v2.r * w2));
+            g = clampU8(static_cast<int>(v0.g * w0 + v1.g * w1 + v2.g * w2));
+            b = clampU8(static_cast<int>(v0.b * w0 + v1.b * w1 + v2.b * w2));
+            a = clampU8(static_cast<int>(v0.a * w0 + v1.a * w1 + v2.a * w2));
+        }
+        else
+        {
+            r = v2.r;
+            g = v2.g;
+            b = v2.b;
+            a = v2.a;
+        }
+
+        if constexpr (TK != 0)
+        {
+            float is, it, iq;
+            uint16_t iu, iv;
+            if (fst)
+            {
+                iu = static_cast<uint16_t>(v0.u * w0 + v1.u * w1 + v2.u * w2);
+                iv = static_cast<uint16_t>(v0.v * w0 + v1.v * w1 + v2.v * w2);
+                is = 0.0f;
+                it = 0.0f;
+                iq = 1.0f;
+            }
+            else
+            {
+                is = v0.s * w0 + v1.s * w1 + v2.s * w2;
+                it = v0.t * w0 + v1.t * w1 + v2.t * w2;
+                iq = v0.q * w0 + v1.q * w1 + v2.q * w2;
+                iu = 0;
+                iv = 0;
+            }
+
+            const uint32_t texel = otxAmostra<TK>(t, is, it, iq, iu, iv);
+            const TextureCombineResult color = combineTexture(ctx.tex0, r, g, b, a, static_cast<uint8_t>(texel & 0xFF),
+                                                              static_cast<uint8_t>((texel >> 8) & 0xFF),
+                                                              static_cast<uint8_t>((texel >> 16) & 0xFF),
+                                                              static_cast<uint8_t>((texel >> 24) & 0xFF));
+            r = color.r;
+            g = color.g;
+            b = color.b;
+            a = color.a;
+        }
+
+        const uint8_t fog = clampU8(static_cast<int>(v0.fog * w0 + v1.fog * w1 + v2.fog * w2));
+        const uint32_t zv = static_cast<u32>(z + 0.5);
+
+        // ---- WritePixel (FB CT32) ----
+        if (fge)
+        {
+            const uint32_t inverseFog = 255u - fog;
+            r = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * r) >> 8) + ((inverseFog * state.fogR) >> 8));
+            g = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * g) >> 8) + ((inverseFog * state.fogG) >> 8));
+            b = static_cast<uint8_t>(((static_cast<uint32_t>(fog) * b) >> 8) + ((inverseFog * state.fogB) >> 8));
+        }
+
+        const PixelWriteMask writeMask = classifyAlphaTest(test, a, GS_PSM_CT32);
+        if (!writeMask.writesAnything())
+            continue;
+
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha;
+        const bool frmw = destinationAlphaTestNeedsRead ||
+                          (writeMask.writesFramebuffer() && ((fbmsk != 0) || alphaBlendEnabled || preserveDestinationAlpha));
+
+        u32 fbrgba = 0;
+        if (frmw)
+            fbrgba = PixelStorageTraits<C32>::Read(tabFb, m_vram, fbp, fbw, x, y);
+
+        if (!passesDestinationAlphaTest(test, GS_PSM_CT32, fbrgba))
+            continue;
+
+        bool zpass = false;
+        switch (ztestMethod)
+        {
+        case 0:
+            zpass = false;
+            break;
+        case 1:
+            zpass = true;
+            break;
+        case 2:
+            zpass = zv >= static_cast<uint32_t>(ZTraits::Read(tabZ, m_vram, zbp, fbw, x, y));
+            break;
+        case 3:
+            zpass = zv > static_cast<uint32_t>(ZTraits::Read(tabZ, m_vram, zbp, fbw, x, y));
+            break;
+        }
+        if (!zpass)
+            continue;
+
+        if (writeMask.writesFramebuffer())
+        {
+            if (alphaBlendEnabled)
+            {
+                const uint8_t dr = fbrgba & 0xFF;
+                const uint8_t dg = (fbrgba >> 8) & 0xFF;
+                const uint8_t db = (fbrgba >> 16) & 0xFF;
+                const uint8_t da = (fbrgba >> 24) & 0xFF;
+
+                if (!(state.pabe && (a & 0x80u) == 0u))
+                {
+                    const uint64_t alphaReg = ctx.alpha;
+                    const uint8_t asel = alphaReg & 3;
+                    const uint8_t bsel = (alphaReg >> 2) & 3;
+                    const uint8_t csel = (alphaReg >> 4) & 3;
+                    const uint8_t dsel = (alphaReg >> 6) & 3;
+                    const uint8_t fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+
+                    const auto pickRGB = [](uint8_t sel, int cs, int cd) -> int
+                    {
+                        if (sel == 0)
+                            return cs;
+                        if (sel == 1)
+                            return cd;
+                        return 0;
+                    };
+                    const int cAlpha = (csel == 0) ? a : (csel == 1) ? da : fix;
+
+                    r = otxCorFinal(state.colclamp, ((pickRGB(asel, r, dr) - pickRGB(bsel, r, dr)) * cAlpha >> 7) + pickRGB(dsel, r, dr));
+                    g = otxCorFinal(state.colclamp, ((pickRGB(asel, g, dg) - pickRGB(bsel, g, dg)) * cAlpha >> 7) + pickRGB(dsel, g, dg));
+                    b = otxCorFinal(state.colclamp, ((pickRGB(asel, b, db) - pickRGB(bsel, b, db)) * cAlpha >> 7) + pickRGB(dsel, b, db));
+                }
+            }
+
+            if (writeMask.writeAlpha && fba)
+                a = static_cast<uint8_t>(a | 0x80u);
+
+            u32 pixel = pack32(r, g, b, a);
+            if (fbmsk != 0)
+                pixel = (pixel & ~fbmsk) | (fbrgba & fbmsk);
+            if (preserveDestinationAlpha)
+                pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+
+            PixelStorageTraits<C32>::Write(tabFb, m_vram, fbp, fbw, x, y, pixel);
+        }
+
+        if (writeMask.writeDepth && !zmask)
+            ZTraits::Write(tabZ, m_vram, zbp, fbw, x, y, static_cast<ZPacked>(zv));
+    }
+}
+
+void GSCpuBackend::DrawTriangle(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &ctx = state.context;
+
+    int ofx = ctx.xyoffset.ofx >> 4;
+    int ofy = ctx.xyoffset.ofy >> 4;
+
+    float fx0 = v0.x - static_cast<float>(ofx);
+    float fy0 = v0.y - static_cast<float>(ofy);
+    float fx1 = v1.x - static_cast<float>(ofx);
+    float fy1 = v1.y - static_cast<float>(ofy);
+    float fx2 = v2.x - static_cast<float>(ofx);
+    float fy2 = v2.y - static_cast<float>(ofy);
+
+    int minX = static_cast<int>(std::floor(std::min(std::min(fx0, fx1), fx2)));
+    int maxX = static_cast<int>(std::ceil(std::max(std::max(fx0, fx1), fx2)));
+    int minY = static_cast<int>(std::floor(std::min(std::min(fy0, fy1), fy2)));
+    int maxY = static_cast<int>(std::ceil(std::max(std::max(fy0, fy1), fy2)));
+
+    minX = clampInt(minX, ctx.scissor.x0, ctx.scissor.x1);
+    maxX = clampInt(maxX, ctx.scissor.x0, ctx.scissor.x1);
+    minY = clampInt(minY, ctx.scissor.y0, ctx.scissor.y1);
+    maxY = clampInt(maxY, ctx.scissor.y0, ctx.scissor.y1);
+    // Otavix (patch_gs_faixa_rejeita): numa faixa do lote, sai já se a caixa não tem nenhuma linha desta faixa
+    // (mesmo critério do laço de linhas), em vez de preparar o triângulo inteiro para não desenhar nada
+    if (t_otxFaixas > 1 && otxFaixaRejeitaLigado())
+    {
+        const int b0 = minY >> 3, b1 = maxY >> 3;
+        if (b1 - b0 + 1 < t_otxFaixas)
+        {
+            bool toca = false;
+            for (int bb = b0; bb <= b1 && !toca; ++bb)
+                toca = (bb % t_otxFaixas) == t_otxFaixa;
+            if (!toca)
+                return;
+        }
+    }
+    otxGsEstat(state, (maxX - minX + 1) * (maxY - minY + 1)); // Otavix (patch_gs_estat)
+
+    float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+    if (std::fabs(denom) < 0.001f)
+        return;
+
+    const float winding = (denom < 0.0f) ? -1.0f : 1.0f;
+    const float invAbsDenom = 1.0f / std::fabs(denom);
+    constexpr float kEdgeEpsilon = 1.0e-4f;
+    // Otavix (diagnÃ³stico): PS2X_DIAG_TRI=N descreve os N primeiros triÃ¢ngulos com textura
+    static const uint32_t diagLimite = []() { const char *s = std::getenv("PS2X_DIAG_TRI"); return s ? static_cast<uint32_t>(std::atoi(s)) : 0u; }();
+    static std::atomic<uint32_t> diagN{0u};
+    const bool diagTri = diagLimite && state.prim.tme && diagN.fetch_add(1u, std::memory_order_relaxed) < diagLimite;
+    uint32_t diagPix = 0, diagCor = 0; int diagX = -1, diagY = -1;
+
+    // Otavix (patch_gs_tri_rapido): escolhe o laço especializado
+    using OtxLinhaFn = void (GSCpuBackend::*)(const OtxTri &, int, int, int);
+    OtxLinhaFn otxLinha = nullptr;
+    OtxTri otxT;
+    if (otxTriRapidoLigado() && !diagTri && m_vram && ctx.frame.psm == GS_PSM_CT32)
+    {
+        int zk = 0;
+        switch (ctx.zbuf.psm)
+        {
+        case GS_PSM_Z32: zk = 1; break;
+        case GS_PSM_Z24: zk = 2; break;
+        case GS_PSM_Z16: zk = 3; break;
+        case GS_PSM_Z16S: zk = 4; break;
+        default: break;
+        }
+        int tk = 0;
+        if (state.prim.tme)
+            tk = ctx.tex0.psm == GS_PSM_CT32 ? 1 : ctx.tex0.psm == GS_PSM_T8 ? 2 : 3;
+        static constexpr OtxLinhaFn tabela[4][4] = {
+            {&GSCpuBackend::otxLinhaRapida<0, 1>, &GSCpuBackend::otxLinhaRapida<0, 2>, &GSCpuBackend::otxLinhaRapida<0, 3>, &GSCpuBackend::otxLinhaRapida<0, 4>},
+            {&GSCpuBackend::otxLinhaRapida<1, 1>, &GSCpuBackend::otxLinhaRapida<1, 2>, &GSCpuBackend::otxLinhaRapida<1, 3>, &GSCpuBackend::otxLinhaRapida<1, 4>},
+            {&GSCpuBackend::otxLinhaRapida<2, 1>, &GSCpuBackend::otxLinhaRapida<2, 2>, &GSCpuBackend::otxLinhaRapida<2, 3>, &GSCpuBackend::otxLinhaRapida<2, 4>},
+            {&GSCpuBackend::otxLinhaRapida<3, 1>, &GSCpuBackend::otxLinhaRapida<3, 2>, &GSCpuBackend::otxLinhaRapida<3, 3>, &GSCpuBackend::otxLinhaRapida<3, 4>}};
+        if (zk != 0)
+        {
+            otxLinha = tabela[tk][zk - 1];
+            otxT.batch = &batch;
+            otxT.fx0 = fx0; otxT.fy0 = fy0; otxT.fx1 = fx1; otxT.fy1 = fy1; otxT.fx2 = fx2; otxT.fy2 = fy2;
+            otxT.winding = winding;
+            otxT.invAbsDenom = invAbsDenom;
+            otxT.tabFb = GSMem::OtxTabelaPagina(GS_PSM_CT32);
+            otxT.tabZ = GSMem::OtxTabelaPagina(ctx.zbuf.psm);
+            otxT.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+            otxT.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+            otxT.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+            if (tk == 1 || tk == 2)
+                otxT.tabTex = GSMem::OtxTabelaPagina(ctx.tex0.psm);
+            if (tk == 2)
+                otxT.lut = otxClutLut(state);
+            // Otavix (patch_gs_tri_simd): AVX2 quando dá (STQ + MODULATE, sem realimentação)
+            bool simd = otxTriSimdLigado() && tk <= 2 && (tk == 0 || (!state.prim.fst && ctx.tex0.tfx == 0u));
+            if (simd && tk != 0)
+            {
+                const auto &tx = ctx.tex0;
+                uint32_t t0, t1, f0, f1, z0, z1;
+                otxPaginas(tx.tbp0 / 32u, tx.tbw, static_cast<uint32_t>(state.textureHeight), tx.psm, t0, t1, (tx.tbp0 % 32u) != 0u);
+                otxPaginas(ctx.frame.fbp, ctx.frame.fbw, static_cast<uint32_t>(maxY + 1), ctx.frame.psm, f0, f1);
+                otxPaginas(ctx.zbuf.zbp, ctx.frame.fbw, static_cast<uint32_t>(maxY + 1), ctx.zbuf.psm, z0, z1);
+                if (otxSobrepoe(t0, t1, f0, f1) || otxSobrepoe(t0, t1, z0, z1))
+                    simd = false;
+            }
+            if (simd)
+            {
+                static constexpr OtxLinhaFn tabela8[3][4] = {
+                    {&GSCpuBackend::otxLinhaRapida8<0, 1>, &GSCpuBackend::otxLinhaRapida8<0, 2>, &GSCpuBackend::otxLinhaRapida8<0, 3>, &GSCpuBackend::otxLinhaRapida8<0, 4>},
