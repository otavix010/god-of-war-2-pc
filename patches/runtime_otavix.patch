+        bool leSemDescer(uint32_t a, uint32_t b, const std::function<uint64_t()> &le) override;
+        // o GS ficou ocioso: só manda se o lote já é grande ou está esperando há 1 ms (PS2X_GS_GPU_SOLTA=<prims>,<ms>);
+        // mandar todo lote pequeno custava ~2000 lotes/s na abertura do Spawn
+        void descarrega() override { descarregaPor("descarrega"); }
+        void solta() override
