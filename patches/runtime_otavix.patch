+void GSCpuBackend::otxPreCalcula(const GSPrimitiveBatch &batch, uint32_t pre[6])
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    const uint32_t linhas = static_cast<uint32_t>(ctx.scissor.y1) + 1u;
+    otxPaginas(ctx.frame.fbp, ctx.frame.fbw, linhas, ctx.frame.psm, pre[0], pre[1]);
+    otxPaginas(ctx.zbuf.zbp, ctx.frame.fbw, linhas, ctx.zbuf.psm, pre[2], pre[3]);
+    pre[4] = pre[5] = 0u;
+    if (state.prim.tme)
+        otxLotePaginasTex(batch, pre[4], pre[5]);
+}
