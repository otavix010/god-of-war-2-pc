+            pix = _mm256_or_si256(_mm256_andnot_si256(mk, pix), _mm256_and_si256(fb, mk));
+        }
+        pix = _mm256_blendv_epi8(pix, _mm256_or_si256(_mm256_and_si256(pix, _mm256_set1_epi32(0x00FFFFFF)),
+                                                      _mm256_and_si256(fb, _mm256_set1_epi32(static_cast<int>(0xFF000000u)))),
+                                 preserva);
+
+        _mm256_store_si256(reinterpret_cast<__m256i *>(lCor), pix);
+        _mm256_store_si256(reinterpret_cast<__m256i *>(lFb), endFb);
+        _mm256_store_si256(reinterpret_cast<__m256i *>(lZ), endZ);
+        _mm256_store_si256(reinterpret_cast<__m256i *>(lZv), zv);
+        const int mFb = mAtivo & _mm256_movemask_ps(_mm256_castsi256_ps(_mm256_or_si256(wRgb, wA)));
+        const int mZ = zmask ? 0 : (mAtivo & _mm256_movemask_ps(_mm256_castsi256_ps(wZ)));
+        for (int k = 0; k < 8; ++k)
+        {
+            if (mFb & (1 << k))
+                std::memcpy(m_vram + static_cast<uint32_t>(lFb[k]), &lCor[k], 4);
+            if (mZ & (1 << k))
+            {
+                uint8_t *pz = m_vram + static_cast<uint32_t>(lZ[k]);
+                if constexpr (ZK == 2)
+                {
+                    uint32_t old;
+                    std::memcpy(&old, pz, 4);
+                    const uint32_t v = (old & 0xFF000000u) | (static_cast<uint32_t>(lZv[k]) & 0x00FFFFFFu);
+                    std::memcpy(pz, &v, 4);
+                }
+                else
+                {
+                    const ZPacked v = static_cast<ZPacked>(static_cast<uint32_t>(lZv[k]));
+                    std::memcpy(pz, &v, sizeof(ZPacked));
+                }
+            }
+        }
+    }
+}
