@@ -0,0 +1,994 @@
+#include "iop_spu2.h"
+
+#include "ps2x/iop/iop_spu2_saida.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        std::atomic<Spu2Saida> g_saida{nullptr};
+    }
+
+    void defineSaidaSpu2(Spu2Saida saida)
+    {
+        g_saida.store(saida, std::memory_order_release);
+    }
+}
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr int32_t kF0[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kF1[5] = {0, 0, -52, -55, -60};
+        constexpr uint32_t kMascaraEnd = IopSpu2::kRamPalavras - 1u;
+        constexpr uint32_t kPacoteSaida = 512u;
+
+        int32_t sat16(int32_t v)
+        {
+            return std::clamp(v, -32768, 32767);
+        }
+
+        uint32_t hi(uint32_t atual, uint16_t v)
+        {
+            return ((static_cast<uint32_t>(v) & 0xFu) << 16) | (atual & 0xFFFFu);
+        }
+
+        uint32_t lo(uint32_t atual, uint16_t v)
+        {
+            return (atual & 0xF0000u) | v;
+        }
+
+        void bits16(uint32_t &reg, bool alto, uint16_t v)
+        {
+            reg = alto ? ((reg & 0xFFFFu) | (static_cast<uint32_t>(v & 0xFFu) << 16)) : ((reg & 0xFF0000u) | v);
+        }
+    }
+
+    IopSpu2::IopSpu2() : m_ram(kRamPalavras)
+    {
+        reset();
+    }
+
+    bool IopSpu2::ativo()
+    {
+        static const bool a = []
+        {
+            const char *e = std::getenv("PS2X_SPU2");
+            return !(e && e[0] == '0');
+        }();
+        return a;
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        std::memset(m_regs, 0, sizeof(m_regs));
+        for (int i = 0; i < 2; ++i)
+        {
+            // valores de reset do console: tudo roteado (o núcleo 1 recebe o 0 pela entrada externa)
+            Nucleo &n = m_n[i];
+            n = Nucleo{};
+            n.mmix = i ? 0xFFCu : 0xFF0u;
+            n.vmixl = n.vmixr = n.vmixel = n.vmixer = 0xFFFFFFu;
+            n.avolL = n.avolR = n.bvolL = n.bvolR = 0x7FFF;
+        }
+        m_ciclo = 0;
+        m_iniciado = false;
+        m_irq = false;
+        m_spdifIrq = 0;
+        m_saida.clear();
+    }
+
+    int32_t IopSpu2::volume(uint16_t reg)
+    {
+        // fixo: bits 0-14 = volume/2; varredura (bit 15): TODO (fica o valor atual)
+        return static_cast<int16_t>(static_cast<uint16_t>(reg << 1));
+    }
+
+    // varredura de volume (bit 15): bit 14 exponencial, bit 13 diminui, bit 12 fase negativa, bits 0-6 taxa
+    void IopSpu2::varre(uint16_t reg, int32_t &atual, int32_t &espera)
+    {
+        if (!(reg & 0x8000u))
+            return;
+        if (espera > 0)
+        {
+            --espera;
+            return;
+        }
+        const int rate = reg & 0x7F, shift = rate >> 2;
+        const bool dec = (reg & 0x2000u) != 0, exp = (reg & 0x4000u) != 0;
+        int32_t nivel = atual < 0 ? -atual : atual;
+        int32_t ciclos = 1 << std::max(0, shift - 11);
+        int32_t st = (dec ? -8 + (rate & 3) : 7 - (rate & 3)) << std::max(0, 11 - shift);
+        if (exp && !dec && nivel > 0x6000)
+            ciclos *= 4;
+        if (exp && dec)
+        {
+            st = static_cast<int32_t>((static_cast<int64_t>(st) * nivel) / 0x8000);
+            if (st == 0 && nivel > 0)
+                st = -1;
+        }
+        nivel = std::clamp(nivel + st, 0, 0x7FFF);
+        espera = ciclos - 1;
+        atual = (reg & 0x1000u) ? -nivel : nivel;
+    }
+
+    void IopSpu2::kon(int n, uint32_t bits)
+    {
+        Nucleo &c = m_n[n];
+        for (int i = 0; i < 24; ++i)
+        {
+            if (!(bits & (1u << i)))
+                continue;
+            Voz &v = c.vozes[i];
+            ++m_kons;
+            {
+                static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] != '0'; }();
+                static int nlog = 0;
+                if (log && v.ssa >= 0xE0000u && nlog++ < 60)
+                    std::fprintf(stderr, "[spu2:kon] %d.%02d ssa=%05x pitch=%04x amostra=%llu\n", n, i, v.ssa, v.pitch,
+                                 static_cast<unsigned long long>(m_amostras));
+            }
+            v.nax = v.ssa;
+            // laço: o LSA escrito pelo jogo para esta nota vale; senão começa no início da amostra
+            v.lsaFixo = v.lsaManual;
+            if (!v.lsaFixo)
+                v.lsa = v.ssa;
+            v.lsaManual = false;
+            v.fase = 1;
+            v.env = 0;
+            v.envEspera = 0;
+            v.contador = 0;
+            v.idx = 28;
+            v.primeiro = true;
+            v.p1 = v.p2 = 0;
+            std::memset(v.hist, 0, sizeof(v.hist));
+            c.endx &= ~(1u << i);
+        }
+    }
+
+    void IopSpu2::koff(int n, uint32_t bits)
+    {
+        Nucleo &c = m_n[n];
+        for (int i = 0; i < 24; ++i)
+            if ((bits & (1u << i)) && c.vozes[i].fase != 0)
+            {
+                c.vozes[i].fase = 4;
+                c.vozes[i].envEspera = 0;
+            }
+    }
+
+    void IopSpu2::confereIrq(uint32_t ini, uint32_t palavras)
+    {
+        for (int n = 0; n < 2; ++n)
+        {
+            Nucleo &c = m_n[n];
+            if (!(c.attr & 0x40u))
+                continue;
+            const uint32_t d = (c.irqa - ini) & kMascaraEnd;
+            if (d < palavras)
+            {
+                m_irq = true;
+                ++m_irqs;
+                m_spdifIrq |= static_cast<uint16_t>(4u << n);
+            }
+        }
+    }
+
+    void IopSpu2::decodifica(int n, Voz &v)
+    {
+        Nucleo &c = m_n[n];
+        if (!v.primeiro)
+        {
+            // fim do bloco anterior: flags de laço
+            if (v.flags & 1u)
+            {
+                c.endx |= 1u << static_cast<uint32_t>(&v - c.vozes);
+                if (v.flags & 2u)
+                    v.nax = v.lsa;
+                else
+                {
+                    v.fase = 0;
+                    v.env = 0;
+                    v.nax = (v.nax + 8u) & kMascaraEnd;
+                }
+            }
+            else
+            {
+                // Otavix: passar do fim da memória de som só acontece com stream perdido (o jogo errou a metade
+                // do anel); no console tocaria lixo da memória baixa — aqui a voz para (PS2X_SPU2_FUGA=1: toca)
+                static const bool fuga = [] { const char *e = std::getenv("PS2X_SPU2_FUGA"); return e && e[0] == '1'; }();
+                if (!fuga && v.nax + 8u > kMascaraEnd)
+                {
+                    c.endx |= 1u << static_cast<uint32_t>(&v - c.vozes);
+                    v.fase = 0;
+                    v.env = 0;
+                    return;
+                }
+                v.nax = (v.nax + 8u) & kMascaraEnd;
+            }
+        }
+        v.primeiro = false;
+        {
+            // Otavix: PS2X_LOG_SPU2 — voz de stream (SSA no topo) que sai do anel
+            static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] != '0'; }();
+            static int nlog = 0;
+            if (log && v.ssa >= 0xE0000u && v.nax < v.ssa && v.nax > 0x100u && nlog < 40)
+            {
+                ++nlog;
+                std::fprintf(stderr, "[spu2:fuga] voz %d.%02d ssa=%05x lsa=%05x nax=%05x flagsAnt=%x amostra=%llu fimAnel=%x\n", n,
+                             static_cast<int>(&v - c.vozes), v.ssa, v.lsa, v.nax, v.flags, static_cast<unsigned long long>(m_amostras),
+                             m_ram[0xFFF78u] >> 8);
+            }
+        }
+        confereIrq(v.nax, 8u);
+        const uint16_t *b = &m_ram[v.nax & kMascaraEnd];
+        const uint8_t h0 = static_cast<uint8_t>(b[0]);
+        v.flags = static_cast<uint8_t>(b[0] >> 8);
+        if ((v.flags & 4u) && !v.lsaFixo)
+            v.lsa = v.nax;
+        int sh = h0 & 0xF;
+        if (sh > 12)
+            sh = 9;
+        int f = (h0 >> 4) & 7;
+        if (f > 4)
+            f = 4;
+        for (int i = 0; i < 28; ++i)
+        {
+            const uint16_t w = m_ram[(v.nax + 1u + static_cast<uint32_t>(i >> 2)) & kMascaraEnd];
+            const int32_t nib = static_cast<int16_t>(static_cast<uint16_t>(((w >> ((i & 3) * 4)) & 0xFu) << 12));
+            int32_t s = (nib >> sh) + ((v.p1 * kF0[f] + v.p2 * kF1[f] + 32) >> 6);
+            s = sat16(s);
+            v.p2 = v.p1;
+            v.p1 = static_cast<int16_t>(s);
+            v.bloco[i] = static_cast<int16_t>(s);
+        }
+        v.idx = 0;
+    }
+
+    void IopSpu2::envelope(Voz &v)
+    {
+        if (v.fase == 0)
+            return;
+        if (v.envEspera > 0)
+        {
+            --v.envEspera;
+            return;
+        }
+        int shift = 0, step = 0;
+        bool exp = false, dec = false;
+        switch (v.fase)
+        {
+        case 1:
+            shift = (v.adsr1 >> 10) & 0x1F;
+            step = 7 - ((v.adsr1 >> 8) & 3);
+            exp = (v.adsr1 & 0x8000u) != 0;
+            break;
+        case 2:
+            shift = (v.adsr1 >> 4) & 0xF;
+            step = -8;
+            exp = dec = true;
+            break;
+        case 3:
+            shift = (v.adsr2 >> 8) & 0x1F;
+            dec = (v.adsr2 & 0x4000u) != 0;
+            step = dec ? -8 + ((v.adsr2 >> 6) & 3) : 7 - ((v.adsr2 >> 6) & 3);
+            exp = (v.adsr2 & 0x8000u) != 0;
+            break;
+        default:
+            shift = v.adsr2 & 0x1F;
+            step = -8;
+            dec = true;
+            exp = (v.adsr2 & 0x20u) != 0;
+            break;
+        }
+        int32_t ciclos = 1 << std::max(0, shift - 11);
+        int32_t st = step << std::max(0, 11 - shift);
+        if (exp && !dec && v.env > 0x6000)
+            ciclos *= 4;
+        if (exp && dec)
+        {
+            st = static_cast<int32_t>((static_cast<int64_t>(st) * v.env) / 0x8000);
+            if (st == 0 && v.env > 0)
+                st = -1;
+        }
+        v.env = std::clamp(v.env + st, 0, 0x7FFF);
+        v.envEspera = ciclos - 1;
+        switch (v.fase)
+        {
+        case 1:
+            if (v.env >= 0x7FFF)
+            {
+                v.fase = 2;
+                v.envEspera = 0;
+            }
+            break;
+        case 2:
+            if (v.env <= static_cast<int32_t>(((v.adsr1 & 0xFu) + 1u) * 0x800u))
+            {
+                v.fase = 3;
+                v.envEspera = 0;
+            }
+            break;
+        case 4:
+            if (v.env == 0)
+                v.fase = 0;
+            break;
+        default:
+            break;
+        }
+    }
+
+    int32_t IopSpu2::amostraVoz(int n, int iv, Voz &v, int32_t pmonAnt)
+    {
+        Nucleo &c = m_n[n];
+        uint32_t passo = v.pitch;
+        if (iv > 0 && (c.pmon & (1u << iv)))
+            passo = static_cast<uint32_t>((static_cast<int64_t>(passo) * (pmonAnt + 0x8000)) >> 15);
+        passo = std::min<uint32_t>(passo, 0x3FFFu);
+        // interpolação cúbica (Hermite) nos 4 últimos pontos (o console usa uma tabela gaussiana)
+        const float t = static_cast<float>(v.contador & 0xFFFu) * (1.0f / 4096.0f);
+        const float y0 = v.hist[0], y1 = v.hist[1], y2 = v.hist[2], y3 = v.hist[3];
+        const float c1 = 0.5f * (y2 - y0);
+        const float c2 = y0 - 2.5f * y1 + 2.0f * y2 - 0.5f * y3;
+        const float c3 = 0.5f * (y3 - y0) + 1.5f * (y1 - y2);
+        int32_t s = static_cast<int32_t>(((c3 * t + c2) * t + c1) * t + y1);
+        if (c.non & (1u << iv))
+            s = c.ruidoAmostra;
+        s = sat16(s);
+        v.contador += passo;
+        while (v.contador >= 0x1000u && v.fase != 0)
+        {
+            v.contador -= 0x1000u;
+            if (v.idx >= 28)
+            {
+                decodifica(n, v);
+                if (v.idx >= 28)
+                    break; // a voz parou sem decodificar
+            }
+            v.hist[0] = v.hist[1];
+            v.hist[1] = v.hist[2];
+            v.hist[2] = v.hist[3];
+            v.hist[3] = v.bloco[v.idx++];
+        }
+        envelope(v);
+        s = (s * v.env) >> 15;
+        v.saida = s;
+        return s;
+    }
+
+    uint32_t IopSpu2::rvAddr(const Nucleo &c, uint32_t off) const
+    {
+        const uint32_t ini = c.esa & kMascaraEnd, fim = (c.eea | 0xFFFFu) & kMascaraEnd;
+        if (fim <= ini)
+            return ini;
+        const uint32_t tam = fim - ini + 1u;
+        return ini + ((c.rvX + off) % tam);
+    }
+
+    void IopSpu2::reverb(Nucleo &c, int32_t entL, int32_t entR)
+    {
+        // roda a 24 kHz: média de 2 entradas, saída repetida
+        c.rvEntL += entL;
+        c.rvEntR += entR;
+        c.rvMeio = !c.rvMeio;
+        if (c.rvMeio)
+            return;
+        const int32_t inL = c.rvEntL >> 1, inR = c.rvEntR >> 1;
+        c.rvEntL = c.rvEntR = 0;
+        const uint32_t *e = c.rvEnd;
+        const int32_t *k = nullptr;
+        (void)k;
+        auto co = [&](int i) { return static_cast<int32_t>(c.rvCoef[i]); };
+        auto rd = [&](uint32_t off) { return static_cast<int32_t>(static_cast<int16_t>(m_ram[rvAddr(c, off)])); };
+        auto wr = [&](uint32_t off, int32_t v) { m_ram[rvAddr(c, off)] = static_cast<uint16_t>(sat16(v)); };
+        auto mul = [](int32_t a, int32_t b) { return (a * b) >> 15; };
+        const int32_t vIIR = co(0), vWALL = co(5), vAPF1 = co(6), vAPF2 = co(7);
+        const int32_t Lin = mul(inL, co(8)), Rin = mul(inR, co(9));
+        // mesma superfície (SAME) e reflexões cruzadas (DIFF)
+        wr(e[2], mul(Lin + mul(rd(e[8]), vWALL) - rd(e[2] - 1u), vIIR) + rd(e[2] - 1u));
+        wr(e[3], mul(Rin + mul(rd(e[9]), vWALL) - rd(e[3] - 1u), vIIR) + rd(e[3] - 1u));
+        wr(e[10], mul(Lin + mul(rd(e[17]), vWALL) - rd(e[10] - 1u), vIIR) + rd(e[10] - 1u));
+        wr(e[11], mul(Rin + mul(rd(e[16]), vWALL) - rd(e[11] - 1u), vIIR) + rd(e[11] - 1u));
+        int32_t L = mul(co(1), rd(e[4])) + mul(co(2), rd(e[6])) + mul(co(3), rd(e[12])) + mul(co(4), rd(e[14]));
+        int32_t R = mul(co(1), rd(e[5])) + mul(co(2), rd(e[7])) + mul(co(3), rd(e[13])) + mul(co(4), rd(e[15]));
+        // passa-tudo 1 e 2
+        L = L - mul(vAPF1, rd(e[18] - e[0]));
+        wr(e[18], L);
+        L = mul(sat16(L), vAPF1) + rd(e[18] - e[0]);
+        R = R - mul(vAPF1, rd(e[19] - e[0]));
+        wr(e[19], R);
+        R = mul(sat16(R), vAPF1) + rd(e[19] - e[0]);
+        L = L - mul(vAPF2, rd(e[20] - e[1]));
+        wr(e[20], L);
+        L = mul(sat16(L), vAPF2) + rd(e[20] - e[1]);
+        R = R - mul(vAPF2, rd(e[21] - e[1]));
+        wr(e[21], R);
+        R = mul(sat16(R), vAPF2) + rd(e[21] - e[1]);
+        c.rvSaiL = sat16(L);
+        c.rvSaiR = sat16(R);
+        ++c.rvX;
+    }
+
+    void IopSpu2::tick()
+    {
+        int32_t extL = 0, extR = 0, saiL = 0, saiR = 0;
+        for (int n = 0; n < 2; ++n)
+        {
+            Nucleo &c = m_n[n];
+            // ruído
+            {
+                const int clk = (c.attr >> 8) & 0x3F;
+                const int passo = 4 + (clk & 3), sh = clk >> 2;
+                c.ruidoCont -= passo;
+                const uint32_t lv = c.ruido;
+                const uint32_t par = ((lv >> 15) ^ (lv >> 12) ^ (lv >> 11) ^ (lv >> 10) ^ 1u) & 1u;
+                if (c.ruidoCont < 0)
+                {
+                    c.ruido = ((lv << 1) | par) & 0xFFFFu;
+                    c.ruidoCont += 0x20000 >> sh;
+                    if (c.ruidoCont < 0)
+                        c.ruidoCont += 0x20000 >> sh;
+                }
+                c.ruidoAmostra = static_cast<int16_t>(static_cast<uint16_t>(c.ruido));
+            }
+            int32_t secoL = 0, secoR = 0, molL = 0, molR = 0;
+            int32_t ant = 0;
+            for (int iv = 0; iv < 24; ++iv)
+            {
+                Voz &v = c.vozes[iv];
+                if (v.fase == 0)
+                {
+                    v.saida = 0;
+                    ant = 0;
+                    continue;
+                }
+                varre(v.volL, v.volAtualL, v.volEsperaL);
+                varre(v.volR, v.volAtualR, v.volEsperaR);
+                int32_t s = amostraVoz(n, iv, v, ant);
+                ant = s;
+                const uint32_t b = 1u << iv;
+                {
+                    // Otavix: PS2X_SPU2_MUDO_VOZES=<máscara núcleo 0>,<máscara núcleo 1> (hex) silencia vozes (diagnóstico)
+                    static const uint32_t *mudo = []
+                    {
+                        static uint32_t m[2] = {0, 0};
+                        if (const char *e = std::getenv("PS2X_SPU2_MUDO_VOZES"))
+                        {
+                            char *fim = nullptr;
+                            m[0] = static_cast<uint32_t>(std::strtoul(e, &fim, 16));
+                            if (fim && *fim == ',')
+                                m[1] = static_cast<uint32_t>(std::strtoul(fim + 1, nullptr, 16));
+                        }
+                        return m;
+                    }();
+                    if (mudo[n] & b)
+                        s = 0;
+                }
+                const int32_t l = (s * v.volAtualL) >> 15, r = (s * v.volAtualR) >> 15;
+                if (c.vmixl & b)
+                    secoL += l;
+                if (c.vmixr & b)
+                    secoR += r;
+                if (c.vmixel & b)
+                    molL += l;
+                if (c.vmixer & b)
+                    molR += r;
+            }
+            {
+                int32_t mL = c.mvolL, mR = c.mvolR;
+                varre(c.mvolRegL, mL, c.mvolEsperaL);
+                varre(c.mvolRegR, mR, c.mvolEsperaR);
+                c.mvolL = static_cast<int16_t>(mL);
+                c.mvolR = static_cast<int16_t>(mR);
+            }
+            int32_t inL = 0, inR = 0;
+            if ((c.admas & (n + 1)) && !c.fifo.empty())
+            {
+                const int32_t par = c.fifo.front();
+                c.fifo.pop_front();
+                inL = (static_cast<int16_t>(par >> 16) * c.bvolL) >> 15;
+                inR = (static_cast<int16_t>(par & 0xFFFF) * c.bvolR) >> 15;
+            }
+            int32_t eL = 0, eR = 0;
+            if (n == 1)
+            {
+                eL = (extL * c.avolL) >> 15;
+                eR = (extR * c.avolR) >> 15;
+            }
+            const uint16_t m = c.mmix;
+            int32_t tL = ((m & 0x80u) ? inL : 0) + ((m & 0x800u) ? sat16(secoL) : 0) + ((m & 0x8u) ? eL : 0);
+            int32_t tR = ((m & 0x40u) ? inR : 0) + ((m & 0x400u) ? sat16(secoR) : 0) + ((m & 0x4u) ? eR : 0);
+            static const bool otxReverb = [] { const char *e = std::getenv("PS2X_SPU2_REVERB"); return !(e && e[0] == '0'); }();
+            if (otxReverb && (c.attr & 0x80u))
+            {
+                const int32_t wL = ((m & 0x20u) ? inL : 0) + ((m & 0x200u) ? sat16(molL) : 0) + ((m & 0x2u) ? eL : 0);
+                const int32_t wR = ((m & 0x10u) ? inR : 0) + ((m & 0x100u) ? sat16(molR) : 0) + ((m & 0x1u) ? eR : 0);
+                reverb(c, sat16(wL), sat16(wR));
+                tL += (c.rvSaiL * c.evolL) >> 15;
+                tR += (c.rvSaiR * c.evolR) >> 15;
+            }
+            {
+                // Otavix (diagnóstico): PS2X_LOG_SPU2 registra os termos das primeiras amostras saturadas
+                static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] != '0'; }();
+                static int nsat = 0;
+                if (log && (tL > 30000 || tL < -30000) && nsat < 30 && (m_amostras % 7u) == 0u)
+                {
+                    ++nsat;
+                    std::fprintf(stderr, "[spu2:sat] n%d tL=%d inL=%d seco=%d mol=%d ext=%d rv=%d evol=%d mvol=%d mmix=%03x attr=%04x\n",
+                                 n, tL, inL, secoL, molL, eL, c.rvSaiL, c.evolL, c.mvolL, m, c.attr);
+                }
+            }
+            tL = sat16((sat16(tL) * c.mvolL) >> 15);
+            tR = sat16((sat16(tR) * c.mvolR) >> 15);
+            if (n == 0)
+            {
+                extL = tL;
+                extR = tR;
+            }
+            else
+            {
+                saiL = tL;
+                saiR = tR;
+            }
+        }
+        m_soma2 += static_cast<double>(saiL) * saiL + static_cast<double>(saiR) * saiR;
+        if (++m_amostras % 96000u == 0u)
+        {
+            // Otavix: PS2X_SPU2_DUMP=<arquivo> grava a memória de som aos 60 s de áudio
+            if (m_amostras == 96000u * 30u)
+                if (const char *dp = std::getenv("PS2X_SPU2_DUMP"); dp && *dp)
+                    if (FILE *f = std::fopen(dp, "wb"))
+                    {
+                        std::fwrite(m_ram.data(), 2, m_ram.size(), f);
+                        std::fclose(f);
+                    }
+            static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && (e[0] == '1' || e[0] == '2'); }();
+            if (log)
+            {
+                int ativas[2] = {0, 0};
+                for (int n = 0; n < 2; ++n)
+                    for (const Voz &v : m_n[n].vozes)
+                        ativas[n] += v.fase != 0;
+                std::fprintf(stderr, "[spu2] amostras=%llu rms=%.1f vozes=%d/%d kon=%llu porta=%llu dma=%llu adma=%llu irq=%llu fifo=%zu/%zu attr=%04x/%04x mmix=%03x/%03x non=%x/%x salto=%llu s20=%llu mvol=%d/%d\n",
+                             static_cast<unsigned long long>(m_amostras), std::sqrt(m_soma2 / 192000.0), ativas[0], ativas[1],
+                             static_cast<unsigned long long>(m_kons), static_cast<unsigned long long>(m_portas), static_cast<unsigned long long>(m_dmas),
+                             static_cast<unsigned long long>(m_admas), static_cast<unsigned long long>(m_irqs),
+                             m_n[0].fifo.size(), m_n[1].fifo.size(), m_n[0].attr, m_n[1].attr, m_n[0].mmix, m_n[1].mmix, m_n[0].non, m_n[1].non, static_cast<unsigned long long>(m_maxSalto), static_cast<unsigned long long>(m_saltos20ms),
+                             m_n[1].mvolL, m_n[1].mvolR);
+                static const bool log2 = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] == '2'; }();
+                for (int n = 0; log2 && n < 2; ++n)
+                    for (int iv = 0; iv < 24; ++iv)
+                    {
+                        const Voz &v = m_n[n].vozes[iv];
+                        if (v.fase && v.ssa >= 0xF0000u)
+                        {
+                            // flags ADPCM não nulas nos 0x4000 halfwords a partir do SSA (streams)
+                            std::fprintf(stderr, "[spu2:flags] %d.%02d ssa=%05x:", n, iv, v.ssa);
+                            int k = 0;
+                            for (uint32_t a = v.ssa; a < v.ssa + 0x4000u && k < 24; a += 8u)
+                            {
+                                const uint8_t f = static_cast<uint8_t>(m_ram[a & kMascaraEnd] >> 8);
+                                if (f)
+                                {
+                                    std::fprintf(stderr, " %05x=%x", a, f);
+                                    ++k;
+                                }
+                            }
+                            std::fprintf(stderr, " irqa=%05x/%05x attr=%04x\n", m_n[0].irqa, m_n[1].irqa, m_n[0].attr);
+                        }
+                        if (v.fase)
+                            std::fprintf(stderr, "[spu2:voz] %d.%02d fase=%d env=%d pitch=%04x vol=%04x/%04x atual=%d/%d ssa=%05x nax=%05x lsa=%05x adsr=%04x/%04x\n",
+                                         n, iv, v.fase, v.env, v.pitch, v.volL, v.volR, v.volAtualL, v.volAtualR, v.ssa, v.nax, v.lsa, v.adsr1, v.adsr2);
+                    }
+            }
+            m_soma2 = 0.0;
+            m_maxSalto = 0;
+        }
+        // Otavix: o hardware grava a saída das vozes 1 e 3 (0x400/0x600 no núcleo 0, 0xC00/0xE00 no 1) e as mixagens
+        // (0x1000..0x1FFF) em anéis de 0x200 palavras; drivers usam IRQA nesses anéis como temporizador (RenderWare)
+        {
+            const uint32_t p = m_outPos;
+            m_ram[0x400u + p] = static_cast<uint16_t>(m_n[0].vozes[1].saida);
+            m_ram[0x600u + p] = static_cast<uint16_t>(m_n[0].vozes[3].saida);
+            m_ram[0xC00u + p] = static_cast<uint16_t>(m_n[1].vozes[1].saida);
+            m_ram[0xE00u + p] = static_cast<uint16_t>(m_n[1].vozes[3].saida);
+            for (int n = 0; n < 2; ++n)
+            {
+                const Nucleo &c = m_n[n];
+                static const bool otxIrqSaida = [] { const char *e = std::getenv("PS2X_SPU2_IRQ_SAIDA"); return !(e && e[0] == '0'); }();
+                if (!otxIrqSaida || !(c.attr & 0x40u) || (c.irqa & 0x1FFu) != p)
+                    continue;
+                const uint32_t area = c.irqa & ~0x1FFu;
+                if ((area >= 0x400u && area < 0x800u) || (area >= 0xC00u && area < 0x2000u))
+                {
+                    m_irq = true;
+                    ++m_irqs;
+                    m_spdifIrq |= static_cast<uint16_t>(4u << n);
+                }
+            }
+            m_outPos = (p + 1u) & 0x1FFu;
+        }
+        m_saida.push_back(static_cast<int16_t>(saiL));
+        m_saida.push_back(static_cast<int16_t>(saiR));
+        if (m_saida.size() >= kPacoteSaida * 2u)
+        {
+            if (const Spu2Saida f = g_saida.load(std::memory_order_acquire))
+                f(m_saida.data(), static_cast<uint32_t>(m_saida.size() / 2u));
+            m_saida.clear();
+        }
+    }
+
+    void IopSpu2::avanca(uint64_t ciclo)
+    {
+        if (!m_iniciado)
+        {
+            m_iniciado = true;
+            m_ciclo = ciclo;
+            return;
+        }
+        if (ciclo > m_ciclo)
+        {
+            const uint64_t salto = (ciclo - m_ciclo) / kCiclosPorAmostra;
+            m_maxSalto = std::max(m_maxSalto, salto);
+            if (salto > 960u)
+                ++m_saltos20ms;
+        }
+        if (ciclo > m_ciclo + 48000ull * kCiclosPorAmostra)
+            m_ciclo = ciclo - 48000ull * kCiclosPorAmostra; // no máximo 1 s de atraso
+        while (m_ciclo + kCiclosPorAmostra <= ciclo)
+        {
+            tick();
+            m_ciclo += kCiclosPorAmostra;
+        }
+    }
+
+    uint64_t IopSpu2::dma(int n, uint8_t *ramIop, uint32_t tamRam, uint32_t madr, uint32_t bytes, bool paraSpu)
+    {
+        Nucleo &c = m_n[n & 1];
+        c.statx |= 0x80u; // a cópia é imediata; o fim (IRQ) vem depois do atraso devolvido
+        madr &= 0x1FFFFFu;
+        if (madr >= tamRam)
+            return 64u;
+        bytes = std::min(bytes, tamRam - madr);
+        if (paraSpu && (c.admas & ((n & 1) + 1)))
+        {
+            ++m_admas;
+            {
+                static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] != '0'; }();
+                if (log && (m_admas % 50u) == 1u)
+                {
+                    int16_t a0, a1, a2, a3;
+                    std::memcpy(&a0, ramIop + madr, 2);
+                    std::memcpy(&a1, ramIop + madr + 2, 2);
+                    std::memcpy(&a2, ramIop + madr + 512, 2);
+                    std::memcpy(&a3, ramIop + madr + 514, 2);
+                    std::fprintf(stderr, "[spu2:adma] n=%llu núcleo=%d madr=%06x bytes=%x amostras L=%d,%d R=%d,%d bvol=%d/%d\n",
+                                 static_cast<unsigned long long>(m_admas), n, madr, bytes, a0, a1, a2, a3, c.bvolL, c.bvolR);
+                }
+            }
+            // AutoDMA: blocos de 1 KB = 256 amostras L + 256 R; termina quando a fila baixa de 512 pares
+            for (uint32_t off = 0; off + 1024u <= bytes; off += 1024u)
+            {
+                const uint8_t *p = ramIop + madr + off;
+                for (uint32_t i = 0; i < 256u; ++i)
+                {
+                    int16_t l, r;
+                    std::memcpy(&l, p + i * 2u, 2);
+                    std::memcpy(&r, p + 512u + i * 2u, 2);
+                    c.fifo.push_back((static_cast<int32_t>(static_cast<uint16_t>(l)) << 16) | static_cast<uint16_t>(r));
+                    {
+                        static int nlog = 0;
+                        static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] != '0'; }();
+                        if (log && (l > 30000 || l < -30000) && nlog < 6)
+                        {
+                            ++nlog;
+                            std::fprintf(stderr, "[spu2:adma-sat] n=%llu madr=%06x off=%x i=%u bloco:", static_cast<unsigned long long>(m_admas), madr, off, i);
+                            for (uint32_t k = 0; k < 16u; ++k)
+                            {
+                                int16_t v;
+                                std::memcpy(&v, p + (i & ~7u) * 2u + k * 2u, 2);
+                                std::fprintf(stderr, " %d", v);
+                            }
+                            std::fprintf(stderr, "\n");
+                        }
+                    }
+                }
+            }
+            while (c.fifo.size() > 48000u)
+                c.fifo.pop_front();
+            const uint64_t nivel = c.fifo.size();
+            return nivel > 512u ? (nivel - 512u) * kCiclosPorAmostra : 64u;
+        }
+        const uint32_t palavras = bytes / 2u;
+        ++m_dmas;
+        {
+            static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && (e[0] == '1' || e[0] == '2'); }();
+            if (log && m_dmas <= 400u)
+                std::fprintf(stderr, "[spu2:dma] núcleo=%d madr=%06x bytes=%x tsa=%05x %s\n", n, madr, bytes, c.tsa, paraSpu ? "->spu" : "<-spu");
+        }
+        if (paraSpu)
+        {
+            confereIrq(c.tsa, palavras);
+            for (uint32_t i = 0; i < palavras; ++i)
+            {
+                uint16_t w;
+                std::memcpy(&w, ramIop + madr + i * 2u, 2);
+                m_ram[(c.tsa + i) & kMascaraEnd] = w;
+            }
+        }
+        else
+        {
+            for (uint32_t i = 0; i < palavras; ++i)
+            {
+                const uint16_t w = m_ram[(c.tsa + i) & kMascaraEnd];
+                std::memcpy(ramIop + madr + i * 2u, &w, 2);
+            }
+        }
+        c.tsa = (c.tsa + palavras) & kMascaraEnd;
+        return std::max<uint64_t>(static_cast<uint64_t>(palavras), 64u);
+    }
+
+    uint16_t IopSpu2::leCore(int n, uint32_t r)
+    {
+        Nucleo &c = m_n[n];
+        if (r < 0x180u)
+        {
+            Voz &v = c.vozes[r >> 4];
+            switch (r & 0xFu)
+            {
+            case 0x0: return v.volL;
+            case 0x2: return v.volR;
+            case 0x4: return v.pitch;
+            case 0x6: return v.adsr1;
+            case 0x8: return v.adsr2;
+            case 0xA: return static_cast<uint16_t>(v.env);
+            case 0xC: return static_cast<uint16_t>(v.volAtualL);
+            default: return static_cast<uint16_t>(v.volAtualR);
+            }
+        }
+        if (r >= 0x1C0u && r < 0x1C0u + 24u * 0xCu)
+        {
+            Voz &v = c.vozes[(r - 0x1C0u) / 0xCu];
+            switch ((r - 0x1C0u) % 0xCu)
+            {
+            case 0x0: return static_cast<uint16_t>(v.ssa >> 16);
+            case 0x2: return static_cast<uint16_t>(v.ssa);
+            case 0x4: return static_cast<uint16_t>(v.lsa >> 16);
+            case 0x6: return static_cast<uint16_t>(v.lsa);
+            case 0x8: return static_cast<uint16_t>(v.nax >> 16);
+            default: return static_cast<uint16_t>(v.nax);
+            }
+        }
+        switch (r)
+        {
+        case 0x180: return static_cast<uint16_t>(c.pmon);
+        case 0x182: return static_cast<uint16_t>(c.pmon >> 16);
+        case 0x184: return static_cast<uint16_t>(c.non);
+        case 0x186: return static_cast<uint16_t>(c.non >> 16);
+        case 0x188: return static_cast<uint16_t>(c.vmixl);
+        case 0x18A: return static_cast<uint16_t>(c.vmixl >> 16);
+        case 0x18C: return static_cast<uint16_t>(c.vmixel);
+        case 0x18E: return static_cast<uint16_t>(c.vmixel >> 16);
+        case 0x190: return static_cast<uint16_t>(c.vmixr);
+        case 0x192: return static_cast<uint16_t>(c.vmixr >> 16);
+        case 0x194: return static_cast<uint16_t>(c.vmixer);
+        case 0x196: return static_cast<uint16_t>(c.vmixer >> 16);
+        case 0x198: return c.mmix;
+        case 0x19A: return c.attr;
+        case 0x19C: return static_cast<uint16_t>(c.irqa >> 16);
+        case 0x19E: return static_cast<uint16_t>(c.irqa);
+        case 0x1A0: case 0x1A2: case 0x1A4: case 0x1A6: return 0;
+        case 0x1A8: return static_cast<uint16_t>(c.tsa >> 16);
+        case 0x1AA: return static_cast<uint16_t>(c.tsa);
+        case 0x1B0: return c.admas;
+        case 0x340: return static_cast<uint16_t>(c.endx);
+        case 0x342: return static_cast<uint16_t>(c.endx >> 16);
+        case 0x344: return c.statx;
+        default: return m_regs[((n ? 0x400u : 0u) + r) >> 1];
+        }
+    }
+
+    void IopSpu2::escreveCore(int n, uint32_t r, uint16_t x)
+    {
+        Nucleo &c = m_n[n];
+        if (r < 0x180u)
+        {
+            Voz &v = c.vozes[r >> 4];
+            switch (r & 0xFu)
+            {
+            case 0x0:
+                v.volL = x;
+                if (!(x & 0x8000u))
+                    v.volAtualL = volume(x);
+                break;
+            case 0x2:
+                v.volR = x;
+                if (!(x & 0x8000u))
+                    v.volAtualR = volume(x);
+                break;
+            case 0x4: v.pitch = x; break;
+            case 0x6: v.adsr1 = x; break;
+            case 0x8: v.adsr2 = x; break;
+            case 0xA: v.env = x & 0x7FFF; break;
+            default: break;
+            }
+            return;
+        }
+        if (r >= 0x2E4u && r < 0x33Cu)
+        {
+            uint32_t &a = c.rvEnd[(r - 0x2E4u) >> 2];
+            a = ((r - 0x2E4u) & 2u) ? lo(a, x) : hi(a, x);
+            return;
+        }
+        if (r >= 0x1C0u && r < 0x1C0u + 24u * 0xCu)
+        {
+            Voz &v = c.vozes[(r - 0x1C0u) / 0xCu];
+            switch ((r - 0x1C0u) % 0xCu)
+            {
+            case 0x0: v.ssa = hi(v.ssa, x); break;
+            case 0x2: v.ssa = lo(v.ssa, x); break;
+            case 0x4: v.lsa = hi(v.lsa, x); v.lsaManual = true; if (v.fase) v.lsaFixo = true; break;
+            case 0x6: v.lsa = lo(v.lsa, x); v.lsaManual = true; if (v.fase) v.lsaFixo = true; break;
+            case 0x8: v.nax = hi(v.nax, x); break;
+            default: v.nax = lo(v.nax, x); break;
+            }
+            return;
+        }
+        switch (r)
+        {
+        case 0x180: bits16(c.pmon, false, x); break;
+        case 0x182: bits16(c.pmon, true, x); break;
+        case 0x184: bits16(c.non, false, x); break;
+        case 0x186: bits16(c.non, true, x); break;
+        case 0x188: bits16(c.vmixl, false, x); break;
+        case 0x18A: bits16(c.vmixl, true, x); break;
+        case 0x18C: bits16(c.vmixel, false, x); break;
+        case 0x18E: bits16(c.vmixel, true, x); break;
+        case 0x190: bits16(c.vmixr, false, x); break;
+        case 0x192: bits16(c.vmixr, true, x); break;
+        case 0x194: bits16(c.vmixer, false, x); break;
+        case 0x196: bits16(c.vmixer, true, x); break;
+        case 0x198: c.mmix = x; break;
+        case 0x19A: c.attr = x; break;
+        case 0x19C: c.irqa = hi(c.irqa, x); break;
+        case 0x19E: c.irqa = lo(c.irqa, x); break;
+        case 0x1A0: kon(n, x); break;
+        case 0x1A2: kon(n, static_cast<uint32_t>(x & 0xFFu) << 16); break;
+        case 0x1A4: koff(n, x); break;
+        case 0x1A6: koff(n, static_cast<uint32_t>(x & 0xFFu) << 16); break;
+        case 0x1A8: c.tsa = hi(c.tsa, x); break;
+        case 0x1AA: c.tsa = lo(c.tsa, x); break;
+        case 0x1AC:
+            ++m_portas;
+            confereIrq(c.tsa, 1u);
+            m_ram[c.tsa & kMascaraEnd] = x;
+            c.tsa = (c.tsa + 1u) & kMascaraEnd;
+            break;
+        case 0x1B0:
+            c.admas = x;
+            if (!(x & (n + 1)))
+                c.fifo.clear();
+            break;
+        case 0x2E0: c.esa = hi(c.esa, x); break;
+        case 0x2E2: c.esa = lo(c.esa, x); break;
+        case 0x33C: c.eea = (static_cast<uint32_t>(x) & 0xFu) << 16; break;
+        case 0x340: c.endx &= 0xFF0000u; break;
+        case 0x342: c.endx &= 0xFFFFu; break;
+        case 0x344: break;
+        default: break;
+        }
+    }
+
+    static uint32_t otxMaxLog()
+    {
+        static const uint32_t m = [] { const char *e = std::getenv("PS2X_LOG_SPU2_MAX"); return e ? static_cast<uint32_t>(std::strtoul(e, nullptr, 10)) : 3000u; }();
+        return m;
+    }
+
+    uint16_t IopSpu2::le(uint32_t off)
+    {
+        off &= kRegs - 2u;
+        {
+            // Otavix: PS2X_LOG_SPU2=3 registra as leituras (laços de espera)
+            static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] == '3'; }();
+            static uint32_t ult = 0xFFFFFFFFu, rep = 0, n = 0;
+            if (log && n < otxMaxLog())
+            {
+                if (off == ult)
+                    ++rep;
+                else
+                {
+                    if (rep)
+                        std::fprintf(stderr, "[spu2:le] ... x%u\n", rep);
+                    rep = 0;
+                    ult = off;
+                    ++n;
+                    std::fprintf(stderr, "[spu2:le] %03x\n", off);
+                }
+            }
+        }
+        if (off < 0x760u)
+            return leCore(off >= 0x400u ? 1 : 0, off & 0x3FFu);
+        if (off < 0x7B0u)
+        {
+            const int n = static_cast<int>((off - 0x760u) / 0x28u);
+            const uint32_t s = (off - 0x760u) % 0x28u;
+            Nucleo &c = m_n[n];
+            switch (s)
+            {
+            case 0x00: return m_regs[off >> 1];
+            case 0x02: return m_regs[off >> 1];
+            case 0x04: return static_cast<uint16_t>(c.evolL);
+            case 0x06: return static_cast<uint16_t>(c.evolR);
+            case 0x08: return static_cast<uint16_t>(c.avolL);
+            case 0x0A: return static_cast<uint16_t>(c.avolR);
+            case 0x0C: return static_cast<uint16_t>(c.bvolL);
+            case 0x0E: return static_cast<uint16_t>(c.bvolR);
+            case 0x10: return static_cast<uint16_t>(c.mvolL);
+            case 0x12: return static_cast<uint16_t>(c.mvolR);
+            default: return m_regs[off >> 1];
+            }
+        }
+        if (off == 0x7C2u)
+            return m_spdifIrq;
+        return m_regs[off >> 1];
+    }
+
+    void IopSpu2::escreve(uint32_t off, uint16_t x)
+    {
+        off &= kRegs - 2u;
+        {
+            static const bool log = [] { const char *e = std::getenv("PS2X_LOG_SPU2"); return e && e[0] == '3'; }();
+            static uint32_t n = 0;
+            if (log && n++ < otxMaxLog())
+                std::fprintf(stderr, "[spu2:esc] %03x=%04x\n", off, x);
+        }
+        m_regs[off >> 1] = x;
+        if (off < 0x760u)
+        {
+            escreveCore(off >= 0x400u ? 1 : 0, off & 0x3FFu, x);
+            return;
+        }
+        if (off < 0x7B0u)
+        {
+            const int n = static_cast<int>((off - 0x760u) / 0x28u);
+            const uint32_t s = (off - 0x760u) % 0x28u;
+            Nucleo &c = m_n[n];
+            switch (s)
+            {
+            case 0x00:
+                c.mvolRegL = x;
+                if (!(x & 0x8000u))
+                    c.mvolL = static_cast<int16_t>(volume(x));
+                break;
+            case 0x02:
+                c.mvolRegR = x;
+                if (!(x & 0x8000u))
+                    c.mvolR = static_cast<int16_t>(volume(x));
+                break;
+            case 0x04: c.evolL = static_cast<int16_t>(x); break;
+            case 0x06: c.evolR = static_cast<int16_t>(x); break;
+            case 0x08: c.avolL = static_cast<int16_t>(x); break;
+            case 0x0A: c.avolR = static_cast<int16_t>(x); break;
+            case 0x0C: c.bvolL = static_cast<int16_t>(x); break;
+            case 0x0E: c.bvolR = static_cast<int16_t>(x); break;
+            default:
+                if (s >= 0x14u && s < 0x28u)
+                    c.rvCoef[(s - 0x14u) >> 1] = static_cast<int16_t>(x);
+                break;
+            }
+            return;
+        }
+        if (off == 0x7C2u)
+            m_spdifIrq = static_cast<uint16_t>(m_spdifIrq & ~x);
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..4164018
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,116 @@
+#pragma once
+
+// Otavix: SPU2 (os dois núcleos de som do PS2) emulado no nível dos registradores, para os IRX de som do jogo
+// (LIBSD e drivers) rodarem como no console: 2 MB de memória de som, 48 vozes ADPCM com ADSR, ruído e modulação
+// de pitch, transferências manuais e por DMA (canais 4 e 7, inclusive AutoDMA de PCM), IRQ por endereço e a
+// mixagem núcleo 0 -> núcleo 1 -> saída a 48 kHz (768 ciclos do IOP por amostra). Reverberação: TODO.
+// PS2X_SPU2=0 desliga (registradores voltam a ser só memória, como antes).
+
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t kRegs = 0x800u;           // 0x1F900000..0x1F9007FF
+        static constexpr uint32_t kRamPalavras = 0x100000u; // 2 MB em palavras de 16 bits
+        static constexpr uint32_t kCiclosPorAmostra = 768u;
+
+        IopSpu2();
+        void reset();
+        [[nodiscard]] static bool ativo();
+
+        [[nodiscard]] uint16_t le(uint32_t off);
+        void escreve(uint32_t off, uint16_t v);
+
+        // DMA de som (núcleo 0 = canal 4, núcleo 1 = canal 7): copia entre a RAM do IOP e a memória de som e
+        // devolve em quantos ciclos do IOP a transferência termina
+        uint64_t dma(int nucleo, uint8_t *ramIop, uint32_t tamRam, uint32_t madr, uint32_t bytes, bool paraSpu);
+
+        // gera as amostras até o ciclo 'ciclo' do IOP
+        void avanca(uint64_t ciclo);
+        // IRQ do SPU2 (INTC 9) pendente
+        [[nodiscard]] bool pegaIrq()
+        {
+            const bool r = m_irq;
+            m_irq = false;
+            return r;
+        }
+
+    private:
+        struct Voz
+        {
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            int32_t volAtualL = 0, volAtualR = 0;
+            int32_t volEsperaL = 0, volEsperaR = 0;
+            uint32_t ssa = 0, lsa = 0, nax = 0;
+            bool lsaManual = false;  // LSA escrito pelo jogo desde o último KON
+            bool lsaFixo = false;    // a nota atual usa o LSA escrito (flags de início não mexem)
+            int32_t env = 0;
+            uint8_t fase = 0; // 0 desligada, 1 ataque, 2 decaimento, 3 sustentação, 4 soltura
+            int32_t envEspera = 0;
+            uint32_t contador = 0;
+            int16_t bloco[28]{};
