diff --git a/ps2xIOP/src/emulator/imports/iop_sio2.cpp b/ps2xIOP/src/emulator/imports/iop_sio2.cpp
new file mode 100644
index 0000000..92c2c93
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_sio2.cpp
@@ -0,0 +1,213 @@
+#include "iop_sio2.h"
+
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+#include "ps2x/iop/iop_host.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // sio2_transfer_data_t (ps2sdk sio2man.h)
+        constexpr uint32_t kStat6c = 0x00u;
+        constexpr uint32_t kStat70 = 0x24u;
+        constexpr uint32_t kRegdata = 0x28u;
+        constexpr uint32_t kStat74 = 0x68u;
+        constexpr uint32_t kInSize = 0x6Cu;
+        constexpr uint32_t kOutSize = 0x70u;
+        constexpr uint32_t kIn = 0x74u;
+        constexpr uint32_t kOut = 0x78u;
+        constexpr uint32_t kInDma = 0x7Cu;  // addr, size (palavras), count
+        constexpr uint32_t kOutDma = 0x88u;
+
+        bool logLigado()
+        {
+            static const bool ligado = [] { const char *e = std::getenv("PS2X_LOG_SIO2"); return e && e[0] == '1'; }();
+            return ligado;
+        }
+    }
+
+    IopSio2::IopSio2(IopMemory &memory, IopHost &host) noexcept
+        : m_memory(memory), m_host(host)
+    {
+    }
+
+    void IopSio2::reset()
+    {
+        m_controles[0] = Controle{};
+        m_controles[1] = Controle{};
+        m_logs = 0u;
+    }
+
+    bool IopSio2::dispatchImport(uint16_t ordinal, IopCpuState &cpu)
+    {
+        switch (ordinal)
+        {
+        case 51: // sio2_transfer(td)
+            transfere(cpu.gpr[4]);
+            cpu.gpr[2] = 1u;
+            return true;
+        case 61: // trava / destrava / reset da transferência (a HLE não tem thread nem hardware)
+        case 62:
+        case 63:
+            cpu.gpr[2] = 0u;
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    void IopSio2::transfere(uint32_t td)
+    {
+        if (td == 0u)
+            return;
+        // entrada: buffer direto ou descritor de DMA
+        uint32_t inAddr = m_memory.read32(td + kIn);
+        uint32_t inTam = m_memory.read32(td + kInSize);
+        if (inAddr == 0u)
+        {
+            inAddr = m_memory.read32(td + kInDma);
+            inTam = m_memory.read32(td + kInDma + 4u) * 4u * std::max<uint32_t>(1u, m_memory.read32(td + kInDma + 8u));
+        }
+        uint32_t outAddr = m_memory.read32(td + kOut);
+        uint32_t outTam = m_memory.read32(td + kOutSize);
+        if (outAddr == 0u)
+        {
+            outAddr = m_memory.read32(td + kOutDma);
+            outTam = m_memory.read32(td + kOutDma + 4u) * 4u * std::max<uint32_t>(1u, m_memory.read32(td + kOutDma + 8u));
+        }
+        inTam = std::min<uint32_t>(inTam, 0x1000u);
+        outTam = std::min<uint32_t>(outTam, 0x1000u);
+        std::vector<uint8_t> entrada(inTam), saida(std::max<uint32_t>(outTam, 1u), 0xFFu);
+        for (uint32_t i = 0; i < inTam; ++i)
+            entrada[i] = m_memory.read8(inAddr + i);
+
+        bool todosPresentes = true;
+        uint32_t pos = 0u;
+        for (uint32_t r = 0; r < 16u; ++r)
+        {
+            const uint32_t reg = m_memory.read32(td + kRegdata + r * 4u);
+            if (reg == 0u)
+                break;
+            const int porta = static_cast<int>(reg & 3u);
+            const uint32_t tamanho = (reg >> 18) & 0x1FFu;
+            if (tamanho == 0u || pos >= inTam)
+                break;
+            const uint32_t n = std::min<uint32_t>(tamanho, std::min<uint32_t>(inTam - pos, static_cast<uint32_t>(saida.size()) - std::min<uint32_t>(pos, static_cast<uint32_t>(saida.size()))));
+            const bool presente = comando(porta, entrada.data() + pos, saida.data() + pos, n);
+            todosPresentes = todosPresentes && presente;
+            if (logLigado() && m_logs < 300u)
+            {
+                ++m_logs;
+                std::fprintf(stderr, "[sio2] porta=%d tam=%u %s in:", porta, tamanho, presente ? "ok" : "vazia");
+                for (uint32_t k = 0; k < std::min<uint32_t>(n, 9u); ++k)
+                    std::fprintf(stderr, " %02x", entrada[pos + k]);
+                std::fprintf(stderr, " out:");
+                for (uint32_t k = 0; k < std::min<uint32_t>(n, 9u); ++k)
+                    std::fprintf(stderr, " %02x", saida[pos + k]);
+                std::fprintf(stderr, "\n");
+            }
+            pos += tamanho;
+        }
+        for (uint32_t i = 0; i < outTam; ++i)
+            m_memory.write8(outAddr + i, saida[i]);
+        m_memory.write32(td + kStat6c, todosPresentes ? 0x1100u : 0x1D100u);
+        m_memory.write32(td + kStat70, 0xFu);
+        m_memory.write32(td + kStat74, 0u);
+    }
+
+    bool IopSio2::comando(int porta, const uint8_t *in, uint8_t *out, uint32_t n)
+    {
+        uint8_t estado[6];
+        if (porta > 1 || n < 3u || in[0] != 0x01u || !m_host.controleDualShock(porta, estado))
+        {
+            std::memset(out, 0xFF, n); // sem dispositivo (cartões do MC2_D: ainda não)
+            return false;
+        }
+        Controle &c = m_controles[porta];
+        uint8_t r[32];
+        std::memset(r, 0x00, sizeof(r));
+        r[0] = 0xFF;
+        r[1] = c.config ? 0xF3u : c.modo;
+        r[2] = 0x5A;
+        const uint8_t cmd = in[1];
+        const uint8_t a = n > 3u ? in[3] : 0u;
+        const uint8_t b = n > 4u ? in[4] : 0u;
+        auto dadosNormais = [&]()
+        {
+            r[3] = estado[0];
+            r[4] = estado[1];
+            if (c.modo != 0x41)
+            {
+                r[5] = estado[2];
+                r[6] = estado[3];
+                r[7] = estado[4];
+                r[8] = estado[5];
+            }
+            if (c.modo == 0x79)
+            {
+                // pressões: direita, esquerda, cima, baixo, triângulo, círculo, xis, quadrado, L1, R1, L2, R2
+                static const uint8_t bits[12][2] = {{0, 5}, {0, 7}, {0, 4}, {0, 6}, {1, 4}, {1, 5}, {1, 6}, {1, 7},
+                                                    {1, 2}, {1, 3}, {1, 0}, {1, 1}};
+                for (int k = 0; k < 12; ++k)
+                    r[9 + k] = ((estado[bits[k][0]] >> bits[k][1]) & 1u) ? 0x00u : 0xFFu;
+            }
+        };
+        switch (cmd)
+        {
+        case 0x42: // ler dados
+            if (!c.config)
+                dadosNormais();
+            break;
+        case 0x43: // entrar/sair da configuração
+            if (!c.config)
+                dadosNormais();
+            c.config = a == 1u;
+            break;
+        case 0x44: // modo digital/analógico
+            if (c.config)
+                c.modo = a ? 0x73u : 0x41u;
+            break;
+        case 0x45: // modelo: DualShock 2
+            r[3] = 0x03; r[4] = 0x02; r[5] = c.modo == 0x41 ? 0x00 : 0x01; r[6] = 0x02; r[7] = 0x01; r[8] = 0x00;
+            break;
+        case 0x46:
+            if (a == 0u) { r[5] = 0x01; r[6] = 0x02; r[7] = 0x00; r[8] = 0x0A; }
+            else { r[5] = 0x01; r[6] = 0x01; r[7] = 0x01; r[8] = 0x14; }
+            break;
+        case 0x47:
+            r[5] = 0x02; r[6] = 0x00; r[7] = 0x01; r[8] = 0x00;
+            break;
+        case 0x4C:
+            r[6] = a == 0u ? 0x04 : 0x07;
+            break;
+        case 0x4D: // alinhamento dos motores: devolve o anterior
+            std::memcpy(r + 3, c.act, 6);
+            for (uint32_t k = 0; k < 6u && 3u + k < n; ++k)
+                c.act[k] = in[3 + k];
+            break;
+        case 0x4F: // máscara de pressão
+            if (c.config)
+                c.modo = (a | b) ? 0x79u : 0x73u;
+            r[8] = 0x5A;
+            break;
+        case 0x40:
+            r[5] = 0x02; r[8] = 0x5A;
+            break;
+        case 0x41:
+            if (c.modo != 0x41) { r[3] = 0xFF; r[4] = 0xFF; r[5] = 0x03; r[8] = 0x5A; }
+            break;
+        default:
+            break;
+        }
+        for (uint32_t k = 0; k < n; ++k)
+            out[k] = k < sizeof(r) ? r[k] : 0x00u;
+        return true;
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_sio2.h b/ps2xIOP/src/emulator/imports/iop_sio2.h
new file mode 100644
index 0000000..7a40eb7
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_sio2.h
@@ -0,0 +1,42 @@
+#pragma once
+// Otavix (30/10): HLE das exportações de transferência do xsio2man (SIO2MAN da IOPRP mais nova): 51 sio2_transfer,
+// 61/62/63 trava/destrava. Responde com um DualShock 2 virtual na porta 0 (controle do PC via IopHost) e "sem
+// dispositivo" nas outras (cartões do MC2_D ainda não). O resto da pilha (SIO2D, DS2U_D, DBCMAN) é o código original.
+
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    class IopHost;
+}
+
+namespace ps2x::iop::detail
+{
+    struct IopCpuState;
+    class IopMemory;
+
+    class IopSio2
+    {
+    public:
+        IopSio2(IopMemory &memory, IopHost &host) noexcept;
+
+        void reset();
+        [[nodiscard]] bool dispatchImport(uint16_t ordinal, IopCpuState &cpu);
+
+    private:
+        struct Controle
+        {
+            bool config = false;
+            uint8_t modo = 0x41; // 0x41 digital, 0x73 analógico, 0x79 analógico com pressão
+            uint8_t act[6] = {0x00, 0x01, 0xFF, 0xFF, 0xFF, 0xFF};
+        };
+
+        void transfere(uint32_t td);
+        bool comando(int porta, const uint8_t *entrada, uint8_t *saida, uint32_t tamanho);
+
+        IopMemory &m_memory;
+        IopHost &m_host;
+        Controle m_controles[2];
+        uint32_t m_logs = 0u;
+    };
+}
