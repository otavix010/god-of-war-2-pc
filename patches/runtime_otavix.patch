+++ b/ps2xRuntime/src/lib/Kernel/otx_guarda.cpp
@@ -0,0 +1,214 @@
+// Otavix (diagnóstico temporário, patch_guarda): armadilha de escrita numa página da RAM do EE durante uma
+// janela (PS2X_GUARDA=1). otxGuardaIni(rdram, end) deixa só-leitura a página do host que contém rdram+end e
+// lembra a thread do EE; qualquer escrita nela gera exceção, o VEH registra [guarda] (thread, se é a do EE,
+// RIP, palavras do topo da pilha do host), libera a página e deixa a escrita seguir. otxGuardaFim() desfaz e
+// avisa se o valor guardado mudou.
+#include "runtime/otx_guarda.h"
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace
+{
+    std::atomic<uintptr_t> g_pagina{0};
+    std::atomic<DWORD> g_threadEe{0};
+    std::atomic<int> g_relatos{0};
+    uint32_t g_end = 0;
+    uint32_t g_valor = 0;
+    PVOID g_veh = nullptr;
+
+    // PS2X_GUARDA=1: página só-leitura na janela (pesado); =2: só compara o valor no fim da janela (leve)
+    int modo()
+    {
+        static const int m = [] { const char *e = std::getenv("PS2X_GUARDA"); return e ? std::atoi(e) : 0; }();
+        return m;
+    }
+    bool ligado() { return modo() != 0; }
+
+    LONG CALLBACK veh(PEXCEPTION_POINTERS ep)
+    {
+        if (ep->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || ep->ExceptionRecord->NumberParameters < 2)
+            return EXCEPTION_CONTINUE_SEARCH;
+        const uintptr_t alvo = static_cast<uintptr_t>(ep->ExceptionRecord->ExceptionInformation[1]);
+        const uintptr_t pag = g_pagina.load();
+        if (pag == 0 || alvo < pag || alvo >= pag + 4096u)
+            return EXCEPTION_CONTINUE_SEARCH;
+        DWORD velho;
+        VirtualProtect(reinterpret_cast<void *>(pag), 4096u, PAGE_READWRITE, &velho);
+        g_pagina.store(0);
+        if (g_relatos.fetch_add(1) < 40)
+        {
+            const CONTEXT *c = ep->ContextRecord;
+            const uint64_t *rsp = reinterpret_cast<const uint64_t *>(c->Rsp);
+            std::fprintf(stderr,
+                         "[guarda] escrita na pagina vigiada (slot ee 0x%x) deslocamento=0x%llx thread=%lu ee=%s rip=%llx base=%llx "
+                         "rsp[0..5]=%llx %llx %llx %llx %llx %llx\n",
+                         g_end, static_cast<unsigned long long>(alvo - pag), GetCurrentThreadId(),
+                         GetCurrentThreadId() == g_threadEe.load() ? "sim" : "NAO", static_cast<unsigned long long>(c->Rip),
+                         static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(GetModuleHandleA(nullptr))),
+                         static_cast<unsigned long long>(rsp[0]), static_cast<unsigned long long>(rsp[1]),
+                         static_cast<unsigned long long>(rsp[2]), static_cast<unsigned long long>(rsp[3]),
+                         static_cast<unsigned long long>(rsp[4]), static_cast<unsigned long long>(rsp[5]));
+            std::fflush(stderr);
+        }
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+}
+
+void otxGuardaIni(uint8_t *rdram, uint32_t end)
+{
+    if (!ligado())
+        return;
+    if (!g_veh)
+        g_veh = AddVectoredExceptionHandler(1, veh);
+    end &= 0x1FFFFFF0u;
+    g_end = end;
+    std::memcpy(&g_valor, rdram + end, 4);
+    g_threadEe.store(GetCurrentThreadId());
+    if ((g_valor < 0x100000u || g_valor >= 0x2000000u) && g_relatos.fetch_add(1) < 40)
+    {
+        std::fprintf(stderr, "[guarda] ra JA RUIM no sq: slot 0x%x = 0x%x (thread %lu)\n", end, g_valor, GetCurrentThreadId());
+        std::fflush(stderr);
+    }
+    if (modo() != 1)
+        return;
+    const uintptr_t pag = reinterpret_cast<uintptr_t>(rdram + end) & ~static_cast<uintptr_t>(4095);
+    DWORD velho;
+    if (VirtualProtect(reinterpret_cast<void *>(pag), 4096u, PAGE_READONLY, &velho))
+        g_pagina.store(pag);
+}
+
+void otxGuardaFim(uint8_t *rdram, uint32_t end)
+{
+    if (!ligado())
+        return;
+    const uintptr_t pag = g_pagina.exchange(0);
+    if (pag)
+    {
+        DWORD velho;
+        VirtualProtect(reinterpret_cast<void *>(pag), 4096u, PAGE_READWRITE, &velho);
+    }
+    end &= 0x1FFFFFF0u;
+    uint32_t agora;
+    std::memcpy(&agora, rdram + end, 4);
+    if ((agora < 0x100000u || agora >= 0x2000000u) && g_relatos.fetch_add(1) < 40)
+    {
+        std::fprintf(stderr, "[guarda] ra a restaurar em 0x%x = 0x%x (no Ini era 0x%x, slot do Ini 0x%x, thread %lu)\n", end,
+                     agora, g_valor, g_end, GetCurrentThreadId());
+        std::fflush(stderr);
+    }
+    else if (end == g_end && agora != g_valor && g_relatos.fetch_add(1) < 40)
+    {
+        std::fprintf(stderr, "[guarda] slot 0x%x mudou 0x%x -> 0x%x dentro da janela (thread %lu)\n", end, g_valor, agora,
+                     GetCurrentThreadId());
+        std::fflush(stderr);
+    }
+}
+
+// canário: otxCanarioIni anota a palavra em 'end'; otxCanario confere depois de cada chamada e registra a
+// primeira chamada depois da qual ela mudou (com as 16 palavras em volta)
+namespace
+{
+    // valor esperado por endereço de slot (aninhamento em pilhas diferentes não atrapalha)
+    std::mutex g_canMtx;
+    std::vector<std::pair<uint32_t, uint32_t>> g_can;
+    int g_canRelatos = 0;
+}
+
+void otxCanarioIni(uint8_t *rdram, uint32_t end)
+{
+    if (!ligado())
+        return;
+    end &= 0x1FFFFFF0u;
+    uint32_t v;
+    std::memcpy(&v, rdram + end, 4);
+    std::lock_guard<std::mutex> lk(g_canMtx);
+    for (auto &e : g_can)
+        if (e.first == end)
+        {
+            e.second = v;
+            return;
+        }
+    g_can.emplace_back(end, v);
+}
+
+void otxCanario(uint8_t *rdram, uint32_t end, uint32_t pcRetorno)
+{
+    if (!ligado())
+        return;
+    end &= 0x1FFFFFF0u;
+    uint32_t agora;
+    std::memcpy(&agora, rdram + end, 4);
+    std::lock_guard<std::mutex> lk(g_canMtx);
+    for (auto &e : g_can)
+        if (e.first == end)
+        {
+            if (agora != e.second && g_canRelatos++ < 20)
+            {
+                std::fprintf(stderr, "[canario] slot 0x%x mudou 0x%x -> 0x%x; detectado no retorno 0x%x; em volta:", end, e.second,
+                             agora, pcRetorno);
+                for (int i = -8; i < 8; ++i)
+                {
+                    uint32_t w;
+                    std::memcpy(&w, rdram + end + i * 4, 4);
+                    std::fprintf(stderr, " %08x", w);
+                }
+                std::fprintf(stderr, "\n");
+                std::fflush(stderr);
+            }
+            e.second = agora;
+            return;
+        }
+    static int desconhecidos = 0;
+    if (desconhecidos++ < 20)
+    {
+        std::fprintf(stderr, "[canario] slot 0x%x NUNCA anotado (sp de outro quadro?) valor=0x%x retorno 0x%x\n", end, agora, pcRetorno);
+        std::fflush(stderr);
+    }
+}
+// sp antes de uma chamada e conferência na volta (registra o destino que desequilibrou a pilha)
+namespace
+{
+    uint32_t g_spAntes = 0, g_spAlvo = 0;
+    bool g_spValido = false;
+}
+
+void otxSpGuarda(uint32_t sp, uint32_t alvo)
+{
+    if (!ligado())
+        return;
+    g_spAntes = sp;
+    g_spAlvo = alvo;
+    g_spValido = true;
+}
+
+void otxSpConfere(uint32_t sp, uint32_t pcVolta)
+{
+    if (!ligado() || !g_spValido)
+        return;
+    g_spValido = false;
+    static int relatos = 0;
+    if (sp != g_spAntes && relatos++ < 20)
+    {
+        std::fprintf(stderr, "[sp-volta] chamada para 0x%x voltou em 0x%x com sp 0x%x (antes 0x%x, diferença %d)\n", g_spAlvo, pcVolta,
+                     sp, g_spAntes, static_cast<int>(sp - g_spAntes));
+        std::fflush(stderr);
+    }
+}
+#else
+void otxSpGuarda(uint32_t, uint32_t) {}
+void otxSpConfere(uint32_t, uint32_t) {}
+void otxCanarioIni(uint8_t *, uint32_t) {}
+void otxCanario(uint8_t *, uint32_t, uint32_t) {}
+void otxGuardaIni(uint8_t *, uint32_t) {}
+void otxGuardaFim(uint8_t *, uint32_t) {}
+#endif
