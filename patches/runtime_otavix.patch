+        uint32_t rvAddr(const Nucleo &c, uint32_t off) const;
+        static int32_t volume(uint16_t reg);
+        static void varre(uint16_t reg, int32_t &atual, int32_t &espera);
+        void escreveCore(int n, uint32_t r, uint16_t v);
+        uint16_t leCore(int n, uint32_t r);
+
+        std::vector<uint16_t> m_ram;
