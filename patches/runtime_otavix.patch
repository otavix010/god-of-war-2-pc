+            static double minMs = 1.0;
+            if (minPrims < 0)
+            {
+                minPrims = 2048;
+                if (const char *e = std::getenv("PS2X_GS_GPU_SOLTA"))
+                    std::sscanf(e, "%d,%lf", &minPrims, &minMs);
+            }
+            if (m_prims.empty())
+                return;
+            if (static_cast<int>(m_prims.size()) >= minPrims || agoraMs() - m_tPrimeira >= minMs)
+                descarregaPor("solta");
+        }
+        void descarregaPor(const char *motivo);
+        void desceAssinc(const std::vector<std::pair<uint32_t, uint32_t>> &faixas, uint8_t *destino,
+                         std::shared_future<void> &pronto) override
+        {
+            for (const auto &f : faixas)
+                if (!m_prims.empty() && tocaFaixa(m_escreve, f.first, f.second))
+                {
+                    descarregaPor("exibe-assinc");
+                    break;
+                }
+            std::bitset<kPaginas> quer;
+            for (const auto &f : faixas)
+                poeFaixa(quer, f.first, f.second);
+            std::vector<uint32_t> pags;
+            for (uint32_t p = 0; p < kPaginas; ++p)
+                if (quer.test(p) && m_estado[p] >= 2u)
+                    pags.push_back(p);
