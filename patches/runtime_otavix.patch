diff --git a/ps2xIOP/src/emulator/imports/iop_formata.h b/ps2xIOP/src/emulator/imports/iop_formata.h
new file mode 100644
index 0000000..0ac83bd
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_formata.h
@@ -0,0 +1,168 @@
+#pragma once
+// Otavix (30/10): formatação estilo printf para as funções do IOP (sysclib sprintf/vsprintf, stdio printf,
+// sysmem Kprintf). Antes elas copiavam só o texto do formato: o SMPD_IOP do God of War monta nomes de recurso com
+// sprintf e nunca achava nada. Argumentos pelo ABI o32 do IOP: os primeiros nos registradores a0-a3 e o resto na
+// pilha a partir de sp+0x10 (ArgsRegistro), ou numa área contígua de palavras (va_list do vsprintf, ArgsMemoria).
+
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    // Lê os argumentos variáveis a partir do registrador 'primeiro' (4 = a0 ... 7 = a3); os seguintes vêm da pilha.
+    class IopArgsRegistro
+    {
+    public:
+        IopArgsRegistro(const IopMemory &memoria, const IopCpuState &cpu, uint32_t primeiro)
+            : m_memoria(memoria), m_cpu(cpu), m_proximo(primeiro) {}
+
+        uint32_t proximo()
+        {
+            const uint32_t i = m_proximo++;
+            if (i <= 7u)
+                return m_cpu.gpr[i];
+            // o32: o argumento n (a partir de 0 = a0) fica em sp + 4n; os 16 bytes iniciais são a área de a0-a3
+            return m_memoria.read32(m_cpu.gpr[29] + (i - 4u) * 4u);
+        }
+
+    private:
+        const IopMemory &m_memoria;
+        const IopCpuState &m_cpu;
+        uint32_t m_proximo;
+    };
+
+    // va_list: palavras seguidas na memória
+    class IopArgsMemoria
+    {
+    public:
+        IopArgsMemoria(const IopMemory &memoria, uint32_t endereco) : m_memoria(memoria), m_endereco(endereco) {}
+        uint32_t proximo()
+        {
+            const uint32_t v = m_memoria.read32(m_endereco);
+            m_endereco += 4u;
+            return v;
+        }
+
+    private:
+        const IopMemory &m_memoria;
+        uint32_t m_endereco;
+    };
+
+    template <typename Args>
+    std::string iopFormata(const IopMemory &memoria, uint32_t formato, Args &&args)
+    {
+        const std::string f = memoria.readString(formato, 4096u);
+        std::string saida;
+        for (size_t i = 0; i < f.size(); ++i)
+        {
+            if (f[i] != '%')
+            {
+                saida.push_back(f[i]);
+                continue;
+            }
+            if (i + 1 < f.size() && f[i + 1] == '%')
+            {
+                saida.push_back('%');
+                ++i;
+                continue;
+            }
+            // %[flags][largura][.precisão][h|hh|l|ll]conversão
+            std::string spec = "%";
+            size_t j = i + 1;
+            while (j < f.size() && std::string("-+ #0").find(f[j]) != std::string::npos)
+                spec.push_back(f[j++]);
+            if (j < f.size() && f[j] == '*')
+            {
+                spec += std::to_string(static_cast<int32_t>(args.proximo()));
+                ++j;
+            }
+            while (j < f.size() && f[j] >= '0' && f[j] <= '9')
+                spec.push_back(f[j++]);
+            if (j < f.size() && f[j] == '.')
+            {
+                spec.push_back(f[j++]);
+                if (j < f.size() && f[j] == '*')
+                {
+                    spec += std::to_string(static_cast<int32_t>(args.proximo()));
+                    ++j;
+                }
+                while (j < f.size() && f[j] >= '0' && f[j] <= '9')
+                    spec.push_back(f[j++]);
+            }
+            int longos = 0;
+            while (j < f.size() && (f[j] == 'h' || f[j] == 'l' || f[j] == 'z' || f[j] == 't' || f[j] == 'q'))
+            {
+                if (f[j] == 'l' || f[j] == 'q')
+                    ++longos;
+                ++j;
+            }
+            if (j >= f.size())
+                break;
+            const char c = f[j];
+            char buf[512];
+            buf[0] = '\0';
+            switch (c)
+            {
+            case 'd':
+            case 'i':
+            {
+                spec.push_back('l');
+                spec.push_back('l');
+                spec.push_back(c);
+                long long v = static_cast<int32_t>(args.proximo());
+                if (longos >= 2)
+                    v = static_cast<long long>((static_cast<uint64_t>(args.proximo()) << 32u) | static_cast<uint32_t>(v));
+                std::snprintf(buf, sizeof(buf), spec.c_str(), v);
+                break;
+            }
+            case 'u':
+            case 'x':
+            case 'X':
+            case 'o':
+            {
+                spec.push_back('l');
+                spec.push_back('l');
+                spec.push_back(c);
+                unsigned long long v = args.proximo();
+                if (longos >= 2)
+                    v |= static_cast<unsigned long long>(args.proximo()) << 32u;
+                std::snprintf(buf, sizeof(buf), spec.c_str(), v);
+                break;
+            }
+            case 'p':
+                std::snprintf(buf, sizeof(buf), "0x%08x", args.proximo());
+                break;
+            case 'c':
+                spec.push_back('c');
+                std::snprintf(buf, sizeof(buf), spec.c_str(), static_cast<int>(args.proximo() & 0xFFu));
+                break;
+            case 's':
+            {
+                const uint32_t p = args.proximo();
+                const std::string s = p ? memoria.readString(p, 4096u) : std::string("(null)");
+                spec.push_back('s');
+                std::snprintf(buf, sizeof(buf), spec.c_str(), s.c_str());
+                break;
+            }
+            case 'f':
+            case 'e':
+            case 'g':
+                // o IOP não tem ponto flutuante: consome uma palavra e escreve como inteiro
+                std::snprintf(buf, sizeof(buf), "%d", static_cast<int32_t>(args.proximo()));
+                break;
+            default:
+                spec.push_back(c);
+                saida += spec;
+                i = j;
+                continue;
+            }
+            saida += buf;
+            i = j;
+        }
+        return saida;
+    }
+}
