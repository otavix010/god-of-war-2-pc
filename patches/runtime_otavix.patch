+    void GsGpu::reproduz(const char *arq)
+    {
+        std::FILE *f = std::fopen(arq, "rb");
+        if (!f)
+        {
+            std::printf("[gs-gpu-reproduz] não abriu %s\n", arq);
+            return;
+        }
+        std::vector<uint8_t> dados;
+        {
+            std::fseek(f, 0, SEEK_END);
+            const long n = std::ftell(f);
+            std::fseek(f, 0, SEEK_SET);
+            dados.resize(static_cast<size_t>(std::max(n, 0L)));
+            if (!dados.empty() && std::fread(dados.data(), 1, dados.size(), f) != dados.size())
+                dados.clear();
+            std::fclose(f);
+        }
+        const size_t vramN = static_cast<size_t>(kPaginas) * kPagBytes;
+        if (dados.size() < 4u + vramN || std::memcmp(dados.data(), "OTXG", 4) != 0)
+        {
+            std::printf("[gs-gpu-reproduz] arquivo inválido\n");
+            return;
+        }
+        const uint8_t *vram0 = dados.data() + 4;
+        const uint8_t *p = vram0 + vramN, *fim = dados.data() + dados.size();
+        std::vector<Cmd> cmds;
+        uint64_t prims = 0, tiles = 0;
+        while (fim - p >= 16)
+        {
+            uint32_t cab[4];
+            std::memcpy(cab, p, 16);
+            p += 16;
+            Cmd c;
+            c.tipo = static_cast<int>(cab[0]);
+            c.copia = cab[1] != 0u;
+            c.copiaA = cab[2];
+            c.copiaB = cab[3];
+            if (!otxLeVec(p, fim, c.sobePag) || !otxLeVec(p, fim, c.sobe) || !otxLeVec(p, fim, c.prims) || !otxLeVec(p, fim, c.ests) ||
+                !otxLeVec(p, fim, c.tiles) || !otxLeVec(p, fim, c.lista) || !otxLeVec(p, fim, c.luts) || !otxLeVec(p, fim, c.caixas) ||
+                !otxLeVec(p, fim, c.mesclaPag) || !otxLeVec(p, fim, c.mescla))
+                break;
+            prims += c.prims.size();
+            tiles += c.tiles.size() / 4u;
+            cmds.push_back(std::move(c));
+        }
+        static const int vezes = [] { const char *e = std::getenv("PS2X_GS_GPU_REPRODUZ_N"); return e ? std::max(1, std::atoi(e)) : 5; }();
+        std::printf("[gs-gpu-reproduz] %zu comandos, %llu primitivas, %llu tiles, %d vezes\n", cmds.size(),
+                    static_cast<unsigned long long>(prims), static_cast<unsigned long long>(tiles), vezes);
+        std::vector<uint8_t> vram(vramN);
+        double melhor = 1e30, soma = 0.0;
+        for (int v = 0; v < vezes; ++v)
+        {
+            for (GLuint b : {m_buf[0], m_buf[6]})
+            {
+                p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, b);
+                p_glBufferSubData(kGL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(vramN), vram0);
+            }
+            glFinish();
+            const auto t0 = std::chrono::steady_clock::now();
+            for (Cmd &c : cmds)
+                executa(c);
+            glFinish();
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            melhor = std::min(melhor, ms);
+            soma += ms;
+            p_glMemoryBarrier(kGL_ALL_BARRIER_BITS);
+            p_glBindBuffer(kGL_SHADER_STORAGE_BUFFER, m_buf[0]);
+            p_glGetBufferSubData(kGL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(vramN), vram.data());
+            // páginas diferentes da 1ª vez (o efeito do GoW 1 com quadro e Z no mesmo endereço é uma corrida na GPU)
+            static std::vector<uint8_t> prim1;
+            static std::vector<bool> instavel(kPaginas, false);
+            std::string dif;
+            int nDif = 0;
+            if (v == 0)
+                prim1 = vram;
+            else
+                for (uint32_t pg = 0; pg < kPaginas; ++pg)
+                    if (std::memcmp(prim1.data() + pg * kPagBytes, vram.data() + pg * kPagBytes, kPagBytes) != 0)
+                    {
+                        instavel[pg] = true;
+                        if (nDif++ < 12)
+                            dif += " " + std::to_string(pg);
+                    }
+            if (v == vezes - 1)
+            {
+                // hash só das páginas que não mudaram entre as vezes: compara variantes do shader apesar da corrida
+                uint64_t h = 1469598103934665603ull;
+                int nEst = 0;
+                for (uint32_t pg = 0; pg < kPaginas; ++pg)
+                    if (!instavel[pg])
+                    {
+                        h = (h ^ otxFnv(prim1.data() + pg * kPagBytes, kPagBytes)) * 1099511628211ull;
+                        ++nEst;
+                    }
+                std::printf("[gs-gpu-reproduz] hash_estavel=%016llx (%d pags)\n", static_cast<unsigned long long>(h), nEst);
+                if (const char *sai = std::getenv("PS2X_GS_GPU_REPRODUZ_SAI")) // VRAM final da 1ª vez, para comparar fora
+                    if (std::FILE *fs = std::fopen(sai, "wb"))
+                    {
+                        std::fwrite(prim1.data(), 1, prim1.size(), fs);
+                        std::fclose(fs);
+                    }
+            }
+            std::printf("[gs-gpu-reproduz] vez %d: %.1f ms (%.1f ns/prim) hash=%016llx difere da 1a em %d pags:%s\n", v + 1, ms,
+                        ms * 1e6 / std::max<double>(1.0, double(prims)), static_cast<unsigned long long>(otxFnv(vram.data(), vram.size())),
+                        nDif, dif.c_str());
+            std::fflush(stdout);
+        }
+        std::printf("[gs-gpu-reproduz] melhor=%.1f ms media=%.1f ms\n", melhor, soma / vezes);
+    }
+
+    bool GsGpu::desceComFence(Cmd &c, GLbitfield barreira)
+    {
+        static const bool liga = [] { const char *e = std::getenv("PS2X_GS_GPU_DESCE_FENCE"); return !(e && e[0] == '0'); }();
+        if (!liga || !p_glFenceSync || !p_glClientWaitSync || !p_glDeleteSync || !p_glCopyBufferSubData)
+            return false;
+        size_t bytes = 0;
+        for (const auto &r : c.descePag)
+            bytes += static_cast<size_t>(r.second) * kPagBytes;
+        DescePend d;
+        if (!m_desceLivres.empty())
+        {
+            d = std::move(m_desceLivres.back());
+            m_desceLivres.pop_back();
+        }
+        if (!d.buf)
+            p_glGenBuffers(1, &d.buf);
+        p_glMemoryBarrier(barreira);
+        p_glBindBuffer(0x8F37, d.buf); // GL_COPY_WRITE_BUFFER
+        if (d.cap < bytes)
+        {
+            d.cap = bytes;
+            p_glBufferData(0x8F37, static_cast<GLsizeiptr>(bytes), nullptr, 0x88E1u); // GL_STREAM_READ
+        }
+        p_glBindBuffer(0x8F36, m_buf[0]); // GL_COPY_READ_BUFFER
+        size_t o = 0;
+        for (const auto &r : c.descePag)
+        {
+            const size_t n = static_cast<size_t>(r.second) * kPagBytes;
+            p_glCopyBufferSubData(0x8F36, 0x8F37, static_cast<GLintptr>(r.first) * kPagBytes, static_cast<GLintptr>(o),
+                                  static_cast<GLsizeiptr>(n));
+            o += n;
+        }
+        d.fence = p_glFenceSync(0x9117u, 0u); // GL_SYNC_GPU_COMMANDS_COMPLETE
+        glFlush(); // a fence só anda se os comandos forem para a GPU
+        d.runs = std::move(c.descePag);
+        d.destino = c.destino;
+        d.pronto = std::move(c.prontoAssinc);
+        m_descePend.push_back(std::move(d));
+        return true;
+    }
+
+    // entrega as descidas cuja cópia a GPU já terminou (em ordem); espera=true: todas (fim da thread)
+    void GsGpu::terminaDescidas(bool espera)
+    {
+        while (!m_descePend.empty())
+        {
+            DescePend &d = m_descePend.front();
+            // Otavix (02/11): só a espera final faz flush; a consulta (timeout 0) com SYNC_FLUSH_COMMANDS_BIT mandava os comandos
+            // para a GPU a cada volta do laço (27% da thread da GPU no driver, no perfil do notebook); o glFlush da criação basta
+            const GLenum r = p_glClientWaitSync(d.fence, espera ? 0x00000001u : 0u, espera ? 2000000000ull : 0ull);
+            if (r != 0x911Au && r != 0x911Cu && r != 0x911Du) // ALREADY_SIGNALED, CONDITION_SATISFIED, WAIT_FAILED
+                return;
+            p_glDeleteSync(d.fence);
+            d.fence = nullptr;
+            p_glBindBuffer(0x8F36, d.buf);
+            size_t o = 0;
+            for (const auto &run : d.runs)
+            {
+                const size_t n = static_cast<size_t>(run.second) * kPagBytes;
+                p_glGetBufferSubData(0x8F36, static_cast<GLintptr>(o), static_cast<GLsizeiptr>(n),
+                                     d.destino + static_cast<size_t>(run.first) * kPagBytes);
+                o += n;
+            }
+            d.pronto->set_value();
+            d.pronto.reset();
+            d.runs.clear();
+            d.destino = nullptr;
+            m_desceLivres.push_back(std::move(d));
+            m_descePend.pop_front();
+        }
+    }
+
+    void GsGpu::desce(const std::vector<std::pair<uint32_t, uint32_t>> &runs, uint8_t *destino)
+    {
+        if (runs.empty())
+            return;
+        const double t0 = agoraMs();
+        std::promise<void> pronto;
+        auto f = pronto.get_future();
+        Cmd c;
+        c.tipo = 1;
+        c.descePag = runs;
+        c.destino = destino;
+        c.pronto = &pronto;
+        poe(std::move(c));
+        f.wait();
+        m_msEspera += agoraMs() - t0;
+        ++m_nDescidas;
+        for (const auto &r : runs)
+            m_nPagDesce += r.second;
+    }
+
+    // Otavix (31/10): só mede com PS2X_GS_GPU_CRONO=1 (duas leituras do relógio por lote custavam ~9% da thread de desenho)
+    bool otxCronoLigado()
+    {
+        static const bool l = [] { const char *e = std::getenv("PS2X_GS_GPU_CRONO"); return e && e[0] == '1'; }();
+        return l;
+    }
+
+    struct OtxCrono
+    {
+        double &soma;
+        const bool ligado = otxCronoLigado();
+        std::chrono::steady_clock::time_point t0 = ligado ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        explicit OtxCrono(double &s) : soma(s) {}
+        ~OtxCrono()
+        {
+            if (ligado)
+                soma += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        }
+    };
+
+    bool GsGpu::adiciona(const GSPrimitiveBatch &batch, const uint32_t *lut, const Paginas &pg, const PrimPre *pre)
+    {
+        const OtxCrono otxCr(m_msAdiciona);
+        const GSDrawState &state = batch.state;
+        const auto &ctx = state.context;
+        bool realim = false;
+        // linhas e pontos: a CPU não usa textura neles (DrawLine/WritePixel); viram pixels prontos (tipo 2)
+        const bool linha = state.prim.type == GS_PRIM_LINE || state.prim.type == GS_PRIM_LINESTRIP || state.prim.type == GS_PRIM_POINT;
+        const bool tme = state.prim.tme && !linha;
+        switch (ctx.frame.psm)
+        {
+        case 0u: case 1u: case 2u: case 10u: case 48u: case 49u: case 50u: case 58u: break;
+        default: return false;
+        }
+        // Otavix (01/11): quadro e Z no mesmo endereço, os dois gravados (efeito do GoW 1 num buffer de 64 px): o Z de um
+        // pixel cai na palavra do quadro de outro (tabelas de desentrelaçamento diferentes) e na GPU a ordem entre eles é a
+        // do escalonamento. Mandar para a CPU é exato mas custa uma descida por lote (~240/s no GoW 1: -15% no notebook);
+        // só com PS2X_GS_GPU_ALIAS_CPU=1 ou no CONFERE (que prova o resto bit a bit)
+        static const bool aliasCpu = [] { const char *e = std::getenv("PS2X_GS_GPU_ALIAS_CPU"); return (e && e[0] == '1') || confere(); }();
+        if (aliasCpu && ctx.frame.fbp == ctx.zbuf.zbp && !ctx.zbuf.zmask && ctx.frame.fbmsk != 0xFFFFFFFFu && ((ctx.test >> 17) & 3u) != 0u)
+            return false;
+        // Otavix (31/10): retângulo da textura que o desenho lê (texels, com 1 de margem para o bilinear e o arredondamento);
+        // fora da textura (repetição) ou q <= 0: a textura inteira
+        const auto leEscrito = [&]() -> bool
+        {
+            if (!tocaFaixa(m_escreve, pg.t0, pg.t1))
+                return false;
+            const int tw = static_cast<int>(state.textureWidth), th = static_cast<int>(state.textureHeight);
+            float u0 = 1e30f, v0 = 1e30f, u1 = -1e30f, v1 = -1e30f;
+            bool inteira = tw <= 0 || th <= 0;
+            const uint32_t nv = std::min<uint32_t>(batch.vertexCount, 3u);
+            for (uint32_t i = 0; i < nv && !inteira; ++i)
+            {
+                const GSVertex &vv = batch.vertices[i];
+                float u, v;
+                if (state.prim.fst)
+                {
+                    u = static_cast<float>(vv.u) / 16.0f;
+                    v = static_cast<float>(vv.v) / 16.0f;
+                }
+                else
+                {
+                    if (!(vv.q > 0.0f))
+                    {
+                        inteira = true;
+                        break;
+                    }
+                    u = vv.s / vv.q * static_cast<float>(tw);
+                    v = vv.t / vv.q * static_cast<float>(th);
+                }
+                if (!(std::isfinite(u) && std::isfinite(v)))
+                    inteira = true;
+                u0 = std::min(u0, u); v0 = std::min(v0, v);
+                u1 = std::max(u1, u); v1 = std::max(v1, v);
+            }
+            int x0 = 0, y0 = 0, x1 = tw - 1, y1 = th - 1;
+            if (!inteira)
+            {
+                // Otavix (02/11): sprite com UV inteiro (fst) é exato (ponto fixo de 1/16): só os texels que o filtro pega, sem a
+                // margem de 1. Com a margem, v0=0,5 dava -1 e caía na textura inteira; as faixas de 32 px do GoW 1 (fbw=8,
+                // fbp=0/208/320) fechavam um lote cada (~6,5 mil "realim-le" por intervalo). PS2X_GS_GPU_SPRITE_EXATO=0 volta
+                static const bool spriteExato = [] { const char *e = std::getenv("PS2X_GS_GPU_SPRITE_EXATO"); return !(e && e[0] == '0'); }();
