+// Otavix (patch_mtvu): thread gráfica. Recebe, em ordem, as cadeias de GIF/VIF1 já copiadas da RAM e as
+// escritas nos registradores de exibição do GS; o EE segue sem esperar (como o MTVU do PCSX2).
+namespace
+{
+    struct OtxFilaGrafica
+    {
+        std::mutex m;
+        std::condition_variable temTrabalho, vazia, andou;
+        std::deque<std::function<void()>> fila;
+        std::atomic<uint64_t> pendentes{0};
+        std::atomic<uint64_t> postados{0}, feitos{0};
+        std::atomic<uint32_t> vif1StatQuieto{0}; // VIF1_STAT no fim da última cadeia processada
+        // quem espera avisa o que espera: feitos >= alvoFeitos, ou a fila abaixo de limiteFila (só acorda nesses casos)
+        std::atomic<uint64_t> alvoFeitos{~0ull};
+        std::atomic<uint64_t> limiteFila{0};
+        bool iniciada = false;
+    };
+    OtxFilaGrafica g_otxG;
+    thread_local bool t_otxSouGrafico = false;
+
+    // Otavix (patch_mtvu): 4º estágio, o frontend do GS (pacotes GIF → registradores/vértices → backend), atrás
+    // da thread gráfica (PS2X_MTVU_FRONT=1, padrão com o MTVU)
+    OtxFilaGrafica g_otxF;
+    thread_local bool t_otxSouFrontend = false;
+}
+extern std::atomic<uint64_t> g_otxPrimsFrontend; // gs_thread_backend.cpp (Submit)
+namespace
+{
+
+    bool g_otxFDormindo = false; // sob g_otxF.m
+
+    void otxLacoFrontend()
+    {
+        t_otxSouFrontend = true;
+        otxPerfilRegistra("frontend");
+        static const bool emLote = [] { const char *e = std::getenv("PS2X_MTVU_LOTE_FILA"); return !(e && e[0] == '0'); }();
+        std::deque<std::function<void()>> lote; // Otavix (fila em lote): pega tudo num lock só
+        for (;;)
+        {
+            std::function<void()> f;
+            if (lote.empty())
+            {
+                std::unique_lock<std::mutex> lk(g_otxF.m);
+                if (g_otxF.fila.empty())
+                {
+                    g_otxFDormindo = true;
+                    otxLinhaTempo("gsf-vazio");
+                    g_otxF.temTrabalho.wait(lk, [] { return !g_otxF.fila.empty(); });
+                    g_otxFDormindo = false;
+                    otxLinhaTempo("gsf-acorda", static_cast<uint32_t>(std::hash<std::thread::id>{}(std::this_thread::get_id())));
+                }
+                if (emLote)
+                    lote.swap(g_otxF.fila);
+                else
+                {
+                    lote.push_back(std::move(g_otxF.fila.front()));
+                    g_otxF.fila.pop_front();
+                }
+            }
+            f = std::move(lote.front());
+            lote.pop_front();
+            // Otavix (02/11): tempo ocupado do frontend por primitiva a cada 2 s ([gs-frontend]); o frontend é um elo da
+            // cadeia do quadro (o FINISH sai dele) e o tempo por trecho depende da cena: ns/prim compara rodadas
+            static uint64_t otxNsF = 0, otxPrims0 = 0;
+            static auto otxUltF = std::chrono::steady_clock::now();
+            const auto otxTf0 = std::chrono::steady_clock::now();
+            f();
+            const auto otxTf1 = std::chrono::steady_clock::now();
+            otxNsF += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(otxTf1 - otxTf0).count());
+            if (otxTf1 - otxUltF >= std::chrono::seconds(2))
+            {
+                const uint64_t p = g_otxPrimsFrontend.load(std::memory_order_relaxed);
+                std::printf("[gs-frontend] ocupado=%.0fms prims=%llu ns/prim=%.1f\n", otxNsF / 1e6, static_cast<unsigned long long>(p - otxPrims0),
+                            p > otxPrims0 ? double(otxNsF) / double(p - otxPrims0) : 0.0);
+                otxNsF = 0;
+                otxPrims0 = p;
+                otxUltF = otxTf1;
+            }
+            f = nullptr;
+            const bool esvaziou = g_otxF.pendentes.fetch_sub(1u, std::memory_order_acq_rel) == 1u;
+            const uint64_t lim = g_otxF.limiteFila.load(std::memory_order_acquire);
+            if (esvaziou || (lim != 0u && g_otxF.pendentes.load(std::memory_order_acquire) < lim))
+            {
+                {
+                    std::lock_guard<std::mutex> lk(g_otxF.m);
+                }
+                g_otxF.vazia.notify_all();
+                g_otxF.andou.notify_all();
+            }
+        }
+    }
+
+    void otxLacoGrafico()
+    {
+        t_otxSouGrafico = true;
+        otxPerfilRegistra("grafico");
+        uint64_t nsOcioso = 0, nsTrabalho = 0, nsFim = 0, tarefas = 0;
+        auto ult = std::chrono::steady_clock::now();
+        // Otavix (fila em lote): pega TODAS as tarefas da fila num lock só (antes: um lock por tarefa, disputado com o
+        // EE que posta ~15 mil/s). PS2X_MTVU_LOTE_FILA=0 volta a uma por vez.
+        static const bool emLote = [] { const char *e = std::getenv("PS2X_MTVU_LOTE_FILA"); return !(e && e[0] == '0'); }();
+        std::deque<std::function<void()>> lote;
+        for (;;)
+        {
+            std::function<void()> f;
+            const auto t0 = std::chrono::steady_clock::now();
+            if (lote.empty())
+            {
+                std::unique_lock<std::mutex> lk(g_otxG.m);
+                const bool otxVazia = g_otxG.fila.empty();
+                if (otxVazia)
+                    otxLinhaTempo("vu1-vazio");
+                g_otxG.temTrabalho.wait(lk, [] { return !g_otxG.fila.empty(); });
+                if (otxVazia)
+                    otxLinhaTempo("vu1-acorda", static_cast<uint32_t>(std::hash<std::thread::id>{}(std::this_thread::get_id())));
+                if (emLote)
+                    lote.swap(g_otxG.fila);
+                else
+                {
+                    lote.push_back(std::move(g_otxG.fila.front()));
+                    g_otxG.fila.pop_front();
+                }
+            }
+            f = std::move(lote.front());
+            lote.pop_front();
+            const auto t1 = std::chrono::steady_clock::now();
+            f();
+            const auto t1b = std::chrono::steady_clock::now();
+            otxEntregaFrontend(); // antes de contar a tarefa como feita (o sinc espera os dois estágios)
+            const auto t2 = std::chrono::steady_clock::now();
+            static uint64_t nsEntrega = 0, nsAcorda = 0, nAcorda = 0;
+            nsEntrega += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t2 - t1b).count());
+            f = nullptr;
+            const auto t3 = std::chrono::steady_clock::now();
+            nsOcioso += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+            nsTrabalho += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t2 - t1).count());
+            nsFim += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t3 - t2).count());
+            ++tarefas;
+            if (t3 - ult >= std::chrono::seconds(10))
+            {
+                ult = t3;
+                std::cout << "[mtvu:grafico] tarefas=" << tarefas << " ocioso=" << nsOcioso / 1000000u << "ms trabalho="
+                          << nsTrabalho / 1000000u << "ms destruir=" << nsFim / 1000000u << "ms entrega=" << nsEntrega / 1000000u
+                          << "ms acorda=" << nsAcorda / 1000000u << "ms(" << nAcorda << ")" << std::endl;
+                nsOcioso = nsTrabalho = nsFim = tarefas = 0;
+                nsEntrega = nsAcorda = nAcorda = 0;
+            }
+            const uint64_t feitos = g_otxG.feitos.fetch_add(1u, std::memory_order_acq_rel) + 1u;
+            const bool esvaziou = g_otxG.pendentes.fetch_sub(1u, std::memory_order_acq_rel) == 1u;
+            const uint64_t lim = g_otxG.limiteFila.load(std::memory_order_acquire);
+            const bool acorda = esvaziou || feitos >= g_otxG.alvoFeitos.load(std::memory_order_acquire) ||
+                                (lim != 0u && g_otxG.pendentes.load(std::memory_order_acquire) < lim);
+            if (acorda)
+            {
+                const auto ta = std::chrono::steady_clock::now();
+                {
+                    std::lock_guard<std::mutex> lk(g_otxG.m);
+                }
+                g_otxG.vazia.notify_all();
+                g_otxG.andou.notify_all();
+                nsAcorda += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - ta).count());
+                ++nAcorda;
+            }
+        }
+    }
+}
