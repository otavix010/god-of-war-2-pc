+    const uint64_t alphaReg = ctx.alpha;
+    const uint32_t asel = alphaReg & 3, bsel = (alphaReg >> 2) & 3, csel = (alphaReg >> 4) & 3, dsel = (alphaReg >> 6) & 3;
