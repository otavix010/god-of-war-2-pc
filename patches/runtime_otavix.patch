+// microcódigo do God of War é um despachante (0x0000/0x0018/0x0030 saltam por JR para a rotina escolhida pelos dados)
+void otxVu1ColetaDestino(uint32_t pc)
+{
+    static const char *pasta = std::getenv("PS2X_VU1_DUMP");
+    if (pasta && g_otxColetaCodigo)
+        otxVu1Coleta(g_otxColetaCodigo, g_otxColetaTam, g_otxColetaMem, pc);
+}
