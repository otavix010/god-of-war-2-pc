diff --git a/ps2xRuntime/include/runtime/gs/gs_gpu.h b/ps2xRuntime/include/runtime/gs/gs_gpu.h
new file mode 100644
index 0000000..15fb043
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_gpu.h
@@ -0,0 +1,70 @@
+// Otavix (gs_gpu): rasterizador do GS na GPU (compute shader, OpenGL 4.3 num contexto próprio).
+//
+// O GSCpuBackend continua sendo o dono de tudo; só os triângulos e sprites vão para a GPU. A VRAM (4 MB) existe
+// nas duas pontas e cada página de 8 KB tem um dono: em dia nas duas, mais nova na CPU (alguma escrita da CPU ainda
+// não subiu) ou mais nova na GPU (algum lote escreveu e ainda não desceu). Antes de qualquer leitura/escrita da CPU
+// o backend chama paraCpu() nas páginas que vai tocar (desce o que a GPU tem de novo); depois de escrever, chama
+// cpuEscreveu(). Os lotes sobem as páginas mais novas na CPU antes de desenhar.
+//
+// Cada lote tem um FB/Z só; as primitivas são distribuídas em tiles de 16x16 (na ordem) e cada invocação do shader
+// é um pixel que percorre as primitivas do seu tile em ordem, com a MESMA aritmética do backend de CPU (DrawTriangle,
+// DrawSprite, SampleTexture, WritePixel). Liga com PS2X_GS_GPU=1; PS2X_GS_GPU_CONFERE=1 desenha também na CPU e
+// compara a VRAM lote a lote ([gs-gpu-confere]).
+#pragma once
+
+#include "runtime/gs/gs_types.h"
+
+#include <cstdint>
+#include <functional>
+#include <future>
+#include <memory>
+#include <utility>
+#include <vector>
+
+class OtxGsGpu
+{
+public:
+    // páginas [a, b) de 8 KB (b pode passar de 512: dá a volta na VRAM)
+    struct Paginas
+    {
+        uint32_t f0 = 0, f1 = 0, z0 = 0, z1 = 0, t0 = 0, t1 = 0;
+        bool temTex = false;
+        uint64_t lutVer = 0; // Otavix (01/11): versão do conteúdo da lut (0 = desconhecida: o adiciona compara o conteúdo)
+    };
+
+    // Otavix (01/11, frente 1): geometria da primitiva montada fora da thread desenho (no frontend); estado 0 = não
+    // montada, 1 = montada, 2 = nada a desenhar. Só triângulos e sprites.
+    struct PrimPre
+    {
+        alignas(8) uint8_t b[184];
+        uint8_t estado = 0;
+    };
+    static void montaPrim(const GSPrimitiveBatch &batch, PrimPre &out);
+
+    static bool ligado();       // PS2X_GS_GPU=1
+    static bool confere();      // PS2X_GS_GPU_CONFERE=1
+    static std::unique_ptr<OtxGsGpu> cria(uint8_t *vram); // nullptr se a GPU não deu (o backend segue na CPU)
+    virtual ~OtxGsGpu() = default;
+
+    // triângulo (TRIANGLE/TRISTRIP/TRIFAN) ou sprite; false = a CPU desenha (realimentação, formato sem suporte)
+    virtual bool adiciona(const GSPrimitiveBatch &batch, const uint32_t *lut, const Paginas &p, const PrimPre *pre = nullptr) = 0;
+    // motivo: nome curto de quem pediu (estatística [gs-gpu-motivos])
+    virtual void paraCpu(uint32_t a, uint32_t b, bool escreve, const char *motivo = "?") = 0;
+    virtual void cpuEscreveu(uint32_t a, uint32_t b) = 0;
+    virtual void descarrega() = 0; // manda o lote atual para a GPU (sem esperar)
+    virtual void solta() = 0;      // o GS ficou ocioso: manda só se o lote já vale a pena
+    // desce as páginas mais novas na GPU das faixas [a, b) para 'destino' (uma cópia de 4 MB, não a VRAM da CPU)
+    // sem esperar; o dono das páginas não muda. 'pronto' fica pronto quando a cópia estiver completa.
+    virtual void desceAssinc(const std::vector<std::pair<uint32_t, uint32_t>> &faixas, uint8_t *destino,
+                             std::shared_future<void> &pronto) = 0;
+    // Otavix (31/10): escrita da CPU em [a, b) sem descer as páginas mais novas na GPU: 'grava' roda duas vezes (páginas
+    // zeradas e todas em 1) para achar os bits escritos, que a GPU mescla com máscara. false = nenhuma página do
+    // intervalo é mais nova na GPU (o chamador segue com paraCpu + grava + cpuEscreveu).
+    virtual bool escreveMesclado(uint32_t a, uint32_t b, const std::function<void()> &grava) = 0;
+    // leitura da CPU em [a, b) que talvez não precise descer: 'le' roda com os bits que a CPU não tem em 0 e em 1 e devolve
+    // um resumo do que leu; igual = a leitura (já feita) não dependeu deles. false = paraCpu e ler de novo.
+    virtual bool leSemDescer(uint32_t a, uint32_t b, const std::function<uint64_t()> &le) = 0;
+
+    std::function<void()> antesDeSubir;                       // o backend termina as escritas pendentes da CPU
+    std::function<void(const GSPrimitiveBatch &)> desenhaCpu; // modo confere
+};
