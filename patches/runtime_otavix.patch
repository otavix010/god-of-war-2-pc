+    const uint32_t atst = static_cast<uint32_t>((test >> 1) & 0x7u);
+    const __m256i vAref = _mm256_set1_epi32(static_cast<int>((test >> 4) & 0xFFu));
+    const uint32_t afail = static_cast<uint32_t>((test >> 12) & 0x3u);
+    const bool afRgb = afail == 1u || afail == 3u, afA = afail == 1u, afZ = afail == 2u;
+
