+// Otavix (30/10): servidor CDVDFSV do IOP (o do console fica na ROM/IOPRP) respondido pelo host, para os jogos que rodam
+// o libcdvd original no EE em vez dos stubs do runtime (God of War: só sceCdInit/Sync/SyncS/Mmode eram reconhecidos).
+// Protocolo conferido com o cdvdfsv do ps2sdk (iop/cdvd/cdvdfsv): SID 0x80000592 init, 0x80000593 comandos S,
+// 0x80000595 comandos N (leituras), 0x80000597 busca de arquivo, 0x8000059A/0x8000059C disco pronto.
+// Lê da imagem do disco (PS2X_CD_IMAGE), as duas camadas dos DVD9 com LSN absoluto (IsoReal).
+// A leitura para o EE escreve TUDO direto no destino (o host não tem a restrição de 64 bytes do DMA do SIF), então o
+// pacote de "sobras" desalinhadas vai com tamanhos 0 e o callback do libcdvd do EE não copia nada.
+#include "module_factories.h"
+#include "ps2x/iop/iso_real.h"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <iostream>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kSidInit = 0x80000592u;
+        constexpr uint32_t kSidScmd = 0x80000593u;
+        constexpr uint32_t kSidNcmd = 0x80000595u;
+        constexpr uint32_t kSidBusca = 0x80000597u;
+        constexpr uint32_t kSidPronto = 0x8000059Au;
+        constexpr uint32_t kSidPronto2 = 0x8000059Cu;
+        constexpr uint32_t kSetor = 2048u;
+        constexpr int32_t kTipoPs2Dvd = 0x14;
+        constexpr int32_t kStatusPausa = 0x0A;
+        constexpr int32_t kErroLeitura = 0x30;
+
+        uint8_t bcd(int v)
+        {
+            v %= 100;
+            return static_cast<uint8_t>(((v / 10) << 4) | (v % 10));
+        }
+
+        class CdvdfsvService final : public IopService
+        {
+        public:
+            explicit CdvdfsvService(IopHost &host) : m_host(host) {}
+
+            [[nodiscard]] std::string_view name() const override { return "CDVDFSV"; }
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return kSids; }
+            // sem apelido = sempre ativo (residente, ninguém carrega o cdvdfsv.irx)
+            [[nodiscard]] std::span<const std::string_view> moduleAliases() const override { return {}; }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> trava(m_trava);
+                m_erro = 0;
+                m_logs = 0u;
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                std::lock_guard<std::mutex> trava(m_trava);
+                RpcResult r{};
+                r.handled = true;
+                r.resultAddress = request.receive.address;
+                std::vector<uint8_t> in(std::min<uint32_t>(request.send.size, 0x1000u), 0u);
+                if (!in.empty() && request.send.address != 0u)
+                    (void)m_host.readGuest(request.send.address, in.data(), in.size());
+                std::array<uint32_t, 8> out{};
+                size_t palavras = 1u;
+                switch (request.sid)
+                {
+                case kSidInit: // retres, versão do cdvdfsv, versão do cdvdman, modo debug
+                    out = {1u, 0x0226u, 0x0226u, 0u};
+                    palavras = 4u;
+                    break;
+                case kSidPronto:
+                case kSidPronto2:
+                    out[0] = 2u; // SCECdComplete
+                    break;
+                case kSidBusca:
+                    out[0] = busca(request, in) ? 1u : 0u;
+                    palavras = 4u;
+                    break;
+                case kSidScmd:
+                    palavras = scmd(request.function, in, out);
+                    break;
+                case kSidNcmd:
+                    out[0] = static_cast<uint32_t>(ncmd(request.function, in));
+                    palavras = request.function == 4u ? 2u : 1u;
+                    if (request.function == 4u)
+                        out[1] = 1u; // é DVD
+                    break;
+                default:
+                    r.handled = false;
+                    return r;
+                }
+                if (request.receive.address != 0u && request.receive.size != 0u)
+                {
+                    const size_t bytes = std::min<size_t>(request.receive.size, palavras * 4u);
+                    (void)m_host.writeGuest(request.receive.address, out.data(), bytes);
+                }
+                return r;
+            }
+
+        private:
+            inline static constexpr std::array<uint32_t, 6> kSids{kSidInit, kSidScmd, kSidNcmd, kSidBusca, kSidPronto, kSidPronto2};
+
+            IopHost &m_host;
+            std::mutex m_trava;
+            int32_t m_erro = 0;
+            uint32_t m_logs = 0u;
+
+            static uint32_t le32(const std::vector<uint8_t> &b, size_t o)
+            {
+                uint32_t v = 0u;
+                if (o + 4u <= b.size())
+                    std::memcpy(&v, b.data() + o, 4u);
+                return v;
+            }
+
+            IsoReal *iso()
+            {
+                const std::string imagem = m_host.hostPath(HostPathKind::CdImage);
+                if (imagem.empty())
+                    return nullptr;
+                IsoReal &i = IsoReal::para(imagem);
+                return i.valida() ? &i : nullptr;
+            }
+
+            void log(const std::string &t)
+            {
+                if (m_logs++ < 200u)
+                    std::cerr << "[cdvdfsv] " << t << std::endl;
+            }
+
+            // sceCdlFILE (lsn, size, name[16], date[8]) + atributos, path[256], destino no EE (+ camada no pacote 0x12C)
+            bool busca(const RpcRequest &req, const std::vector<uint8_t> &in)
+            {
+                const size_t tam = req.send.size;
+                size_t oPath = 0x24u, oDest = 0x124u;
+                int camada = -1;
+                if (tam < 0x128u) // pacote antigo (0x124): sem atributos
+                {
+                    oPath = 0x20u;
+                    oDest = 0x120u;
+                }
+                else if (tam >= 0x12Cu)
+                    camada = static_cast<int>(le32(in, 0x128u));
+                std::string caminho;
+                for (size_t i = oPath; i < oPath + 256u && i < in.size() && in[i]; ++i)
+                    caminho.push_back(static_cast<char>(in[i]));
+                const uint32_t destino = le32(in, oDest);
+                IsoReal::Arquivo arq;
+                IsoReal *i = iso();
+                const bool achou = i && i->procura(caminho, camada, arq);
+                log("busca \"" + caminho + "\" camada=" + std::to_string(camada) + (achou ? " lsn=" + std::to_string(arq.lsn) + " tam=" + std::to_string(arq.tamanho) : std::string(" NAO achou")));
+                if (!achou)
+                    return false;
+                std::array<uint8_t, 36u> fp{};
+                std::memcpy(fp.data(), &arq.lsn, 4u);
+                std::memcpy(fp.data() + 4u, &arq.tamanho, 4u);
+                std::string folha = caminho;
+                if (const size_t b = folha.find_last_of("\\/:"); b != std::string::npos)
+                    folha.erase(0, b + 1u);
+                std::memcpy(fp.data() + 8u, folha.data(), std::min<size_t>(15u, folha.size()));
+                // +32: atributos do arquivo (o cdvdfsv manda o começo do pacote: sceCdlFILE + 1 palavra)
+                if (destino != 0u)
+                    (void)m_host.writeGuest(destino, fp.data(), tam < 0x128u ? 32u : 36u);
+                return true;
+            }
+
+            size_t scmd(uint32_t fn, const std::vector<uint8_t> &in, std::array<uint32_t, 8> &out)
+            {
+                switch (fn)
+                {
+                case 0x01: // ReadClock: retres + sceCdCLOCK (stat, s, m, h, pad, dia, mês, ano) em BCD
+                {
+                    const std::time_t agora = std::time(nullptr);
+                    std::tm t{};
+#ifdef _WIN32
+                    localtime_s(&t, &agora);
+#else
+                    localtime_r(&agora, &t);
+#endif
+                    const uint8_t c[8] = {0u, bcd(t.tm_sec), bcd(t.tm_min), bcd(t.tm_hour), 0u, bcd(t.tm_mday), bcd(t.tm_mon + 1), bcd(t.tm_year)};
+                    out[0] = 1u;
+                    std::memcpy(&out[1], c, 8u);
+                    return 3u;
+                }
+                case 0x03: out[0] = kTipoPs2Dvd; return 1u;                 // GetDiskType
+                case 0x04: out[0] = static_cast<uint32_t>(m_erro); return 1u; // GetError
+                case 0x05: out[0] = 1u; out[1] = 0u; return 2u;               // TrayReq (bandeja não mexeu)
+                case 0x0C: out[0] = kStatusPausa; return 1u;                // Status
+                case 0x15: out[0] = 1u; return 1u;                          // CtrlADout
+                case 0x16: out[0] = 1u; return 1u;                          // Break
+                case 0x22: out[0] = 1u; return 1u;                          // Mmode
+                case 0x23: out[0] = 1u; return 1u;                          // ChangeThreadPriority
+                case 0x25: out[0] = 1u; return 1u;                          // SetTimeout
+                case 0x27:                                                  // ReadDvdDualInfo
+                {
+                    IsoReal *i = iso();
+                    out[0] = 1u;
+                    out[1] = (i && i->duasCamadas()) ? 1u : 0u;
+                    out[2] = (i && i->duasCamadas()) ? i->inicioCamada1() : 0u;
+                    log("dual info dual=" + std::to_string(out[1]) + " camada1=" + std::to_string(out[2]));
+                    return 3u;
+                }
+                default:
+                    log("S-cmd desconhecido 0x" + std::to_string(fn) + " (devolve 1)");
+                    (void)in;
+                    out[0] = 1u;
+                    return 1u;
+                }
+            }
+
+            // lê 'setores' de 2048 bytes; destino no EE (iop=false) ou na RAM do IOP
+            bool leDisco(uint32_t lsn, uint32_t setores, uint32_t destino, bool naIop)
+            {
+                IsoReal *i = iso();
+                if (!i || setores == 0u || setores > 0x4000u)
+                {
+                    m_erro = kErroLeitura;
+                    return false;
+                }
+                std::vector<uint8_t> dados(static_cast<size_t>(setores) * kSetor);
+                const bool ok = i->le(lsn, setores, dados.data());
+                const bool escreveu = naIop ? m_host.writeIopMemory(destino, dados.data(), dados.size())
+                                            : m_host.writeGuest(destino, dados.data(), dados.size());
+                m_erro = (ok && escreveu) ? 0 : kErroLeitura;
+                return ok && escreveu;
+            }
+
+            int32_t ncmd(uint32_t fn, const std::vector<uint8_t> &in)
+            {
+                switch (fn)
+                {
+                case 1:  // ReadEE: lbn, sectors, paddr, rmode, eeremaindest, eedest(readpos)
+                case 19: // a mesma com chave de decodificação
+                {
+                    const uint32_t lbn = le32(in, 0), setores = le32(in, 4), destino = le32(in, 8);
+                    const uint32_t sobras = le32(in, 16), posicao = le32(in, 20);
+                    if (m_logs < 200u)
+                        log("read lbn=" + std::to_string(lbn) + " setores=" + std::to_string(setores) + " ee=0x" + hex(destino));
+                    const bool ok = leDisco(lbn, setores, destino, false);
+                    const uint32_t lidos = ok ? setores * kSetor : 0u;
+                    std::array<uint8_t, 0x90u> x{}; // b1len, b2len, b1dst, b2dst, pbuf1[64], pbuf2[64]: nada a copiar
+                    if (sobras != 0u)
+                        (void)m_host.writeGuest(sobras, x.data(), x.size());
+                    if (posicao != 0u)
+                        (void)m_host.writeGuest(posicao, &lidos, 4u);
+                    return static_cast<int32_t>(lidos);
+                }
+                case 13: // ReadIOPm: lbn, sectors, buf (IOP), rmode, -, eedest
+                {
+                    const uint32_t lbn = le32(in, 0), setores = le32(in, 4), destino = le32(in, 8);
+                    const uint32_t posicao = le32(in, 20);
+                    const bool ok = leDisco(lbn, setores, destino, true);
+                    const uint32_t lidos = ok ? setores * kSetor : 0u;
+                    if (posicao != 0u)
+                        (void)m_host.writeGuest(posicao, &lidos, 4u);
+                    return ok ? 1 : 0;
+                }
+                case 15: // ReadChain: 65 x (lbn, sectors, buffer), rmode, eedest
+                {
+                    const uint32_t posicao = le32(in, 65u * 12u + 4u);
+                    uint32_t lidos = 0u;
+                    for (uint32_t k = 0; k < 64u; ++k)
+                    {
+                        const uint32_t lbn = le32(in, k * 12u), setores = le32(in, k * 12u + 4u), buf = le32(in, k * 12u + 8u);
+                        if (lbn == 0xFFFFFFFFu || setores == 0xFFFFFFFFu || buf == 0xFFFFFFFFu)
+                            break;
+                        if (!leDisco(lbn, setores, buf & ~1u, (buf & 1u) != 0u))
+                            break;
+                        lidos += setores * kSetor;
+                        if (posicao != 0u)
+                            (void)m_host.writeGuest(posicao, &lidos, 4u);
+                    }
+                    return 1;
+                }
+                case 4: // GetToc: 0x810 bytes para o EE
+                {
+                    std::array<uint8_t, 0x810u> toc{};
+                    if (const uint32_t d = le32(in, 0); d != 0u)
+                        (void)m_host.writeGuest(d, toc.data(), toc.size());
+                    return 1;
+                }
+                case 5: case 6: case 7: case 8: // Seek, Standby, Stop, Pause
+                    m_erro = 0;
+                    return 1;
+                case 14: // NcmdDiskReady
+                    return 2;
+                default:
+                    log("N-cmd sem tratamento " + std::to_string(fn) + " (devolve 0)");
+                    return 0;
+                }
+            }
+
+            static std::string hex(uint32_t v)
+            {
+                char b[12];
+                std::snprintf(b, sizeof(b), "%x", v);
+                return b;
+            }
+        };
+    }
+
+    std::unique_ptr<IopService> createCdvdfsvService(IopHost &host)
+    {
+        return std::make_unique<CdvdfsvService>(host);
+    }
+}
