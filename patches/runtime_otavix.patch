+bool PS2Runtime::otxIntcGsNova() const noexcept
+{
+    if (!otxGsIntcLigadaRt())
+        return false;
+    const uint64_t bits = const_cast<PS2Memory &>(m_memory).gs().csr.load(std::memory_order_acquire) & 0x3ull;
+    const uint64_t imr = const_cast<PS2Memory &>(m_memory).gs().imr;
+    const uint64_t liberados = bits & ~((imr >> 8) & 0x3ull);
+    return (liberados & (~g_otxGsIntcVisto.load(std::memory_order_relaxed) | otxGsEventosNovos())) != 0u;
+}
+
+std::chrono::steady_clock::time_point PS2Runtime::otxPrazoIntcGs() const noexcept
+{
+    static const bool ligado = [] { const char *e = std::getenv("PS2X_GS_INTC_ACORDA"); return !(e && e[0] == '0'); }();
+    if (!ligado || !otxIntcGsNova())
+        return std::chrono::steady_clock::time_point::max();
+    const int64_t atraso = otxGsIntcAtrasoUs();
+    if (atraso <= 0 || !g_otxGsIntcPendente)
+        return std::chrono::steady_clock::now(); // entrega já (ou começa a contar o atraso)
+    return g_otxGsIntcDesde + std::chrono::microseconds(atraso);
+}
