+        double m_soma2 = 0.0;
+        uint64_t m_portas = 0;
+        uint64_t m_maxSalto = 0, m_saltos20ms = 0;
+        uint32_t m_outPos = 0; // posição nos buffers de saída que o hardware grava na memória (0..0x1FF)
+    };
+}
