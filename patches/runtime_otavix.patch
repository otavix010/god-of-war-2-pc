+    void WaitSema(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (otxLogSema(static_cast<int>(getRegU32(ctx, 4))))
+            std::fprintf(stderr, "[sema] espera id=%d ra=0x%x thread=%d\n", static_cast<int>(getRegU32(ctx, 4)), getRegU32(ctx, 31), runtime->eeScheduler().currentThreadId());
+        scheduler(rdram, ctx, runtime).waitSemaphore(static_cast<int>(getRegU32(ctx, 4)));
+    }
