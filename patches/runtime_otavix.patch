+        bool adiciona(const GSPrimitiveBatch &batch, const uint32_t *lut, const Paginas &pg, const PrimPre *pre) override;
+        void paraCpu(uint32_t a, uint32_t b, bool escreve, const char *motivo) override;
+        void cpuEscreveu(uint32_t a, uint32_t b) override
