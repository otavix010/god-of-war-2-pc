+uint32_t GSThreadBackend::poeEstado(const GSDrawState &estado, uint64_t versao)
+{
+    // a desenho troca o vetor a cada lote: vazio, o estado entra de novo
+    const bool mesmo = !m_estados.empty() &&
+                       (versao != 0u ? versao == m_ultVersao : std::memcmp(&m_estados.back(), &estado, sizeof(GSDrawState)) == 0);
+    if (!mesmo)
+    {
+        m_estados.push_back(estado);
+        m_ultVersao = versao;
+    }
+    return static_cast<uint32_t>(m_estados.size() - 1u);
+}
+
+// Otavix (02/11): a desenho só dorme com a fila vazia (conferido sob o mutex): só é acordada quando a fila estava vazia
+// (antes, um notify por primitiva)
+void GSThreadBackend::notificaEEspera(uint64_t postos, bool estavaVazia)
+{
+    if (estavaVazia)
+        m_temTrabalho.notify_one();
+    const uint64_t feitos = m_feitos.load(std::memory_order_acquire);
+    const uint64_t limite = limiteFila();
+    if (postos - feitos >= limite)
+        espera(postos - limite / 2u);
+}
+
+void GSThreadBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (!m_vram || batch.vertexCount == 0u)
+        return;
+    g_otxPrimsFrontend.fetch_add(1u, std::memory_order_relaxed);
+    const bool pre = otxPre();
+    uint32_t pg[6] = {};
+    OtxGsGpu::PrimPre prim{};
+    bool comPrim = false;
+    if (pre)
+    {
+        GSCpuBackend::otxPreCalcula(batch, pg);
+        const GSPrimType t = batch.state.prim.type;
+        if (otxMontaNoFrontend() && (t == GS_PRIM_TRIANGLE || t == GS_PRIM_TRISTRIP || t == GS_PRIM_TRIFAN || t == GS_PRIM_SPRITE))
+        {
+            OtxGsGpu::montaPrim(batch, prim);
+            comPrim = true;
+        }
+    }
+    uint64_t postos;
+    bool estavaVazia;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        estavaVazia = m_fila.empty();
+        const uint32_t est = poeEstado(batch.state, 0u);
+        Cmd &c = m_fila.emplace_back();
+        c.tipo = pre ? Tipo::DesenhoPre : Tipo::Desenho;
+        c.a = pg[0]; c.b = pg[1]; c.c = pg[2]; c.d = pg[3]; c.e = pg[4]; c.f = pg[5];
+        c.est = est;
+        c.nv = batch.vertexCount;
+        for (uint8_t i = 0; i < batch.vertexCount && i < 3u; ++i)
+            c.vtx[i] = batch.vertices[i];
+        if (comPrim)
+        {
+            c.pre = static_cast<uint32_t>(m_pres.size());
+            m_pres.push_back(prim);
+        }
+        postos = ++m_postos;
+    }
+    notificaEEspera(postos, estavaVazia);
+}
+
+void GSThreadBackend::SubmitEstado(const GSVertex *vtx, uint8_t n, const GSDrawState &estado, uint64_t versao)
+{
+    if (!m_vram || n == 0u)
+        return;
+    if (otxPre()) // as páginas (e a geometria) precisam do lote montado
+    {
+        GSRasterBackend::SubmitEstado(vtx, n, estado, versao);
+        return;
+    }
+    g_otxPrimsFrontend.fetch_add(1u, std::memory_order_relaxed);
+    uint64_t postos;
+    bool estavaVazia;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        estavaVazia = m_fila.empty();
+        const uint32_t est = poeEstado(estado, versao);
+        Cmd &c = m_fila.emplace_back();
+        c.tipo = Tipo::Desenho;
+        c.est = est;
+        c.nv = n;
+        for (uint8_t i = 0; i < n && i < 3u; ++i)
+            c.vtx[i] = vtx[i];
+        postos = ++m_postos;
+    }
+    notificaEEspera(postos, estavaVazia);
+}
