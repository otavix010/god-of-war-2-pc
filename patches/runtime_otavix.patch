+uniform float kCoefUsm[384];
+float luma(vec3 c) { return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b; }
+float lumaEm(ivec2 q) { return luma(texelFetch(texture0, clamp(q, ivec2(0), ivec2(tamEnt) - 1), 0).rgb); }
+// GetEdgeMap: p = 4x4 (linha*4 + coluna), 3x3 a partir de (i, j)
+vec4 edgeMap(float p[16], int i, int j)
+{
+    float g0 = abs(p[i*4+j] + p[i*4+1+j] + p[i*4+2+j] - p[(2+i)*4+j] - p[(2+i)*4+1+j] - p[(2+i)*4+2+j]);
+    float g45 = abs(p[(1+i)*4+j] + p[i*4+j] + p[i*4+1+j] - p[(2+i)*4+1+j] - p[(2+i)*4+2+j] - p[(1+i)*4+2+j]);
+    float g90 = abs(p[i*4+j] + p[(1+i)*4+j] + p[(2+i)*4+j] - p[i*4+2+j] - p[(1+i)*4+2+j] - p[(2+i)*4+2+j]);
+    float g135 = abs(p[(1+i)*4+j] + p[(2+i)*4+j] + p[(2+i)*4+1+j] - p[i*4+1+j] - p[i*4+2+j] - p[(1+i)*4+2+j]);
+    float g0_90_max = max(g0, g90), g0_90_min = min(g0, g90);
+    float g45_135_max = max(g45, g135), g45_135_min = min(g45, g135);
+    if (g0_90_max + g45_135_max == 0.0)
+        return vec4(0.0);
+    float e0_90 = min(g0_90_max / (g0_90_max + g45_135_max), 1.0);
+    float e45_135 = 1.0 - e0_90;
+    bool c0_90 = (g0_90_max > (g0_90_min * kDetectRatio)) && (g0_90_max > kDetectThres) && (g0_90_max > g45_135_min);
+    bool c45_135 = (g45_135_max > (g45_135_min * kDetectRatio)) && (g45_135_max > kDetectThres) && (g45_135_max > g0_90_min);
+    bool cg0_90 = g0_90_max == g0;
+    bool cg45_135 = g45_135_max == g45;
+    float fe0_90 = (c0_90 && c45_135) ? e0_90 : 1.0;
+    float fe45_135 = (c0_90 && c45_135) ? e45_135 : 1.0;
+    return vec4((c0_90 && cg0_90) ? fe0_90 : 0.0, (c0_90 && !cg0_90) ? fe0_90 : 0.0,
+                (c45_135 && cg45_135) ? fe45_135 : 0.0, (c45_135 && !cg45_135) ? fe45_135 : 0.0);
+}
+float calcLTI(float p0, float p1, float p2, float p3, float p4, float p5, int fase)
+{
+    bool sel0 = fase <= 32;
+    float sel = sel0 ? p0 : p3;
+    float aMin = min(min(p1, p2), sel), aMax = max(max(p1, p2), sel);
+    sel = sel0 ? p2 : p5;
+    float bMin = min(min(p3, p4), sel), bMax = max(max(p3, p4), sel);
+    float aCont = aMax - aMin, bCont = bMax - bMin;
+    float contRatio = max(aCont, bCont) / (min(aCont, bCont) + kEps);
+    return (1.0 - clamp((contRatio - kMinContrastRatio) * kRatioNorm, 0.0, 1.0)) * kContrastBoost;
+}
+float evalPoly6(float px[6], int fase)
+{
+    float y = 0.0, yUsm = 0.0;
+    for (int i = 0; i < 6; ++i)
+    {
+        y += kCoefEscala[fase * 6 + i] * px[i];
+        yUsm += kCoefUsm[fase * 6 + i] * px[i];
+    }
+    float yScale = 1.0 - clamp((y - kSharpStartY) * kSharpScaleY, 0.0, 1.0);
+    float ySharp = yScale * kSharpStrengthScale + kSharpStrengthMin;
+    yUsm *= ySharp;
+    float yLim = (yScale * kSharpLimitScale + kSharpLimitMin) * y;
+    yUsm = min(yLim, max(-yLim, yUsm));
+    yUsm *= calcLTI(px[0], px[1], px[2], px[3], px[4], px[5], fase);
+    return y + yUsm;
+}
+void main()
+{
+    // (0,5 + destino) * escala - 0,5, como no NVScaler
+    vec2 s = fragTexCoord * tamEnt - 0.5;
+    vec2 fl = floor(s);
+    ivec2 b = ivec2(fl);
+    float fx = s.x - fl.x, fy = s.y - fl.y;
+    int fxi = int(fx * 64.0), fyi = int(fy * 64.0);
+    float p[36]; // 6x6: linha i = y-2+i, coluna j = x-2+j
+    for (int i = 0; i < 6; ++i)
+        for (int j = 0; j < 6; ++j)
+            p[i * 6 + j] = lumaEm(b + ivec2(j - 2, i - 2));
+    float p4[16];
+    for (int i = 0; i < 4; ++i)
+        for (int j = 0; j < 4; ++j)
+            p4[i * 4 + j] = p[(i + 1) * 6 + j + 1];
+    vec4 w = mix(mix(edgeMap(p4, 0, 0), edgeMap(p4, 0, 1), fx), mix(edgeMap(p4, 1, 0), edgeMap(p4, 1, 1), fx), fy);
+    float baseW = 1.0 - w.x - w.y - w.z - w.w;
+    // filtro normal (separável)
+    float hAcc = 0.0;
+    for (int j = 0; j < 6; ++j)
+    {
+        float vAcc = 0.0;
+        for (int i = 0; i < 6; ++i)
+            vAcc += p[i * 6 + j] * kCoefEscala[fyi * 6 + i];
+        hAcc += vAcc * kCoefEscala[fxi * 6 + j];
+    }
+    float opY = hAcc * baseW;
+    if (w.x > 0.0)
+    {
+        float t[6];
+        for (int i = 0; i < 6; ++i) t[i] = mix(p[i * 6 + 2], p[i * 6 + 3], fx);
+        opY += evalPoly6(t, fyi) * w.x;
+    }
+    if (w.y > 0.0)
+    {
+        float t[6];
+        for (int i = 0; i < 6; ++i) t[i] = mix(p[2 * 6 + i], p[3 * 6 + i], fy);
+        opY += evalPoly6(t, fxi) * w.y;
+    }
+    if (w.z > 0.0)
+    {
+        float ph = 0.5 + 0.5 * (fx - fy);
+        float t7[7];
+        t7[1] = mix(p[2 * 6 + 1], p[1 * 6 + 2], ph);
+        t7[3] = mix(p[3 * 6 + 2], p[2 * 6 + 3], ph);
+        t7[5] = mix(p[4 * 6 + 3], p[3 * 6 + 4], ph);
+        ph = ph - 0.5;
+        float a = (ph >= 0.0) ? p[0 * 6 + 2] : p[2 * 6 + 0];
+        float bb = (ph >= 0.0) ? p[1 * 6 + 3] : p[3 * 6 + 1];
+        float c = (ph >= 0.0) ? p[2 * 6 + 4] : p[4 * 6 + 2];
+        float d = (ph >= 0.0) ? p[3 * 6 + 5] : p[5 * 6 + 3];
+        t7[0] = mix(p[1 * 6 + 1], a, abs(ph));
+        t7[2] = mix(p[2 * 6 + 2], bb, abs(ph));
+        t7[4] = mix(p[3 * 6 + 3], c, abs(ph));
+        t7[6] = mix(p[4 * 6 + 4], d, abs(ph));
+        float t[6];
+        float pp = fx + fy;
+        int o = 0;
+        if (pp >= 1.0) { o = 1; pp = pp - 1.0; }
+        for (int i = 0; i < 6; ++i) t[i] = t7[i + o];
+        opY += evalPoly6(t, int(pp * 64.0)) * w.z;
+    }
+    if (w.w > 0.0)
+    {
+        float ph = 0.5 * (fx + fy);
+        float t7[7];
+        t7[1] = mix(p[3 * 6 + 1], p[4 * 6 + 2], ph);
+        t7[3] = mix(p[2 * 6 + 2], p[3 * 6 + 3], ph);
+        t7[5] = mix(p[1 * 6 + 3], p[2 * 6 + 4], ph);
+        ph = ph - 0.5;
+        float a = (ph >= 0.0) ? p[5 * 6 + 2] : p[3 * 6 + 0];
+        float bb = (ph >= 0.0) ? p[4 * 6 + 3] : p[2 * 6 + 1];
+        float c = (ph >= 0.0) ? p[3 * 6 + 4] : p[1 * 6 + 2];
+        float d = (ph >= 0.0) ? p[2 * 6 + 5] : p[0 * 6 + 3];
+        t7[0] = mix(p[4 * 6 + 1], a, abs(ph));
+        t7[2] = mix(p[3 * 6 + 2], bb, abs(ph));
+        t7[4] = mix(p[2 * 6 + 3], c, abs(ph));
+        t7[6] = mix(p[1 * 6 + 4], d, abs(ph));
+        float t[6];
+        float pp = 1.0 + (fx - fy);
+        int o = 0;
+        if (pp >= 1.0) { o = 1; pp = pp - 1.0; }
+        for (int i = 0; i < 6; ++i) t[i] = t7[i + o];
+        opY += evalPoly6(t, int(pp * 64.0)) * w.w;
+    }
+    // cor: o bilinear da entrada com a luma trocada pela do filtro
+    vec3 op = texture(texture0, (s + 0.5) / tamEnt).rgb;
+    finalColor = vec4(op + (opY - luma(op)), 1.0);
+}
+)GLSL";
+
+    enum class Modo
+    {
+        Nativo,
+        Bilinear,
+        Fxaa,
+        Fsr,
+        FxaaFsr,
+        Nis,
+        FxaaNis
+    };
+
+    Modo modo()
+    {
+        static const Modo m = []
+        {
+            const char *e = std::getenv("PS2X_IMAGEM");
+            std::string s = e ? e : "";
+            // Otavix (02/11): as opções do launcher vêm separadas: PS2X_ESCALA = nenhum|bilinear|fsr|nis e PS2X_FXAA = 0|1
+            // (valem quando PS2X_IMAGEM não é dado)
+            if (s.empty())
+            {
+                const char *esc = std::getenv("PS2X_ESCALA");
+                const char *fx = std::getenv("PS2X_FXAA");
+                const std::string escala = esc ? esc : "";
+                const bool comFxaa = fx && fx[0] == '1';
+                if (escala == "fsr" || escala == "nis")
+                    s = comFxaa ? "fxaa+" + escala : escala;
+                else if (comFxaa)
+                    s = "fxaa";
+                else if (escala == "bilinear")
+                    s = "bilinear";
+            }
+            if (s == "bilinear")
+                return Modo::Bilinear;
+            if (s == "fxaa")
+                return Modo::Fxaa;
+            if (s == "fsr")
+                return Modo::Fsr;
+            if (s == "fxaa+fsr" || s == "fsr+fxaa")
+                return Modo::FxaaFsr;
+            if (s == "nis")
+                return Modo::Nis;
+            if (s == "fxaa+nis" || s == "nis+fxaa")
+                return Modo::FxaaNis;
+            return Modo::Nativo;
+        }();
+        return m;
+    }
+
+    struct Estado
+    {
+        bool tentou = false, ok = false;
+        Shader fxaa{}, copia{}, easu{}, rcas{}, nis{};
+        int locFxaaTexel = -1, locFxaaLim = -1, locEasuTam = -1, locRcasTam = -1, locRcasNit = -1, locNisTam = -1;
+        bool nisOk = false;
+        RenderTexture2D alvoEnt{}, alvoSai{}, alvoFim{};
+        const RenderTexture2D *ultimo = nullptr; // o que foi para a tela por último (foto)
+    };
+
+    Estado &estado()
+    {
+        static Estado e;
+        return e;
+    }
+
+    bool carrega(Shader &s, const char *fonte, const char *nome)
+    {
+        s = LoadShaderFromMemory(nullptr, fonte);
+        if (!IsShaderValid(s))
+        {
+            std::fprintf(stderr, "[imagem] shader %s não compilou\n", nome);
+            return false;
+        }
+        return true;
+    }
+
+    bool inicia()
+    {
+        Estado &e = estado();
+        if (e.tentou)
+            return e.ok;
+        e.tentou = true;
+        e.ok = carrega(e.fxaa, kFxaa, "fxaa") && carrega(e.copia, kCopia, "copia") && carrega(e.easu, kEasu, "easu") &&
+               carrega(e.rcas, kRcas, "rcas");
+        if (e.ok)
+        {
+            e.locFxaaTexel = GetShaderLocation(e.fxaa, "texel");
+            e.locFxaaLim = GetShaderLocation(e.fxaa, "lim");
+            e.locEasuTam = GetShaderLocation(e.easu, "tamEnt");
+            e.locRcasTam = GetShaderLocation(e.rcas, "tamEnt");
+            e.locRcasNit = GetShaderLocation(e.rcas, "nitidez");
+        }
+        if (e.ok && (modo() == Modo::Nis || modo() == Modo::FxaaNis))
+        {
+            e.nisOk = carrega(e.nis, kNis, "nis");
+            if (e.nisOk)
+            {
+                e.locNisTam = GetShaderLocation(e.nis, "tamEnt");
+                // tabelas como uniform (um const float[384] indexado por pixel ia para a memória local: lentíssimo)
+                SetShaderValueV(e.nis, GetShaderLocation(e.nis, "kCoefEscala"), kNisCoefEscala, SHADER_UNIFORM_FLOAT, 384);
+                SetShaderValueV(e.nis, GetShaderLocation(e.nis, "kCoefUsm"), kNisCoefUsm, SHADER_UNIFORM_FLOAT, 384);
+                // constantes do NVScalerUpdateConfig (SDR), pela nitidez de 0 a 1 (PS2X_NIS_NITIDEZ, padrão 0,5)
+                // PS2X_NITIDEZ_PCT (0 a 100, o controle do launcher) tem prioridade
+                const char *sn = std::getenv("PS2X_NIS_NITIDEZ");
+                const char *sp = std::getenv("PS2X_NITIDEZ_PCT");
+                const float nit = std::clamp(sp ? static_cast<float>(std::atof(sp)) / 100.0f : sn ? static_cast<float>(std::atof(sn)) : 0.5f,
+                                             0.0f, 1.0f);
+                const float sl = nit - 0.5f;
+                const float maxScale = sl >= 0.0f ? 1.25f : 1.75f, minScale = sl >= 0.0f ? 1.25f : 1.0f;
+                const float limitScale = sl >= 0.0f ? 1.25f : 1.0f;
+                const float minContrast = 2.0f, maxContrast = 10.0f, startY = 0.45f, endY = 0.9f;
+                const float strMin = std::max(0.0f, 0.4f + sl * minScale * 1.2f), strMax = 1.6f + sl * maxScale * 1.8f;
+                const float limMin = std::max(0.1f, 0.14f + sl * limitScale * 0.32f), limMax = 0.5f + sl * limitScale * 0.6f;
+                const struct { const char *nome; float v; } cs[] = {
+                    {"kDetectRatio", 2.0f * 1127.0f / 1024.0f}, {"kDetectThres", 64.0f / 1024.0f},
+                    {"kMinContrastRatio", minContrast}, {"kRatioNorm", 1.0f / (maxContrast - minContrast)},
+                    {"kContrastBoost", 1.0f}, {"kEps", 1.0f / 255.0f}, {"kSharpStartY", startY},
+                    {"kSharpScaleY", 1.0f / (endY - startY)}, {"kSharpStrengthMin", strMin},
+                    {"kSharpStrengthScale", strMax - strMin}, {"kSharpLimitMin", limMin}, {"kSharpLimitScale", limMax - limMin}};
+                for (const auto &c : cs)
+                    SetShaderValue(e.nis, GetShaderLocation(e.nis, c.nome), &c.v, SHADER_UNIFORM_FLOAT);
+            }
+        }
+        static const char *nomes[] = {"nativo", "bilinear", "fxaa", "fsr", "fxaa+fsr", "nis", "fxaa+nis"};
+        std::printf("[imagem] modo %s%s\n", nomes[static_cast<int>(modo())], e.ok ? "" : " (shaders falharam: nativo)");
+        return e.ok;
+    }
+
+    void garanteAlvo(RenderTexture2D &a, int w, int h)
+    {
+        if (a.id != 0 && a.texture.width == w && a.texture.height == h)
+            return;
+        if (a.id != 0)
+            UnloadRenderTexture(a);
+        a = LoadRenderTexture(w, h);
+        SetTextureFilter(a.texture, TEXTURE_FILTER_BILINEAR);
+        SetTextureWrap(a.texture, TEXTURE_WRAP_CLAMP);
+    }
+
+    // textura de alvo desenhada em pé (o FBO do OpenGL fica de cabeça para baixo)
+    Rectangle deAlvo(const RenderTexture2D &a)
+    {
+        return Rectangle{0.0f, 0.0f, static_cast<float>(a.texture.width), -static_cast<float>(a.texture.height)};
+    }
+}
+
+namespace otx_imagem
+{
+    bool desenha(Texture2D quadro, int w, int h, Rectangle dst)
+    {
+        const Modo m = modo();
+        if (m == Modo::Nativo || w <= 0 || h <= 0)
+            return false;
+        if (m == Modo::Bilinear)
+        {
+            SetTextureFilter(quadro, TEXTURE_FILTER_BILINEAR);
+            DrawTexturePro(quadro, Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, dst, Vector2{0, 0}, 0.0f,
+                           WHITE);
+            return true;
+        }
+        if (!inicia())
+            return false;
+        Estado &e = estado();
+        const bool usaFxaa = m == Modo::Fxaa || m == Modo::FxaaFsr || m == Modo::FxaaNis;
+        const bool usaFsr = m == Modo::Fsr || m == Modo::FxaaFsr;
+        const bool usaNis = (m == Modo::Nis || m == Modo::FxaaNis) && e.nisOk;
+        // 1) área apresentada -> alvo w x h (com FXAA, ou só cópia)
+        garanteAlvo(e.alvoEnt, w, h);
+        SetTextureFilter(quadro, TEXTURE_FILTER_BILINEAR);
+        BeginTextureMode(e.alvoEnt);
+        if (usaFxaa)
+        {
+            const float texel[2] = {1.0f / static_cast<float>(quadro.width), 1.0f / static_cast<float>(quadro.height)};
+            const float lim[2] = {(static_cast<float>(w) - 0.5f) * texel[0], (static_cast<float>(h) - 0.5f) * texel[1]};
+            SetShaderValue(e.fxaa, e.locFxaaTexel, texel, SHADER_UNIFORM_VEC2);
+            SetShaderValue(e.fxaa, e.locFxaaLim, lim, SHADER_UNIFORM_VEC2);
+            BeginShaderMode(e.fxaa);
+        }
+        else
+            BeginShaderMode(e.copia);
+        DrawTexturePro(quadro, Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)},
+                       Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+        if (usaNis)
+        {
+            // NIS até 2x (o NVScaler aceita escala de 1 a 2); o que faltar até a tela, em bilinear
+            const int tw = std::max(1, static_cast<int>(std::lround(dst.width))), th = std::max(1, static_cast<int>(std::lround(dst.height)));
+            const int nw = std::max(w, std::min(tw, 2 * w)), nh = std::max(h, std::min(th, 2 * h));
+            garanteAlvo(e.alvoSai, nw, nh);
+            const float tamEnt[2] = {static_cast<float>(w), static_cast<float>(h)};
+            SetShaderValue(e.nis, e.locNisTam, tamEnt, SHADER_UNIFORM_VEC2);
+            BeginTextureMode(e.alvoSai);
+            BeginShaderMode(e.nis);
+            DrawTexturePro(e.alvoEnt.texture, deAlvo(e.alvoEnt), Rectangle{0.0f, 0.0f, static_cast<float>(nw), static_cast<float>(nh)},
+                           Vector2{0, 0}, 0.0f, WHITE);
+            EndShaderMode();
+            EndTextureMode();
+            DrawTexturePro(e.alvoSai.texture, deAlvo(e.alvoSai), dst, Vector2{0, 0}, 0.0f, WHITE);
+            e.ultimo = &e.alvoSai;
+            return true;
+        }
+        if (!usaFsr)
+        {
+            DrawTexturePro(e.alvoEnt.texture, deAlvo(e.alvoEnt), dst, Vector2{0, 0}, 0.0f, WHITE);
+            e.ultimo = &e.alvoEnt;
+            return true;
+        }
+        // 2) EASU: w x h -> tamanho da tela
+        const int dw = std::max(1, static_cast<int>(std::lround(dst.width))), dh = std::max(1, static_cast<int>(std::lround(dst.height)));
+        garanteAlvo(e.alvoSai, dw, dh);
+        BeginTextureMode(e.alvoSai);
+        const float tamEnt[2] = {static_cast<float>(w), static_cast<float>(h)};
+        SetShaderValue(e.easu, e.locEasuTam, tamEnt, SHADER_UNIFORM_VEC2);
+        BeginShaderMode(e.easu);
+        DrawTexturePro(e.alvoEnt.texture, deAlvo(e.alvoEnt),
+                       Rectangle{0.0f, 0.0f, static_cast<float>(dw), static_cast<float>(dh)}, Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+        // 3) RCAS 1:1 num alvo final (vai para a tela e para a foto)
+        static const float nitidez = []
+        {
+            // PS2X_NITIDEZ_PCT (0 a 100, o controle do launcher; 100 = máxima, 0 = quase nenhuma = 2 stops) tem prioridade
+            const char *s = std::getenv("PS2X_NITIDEZ");
+            const char *sp = std::getenv("PS2X_NITIDEZ_PCT");
+            const float stops = sp ? 2.0f * (1.0f - std::clamp(static_cast<float>(std::atof(sp)) / 100.0f, 0.0f, 1.0f))
+                                   : s ? static_cast<float>(std::atof(s)) : 0.2f;
+            return std::exp2(-std::max(0.0f, stops));
+        }();
+        const float tamSai[2] = {static_cast<float>(dw), static_cast<float>(dh)};
+        SetShaderValue(e.rcas, e.locRcasTam, tamSai, SHADER_UNIFORM_VEC2);
+        SetShaderValue(e.rcas, e.locRcasNit, &nitidez, SHADER_UNIFORM_FLOAT);
+        garanteAlvo(e.alvoFim, dw, dh);
+        SetTextureFilter(e.alvoFim.texture, TEXTURE_FILTER_POINT);
+        BeginTextureMode(e.alvoFim);
+        BeginShaderMode(e.rcas);
+        DrawTexturePro(e.alvoSai.texture, deAlvo(e.alvoSai), Rectangle{0.0f, 0.0f, static_cast<float>(dw), static_cast<float>(dh)},
+                       Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+        DrawTexturePro(e.alvoFim.texture, deAlvo(e.alvoFim),
+                       Rectangle{std::round(dst.x), std::round(dst.y), static_cast<float>(dw), static_cast<float>(dh)}, Vector2{0, 0},
+                       0.0f, WHITE);
+        e.ultimo = &e.alvoFim;
+        return true;
+    }
+
+    bool foto(Image &img)
+    {
+        const Estado &e = estado();
+        if (!e.ultimo || e.ultimo->id == 0)
+            return false;
+        img = LoadImageFromTexture(e.ultimo->texture);
+        ImageFlipVertical(&img); // o FBO fica de cabeça para baixo
+        return true;
+    }
+}
