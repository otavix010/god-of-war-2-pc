+static bool otxTriConfere()
+{
+    static const bool c = [] { const char *e = std::getenv("PS2X_GS_TRI_CONFERE"); return e && e[0] == '1'; }();
+    return c;
+}
+
+static bool otxTriRapidoLigado()
+{
+    static const bool l = []
+    {
+        const char *e = std::getenv("PS2X_GS_TRI_RAPIDO");
+        const char *c = std::getenv("PS2X_GS_CACHE_COPIA");
+        const char *a = std::getenv("PS2X_DIAG_SEM_ATEST");
+        const char *z = std::getenv("PS2X_DIAG_SEM_Z");
+        return !(e && e[0] == '0') && !(c && c[0] == '1') && !(a && *a == '1') && !(z && *z == '1');
+    }();
+    return l;
+}
