+void PS2Runtime::otxVerificaIntcGs()
+{
+    // Otavix (patch_gs_intc): SIGNAL/FINISH do GS (ligados pelo GIF) → INTC 0 na subida, se o IMR deixar
+    if (!otxGsIntcLigadaRt() || !m_eeScheduler)
+        return;
+    const uint64_t bits = m_memory.gs().csr.load(std::memory_order_acquire) & 0x3ull;
+    const uint64_t imr = m_memory.gs().imr;
+    const uint64_t novos = otxGsEventosNovos();
+    const uint64_t liberados = bits & ~((imr >> 8) & 0x3ull);
+    const bool entrega = (liberados & (~g_otxGsIntcVisto.load(std::memory_order_relaxed) | novos)) != 0u;
+    if (entrega && !otxGsIntcPrazoVencido(m_eeScheduler->otxCiclos()))
+        return; // Otavix: ainda no atraso; nada é marcado como visto
+    g_otxGsIntcPendente = false;
+    for (int i = 0; i < 2; ++i)
+        g_otxGsEventosVistos[i] = g_otxGsEventosIntc[i].load(std::memory_order_acquire);
+    if (entrega)
+    {
+        otxLinhaTempo("intc-gs", static_cast<uint32_t>(liberados));
+        m_eeScheduler->dispatchIrq(false, 0u);
+    }
+    g_otxGsIntcVisto.store(bits, std::memory_order_relaxed);
+}
