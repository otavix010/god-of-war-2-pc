+
+GSThreadBackend::~GSThreadBackend()
+{
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        m_parar = true;
+    }
+    m_temTrabalho.notify_all();
+    if (m_thread.joinable())
+        m_thread.join();
+}
+
+void GSThreadBackend::trabalha()
+{
+    std::vector<Cmd> lote;
+    std::vector<std::vector<uint8_t>> uploads;
+    std::vector<Extra> extras;
+    std::vector<GSDrawState> estados;
+    std::vector<OtxGsGpu::PrimPre> pres;
+    lote.reserve(4096);
+    // Otavix (01/11): tempo ocupado desta thread a cada 2 s ([gs-desenho]; com o prims= do [gs-gpu] dá ns por primitiva)
+    uint64_t otxNsOcup = 0, otxCmds = 0;
+    auto otxUlt = std::chrono::steady_clock::now();
+    for (;;)
+    {
+        {
+            std::unique_lock<std::mutex> lk(m_filaMutex);
+            m_temTrabalho.wait(lk, [this]
+                               { return m_parar || !m_fila.empty(); });
+            if (m_fila.empty() && m_parar)
+                return;
+            lote.swap(m_fila);
+            uploads.swap(m_uploads);
+            extras.swap(m_extras);
+            estados.swap(m_estados);
+            pres.swap(m_pres);
+            ++m_otxLoteN;
+        }
+        const auto otxT0 = std::chrono::steady_clock::now();
+        uint64_t n = 0;
+        for (Cmd &cmd : lote)
+        {
+            while (m_querPresentar.load(std::memory_order_acquire) != 0u)
+                std::this_thread::yield();
+            {
+                std::lock_guard<std::mutex> vez(m_vezMutex);
+                executa(cmd, uploads, extras, estados, pres);
+            }
+            // avisa a cada 256 comandos (Sync da apresentação e o limite da fila esperam por isto)
+            if ((++n & 255u) == 0u)
+            {
+                m_feitos.fetch_add(256u, std::memory_order_release);
+                {
+                    std::lock_guard<std::mutex> lk(m_filaMutex); // não perder o aviso de quem está entrando no wait
+                }
+                m_andou.notify_all();
+            }
+        }
+        m_feitos.fetch_add(n & 255u, std::memory_order_release);
+        // lote assíncrono: o que ficou acumulado vai para as faixas enquanto esta thread espera mais comandos
+        {
+            std::lock_guard<std::mutex> vez(m_vezMutex);
+            m_cpu->otxLoteSolta();
+        }
+        {
+            const auto otxT1 = std::chrono::steady_clock::now();
+            otxNsOcup += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(otxT1 - otxT0).count());
+            otxCmds += lote.size();
+            if (otxT1 - otxUlt >= std::chrono::seconds(2))
+            {
+                std::printf("[gs-desenho] ocupado=%.0fms cmds=%llu captura=%.0fms (espera slot %.0fms, %llu capturas, %llu avulsas)\n",
+                            otxNsOcup / 1e6, static_cast<unsigned long long>(otxCmds), m_otxCapTotalNs / 1e6, m_otxCapEsperaNs / 1e6,
+                            static_cast<unsigned long long>(m_otxCaps), static_cast<unsigned long long>(m_otxCapAvulsas));
+                m_otxCapTotalNs = m_otxCapEsperaNs = m_otxCaps = m_otxCapAvulsas = 0;
+                otxNsOcup = otxCmds = 0;
+                otxUlt = otxT1;
+            }
+        }
+        lote.clear();
+        uploads.clear();
+        extras.clear();
+        estados.clear();
+        pres.clear();
+        {
+            // acorda quem espera (sob o mutex para não perder o aviso)
+            std::lock_guard<std::mutex> lk(m_filaMutex);
+        }
+        m_andou.notify_all();
+    }
+}
+
+void GSThreadBackend::executa(Cmd &cmd, std::vector<std::vector<uint8_t>> &uploads, std::vector<Extra> &extras,
+                              std::vector<GSDrawState> &estados, std::vector<OtxGsGpu::PrimPre> &pres)
+{
+    switch (cmd.tipo)
+    {
+    case Tipo::Desenho:
+    case Tipo::DesenhoPre:
+    {
+        // o lote é remontado aqui (a desenho tem folga; o frontend, não). Otavix (02/11): um lote reaproveitado, com o
+        // estado copiado só quando o índice muda (primitivas seguidas quase sempre têm o mesmo): zerar e copiar ~650
+        // bytes por primitiva era ~8% da desenho no notebook
+        // (o vetor de estados é reaproveitado entre lotes, no mesmo endereço: a comparação leva o número do lote)
+        static thread_local GSPrimitiveBatch batch;
+        static thread_local uint32_t ultEst = ~0u;
+        static thread_local uint64_t ultLote = ~0ull;
+        if (cmd.est != ultEst || m_otxLoteN != ultLote)
+        {
+            batch.state = estados[cmd.est];
+            ultEst = cmd.est;
+            ultLote = m_otxLoteN;
+        }
+        batch.vertexCount = cmd.nv;
+        for (uint8_t i = 0; i < cmd.nv; ++i)
+            batch.vertices[i] = cmd.vtx[i];
+        auto &g = m_genFb[batch.state.context.frame.fbp & 511u];
+        g.store(g.load(std::memory_order_relaxed) + 1u, std::memory_order_release);
+        if (cmd.tipo == Tipo::DesenhoPre)
+        {
+            static OtxGsGpu::PrimPre semPrim{};
+            const uint32_t pg[6] = {cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, cmd.f};
+            m_cpu->otxSubmitPre(batch, pg, cmd.pre != ~0u ? &pres[cmd.pre] : &semPrim);
+        }
+        else
+            m_cpu->Submit(batch);
+        break;
+    }
+    case Tipo::Clut:
+        m_cpu->LoadClut(extras[cmd.a].tex0, extras[cmd.a].texclut);
+        break;
+    case Tipo::Transfer:
+        m_otxDbpTransf = extras[cmd.a].transfer.bitbltbuf.dbp / 32u;
+        {
+            auto &g = m_genFb[m_otxDbpTransf & 511u];
+            g.store(g.load(std::memory_order_relaxed) + 1u, std::memory_order_release);
+        }
+        m_cpu->BeginTransfer(extras[cmd.a].transfer);
+        {
+            const GSTransferSnapshot t = m_cpu->GetTransferSnapshot();
+            std::lock_guard<std::mutex> lk(m_transfMutex);
+            m_transf = t;
+        }
+        break;
+    case Tipo::Upload:
+        {
+            auto &g = m_genFb[m_otxDbpTransf & 511u];
+            g.store(g.load(std::memory_order_relaxed) + 1u, std::memory_order_release);
+        }
+    {
+        const std::vector<uint8_t> &dados = uploads[cmd.a];
+        m_cpu->UploadImage(dados.data(), static_cast<uint32_t>(dados.size()));
+        const GSTransferSnapshot t = m_cpu->GetTransferSnapshot();
+        std::lock_guard<std::mutex> lk(m_transfMutex);
+        m_transf = t;
+        break;
+    }
+    case Tipo::TexFlush:
+        m_cpu->TextureFlush();
+        break;
+    case Tipo::Limpa:
+        {
+            auto &g = m_genFb[estados[cmd.est].context.frame.fbp & 511u];
+            g.store(g.load(std::memory_order_relaxed) + 1u, std::memory_order_release);
+        }
+        m_cpu->ClearFramebuffer(estados[cmd.est].context, cmd.a);
+        break;
+    case Tipo::Escreve:
+        m_genOutros.store(m_genOutros.load(std::memory_order_relaxed) + 1u, std::memory_order_release);
+        m_cpu->WriteVram(cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, cmd.f);
+        break;
+    case Tipo::Marca:
+        capturaComVez(extras[cmd.a].pedido); // Otavix (captura na troca)
+        break;
+    }
+}
+
+void GSThreadBackend::poe(Cmd &&cmd)
+{
+    uint64_t postos;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        m_fila.push_back(std::move(cmd));
+        postos = ++m_postos;
+    }
+    m_temTrabalho.notify_one();
+    const uint64_t feitos = m_feitos.load(std::memory_order_acquire);
+    const uint64_t limite = limiteFila();
+    if (postos - feitos >= limite)
+        espera(postos - limite / 2u);
+}
+
+void GSThreadBackend::poeExtra(Cmd &&cmd, Extra &&extra)
+{
+    uint64_t postos;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        cmd.a = static_cast<uint32_t>(m_extras.size());
+        m_extras.push_back(std::move(extra));
+        m_fila.push_back(std::move(cmd));
+        postos = ++m_postos;
+    }
+    m_temTrabalho.notify_one();
+    const uint64_t feitos = m_feitos.load(std::memory_order_acquire);
+    const uint64_t limite = limiteFila();
+    if (postos - feitos >= limite)
+        espera(postos - limite / 2u);
+}
+
+void GSThreadBackend::espera(uint64_t ate) const
+{
+    if (m_feitos.load(std::memory_order_acquire) >= ate)
+        return;
+    std::unique_lock<std::mutex> lk(m_filaMutex);
+    m_andou.wait(lk, [this, ate]
+                 { return m_feitos.load(std::memory_order_acquire) >= ate; });
+}
+
+void GSThreadBackend::esperaTudo() const
+{
+    uint64_t postos;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        postos = m_postos;
+    }
+    espera(postos);
+}
+
+void GSThreadBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    esperaTudo();
+    m_vram = vram;
+    m_cpu->Initialize(vram, vramSize);
+}
+
+void GSThreadBackend::Reset()
+{
+    esperaTudo();
+    m_cpu->Reset();
+}
