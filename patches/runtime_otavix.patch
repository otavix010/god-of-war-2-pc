+            }
+        }
+
+        // cor do vértice
+        __m256i r, g, b, a;
+        if (iip)
+        {
+            const auto canal = [&](float c0f, float c1f, float c2f)
+            {
+                const __m256 s = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(_mm256_set1_ps(c0f), w0), _mm256_mul_ps(_mm256_set1_ps(c1f), w1)),
+                                               _mm256_mul_ps(_mm256_set1_ps(c2f), w2));
+                return otxClampU8x8(_mm256_cvttps_epi32(s));
