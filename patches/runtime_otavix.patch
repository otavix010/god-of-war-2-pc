+void GSThreadBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Cmd c;
+    c.tipo = Tipo::Clut;
+    Extra x;
+    x.tex0 = tex0;
+    x.texclut = texclut;
+    poeExtra(std::move(c), std::move(x));
+}
+
+void GSThreadBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    Cmd c;
+    c.tipo = Tipo::Transfer;
+    Extra x;
+    x.transfer = command;
+    poeExtra(std::move(c), std::move(x));
+    // GS->host: a cópia para o buffer do host é feita no BeginTransfer; quem lê usa ConsumeLocalToHostBytes
+}
+
+void GSThreadBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    Cmd c;
+    c.tipo = Tipo::Upload;
+    {
+        std::lock_guard<std::mutex> lk(m_filaMutex);
+        c.a = static_cast<uint32_t>(m_uploads.size());
+        m_uploads.emplace_back(data, data + sizeBytes);
+        m_fila.push_back(std::move(c));
+        ++m_postos;
+    }
+    m_temTrabalho.notify_one();
+}
