+    // Otavix (patch_iop_rpc_ee): servidor do EE registrado por sceSifRegisterRpc
+    bool otxTemServidorRpcEe(uint32_t sid)
+    {
+        std::unique_lock<std::mutex> lock(g_rpc_mutex, std::try_to_lock); // o IOP pode rodar com o mutex já preso pela própria thread do executor
+        auto it = g_rpc_servers.find(sid);
