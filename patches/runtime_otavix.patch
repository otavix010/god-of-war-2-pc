+    while (std::fgets(linha, sizeof linha, f))
+    {
+        std::string l(linha);
+        while (!l.empty() && (l.back() == '\n' || l.back() == '\r' || l.back() == ' '))
+            l.pop_back();
+        const size_t eq = l.find('=');
+        if (l.empty() || l[0] == '#' || eq == std::string::npos || eq == 0)
+            continue;
+        const std::string nome = l.substr(0, eq), valor = l.substr(eq + 1);
+        if (!std::getenv(nome.c_str()))
+        {
+            _putenv_s(nome.c_str(), valor.c_str());
+            ++n;
+        }
+    }
