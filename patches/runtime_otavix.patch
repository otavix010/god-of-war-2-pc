+void VU1Interpreter::otxXgkickEstouro(const char *motivo)
+{
+    static std::atomic<uint32_t> n{0u};
+    if (n.fetch_add(1u, std::memory_order_relaxed) >= 12u)
+        return;
+    std::fprintf(stderr, "[vu1:xgkick-estouro] %s origem=0x%04x copiado=%u pc=0x%04x emitido=%llu agora=%llu tags:",
+                 motivo, m_xgkick.sourceAddress, m_xgkick.copiedBytes, m_state.pc,
+                 static_cast<unsigned long long>(m_xgkick.issueCycle), static_cast<unsigned long long>(m_cycle));
+    // percorre as tags a partir da origem na memória atual do VU1
+    uint32_t off = 0;
+    for (int k = 0; k < 8 && m_activeVuData; ++k)
+    {
+        uint64_t t = 0;
+        for (uint32_t i = 0; i < 8u; ++i)
+            t |= static_cast<uint64_t>(m_activeVuData[(m_xgkick.sourceAddress + off + i) % m_activeVuDataSize]) << (8u * i);
+        const uint32_t nloop = static_cast<uint32_t>(t & 0x7FFFu), flg = static_cast<uint32_t>((t >> 58) & 3u);
+        uint32_t nreg = static_cast<uint32_t>((t >> 60) & 0xFu);
+        if (!nreg)
+            nreg = 16u;
+        std::fprintf(stderr, " [%016llx n=%u flg=%u nreg=%u eop=%u]", static_cast<unsigned long long>(t), nloop, flg, nreg,
+                     static_cast<unsigned>((t >> 15) & 1u));
+        uint32_t b = 16u + (flg == 0u ? nloop * nreg * 16u : flg == 1u ? ((nloop * nreg + 1u) & ~1u) * 8u : nloop * 16u);
+        if ((t >> 15) & 1u)
+            break;
+        off += b;
+    }
+    std::fprintf(stderr, "\n");
 }
 
